aps":3,"ot":3,"nt":0,"first":"诗篇 107:14","top":[["诗篇",2],["以赛亚书",1]],"rest":[0,0],"co":[["折断",1],["黑暗",1],["出来",1],["仆人",1]],"books":{"诗篇":2,"以赛亚书":1},"verse":"他从黑暗中和死荫里领他们出来，折断他们的绑索。","ref":"诗篇 107:14","def":"和合本用词；常见搭配：折断 1、黑暗 1、出来 1。","senses":[],"bverse":"耶和华啊，我真是你的仆人；我是你的仆人，是你婢女的儿子。你已经解开我的绑索。","bref":"诗篇 116:16"},{"no":7595,"w":"铜门","py":"tóng mén","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 107:16","top":[["诗篇",1],["以赛亚书",1]],"rest":[0,0],"co":[["砍断",2],["打破",2],["修平",1],["我必",1]],"books":{"诗篇":1,"以赛亚书":1},"verse":"因为他打破了铜门，砍断了铁闩。","ref":"诗篇 107:16","def":"指金门﹐金马门","senses":[["①","指金门﹐金马门","诗 107:16","出现 2 次"]],"bverse":"我必在你前面行，修平崎岖之地。我必打破铜门，砍断铁闩。","bref":"以赛亚书 45:2"},{"no":7596,"w":"发命","py":"fā mìng","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"诗篇 107:20","top":[["诗篇",2],["以赛亚书",1]],"rest":[1,1],"co":[["医治",1],["脱离",1],["死亡",1],["颁行",1]],"books":{"诗篇":2,"以赛亚书":1,"阿摩司书":1},"verse":"他发命在地；他的话颁行最快。","ref":"诗篇 147:15","def":"和合本用词；常见搭配：医治 1、脱离 1、死亡 1。","senses":[],"bverse":"他发命医治他们，救他们脱离死亡。","bref":"诗篇 107:20"},{"no":7597,"w":"暴虐","py":"bào nüè","pos":"动词","orig":"","freq":6,"verses":6,"vols":5,"chaps":5,"ot":5,"nt":1,"first":"诗篇 107:39","top":[["箴言",2],["诗篇",1]],"rest":[3,3],"co":[["经过",2],["愁苦",1],["减少",1],["卑下",1]],"books":{"箴言":2,"诗篇":1,"以赛亚书":1,"撒迦利亚书":1,"罗马书":1},"verse":"暴虐的君王辖制贫民，好像吼叫的狮子、觅食的熊。","ref":"箴言 28:15","def":"和合本用词；常见搭配：经过 2、愁苦 1、减少 1。","senses":[["①","凶恶残酷～无道","诗 107:39","出现 6 次"]],"bverse":"无知的君多行暴虐；以贪财为可恨的，必年长日久。","bref":"箴言 28:16"},{"no":7598,"w":"大过","py":"dà guò","pos":"形容词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 108:4","top":[["诗篇",1],["传道书",1]],"rest":[1,1],"co":[["诚实",1],["达到",1],["诸天",1],["穹苍",1]],"books":{"诗篇":1,"传道书":1,"路加福音":1},"verse":"因为，你的慈爱大过诸天；你的诚实达到穹苍。","ref":"诗篇 108:4","def":"《周易》卦名。巽下兑上。《易．大过》\"大过﹐栋挠﹐利有攸往∴。\"孔颖达疏\"栋挠者谓屋栋也﹐本之与末俱挠弱","senses":[["①","《周易》卦名","诗 108:4","出现 3 次"]],"bverse":"掌权者的心若向你发怒，不要离开你的本位，因为柔和能免大过。","bref":"传道书 10:4"},{"no":7599,"w":"罪名","py":"zuì míng","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"诗篇 109:7","top":[["诗篇",1],["传道书",1]],"rest":[2,2],"co":[["担当",2],["时候",1],["审判",1],["成为",1]],"books":{"诗篇":1,"传道书":1,"使徒行传":1,"加拉太书":1},"verse":"他受审判的时候，愿他出来担当罪名！愿他的祈祷反成为罪！","ref":"诗篇 109:7","def":"刑事法律规定的犯罪行为的名称。如抢劫罪、伤害罪等。罪名反映犯罪行为的性质和特征，不能混淆不同的罪名。罪名","senses":[["①","刑事法律规定的犯罪行","诗 109:7","出现 4 次"]],"bverse":"因为断定罪名不立刻施刑，所以世人满心作恶。","bref":"传道书 8:11"},{"no":7600,"w":"不想","py":"bù xiǎng","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"诗篇 109:16","top":[["诗篇",1],["马太福音",1]],"rest":[2,2],"co":[["梁木",2],["眼中",2],["弟兄",2],["看见",2]],"books":{"诗篇":1,"马太福音":1,"路加福音":1,"约翰福音":1},"verse":"因为他不想施恩，却逼迫困苦穷乏的和伤心的人，要把他们治死。","ref":"诗篇 109:16","def":"和合本用词；常见搭配：梁木 2、眼中 2、弟兄 2。","senses":[],"bverse":"为什么看见你弟兄眼中有刺，却不想自己眼中有梁木呢？","bref":"马太福音 7:3"}]