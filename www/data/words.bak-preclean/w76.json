,"ref":"诗篇 92:7","def":"植物茂密旺盛树木茂盛。②事业兴盛；功德卓著生意茂┦ⅲ功德茂盛","senses":[["①","植物茂密旺盛树木茂盛","诗 72:16","出现 7 次"]],"bverse":"到那日，耶和华发生的苗必华美尊荣，地的出产必为以色列逃脱的人显为荣华茂盛。","bref":"以赛亚书 4:2"},{"no":7506,"w":"独行","py":"dú xíng","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 72:18","top":[["诗篇",2],["何西阿书",1]],"rest":[0,0],"co":[["奇事",2],["应当",1],["以色列",1],["称颂",1]],"books":{"诗篇":2,"何西阿书":1},"verse":"称谢那独行大奇事的，因他的慈爱永远长存。","ref":"诗篇 136:4","def":"独自走路踽踽","senses":[["①","独自走路踽踽～","诗 72:18","出现 3 次"]],"bverse":"独行奇事的耶和华─以色列的神是应当称颂的！","bref":"诗篇 72:18"},{"no":7507,"w":"清心","py":"qīng xīn","pos":"形容词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"诗篇 73:1","top":[["诗篇",1],["箴言",1]],"rest":[2,2],"co":[["实在",1],["以色列",1],["亚萨",1],["恩待",1]],"books":{"诗篇":1,"箴言":1,"马太福音":1,"提摩太（后书）":1},"verse":"（亚萨的诗。）神实在恩待以色列那些清心的人！","ref":"诗篇 73:1","def":"心地恬静，无思无虑","senses":[["①","心地恬静","诗 73:1","出现 4 次"]],"bverse":"清心的人有福了！因为他们必得见神。","bref":"马太福音 5:8"},{"no":7508,"w":"常享","py":"cháng xiǎng","pos":"副词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"诗篇 73:12","top":[["诗篇",1],["箴言",1]],"rest":[1,1],"co":[["安逸",2],["财宝",1],["恶人",1],["加增",1]],"books":{"诗篇":1,"箴言":1,"耶利米书":1},"verse":"看哪，这就是恶人；他们既是常享安逸，财宝便加增。","ref":"诗篇 73:12","def":"和合本用词；常见搭配：安逸 2、财宝 1、恶人 1。","senses":[],"bverse":"困苦人的日子都是愁苦；心中欢畅的，常享丰筵。","bref":"箴言 15:15"},{"no":7509,"w":"思索","py":"sī suǒ","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 73:16","top":[["诗篇",1],["以赛亚书",1]],"rest":[0,0],"co":[["怎能",1],["眼看",1],["明白",1],["为难",1]],"books":{"诗篇":1,"以赛亚书":1},"verse":"我思索怎能明白这事，眼看实系为难，","ref":"诗篇 73:16","def":"和合本用词；常见搭配：怎能 1、眼看 1、明白 1。","senses":[["①","思考探求","诗 73:16","出现 2 次"]],"bverse":"可以声明，指示我们将来必遇的事，说明先前的是什么事，好叫我们思索，得知事的结局，或者把将来的事指示我们。","bref":"以赛亚书 41:22"},{"no":7510,"w":"为难","py":"wéi nán","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 73:16","top":[["诗篇",1],["但以理书",1]],"rest":[1,1],"co":[["怎能",1],["眼看",1],["明白",1],["思索",1]],"books":{"诗篇":1,"但以理书":1,"腓立比书":1},"verse":"我思索怎能明白这事，眼看实系为难，","ref":"诗篇 73:16","def":"感到困难，难以应付左右为难","senses":[["①","感到困难","诗 73:16","出现 3 次"]],"bverse":"‘术士的领袖伯提沙撒啊，因我知道你里头有圣神的灵，什么奥秘的事都不能使你为难。现在要把我梦中所见的异象和梦的讲解告诉我。’","bref":"但以理书 4:9"},{"no":7511,"w":"发酸","py":"fā suān","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 73:21","top":[["诗篇",1],["何西阿书",1]],"rest":[1,1],"co":[["肺腑",1],["因而",1],["心里",1],["行淫",1]],"books":{"诗篇":1,"何西阿书":1,"希伯来书":1},"verse":"因而，我心里发酸，肺腑被刺。","ref":"诗篇 73:21","def":"和合本用词；常见搭配：肺腑 1、因而 1、心里 1。","senses":[],"bverse":"所以，你们要把下垂的手、发酸的腿挺起来；","bref":"希伯来书 12:12"},{"no":7512,"w":"训言","py":"xùn yán","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":4,"nt":0,"first":"诗篇 73:24","top":[["诗篇",2],["箴言",2]],"rest":[0,0],"co":[["以后",1],["荣耀",1],["引导",1],["金银",1]],"books":{"诗篇":2,"箴言":2},"verse":"你要以你的训言引导我，以后必接我到荣耀里。","ref":"诗篇 73:24","def":"和合本用词；常见搭配：以后 1、荣耀 1、引导 1。","senses":[],"bverse":"你口中的训言（或译：律法）与我有益，胜于千万的金银。","bref":"诗篇 119:72"},{"no":7513,"w":"分裂","py":"fēn liè","pos":"动词","orig":"","freq":7,"verses":7,"vols":4,"chaps":6,"ot":7,"nt":0,"first":"诗篇 74:15","top":[["诗篇",4],["以赛亚书",1]],"rest":[2,2],"co":[["磐石",3],["溪河",1],["江河",1],["水便",1]],"books":{"诗篇":4,"以赛亚书":1,"但以理书":1,"撒迦利亚书":1},"verse":"称谢那分裂红海的，因他的慈爱永远长存。","ref":"诗篇 136:13","def":"整体的事物分开细胞","senses":[["①","整体的事物分开细胞～","诗 74:15","出现 7 次"]],"bverse":"他将海分裂，使他们过去，又叫水立起如垒。","bref":"诗篇 78:13"},{"no":7514,"w":"冬天","py":"dōng tiān","pos":"时间词","orig":"","freq":7,"verses":7,"vols":7,"chaps":7,"ot":3,"nt":4,"first":"诗篇 74:17","top":[["诗篇",1],["雅歌",1]],"rest":[5,5],"co":[["夏天",2],["应当",2],["时候",2],["祈求",2]],"books":{"诗篇":1,"雅歌":1,"以赛亚书":1,"马太福音":1,"马可福音":1,"约翰福音":1,"提摩太（后书）":1},"verse":"地的一切疆界是你所立的；夏天和冬天是你所定的。","ref":"诗篇 74:17","def":"和合本用词；常见搭配：夏天 2、应当 2、时候 2。","senses":[],"bverse":"因为冬天已往，雨水止住过去了。","bref":"雅歌 2:11"},{"no":7515,"w":"渣滓","py":"zhā zǐ","pos":"名词","orig":"","freq":12,"verses":11,"vols":8,"chaps":9,"ot":11,"nt":1,"first":"诗篇 75:8","top":[["以西结书",3],["诗篇",2]],"rest":[6,7],"co":[["耶和华",3],["我必",3],["恶人",2],["地上",2]],"books":{"以西结书":3,"诗篇":2,"以赛亚书":2,"箴言":1,"耶利米书":1,"耶利米哀歌":1,"西番雅书":1,"哥林多前书":1},"verse":"所以主耶和华如此说：因你们都成为渣滓，我必聚集你们在耶路撒冷中。","ref":"以西结书 22:19","def":"物品提取出精华后的残余部分微有些渣滓去不尽。②比喻品质恶劣无益于社会的人社会渣滓","senses":[["①","物品提取出精华后的残","诗 75:8","出现 12 次"]],"bverse":"“人子啊，以色列家在我看为渣滓。他们都是炉中的铜、锡、铁、铅，都是银渣滓。","bref":"以西结书 22:18"},{"no":7516,"w":"宣扬","py":"xuān yáng","pos":"动词","orig":"","freq":7,"verses":7,"vols":7,"chaps":7,"ot":3,"nt":4,"first":"诗篇 75:9","top":[["诗篇",1],["以赛亚书",1]],"rest":[5,5],"co":[["出来",3],["雅各",2],["明处",2],["暗中",2]],"books":{"诗篇":1,"以赛亚书":1,"但以理书":1,"马太福音":1,"路加福音":1,"使徒行传":1,"彼得前书":1},"verse":"但我要宣扬，直到永远！我要歌颂雅各的神！","ref":"诗篇 75:9","def":"广泛传布;传扬","senses":[["①","广泛传布;传扬","诗 75:9","出现 7 次"]],"bverse":"我乐意将至高的神向我所行的神迹奇事宣扬出来。","bref":"但以理书 4:2"},{"no":7517,"w":"角必","py":"jiǎo bì","pos":"名词","orig":"","freq":5,"verses":5,"vols":2,"chaps":4,"ot":5,"nt":0,"first":"诗篇 75:10","top":[["诗篇",4],["阿摩司书",1]],"rest":[0,0],"co":[["高举",4],["荣耀",2],["我要",1],["义人",1]],"books":{"诗篇":4,"阿摩司书":1},"verse":"恶人一切的角，我要砍断；惟有义人的角必被高举。","ref":"诗篇 75:10","def":"和合本用词；常见搭配：高举 4、荣耀 2、我要 1。","senses":[],"bverse":"你是他们力量的荣耀；因为你喜悦我们，我们的角必被高举。","bref":"诗篇 89:17"},{"no":7518,"w":"长觉","py":"zhǎng jué","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"诗篇 76:5","top":[["耶利米书",2],["诗篇",1]],"rest":[0,0],"co":[["醒起",2],["永不",2],["沉醉",2],["抢夺",1]],"books":{"耶利米书":2,"诗篇":1},"verse":"心中勇敢的人都被抢夺；他们睡了长觉，没有一个英雄能措手。","ref":"诗篇 76:5","def":"和合本用词；常见搭配：醒起 2、永不 2、沉醉 2。","senses":[],"bverse":"他们火热的时候，我必为他们设摆酒席，使他们沉醉，好叫他们快乐，睡了长觉，永不醒起。这是耶和华说的。","bref":"耶利米书 51:39"},{"no":7519,"w":"骄气","py":"jiāo qì","pos":"形容词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"诗篇 76:12","top":[["以西结书",2],["诗篇",1]],"rest":[1,1],"co":[["君王",1],["可畏",1],["地上",1],["王子",1]],"books":{"以西结书":2,"诗篇":1,"箴言":1},"verse":"所以主耶和华如此说：“因它高大，树尖插入云中，心骄气傲，","ref":"以西结书 31:10","d