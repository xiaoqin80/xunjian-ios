"实际的行动","诗 89:14","出现 2 次"]],"bverse":"耶和华啊，你是我的神；我要尊崇你，我要称赞你的名。因为你以忠信诚实行过奇妙的事，成就你古时所定的。","bref":"以赛亚书 25:1"},{"no":7552,"w":"光里","py":"guāng lǐ","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 89:15","top":[["诗篇",1],["提摩太（前书）",1]],"rest":[1,1],"co":[["行走",2],["知道",1],["欢呼",1],["脸上",1]],"books":{"诗篇":1,"提摩太（前书）":1,"启示录":1},"verse":"知道向你欢呼的，那民是有福的！耶和华啊，他们在你脸上的光里行走。","ref":"诗篇 89:15","def":"和合本用词；常见搭配：行走 2、知道 1、欢呼 1。","senses":[],"bverse":"列国要在城的光里行走；地上的君王必将自己的荣耀归与那城。","bref":"启示录 21:24"},{"no":7553,"w":"勒索","py":"lè suǒ","pos":"名词","orig":"","freq":11,"verses":11,"vols":8,"chaps":10,"ot":5,"nt":6,"first":"诗篇 89:22","top":[["哥林多前书",3],["路加福音",2]],"rest":[6,6],"co":[["法利赛人",3],["贪婪",3],["里面",2],["外面",2]],"books":{"哥林多前书":3,"路加福音":2,"诗篇":1,"传道书":1,"以赛亚书":1,"以西结书":1,"阿摩司书":1,"马太福音":1},"verse":"偷窃的、贪婪的、醉酒的、辱骂的、勒索的，都不能承受神的国。","ref":"哥林多前书 6:10","def":"和合本用词；常见搭配：法利赛人 3、贪婪 3、里面 2。","senses":[],"bverse":"仇敌必不勒索他；凶恶之子也不苦害他。","bref":"诗篇 89:22"},{"no":7554,"w":"称呼","py":"chēng hū","pos":"动词","orig":"","freq":27,"verses":25,"vols":10,"chaps":18,"ot":7,"nt":20,"first":"诗篇 89:26","top":[["使徒行传",10],["马太福音",6]],"rest":[8,11],"co":[["彼得",5],["西门",5],["耶和华",4],["一位",4]],"books":{"使徒行传":10,"马太福音":6,"以赛亚书":2,"何西阿书":2,"约翰福音":2,"诗篇":1,"箴言":1,"耶利米书":1,"路加福音":1,"提摩太（后书）":1},"verse":"巴拿巴有意要带称呼马可的约翰同去；","ref":"使徒行传 15:37","def":"叫。对人呼唤其身份﹑名称等","senses":[],"bverse":"喊著问：“有称呼彼得的西门住在这里没有？”","bref":"使徒行传 10:18"},{"no":7555,"w":"千年","py":"qiān nián","pos":"数词","orig":"","freq":5,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":2,"first":"诗篇 90:4","top":[["传道书",2],["彼得后书",2]],"rest":[1,1],"co":[["夜间",1],["昨日",1],["再活",1],["众人",1]],"books":{"传道书":2,"彼得后书":2,"诗篇":1},"verse":"那人虽然活千年，再活千年，却不享福，众人岂不都归一个地方去吗？","ref":"传道书 6:6","def":"极言时间久远","senses":[["①","极言时间久远","诗 90:4","出现 5 次"]],"bverse":"亲爱的弟兄啊，有一件事你们不可忘记，就是主看一日如千年，千年如一日。","bref":"彼得后书 3:8"},{"no":7556,"w":"捕鸟","py":"bǔ niǎo","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":4,"nt":0,"first":"诗篇 91:3","top":[["诗篇",1],["箴言",1]],"rest":[2,2],"co":[["网罗",2],["脱离",2],["毒害",1],["必救",1]],"books":{"诗篇":1,"箴言":1,"耶利米书":1,"何西阿书":1},"verse":"他必救你脱离捕鸟人的网罗和毒害的瘟疫。","ref":"诗篇 91:3","def":"和合本用词；常见搭配：网罗 2、脱离 2、毒害 1。","senses":[],"bverse":"要救自己，如鹿脱离猎户的手，如鸟脱离捕鸟人的手。","bref":"箴言 6:5"},{"no":7557,"w":"美事","py":"měi shì","pos":"名词","orig":"","freq":8,"verses":8,"vols":7,"chaps":8,"ot":2,"nt":6,"first":"诗篇 92:2","top":[["希伯来书",2],["诗篇",1]],"rest":[5,5],"co":[["耶稣",2],["难为",2],["身上",2],["一件",2]],"books":{"希伯来书":2,"诗篇":1,"箴言":1,"马太福音":1,"马可福音":1,"腓立比书":1,"提多书":1},"verse":"然而，你们和我同受患难原是美事。","ref":"腓立比书 4:14","def":"和合本用词；常见搭配：耶稣 2、难为 2、身上 2。","senses":[],"bverse":"谋略和知识的美事，我岂没有写给你吗？","bref":"箴言 22:20"},{"no":7558,"w":"太初","py":"tài chū","pos":"名词","orig":"","freq":7,"verses":7,"vols":5,"chaps":5,"ot":5,"nt":2,"first":"诗篇 93:2","top":[["箴言",2],["约翰福音",2]],"rest":[3,3],"co":[["亘古",3],["宝座",2],["神同",2],["立定",1]],"books":{"箴言":2,"约翰福音":2,"诗篇":1,"耶利米书":1,"弥迦书":1},"verse":"从亘古，从太初，未有世界以前，我已被立。","ref":"箴言 8:23","def":"和合本用词；常见搭配：亘古 3、宝座 2、神同 2。","senses":[["①","亦作\"大初\"","诗 93:2","出现 7 次"]],"bverse":"在耶和华造化的起头，在太初创造万物之先，就有了我。","bref":"箴言 8:22"},{"no":7559,"w":"大浪","py":"dà làng","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 93:4","top":[["诗篇",1],["路加福音",1]],"rest":[1,1],"co":[["狂风",2],["胜过",1],["响声",1],["洋海",1]],"books":{"诗篇":1,"路加福音":1,"使徒行传":1},"verse":"耶和华在高处大有能力，胜过诸水的响声，洋海的大浪。","ref":"诗篇 93:4","def":"和合本用词；常见搭配：狂风 2、胜过 1、响声 1。","senses":[],"bverse":"太阳和星辰多日不显露，又有狂风大浪催逼，我们得救的指望就都绝了。","bref":"使徒行传 27:20"},{"no":7560,"w":"人受","py":"rén shòu","pos":"名词","orig":"","freq":6,"verses":6,"vols":5,"chaps":6,"ot":3,"nt":3,"first":"诗篇 94:2","top":[["箴言",2],["诗篇",1]],"rest":[3,3],"co":[["审判",2],["骄傲",1],["而立",1],["报应",1]],"books":{"箴言":2,"诗篇":1,"使徒行传":1,"彼得前书":1,"启示录":1},"verse":"耶和华不使义人受饥饿；恶人所欲的，他必推开。","ref":"箴言 10:3","def":"和合本用词；常见搭配：审判 2、骄傲 1、而立 1。","senses":[],"bverse":"亵慢的人受刑罚，愚蒙的人就得智慧；智慧人受训诲，便得知识。","bref":"箴言 21:11"},{"no":7561,"w":"正说","py":"zhèng shuō","pos":"动词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":3,"nt":3,"first":"诗篇 94:18","top":[["以西结书",2],["路加福音",2]],"rest":[2,2],"co":[["时候",5],["耶和华",2],["大声",2],["预言",2]],"books":{"以西结书":2,"路加福音":2,"诗篇":1,"帖撒罗尼迦（前书）":1},"verse":"我正说我失了脚，耶和华啊，那时你的慈爱扶助我。","ref":"诗篇 94:18","def":"和合本用词；常见搭配：时候 5、耶和华 2、大声 2。","senses":[],"bverse":"于是，我遵命说预言。正说预言的时候，不料，有响声，有地震；骨与骨互相联络。","bref":"以西结书 37:7"},{"no":7562,"w":"相交","py":"xiāng jiāo","pos":"动词","orig":"","freq":10,"verses":9,"vols":5,"chaps":6,"ot":1,"nt":9,"first":"诗篇 94:20","top":[["约翰（一书）",4],["哥林多前书",3]],"rest":[3,3],"co":[["不可",2],["淫乱",2],["称为",2],["乃是",2]],"books":{"约翰（一书）":4,"哥林多前书":3,"诗篇":1,"哥林多后书":1,"加拉太书":1},"verse":"我们若说是与神相交，却仍在黑暗里行，就是说谎话，不行真理了。","ref":"约翰一书 1:6","def":"相交往;结交","senses":[["①","相交往;结交","诗 94:20","出现 10 次"]],"bverse":"我们若在光明中行，如同神在光明中，就彼此相交，他儿子耶稣的血也洗净我们一切的罪。","bref":"约翰一书 1:7"},{"no":7563,"w":"迷糊","py":"mí hū","pos":"形容词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"诗篇 95:10","top":[["诗篇",1],["以赛亚书",1]],"rest":[2,2],"co":[["心里",2],["世代",2],["晓得",2],["作为",2]],"books":{"诗篇":1,"以赛亚书":1,"路加福音":1,"希伯来书":1},"verse":"四十年之久，我厌烦那世代，说：这是心里迷糊的百姓，竟不晓得我的作为！","ref":"诗篇 95:10","def":"神智或视力凝不清烧酒使他更迷糊了，辨不清天地、分不出人物","senses":[["①","神智或视力凝不清烧酒","诗 95:10","出现 4 次"]],"bverse":"只是他们的眼睛迷糊了，不认识他。","bref":"路加福音 24:16"},{"no":7564,"w":"眼要","py":"yǎn yào","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"诗篇 101:6","top":[["诗篇",1],["箴言",1]],"rest":[1,1],"co":[["诚实",1],["行为",1],["完全",1],["同住",1]],"books":{"诗篇":1,"箴言":1,"耶利米书":1},"verse":"我眼要看国中的诚实人，叫他们与我同住；行为完全的，他要伺候我。","ref":"诗篇 101:6","def":"和合本用词；常见搭配：诚实 1、行为 1、完全 1。","senses":[],"bverse":"不要贪睡，免致贫穷；眼要睁开，你就吃饱。","bref":"箴言 20:13"},{"no":7565,"w":"孤单","py":"gū dān","pos":"形容词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 102:7","top":[["诗篇",1],["传道书",1]],"rest":[0,0],"co":[["房顶",1],["警醒",1],["麻雀",1],["无子",1]],"books":{"诗篇":1,"传道书":1},"verse":"我警醒不睡；我像房顶上孤单的麻雀。","ref":"诗篇 102:7","def":"单身无靠，感到寂寞","senses":[["①","单身无靠","诗 102:7","出现 2 次"]],"bverse":"有人孤单无二，无子无兄，竟劳碌不息，眼目也不以钱财为足。他说：“我劳劳碌碌，刻苦自己，不享福乐，到底是为谁呢？”这也是虚空，是极重的劳苦。","bref":"传道书 4:8"},{"no":7566,"w":"赌咒","py":"dǔ zhòu","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"诗篇 102:8","top":[["耶利米书",2],["诗篇",1]],"rest":[1,1],"co":[["耶和华",2],["终日",1],["仇敌",1],["辱骂",1]],"books":{"耶利米书":2,"诗篇":1,"以赛亚书":1},"verse":"我的仇敌终日辱骂我；向我猖狂的人指着我赌咒。","ref":"诗篇 102:8","def":"和合本用词；常见搭配：耶和华 2、终日 1、仇敌 1。","senses":[],"bverse":"你们必留下自己的名，为我选民指著赌咒。主耶和华必杀你们，另起别名称呼他的仆人。","bref":"以赛亚书 65:15"},{"no":7567,"w":"偏斜","py":"piān xié","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 102:11","top":[["诗篇",2]],"rest":[0,0],"co":[["日影",2],["如草",1],["枯干",1],["蝗虫",1]],"books":{"诗篇":2},"verse":"我的年日如日影偏斜；我也如草枯干。","ref":"诗篇 102:11","def":"和合本用词；常见搭配：日影 2、如草 1、枯干 1。","senses":[["①","不正;倾斜","诗 102:11","出现 2 次"]],"bverse":"我如日影渐渐偏斜而去；我如蝗虫被抖出来。","bref":"诗篇 109:23"},{"no":7568,"w":"中道","py":"zhōng dào","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 102:23","top":[["诗篇",1],["罗马书",1]],"rest":[0,0],"co":[["衰弱",1],["力量",1],["短少",1],["不要",1]],"books":{"诗篇":1,"罗马书":1},"verse":"他使我的力量中道衰弱，使我的年日短少。","ref":"诗篇 102:23","def":"和合本用词；常见搭配：衰弱 1、力量 1、短少 1。","senses":[["①","半途;中途","诗 102:23","出现 2 次"]],"bverse":"我凭着所赐我的恩对你们各人说：不要看自己过于所当看的；要照着神所分给各人信心的大小，看得合乎中道。","bref":"罗马书 12:3"},{"no":7569,"w":"无穷","py":"wú qióng","pos":"副词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":4,"nt":1,"first":"诗篇 102:24","top":[["以赛亚书",2],["诗篇",1]],"rest":[2,2],"co":[["金银",2],["无数",2],["年数",1],["不要",1]],"books":{"以赛亚书":2,"诗篇":1,"那鸿书":1,"希伯来书":1},"verse":"他们的国满了金银，财宝也无穷；他们的地满了马匹，车辆也无数。","ref":"以赛亚书 2:7","def":"没有穷尽;没有极限","senses":[["①","没有穷尽;没有极限","诗 102:24","出现 5 次"]],"bverse":"你们抢掠金银吧！因为所积蓄的无穷，华美的宝器无数。","bref":"那鸿书 2:9"},{"no":7570,"w":"仁爱","py":"rén ài","pos":"名词","orig":"","freq":8,"verses":8,"vols":6,"chaps":7,"ot":2,"nt":6,"first":"诗篇 103:4","top":[["加拉太书",2],["提摩太（后书）",2]],"rest":[4,4],"co":[["和平",3],["谨守",2],["喜乐",2],["信心",2]],"books":{"加拉太书":2,"提摩太（后书）":2,"诗篇":1,"何西阿书":1,"哥林多后书":1,"以弗所书":1},"verse":"圣灵所结的果子，就是仁爱、喜乐、和平、忍耐、恩慈、良善、信实、","ref":"加拉太书 5:22","def":"宽仁慈爱;亲爱","senses":[["①","宽仁慈爱;亲爱","诗 103:4","出现 8 次"]],"bverse":"原来在基督耶稣里，受割礼不受割礼全无功效，惟独使人生发仁爱的信心才有功效。","bref":"加拉太书 5:6"},{"no":7571,"w":"怀怒","py":"huái nù","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":4,"nt":0,"first":"诗篇 103:9","top":[["诗篇",1],["耶利米书",1]],"rest":[2,2],"co":[["永远",3],["耶和华",2],["责备",1],["长久",1]],"books":{"诗篇":1,"耶利米书":1,"弥迦书":1,"那鸿书":1},"verse":"他不长久责备，也不永远怀怒。","ref":"诗篇 103:9","def":"和合本用词；常见搭配：永远 3、耶和华 2、责备 1。","senses":[],"bverse":"神啊，有何神像你，赦免罪孽，饶恕你产业之余民的罪过，不永远怀怒，喜爱施恩？","bref":"弥迦书 7:18"},{"no":7572,"w":"本体","py":"běn tǐ","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 103:14","top":[["诗篇",1],["希伯来书",1]],"rest":[0,0],"co":[["尘土",1],["知道",1],["思念",1],["不过",1]],"books":{"诗篇":1,"希伯来书":1},"verse":"因为他知道我们的本体，思念我们不过是尘土。","ref":"诗篇 103:14","def":"德国哲学家康德唯心主义哲学中的重要概念，指与现象对立的不可认识的‘自在之物’。辩证唯物主义否认现象和本体","senses":[["①","德国哲学家康德唯心主","诗 103:14","出现 2 次"]],"bverse":"他是神荣耀所发的光辉，是神本体的真像，常用他权能的命令托住万有。他洗净了人的罪，就坐在高天至大者的右边。","bref":"希伯来书 1:3"},{"no":7573,"w":"仆役","py":"pú yì","pos":"名词","orig":"","freq":8,"verses":8,"vols":5,"chaps":8,"ot":6,"nt":2,"first":"诗篇 103:21","top":[["诗篇",3],["以西结书",2]],"rest":[3,3],"co":[["耶和华",2],["火焰",2],["使者",2],["祭司",2]],"books":{"诗篇":3,"以西结书":2,"以赛亚书":1,"罗马书":1,"希伯来书":1},"verse":"以风为使者，以火焰为仆役，","ref":"诗篇 104:4","def":"和合本用词；常见搭配：耶和华 2、火焰 2、使者 2。","senses":[],"bverse":"天地照你的安排存到今日；万物都是你的仆役。","bref":"诗篇 119:91"},{"no":7574,"w":"楼阁","py":"lóu gé","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"诗篇 104:3","top":[["诗篇",2],["阿摩司书",1]],"rest":[0,0],"co":[["翅膀",1],["水中",1],["云彩",1],["栋梁",1]],"books":{"诗篇":2,"阿摩司书":1},"verse":"他从楼阁中浇灌山岭；因他作为的功效，地就丰足。","ref":"诗篇 104:13","def":"和合本用词；常见搭配：翅膀 1、水中 1、云彩 1。","senses":[],"bverse":"在水中立楼阁的栋梁，用云彩为车辇，借着风的翅膀而行，","bref":"诗篇 104:3"},{"no":7575,"w":"山间","py":"shān jiān","pos":"名词","orig":"","freq":9,"verses":9,"vols":5,"chaps":9,"ot":9,"nt":0,"first":"诗篇 104:10","top":[["以赛亚书",3],["以西结书",3]],"rest":[3,3],"co":[["地上",3],["耶和华",2],["山谷",2],["人民",2]],"books":{"以赛亚书":3,"以西结书":3,"诗篇":1,"那鸿书":1,"西番雅书":1},"verse":"耶和华使泉源涌在山谷，流在山间，","ref":"诗篇 104:10","def":"和合本用词；常见搭配：地上 3、耶和华 2、山谷 2。","senses":[],"bverse":"都要撇给山间的鸷鸟和地上的野兽。夏天，鸷鸟要宿在其上；冬天，野兽都卧在其中。","bref":"以赛亚书 18:6"},{"no":7576,"w":"啼叫","py":"tí jiào","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 104:12","top":[["诗篇",2]],"rest":[0,0],"co":[["飞鸟",1],["天上",1],["水旁",1],["树枝",1]],"books":{"诗篇":2},"verse":"他赐食给走兽和啼叫的小乌鸦。","ref":"诗篇 147:9","def":"和合本用词；常见搭配：飞鸟 1、天上 1、水旁 1。","senses":[],"bverse":"天上的飞鸟在水旁住宿，在树枝上啼叫。","bref":"诗篇 104:12"},{"no":7577,"w":"游泳","py":"yóu yǒng","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 104:26","top":[["诗篇",1],["以西结书",1]],"rest":[0,0],"co":[["行走",1],["那里",1],["鳄鱼",1],["其中",1]],"books":{"诗篇":1,"以西结书":1},"verse":"那里有船行走，有你所造的鳄鱼游泳在其中。","ref":"诗篇 104:26","def":"人或动物在水中游行","senses":[["①","人或动物在水中游行","诗 104:26","出现 2 次"]],"bverse":"我又必用你的血浇灌你所游泳之地，漫过山顶；河道都必充满。","bref":"以西结书 32:6"},{"no":7578,"w":"张手","py":"zhāng shǒu","pos":"量词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 104:28","top":[["诗篇",2],["箴言",1]],"rest":[0,0],"co":[["美食",1],["它们",1],["饱足",1],["生气",1]],"books":{"诗篇":2,"箴言":1},"verse":"你张手，使有生气的都随愿饱足。","ref":"诗篇 145:16","def":"和合本用词；常见搭配：美食 1、它们 1、饱足 1。","senses":[],"bverse":"你给它们，它们便拾起来；你张手，它们饱得美食。","bref":"诗篇 104:28"},{"no":7579,"w":"美食","py":"měi shí","pos":"名词","orig":"","freq":6,"verses":6,"vols":3,"chaps":6,"ot":5,"nt":1,"first":"诗篇 104:28","top":[["箴言",3],["诗篇",2]],"rest":[1,1],"co":[["如同",2],["深入",2],["心腹",2],["言语",2]],"books":{"箴言":3,"诗篇":2,"路加福音":1},"verse":"传舌人的言语如同美食，深入人的心腹。","ref":"箴言 18:8","def":"和合本用词；常见搭配：如同 2、深入 2、心腹 2。","senses":[["①","味美的食物","诗 104:28","出现 6 次"]],"bverse":"不可贪恋他的美食，因为是哄人的食物。","bref":"箴言 23:3"},{"no":7580,"w":"哈利路亚","py":"hā lì lù yà","pos":"名词","orig":"","freq":5,"verses":5,"vols":2,"chaps":2,"ot":1,"nt":4,"first":"诗篇 104:35","top":[["启示录",4],["诗篇",1]],"rest":[0,0],"co":[["赞美",2],["耶和华",2],["群众",2],["好像",2]],"books":{"启示录":4,"诗篇":1},"verse":"又说：哈利路亚！烧淫妇的烟往上冒，直到永永远远。","ref":"启示录 19:3","def":"「你们要赞美耶和华」","senses":[["①","「你们要赞美耶和华」","诗 104:35","出现 5 次"]],"bverse":"那二十四位长老与四活物就俯伏敬拜坐宝座的神，说：阿们！哈利路亚！","bref":"启示录 19:4"},{"no":7581,"w":"他命","py":"tā mìng","pos":"代词","orig":"","freq":5,"verses":5,"vols":3,"chaps":4,"ot":5,"nt":0,"first":"诗篇 105:16","top":[["诗篇",3],["约珥书",1]],"rest":[1,1],"co":[["成就",2],["耶和华",2],["全行",1],["倚靠",1]],"books":{"诗篇":3,"约珥书":1,"阿摩司书":1},"verse":"他命黑暗，就有黑暗；没有违背他话的。","ref":"诗篇 105:28","def":"和合本用词；常见搭配：成就 2、耶和华 2、全行 1。","senses":[],"bverse":"火与冰雹，雪和雾气，成就他命的狂风，","bref":"诗篇 148:8"},{"no":7582,"w":"全行","py":"quán xíng","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 105:16","top":[["诗篇",1],["以西结书",1]],"rest":[0,0],"co":[["他命",1],["倚靠",1],["饥荒",1],["粮食",1]],"books":{"诗篇":1,"以西结书":1},"verse":"他命饥荒降在那地上，将所倚靠的粮食全行断绝，","ref":"诗篇 105:16","def":"品行完美无缺。亦指完美无缺的品行","senses":[["①","品行完美无缺","诗 105:16","出现 2 次"]],"bverse":"所以主耶和华如此说：看哪，我与埃及王法老为敌，必将他有力的膀臂和已打折的膀臂全行打断，使刀从他手中坠落。","bref":"以西结书 30:22"},{"no":7583,"w":"脚镣","py":"jiǎo liào","pos":"名词","orig":"","freq":4,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":3,"first":"诗篇 105:18","top":[["马可福音",2],["诗篇",1]],"rest":[1,1],"co":[["铁链",3],["屡次",2],["捆锁",2],["挣断",2]],"books":{"马可福音":2,"诗篇":1,"路加福音":1},"verse":"人用脚镣伤他的脚；他被铁链捆拘。","ref":"诗篇 105:18","def":"和合本用词；常见搭配：铁链 3、屡次 2、捆锁 2。","senses":[],"bverse":"因为人屡次用脚镣和铁链捆锁他，铁链竟被他挣断了，脚镣也被他弄碎了；总没有人能制伏他。","bref":"马可福音 5:4"},{"no":7584,"w":"铁链","py":"tiě liàn","pos":"名词","orig":"","freq":8,"verses":7,"vols":4,"chaps":5,"ot":1,"nt":7,"first":"诗篇 105:18","top":[["马可福音",3],["使徒行传",3]],"rest":[2,2],"co":[["脚镣",3],["捆锁",3],["人能",2],["屡次",2]],"books":{"马可福音":3,"使徒行传":3,"诗篇":1,"路加福音":1},"verse":"那人常住在坟茔里，没有人能捆住他，就是用铁链也不能；","ref":"马可福音 5:3","def":"铁锁链。用铁环连串而成","senses":[],"bverse":"人用脚镣伤他的脚；他被铁链捆拘。","bref":"诗篇 105:18"},{"no":7585,"w":"圣言","py":"shèng yán","pos":"名词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":2,"nt":3,"first":"诗篇 105:42","top":[["诗篇",1],["耶利米书",1]],"rest":[3,3],"co":[["凡事",2],["记念",1],["仆人",1],["亚伯拉罕",1]],"books":{"诗篇":1,"耶利米书":1,"使徒行传":1,"罗马书":1,"彼得前书":1},"verse":"这都因他记念他的圣言和他的仆人亚伯拉罕。","ref":"诗篇 105:42","def":"和合本用词；常见搭配：凡事 2、记念 1、仆人 1。","senses":[],"bverse":"凡事大有好处：第一是神的圣言交托他们。","bref":"罗马书 3:2"},{"no":7586,"w":"选民","py":"xuǎn mín","pos":"名词","orig":"","freq":16,"verses":16,"vols":8,"chaps":10,"ot":6,"nt":10,"first":"诗篇 105:43","top":[["以赛亚书",4],["马太福音",3]],"rest":[6,9],"co":[["仆人",3],["日子",3],["原文",3],["百姓",2]],"books":{"以赛亚书":4,"马太福音":3,"马可福音":3,"诗篇":2,"路加福音":1,"歌罗西书":1,"提摩太（后书）":1,"提多书":1},"verse":"他带领百姓欢乐而出，带领选民欢呼前往。","ref":"诗篇 105:43","def":"依法享有选举权，并经过选民登记领取了选民证的公民","senses":[["①","依法享有选举权","诗 105:43","出现 16 次"]],"bverse":"你们必留下自己的名，为我选民指著赌咒。主耶和华必杀你们，另起别名称呼他的仆人。","bref":"以赛亚书 65:15"},{"no":7587,"w":"欲心","py":"yù xīn","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 106:14","top":[["耶利米书",2],["诗篇",1]],"rest":[0,0],"co":[["旷野",2],["反倒",1],["试探",1],["时候",1]],"books":{"耶利米书":2,"诗篇":1},"verse":"反倒在旷野大起欲心，在荒地试探神。","ref":"诗篇 106:14","def":"和合本用词；常见搭配：旷野 2、反倒 1、试探 1。","senses":[],"bverse":"你是野驴，惯在旷野，欲心发动就吸风；起性的时候谁能使它转去呢？凡寻找它的必不致疲乏；在它的月份必能寻见。","bref":"耶利米书 2:24"},{"no":7588,"w":"卑下","py":"bēi xià","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 106:43","top":[["诗篇",2],["箴言",1]],"rest":[0,0],"co":[["罪孽",1],["屡次",1],["搭救",1],["背逆",1]],"books":{"诗篇":2,"箴言":1},"verse":"他们又因暴虐、患难、愁苦，就减少且卑下。","ref":"诗篇 107:39","def":"和合本用词；常见搭配：罪孽 1、屡次 1、搭救 1。","senses":[],"bverse":"他屡次搭救他们，他们却设谋背逆，因自己的罪孽降为卑下。","bref":"诗篇 106:43"},{"no":7589,"w":"从东","py":"cóng dōng","pos":"介词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"诗篇 107:3","top":[["诗篇",1],["以西结书",1]],"rest":[2,2],