":7543,"w":"燕子","py":"yàn zi","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":4,"nt":0,"first":"诗篇 84:3","top":[["诗篇",1],["箴言",1]],"rest":[2,2],"co":[["麻雀",2],["耶和华",2],["房屋",1],["那里",1]],"books":{"诗篇":1,"箴言":1,"以赛亚书":1,"耶利米书":1},"verse":"麻雀往来，燕子翻飞；这样，无故的咒诅也必不临到。","ref":"箴言 26:2","def":"燕科鸟类的通称。益鸟。体型小巧，两翅尖长，尾羽平展时呈叉状，飞行时捕食昆虫。世界各地都有分布。中国有九种","senses":[["①","燕科鸟类的通称","诗 84:3","出现 4 次"]],"bverse":"万军之耶和华─我的王，我的神啊，在你祭坛那里，麻雀为自己找著房屋，燕子为自己找著菢雏之窝。","bref":"诗篇 84:3"},{"no":7544,"w":"宁可","py":"nìng kě","pos":"名词","orig":"","freq":18,"verses":18,"vols":10,"chaps":15,"ot":8,"nt":10,"first":"诗篇 84:10","top":[["箴言",5],["马太福音",3]],"rest":[8,10],"co":[["争吵",3],["妇人",3],["不愿",2],["愚昧",2]],"books":{"箴言":5,"马太福音":3,"罗马书":2,"哥林多前书":2,"诗篇":1,"传道书":1,"耶利米书":1,"马可福音":1,"腓利门书":1,"希伯来书":1},"verse":"宁可住在旷野，不与争吵使气的妇人同住。","ref":"箴言 21:19","def":"宁愿；也作选择。","senses":[],"bverse":"宁可遇见丢崽子的母熊，不可遇见正行愚妄的愚昧人。","bref":"箴言 17:12"},{"no":7545,"w":"看门","py":"kān mén","pos":"动词","orig":"","freq":5,"verses":5,"vols":3,"chaps":4,"ot":1,"nt":4,"first":"诗篇 84:10","top":[["约翰福音",3],["诗篇",1]],"rest":[1,1],"co":[["出来",2],["彼得",2],["使女",2],["门徒",2]],"books":{"约翰福音":3,"诗篇":1,"马可福音":1},"verse":"看门的就给他开门；羊也听他的声音。他按著名叫自己的羊，把羊领出来。","ref":"约翰福音 10:3","def":"和合本用词；常见搭配：出来 2、彼得 2、使女 2。","senses":[],"bverse":"那看门的使女对彼得说：“你不也是这人的门徒吗？”他说：“我不是。”","bref":"约翰福音 18:17"},{"no":7546,"w":"恩赐","py":"ēn cì","pos":"名词","orig":"","freq":40,"verses":36,"vols":13,"chaps":27,"ot":3,"nt":37,"first":"诗篇 85:7","top":[["哥林多前书",12],["罗马书",7]],"rest":[11,21],"co":[["乃是",4],["圣灵",4],["时候",3],["耶稣基督",3]],"books":{"哥林多前书":12,"罗马书":7,"使徒行传":4,"以弗所书":4,"传道书":2,"约翰福音":2,"哥林多后书":2,"彼得前书":2,"诗篇":1,"提摩太（前书）":1,"提摩太（后书）":1,"希伯来书":1,"雅各书":1},"verse":"恩赐原有分别，圣灵却是一位。","ref":"哥林多前书 12:4","def":"圣灵按己意分给信徒的能力与职分；林前 12 章详列。","senses":[["①","原指帝王给予赏赐","传 3:13","出现 39 次"]],"bverse":"你们也是如此，既是切慕属灵的恩赐，就当求多得造就教会的恩赐。","bref":"哥林多前书 14:12"},{"no":7547,"w":"妄行","py":"wàng xíng","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"f