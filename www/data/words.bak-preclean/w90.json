:8953,"w":"别加","py":"bié jiā","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":0,"nt":3,"first":"使徒行传 13:13","top":[["使徒行传",3]],"rest":[0,0],"co":[["来到",2],["利亚",1],["约翰",1],["开船",1]],"books":{"使徒行传":3},"verse":"在别加讲了道，就下亚大利去，","ref":"使徒行传 14:25","def":"和合本用词；常见搭配：来到 2、利亚 1、约翰 1。","senses":[],"bverse":"他们离了别加往前行，来到彼西底的安提阿，在安息日进会堂坐下。","bref":"使徒行传 13:14"},{"no":8954,"w":"兄台","py":"xiōng tái","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":0,"nt":2,"first":"使徒行传 13:15","top":[["使徒行传",2]],"rest":[0,0],"co":[["律法",2],["先知",1],["二位",1],["会堂",1]],"books":{"使徒行传":2},"verse":"他们听见，就归荣耀与神，对保罗说：“兄台，你看犹太人中信主的有多少万，并且都为律法热心。","ref":"使徒行传 21:20","def":"对朋辈的敬称","senses":[["①","对朋辈的敬称","徒 13:15","出现 2 次"]],"bverse":"读完了律法和先知的书，管会堂的叫人过去，对他们说：“二位兄台，若有什么劝勉众人的话，请说。”","bref":"使徒行传 13:15"},{"no":8955,"w":"这作","py":"zhè zuò","pos":"代词","orig":"","freq":4,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":4,"first":"使徒行传 13:33","top":[["哥林多前书",2],["使徒行传",1]],"rest":[1,1],"co":[["耶稣",1],["上记",1],["复活",1],["今日",1]],"books":{"哥林多前书":2,"使徒行传":1,"彼得前书":1},"verse":"你这作妻子的，怎么知道不能救你的丈夫呢？你这作丈夫的，怎么知道不能救你的妻子呢？","ref":"哥林多前书 7:16","def":"和合本用词；常见搭配：耶稣 1、上记 1、复活 1。","senses":[],"bverse":"神已经向我们这作儿女的应验，叫耶稣复活了。正如诗篇第二篇上记着说：你是我的儿子，我今日生你。","bref":"使徒行传 13:33"},{"no":8956,"w":"上记","py":"shàng jì","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"使徒行传 13:33","top":[["使徒行传",1],["哥林多前书",1]],"rest":[1,1],"co":[["儿子",2],["律法",2],["耶稣",1],["复活",1]],"books":{"使徒行传":1,"哥林多前书":1,"加拉太书":1},"verse":"因为律法上记着，亚伯拉罕有两个儿子，一个是使女生的，一个是自主之妇人生的。","ref":"加拉太书 4:22","def":"和合本用词；常见搭配：儿子 2、律法 2、耶稣 1。","senses":[["①","古代典籍","徒 13:33","出现 3 次"]],"bverse":"神已经向我们这作儿女的应验，叫耶稣复活了。正如诗篇第二篇上记着说：你是我的儿子，我今日生你。","bref":"使徒行传 13:33"},{"no":8957,"w":"路司","py":"lù sī","pos":"名词","orig":"","freq":5,"verses":5,"vols":2,"chaps":3,"ot":0,"nt":5,"first":"使徒行传 14:6","top":[["使徒行传",4],["提摩太（后书）",1]],"rest":[0,0],"co":[["使徒",1],["知道",1],["地方",1],["逃往",1]],"books":{"使徒行传":4,"提摩太（后书）":1},"verse":"路司得和以哥念的弟兄都称赞他。","ref":"使徒行传 16:2","def":"和合本用词；常见搭配：使徒 1、知道 1、地方 1。","senses":[],"bverse":"使徒知道了，就逃往吕高尼的路司得、特庇两个城和周围地方去，","bref":"使徒行传 14:6"},{"no":8958,"w":"宙斯","py":"zhòu sī","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":0,"nt":3,"first":"使徒行传 14:12","top":[["使徒行传",3]],"rest":[0,0],"co":[["巴拿巴",1],["说话",1],["保罗",1],["领首",1]],"books":{"使徒行传":3},"verse":"于是称巴拿巴为宙斯，称保罗为希耳米，因为他说话领首。","ref":"使徒行传 14:12","def":"希腊神话中的主神。提坦神克洛诺斯之子。曾率众神推翻以父亲为首的提坦诸神，建立奥林匹斯神系。与波塞冬平分宇","senses":[["①","希腊神话中的主神","徒 14:12","出现 3 次"]],"bverse":"有城外宙斯庙的祭司牵着牛，拿着花圈，来到门前，要同众人向使徒献祭。","bref":"使徒行传 14:13"},{"no":8959,"w":"仅仅","py":"jǐn jǐn","pos":"副词","orig":"","freq":5,"verses":5,"vols":2,"chaps":3,"ot":0,"nt":5,"first":"使徒行传 14:18","top":[["使徒行传",4],["彼得前书",1]],"rest":[0,0],"co":[["背风",2],["来到",2],["名叫",2],["那里",2]],"books":{"使徒行传":4,"彼得前书":1},"verse":"二人说了这些话，仅仅地拦住众人不献祭与他们。","ref":"使徒行传 14:18","def":"和合本用词；常见搭配：背风 2、来到 2、名叫 2。","senses":[],"bverse":"贴著一个小岛的背风岸奔行，那岛名叫高大，在那里仅仅收住了小船。","bref":"使徒行传 27:16"},{"no":8960,"w":"信道","py":"xìn dào","pos":"名词","orig":"","freq":4,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":4,"first":"使徒行传 14:27","top":[["提摩太（前书）",2],["使徒行传",1]],"rest":[1,1],"co":[["述说",1],["聚集",1],["神藉",1],["会众",1]],"books":{"提摩太（前书）":2,"使徒行传":1,"罗马书":1},"verse":"可见，信道是从听道来的，听道是从基督的话来的。","ref":"罗马书 10:17","def":"和合本用词；常见搭配：述说 1、聚集 1、神藉 1。","senses":[["①","信奉正道","徒 14:27","出现 4 次"]],"bverse":"到了那里，聚集了会众，就述说神藉他们所行的一切事，并神怎样为外邦人开了信道的门。","bref":"使徒行传 14:27"},{"no":8961,"w":"法利赛","py":"fǎ lì sài","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":0,"nt":2,"first":"使徒行传 15:5","top":[["使徒行传",2]],"rest":[0,0],"co":[["几个",2],["起来",2],["律法",1],["信徒",1]],"books":{"使徒行传":2},"verse":"惟有几个信徒，是法利赛教门的人，起来说：“必须给外邦人行割礼，吩咐他们遵守摩西的律法。”","ref":"使徒行传 15:5","def":"见「法利赛人」","senses":[["①","见「法利赛人」","徒 15:5","出现 2 次"]],"bverse":"于是大大地喧嚷起来。有几个法利赛党的文士站起来争辩说：“我们看不出这人有什么恶处，倘若有鬼魂或是天使对他说过话，怎么样呢？”","bref":"使徒行传 23:9"},{"no":8962,"w":"不分","py":"bù fēn","pos":"副词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"使徒行传 15:9","top":[["使徒行传",1],["加拉太书",1]],"rest":[1,1],"co":[["希腊人",2],["为奴",2],["犹太人",2],["自主",2]],"books":{"使徒行传":1,"加拉太书":1,"歌罗西书":1},"verse":"又借着信洁净了他们的心，并不分他们我们。","ref":"使徒行传 15:9","def":"不服气;不平","senses":[["①","不服气;不平","徒 15:9","出现 3 次"]],"bverse":"并不分犹太人、希腊人，自主的、为奴的，或男或女，因为你们在基督耶稣里都成为一了。","bref":"加拉太书 3:28"},{"no":8963,"w":"勒死","py":"lēi sǐ","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":0,"nt":3,"first":"使徒行传 15:20","top":[["使徒行传",3]],"rest":[0,0],"co":[["奸淫",3],["牲畜",3],["偶像",3],["写信",2]],"books":{"使徒行传":3},"verse":"只要写信，吩咐他们禁戒偶像的污秽和奸淫，并勒死的牲畜和血。","ref":"使徒行传 15:20","def":"和合本用词；常见搭配：奸淫 3、牲畜 3、偶像 3。","senses":[],"bverse":"就是禁戒祭偶像的物和血，并勒死的牲畜和奸淫。这几件你们若能自己禁戒不犯就好了。愿你们平安！”","bref":"使徒行传 15:29"},{"no":8964,"w":"诉说","py":"sù shuō","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":0,"nt":3,"first":"使徒行传 15:27","top":[["使徒行传",3]],"rest":[0,0],"co":[["犹大",1],["亲口",1],["西拉",1],["承认",1]],"books":{"使徒行传":3},"verse":"那已经信的，多有人来承认诉说自己所行的事。","ref":"使徒行传 19:18","def":"和合本用词；常见搭配：犹大 1、亲口 1、西拉 1。","senses":[],"bverse":"我们就差了犹大和西拉，他们也要亲口诉说这些事。","bref":"使徒行传 15:27"},{"no":8965,"w":"提摩太","py":"tí mó tài","pos":"动词","orig":"","freq":25,"verses":25,"vols":12,"chaps":20,"ot":0,"nt":25,"first":"使徒行传 16:1","top":[["使徒行传",6],["腓立比书",3]],"rest":[10,16],"co":[["保罗",10],["儿子",7],["西拉",6],["基督耶稣",6]],"books":{"使徒行传":6,"腓立比书":3,"帖撒罗尼迦（前书）":3,"提摩太（前书）":3,"哥林多前书":2,"哥林多后书":2,"罗马书":1,"歌罗西书":1,"帖撒罗尼迦（后书）":1,"提摩太（后书）":1,"腓利门书":1,"希伯来书":1},"verse":"当时弟兄们便打发保罗往海边去，西拉和提摩太仍住在庇哩亚。","ref":"使徒行传 17:14","def":"保罗属灵的儿子与同工，受两封书信。","senses":[],"bverse":"西拉和提摩太从马其顿来的时候，保罗为道迫切，向犹太人证明耶稣是基督。","bref":"使徒行传 18:5"},{"no":8966,"w":"加拉太","py":"jiā lā tài","pos":"名词","orig":"","freq":7,"verses":7,"vols":5,"chaps":7,"ot":0,"nt":7,"first":"使徒行传 16:6","top":[["使徒行传",2],["加拉太书",2]],"rest":[3,3],"co":[["地方",2],["经过",2],["教会",2],["耶稣基督",2]],"books":{"使徒行传":2,"加拉太书":2,"哥林多前书":1,"提摩太（后书）":1,"彼得前书":1},"verse":"圣灵既然禁止他们在亚细亚讲道，他们就经过弗吕家、加拉太一带地方。","ref":"使徒行传 16:6","def":"圣经专名（人名／地名／族名），首见 使徒行传 16:6。","senses":[],"bverse":"住了些日子，又离开那里，挨次经过加拉太和弗吕家地方，坚固众门徒。","bref":"使徒行传 18:23"},{"no":8967,"w":"特罗","py":"tè luó","pos":"名词","orig":"","freq":9,"verses":9,"vols":3,"chaps":5,"ot":0,"nt":9,"first":"使徒行传 16:8","top":[["使徒行传",6],["提摩太（后书）",2]],"rest":[1,1],"co":[["开船",2],["越过",1],["亚去",1],["西亚",1]],"books":{"使徒行传":6,"提摩太（后书）":2,"哥林多后书":1},"verse":"这些人先走，在特罗亚等候我们。","ref":"使徒行传 20:5","def":"和合本用词；常见搭配：开船 2、越过 1、亚去 1。","senses":[],"bverse":"他们就越过每西亚，下到特罗亚去。","bref":"使徒行传 16:8"},{"no":8968,"w":"亚去","py":"yà qù","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":0,"nt":3,"first":"使徒行传 16:8","top":[["使徒行传",3]],"rest":[0,0],"co":[["特罗",1],["越过",1],["西亚",1],["犹太人",1]],"books":{"使徒行传":3},"verse":"他们就越过每西亚，下到特罗亚去。","ref":"使徒行传 16:8","def":"和合本用词；常见搭配：特罗 1、越过 1、西亚 1。","senses":[],"bverse":"弟兄们随即在夜间打发保罗和西拉往庇哩亚去。二人到了，就进入犹太人的会堂。","bref":"使徒行传 17:10"},{"no":8969,"w":"马其顿人","py":"mǎ qí dùn rén","pos":"","orig":"","freq":4,"verses":4,"vols":2,"chaps":3,"ot":0,"nt":4,"first":"使徒行传 16:9","top":[["使徒行传",2],["哥林多后书",2]],"rest":[0,0],"co":[["保罗",2],["预备",2],["夜间",1],["帮助",1]],"books":{"使徒行传":2,"哥林多后书":2},"verse":"在夜间有异象现与保罗。有一个马其顿人站着求他说：“请你过到马其顿来帮助我们。”","ref":"使徒行传 16:9","def":"马其顿的主体民族。另有少数分布在欧洲南部。约134万人。讲马其顿语。信东正教，少数信伊斯兰教。主要从事农","senses":[["①","马其顿的主体民族","徒 16:9","出现 4 次"]],"bverse":"满城都轰动起来。众人拿住与保罗同行的马其顿人该犹和亚里达古，齐心拥进戏园里去。","bref":"使徒行传 19:29"},{"no":8970,"w":"神召","py":"shén zhào","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"使徒行传 16:10","top":[["使徒行传",1],["哥林多前书",1]],"rest":[1,1],"co":[["以为",1],["随即",1],["那里",1],["想要",1]],"books":{"使徒行传":1,"哥林多前书":1,"帖撒罗尼迦（前书）":1},"verse":"神召我们，本不是要我们沾染污秽，乃是要我们成为圣洁。","ref":"帖撒罗尼迦前书 4:7","def":"和合本用词；常见搭配：以为 1、随即 1、那里 1。","senses":[],"bverse":"保罗既看见这异象，我们随即想要往马其顿去，以为神召我们传福音给那里的人听。","bref":"使徒行传 16:10"},{"no":8971,"w":"推雅","py":"tuī yǎ","pos":"动词","orig":"","freq":4,"verses":4,"vols":2,"chaps":3,"ot":0,"nt":4,"first":"使徒行传 16:14","top":[["启示录",3],["使徒行传",1]],"rest":[0,0],"co":[["推喇",3],["教会",2],["紫色",1],["妇人",1]],"books":{"启示录":3,"使徒行传":1},"verse":"“你要写信给推雅推喇教会的使者，说：‘那眼目如火焰、脚像光明铜的神之子说：","ref":"启示录 2:18","def":"和合本用词；常见搭配：推喇 3、教会 2、紫色 1。","senses":[],"bverse":"有一个卖紫色布疋的妇人，名叫吕底亚，是推雅推喇城的人，素来敬拜神。她听见了，主就开导她的心，叫她留心听保罗所讲的话。","bref":"使徒行传 16:14"},{"no":8972,"w":"事主","py":"shì zhǔ","pos":"名词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":0,"nt":6,"first":"使徒行传 16:15","top":[["使徒行传",2],["罗马书",2]],"rest":[2,2],"co":[["或译",2],["殷勤",2],["信主",1],["以为",1]],"books":{"使徒行传":2,"罗马书":2,"哥林多前书":1,"以弗所书":1},"verse":"服事主，凡事谦卑，眼中流泪，又因犹太人的谋害，经历试炼。","ref":"使徒行传 20:19","def":"和合本用词；常见搭配：或译 2、殷勤 2、信主 1。","senses":[["①","事奉大夫","徒 16:15","出现 6 次"]],"bverse":"甘心事奉，好像服事主，不像服事人。","bref":"以弗所书 6:7"},{"no":8973,"w":"人们","py":"rén men","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":0,"nt":2,"first":"使徒行传 16:16","top":[["使徒行传",2]],"rest":[0,0],"co":[["使女",2],["后来",1],["地方",1],["祷告",1]],"books":{"使徒行传":2},"verse":"使女的主人们见得利的指望没有了，便揪住保罗和西拉，拉他们到市上去见首领；","ref":"使徒行传 16:19","def":"和合本用词；常见搭配：使女 2、后来 1、地方 1。","senses":[["①","泛称许多人","徒 16:16","出现 2 次"]],"bverse":"后来，我们往那祷告的地方去。有一个使女迎著面来，她被巫鬼所附，用法术，叫她主人们大得财利。","bref":"使徒行传 16:16"},{"no":8974,"w":"禁卒","py":"jìn zú","pos":"动词","orig":"","freq":7,"verses":7,"vols":1,"chaps":1,"ot":0,"nt":7,"first":"使徒行传 16:23","top":[["使徒行传",7]],"rest":[0,0],"co":[["监里",2],["保罗",2],["许多",1],["嘱咐",1]],"books":{"使徒行传":7},"verse":"打了许多棍，便将他们下在监里，嘱咐禁卒严紧看守。","ref":"使徒行传 16:23","def":"禁军中的兵卒","senses":[["①","禁军中的兵卒","徒 16:23","出现 7 次"]],"bverse":"禁卒领了这样的命，就把他们下在内监里，两脚上了木狗。","bref":"使徒行传 16:24"},{"no":8975,"w":"全开","py":"quán kāi","pos":"形容词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":0,"nt":2,"first":"使徒行传 16:26","top":[["使徒行传",2]],"rest":[0,0],"co":[["囚犯",2],["监门",2],["震动",1],["监牢",1]],"books":{"使徒行传":2},"verse":"禁卒一醒，看见监门全开，以为囚犯已经逃走，就拔刀要自杀。","ref":"使徒行传 16:27","def":"印刷上指整张的纸","senses":[["①","印刷上指整张的纸","徒 16:26","出现 2 次"]],"bverse":"忽然，地大震动，甚至监牢的地基都摇动了，监门立刻全开，众囚犯的锁链也都松开了。","bref":"使徒行传 16:26"},{"no":8976,"w":"亚