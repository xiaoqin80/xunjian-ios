py":"mǎn chéng","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":2,"nt":2,"first":"以赛亚书 22:1","top":[["使徒行传",2],["以赛亚书",1]],"rest":[1,1],"co":[["保罗",2],["房顶",1],["默示",1],["异象",1]],"books":{"使徒行传":2,"以赛亚书":1,"以西结书":1},"verse":"保罗在雅典等候他们的时候，看见满城都是偶像，就心里着急；","ref":"使徒行传 17:16","def":"和合本用词；常见搭配：保罗 2、房顶 1、默示 1。","senses":[],"bverse":"满城都轰动起来。众人拿住与保罗同行的马其顿人该犹和亚里达古，齐心拥进戏园里去。","bref":"使徒行传 19:29"},{"no":7983,"w":"民女","py":"mín nǚ","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":4,"nt":0,"first":"以赛亚书 22:4","top":[["耶利米书",3],["以赛亚书",1]],"rest":[0,0],"co":[["原文",4],["众民",2],["痛哭",2],["百姓",2]],"books":{"耶利米书":3,"以赛亚书":1},"verse":"所以我说：你们转眼不看我，我要痛哭。不要因我众民（原文是民女）的毁灭，就竭力安慰我。","ref":"以赛亚书 22:4","def":"和合本用词；常见搭配：原文 4、众民 2、痛哭 2。","senses":[],"bverse":"那时，必有话对这百姓和耶路撒冷说：“有一阵热风从旷野净光的高处向我的众民（原文是民女）刮来，不是为簸扬，也不是为扬净。","bref":"耶利米书 4:11"},{"no":7984,"w":"揭开","py":"jiē kāi","pos":"动词","orig":"","freq":12,"verses":12,"vols":3,"chaps":5,"ot":1,"nt":11,"first":"以赛亚书 22:6","top":[["启示录",10],["以赛亚书",1]],"rest":[1,1],"co":[["时候",7],["看见",5],["活物",4],["听见",4]],"books":{"启示录":10,"以赛亚书":1,"马太福音":1},"verse":"羔羊揭开第七印的时候，天上寂静约有二刻。","ref":"启示录 8:1","def":"和合本用词；常见搭配：时候 7、看见 5、活物 4。","senses":[],"bverse":"揭开第二印的时候，我听见第二个活物说：“你来！”","bref":"启示录 6:3"},{"no":7985,"w":"去掉","py":"qù diào","pos":"动词","orig":"","freq":8,"verses":5,"vols":4,"chaps":4,"ot":1,"nt":7,"first":"以赛亚书 22:8","top":[["马太福音",3],["路加福音",3]],"rest":[2,2],"co":[["梁木",3],["眼中",3],["弟兄",3],["怎能",2]],"books":{"马太福音":3,"路加福音":3,"以赛亚书":1,"马可福音":1},"verse":"你自己眼中有梁木，怎能对你弟兄说：‘容我去掉你眼中的刺’呢？","ref":"马太福音 7:4","def":"和合本用词；常见搭配：梁木 3、眼中 3、弟兄 3。","senses":[],"bverse":"你这假冒为善的人！先去掉自己眼中的梁木，然后才能看得清楚，去掉你弟兄眼中的刺。","bref":"马太福音 7:5"},{"no":7986,"w":"可盛","py":"kě shèng","pos":"形容词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以赛亚书 22:11","top":[["以西结书",2],["以赛亚书",1]],"rest":[0,0],"co":[["仰望",1],["中间",1],["这事",1],["顾念",1]],"books":{"以西结书":2,"以赛亚书":1},"verse":"又在两道城墙中间挖一个聚水池可盛旧池的水，却不仰望做这事的主，也不顾念从古定这事的。","ref":"以赛亚书 22:11","def":"和合本用词；常见搭配：仰望 1、中间 1、这事 1。","senses":[],"bverse":"伊法与罢特大小要一样。罢特可盛贺梅珥十分之一，伊法也可盛贺梅珥十分之一，都以贺梅珥的大小为准。","bref":"以西结书 45:11"},{"no":7987,"w":"身披","py":"shēn pī","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"以赛亚书 22:12","top":[["以赛亚书",1],["马可福音",1]],"rest":[1,1],"co":[["麻布",2],["哀号",1],["光秃",1],["那日",1]],"books":{"以赛亚书":1,"马可福音":1,"启示录":1},"verse":"当那日，主─万军之耶和华叫人哭泣哀号，头上光秃，身披麻布。","ref":"以赛亚书 22:12","def":"和合本用词；常见搭配：麻布 2、哀号 1、光秃 1。","senses":[],"bverse":"有一个少年人，赤身披著一块麻布，跟随耶稣，众人就捉拿他。","bref":"马可福音 14:51"},{"no":7988,"w":"银库","py":"yín kù","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"以赛亚书 22:15","top":[["以赛亚书",1],["马可福音",1]],"rest":[2,2],"co":[["舍伯",1],["万军之耶和华",1],["家宰",1],["耶稣",1]],"books":{"以赛亚书":1,"马可福音":1,"使徒行传":1,"罗马书":1},"verse":"主─万军之耶和华这样说：“你去见掌银库的，就是家宰舍伯那，对他说：","ref":"以赛亚书 22:15","def":"保管和出纳国家资金的机构","senses":[["①","保管和出纳国家资金的","赛 22:15","出现 4 次"]],"bverse":"城内管银库的以拉都和兄弟括土问你们安。","bref":"罗马书 16:24"},{"no":7989,"w":"原位","py":"yuán wèi","pos":"名词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以赛亚书 22:19","top":[["以西结书",2],["以赛亚书",1]],"rest":[0,0],"co":[["我必",1],["离开",1],["赶逐",1],["归回",1]],"books":{"以西结书":2,"以赛亚书":1},"verse":"我必赶逐你离开官职；你必从你的原位撤下。’","ref":"以赛亚书 22:19","def":"和合本用词；常见搭配：我必 1、离开 1、赶逐 1。","senses":[],"bverse":"你的妹妹所多玛和她的众女必归回原位；撒马利亚和她的众女，你和你的众女，也必归回原位。","bref":"以西结书 16:55"},{"no":7990,"w":"必召","py":"bì zhào","pos":"副词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 22:20","top":[["耶利米书",2],["以赛亚书",1]],"rest":[0,0],"co":[["仆人",3],["巴比伦",2],["尼布甲尼撒",2],["那日",1]],"books":{"耶利米书":2,"以赛亚书":1},"verse":"“到那日，我必召我仆人希勒家的儿子以利亚敬来，","ref":"以赛亚书 22:20","def":"和合本用词；常见搭配：仆人 3、巴比伦 2、尼布甲尼撒 2。","senses":[],"bverse":"我必召北方的众族和我仆人巴比伦王尼布甲尼撒来攻击这地和这地的居民，并四围一切的国民。我要将他们尽行灭绝，以致他们令人惊骇、嗤笑，并且永久荒凉。这是耶和华说的。","bref":"耶利米书 25:9"},{"no":7991,"w":"剪断","py":"jiǎn duàn","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 22:25","top":[["以赛亚书",2]],"rest":[0,0],"co":[["耶和华",2],["重担",1],["那日",1],["钉子",1]],"books":{"以赛亚书":2},"verse":"万军之耶和华说：当那日，钉在坚固处的钉子必压斜，被砍断落地；挂在其上的重担必被剪断。因为这是耶和华说的。”","ref":"以赛亚书 22:25","def":"和合本用词；常见搭配：耶和华 2、重担 1、那日 1。","senses":[["①","干脆利落","赛 22:25","出现 2 次"]],"bverse":"我的住处被迁去离开我，好像牧人的帐棚一样；我将性命卷起，像织布的卷布一样。耶和华必将我从机头剪断，从早到晚，他要使我完结。","bref":"以赛亚书 38:12"},{"no":7992,"w":"买卖人","py":"mǎi mài rén","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 23:8","top":[["以赛亚书",1],["马太福音",1]],"rest":[0,0],"co":[["冠冕",1],["尊贵",1],["商家",1],["遭遇",1]],"books":{"以赛亚书":1,"马太福音":1},"verse":"天国又好像买卖人寻找好珠子，","ref":"马太福音 13:45","def":"和合本用词；常见搭配：冠冕 1、尊贵 1、商家 1。","senses":[["①","做生意的人","赛 23:8","出现 2 次"]],"bverse":"泰尔本是赐冠冕的。她的商家是王子；她的买卖人是世上的尊贵人。遭遇如此是谁定的呢？","bref":"以赛亚书 23:8"},{"no":7993,"w":"周流","py":"zhōu liú","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":2,"nt":2,"first":"以赛亚书 23:16","top":[["以赛亚书",2],["使徒行传",2]],"rest":[0,0],"co":[["四方",2],["忘记",1],["想念",1],["城内",1]],"books":{"以赛亚书":2,"使徒行传":2},"verse":"你这被忘记的妓女啊，拿琴周流城内，巧弹多唱，使人再想念你。","ref":"以赛亚书 23:16","def":"和合本用词；常见搭配：四方 2、忘记 1、想念 1。","senses":[],"bverse":"唉！亚利伊勒，亚利伊勒，大卫安营的城，任凭你年上加年，节期照常周流。","bref":"以赛亚书 29:1"},{"no":7994,"w":"雇价","py":"gù jià","pos":"","orig":"","freq":4,"verses":3,"vols":3,"chaps":3,"ot":4,"nt":0,"first":"以赛亚书 23:17","top":[["弥迦书",2],["以赛亚书",1]],"rest":[1,1],"co":[["行淫",1],["眷顾",1],["原文",1],["下同",1]],"books":{"弥迦书":2,"以赛亚书":1,"撒迦利亚书":1},"verse":"七十年后，耶和华必眷顾泰尔，她就仍得利息（原文是雇价；下同），与地上的万国交易（原文是行淫）。","ref":"以赛亚书 23:17","def":"和合本用词；常见搭配：行淫 1、眷顾 1、原文 1。","senses":[],"bverse":"她一切雕刻的偶像必被打碎；她所得的财物必被火烧；所有的偶像我必毁灭；因为是从妓女雇价所聚来的，后必归为妓女的雇价。","bref":"弥迦书 1:7"},{"no":7995,"w":"积攒","py":"jī zǎn","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":3,"ot":1,"nt":3,"first":"以赛亚书 23:18","top":[["马太福音",2],["以赛亚书",1]],"rest":[1,1],"co":[["窟窿",2],["财宝",2],["虫子",2],["所得",1]],"books":{"马太福音":2,"以赛亚书":1,"雅各书":1},"verse":"只要积攒财宝在天上；天上没有虫子咬，不能锈坏，也没有贼挖窟窿来偷。","ref":"马太福音 6:20","def":"和合本用词；常见搭配：窟窿 2、财宝 2、虫子 2。","senses":[],"bverse":"“不要为自己积攒财宝在地上；地上有虫子咬，能锈坏，也有贼挖窟窿来偷。","bref":"马太福音 6:19"},{"no":7996,"w":"打过","py":"dǎ guò","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"以赛亚书 24:13","top":[["以赛亚书",1],["阿摩司书",1]],"rest":[1,1],"co":[["葡萄",1],["必像",1],["万民",1],["地上",1]],"books":{"以赛亚书":1,"阿摩司书":1,"提摩太（后书）":1},"verse":"在地上的万民中，必像打过的橄榄树，又像已摘的葡萄所剩无几。","ref":"以赛亚书 24:13","def":"和合本用词；常见搭配：葡萄 1、必像 1、万民 1。","senses":[],"bverse":"那美好的仗我已经打过了，当跑的路我已经跑尽了，所信的道我已经守住了。","bref":"提摩太后书 4:7"},{"no":7997,"w":"牢狱","py":"láo yù","pos":"名词","orig":"","freq":12,"verses":10,"vols":4,"chaps":5,"ot":11,"nt":1,"first":"以赛亚书 24:22","top":[["耶利米书",8],["以赛亚书",2]],"rest":[2,2],"co":[["耶利米",6],["米勒",4],["或译",3],["绳子",3]],"books":{"耶利米书":8,"以赛亚书":2,"耶利米哀歌":1,"启示录":1},"verse":"这样，他们用绳子将耶利米从牢狱里拉上来。耶利米仍在护卫兵的院中。","ref":"耶利米书 38:13","def":"和合本用词；常见搭配：耶利米 6、米勒 4、或译 3。","senses":[],"bverse":"在王宫的太监古实人以伯‧米勒，听见他们将耶利米下了牢狱（那时王坐在便雅悯门口），","bref":"耶利米书 38:7"},{"no":7998,"w":"讨罪","py":"tǎo zuì","pos":"动词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":4,"nt":0,"first":"以赛亚书 24:22","top":[["以赛亚书",2],["耶利米书",2]],"rest":[0,0],"co":[["时候",2],["仆倒",2],["必致",2],["不然",2]],"books":{"以赛亚书":2,"耶利米书":2},"verse":"万军之耶和华必用雷轰、地震、大声、旋风、暴风，并吞灭的火焰，向她讨罪。","ref":"以赛亚书 29:6","def":"和合本用词；常见搭配：时候 2、仆倒 2、必致 2。","senses":[["①","讨伐罪人","赛 24:22","出现 4 次"]],"bverse":"他们必被聚集，像囚犯被聚在牢狱中，并要囚在监牢里，多日之后便被讨罪（或译：眷顾）。","bref":"以赛亚书 24:22"},{"no":7999,"w":"陈酒","py":"chén jiǔ","pos":"名词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":1,"first":"以赛亚书 25:6","top":[["以赛亚书",2],["路加福音",1]],"rest":[0,0],"co":[["设摆",1],["民用",1],["澄清",1],["筵席",1]],"books":{"以赛亚书":2,"路加福音":1},"verse":"没有人喝了陈酒又想喝新的；他总说陈的好。”","ref":"路加福音 5:39","def":"和合本用词；常见搭配：设摆 1、民用 1、澄清 1。","senses":[],"bverse":"在这山上，万军之耶和华必为万民用肥甘设摆筵席，用陈酒和满髓的肥甘，并澄清的陈酒，设摆筵席。","bref":"以赛亚书 25:6"},{"no":8000,"w":"澄清","py":"chéng qīng","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":4,"nt":0,"first":"以赛亚书 25:6","top":[["以赛亚书",1],["耶利米书",1]],"rest":[2,2],"co":[["渣滓",2],["如酒",2],["那时",2],["耶和华",2]],"books":{"以赛亚书":1,"耶利米书":1,"以西结书":1,"西番雅书":1},"verse":"那时，我必使埃及河澄清，江河像油缓流。这是主耶和华说的。","ref":"以西结书 32:14","def":"和合本用词；常见搭配：渣滓 2、如酒 2、那时 2。","senses":[],"bverse":"在这山上，万军之耶和华必为万民用肥甘设摆筵席，用陈酒和满髓的肥甘，并澄清的陈酒，设摆筵席。","bref":"以赛亚书 25:6"}]