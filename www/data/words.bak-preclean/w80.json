弥迦书":1},"verse":"他必在列国中施行审判，为许多国民断定是非。他们要将刀打成犁头，把枪打成镰刀。这国不举刀攻击那国；他们也不再学习战事。","ref":"以赛亚书 2:4","def":"和合本用词；常见搭配：不再 2、打成 2、镰刀 2。","senses":[],"bverse":"他必在多国的民中施行审判，为远方强盛的国断定是非。他们要将刀打成犁头，把枪打成镰刀。这国不举刀攻击那国；他们也不再学习战事。","bref":"弥迦书 4:3"},{"no":7906,"w":"辖管","py":"xiá guǎn","pos":"动词","orig":"","freq":10,"verses":7,"vols":4,"chaps":6,"ot":2,"nt":8,"first":"以赛亚书 3:4","top":[["启示录",6],["以赛亚书",2]],"rest":[2,2],"co":[["铁杖",3],["原文",3],["孩童",2],["必用",2]],"books":{"启示录":6,"以赛亚书":2,"哥林多前书":1,"哥林多后书":1},"verse":"主说：我必使孩童作他们的首领，使婴孩辖管他们。","ref":"以赛亚书 3:4","def":"和合本用词；常见搭配：铁杖 3、原文 3、孩童 2。","senses":[],"bverse":"我虽是自由的，无人辖管；然而我甘心作了众人的仆人，为要多得人。","bref":"哥林多前书 9:19"},{"no":7907,"w":"自害","py":"zì hài","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 3:9","top":[["以赛亚书",1],["耶利米书",1]],"rest":[0,0],"co":[["述说",1],["不正",1],["罪恶",1],["隐瞒",1]],"books":{"以赛亚书":1,"耶利米书":1},"verse":"他们的面色证明自己的不正；他们述说自己的罪恶，并不隐瞒，好像所多玛一样。他们有祸了！因为作恶自害。","ref":"以赛亚书 3:9","def":"和合本用词；常见搭配：述说 1、不正 1、罪恶 1。","senses":[],"bverse":"你们行诡诈自害；因为你们请我到耶和华─你们的神那里，说：‘求你为我们祷告耶和华─我们神，照耶和华─我们的神一切所说的告诉我们，我们就必遵行。’","bref":"耶利米书 42:20"},{"no":7908,"w":"结好","py":"jié hǎo","pos":"动词","orig":"","freq":9,"verses":9,"vols":4,"chaps":6,"ot":3,"nt":6,"first":"以赛亚书 5:2","top":[["马太福音",4],["以赛亚书",2]],"rest":[2,3],"co":[["果子",7],["火里",3],["坏树",3],["结坏",3]],"books":{"马太福音":4,"以赛亚书":2,"路加福音":2,"耶利米书":1},"verse":"好树不能结坏果子；坏树不能结好果子。","ref":"马太福音 7:18","def":"和合本用词；常见搭配：果子 7、火里 3、坏树 3。","senses":[["①","交结;亲近","赛 5:2","出现 9 次"]],"bverse":"凡不结好果子的树就砍下来，丢在火里。","bref":"马太福音 7:19"},{"no":7909,"w":"野葡萄","py":"yě pú táo","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以赛亚书 5:2","top":[["以赛亚书",2]],"rest":[0,0],"co":[["葡萄",2],["结好",2],["指望",2],["园子",1]],"books":{"以赛亚书":2},"verse":"我为我葡萄园所做之外，还有什么可做的呢？我指望结好葡萄，怎么倒结了野葡萄呢？","ref":"以赛亚书 5:4","def":"落叶藤本植物，茎细长，叶子心脏形，掌状分裂，圆锥花序，花小，淡黄绿色。浆果卵圆形，紫黑色，味酸，可以吃，","senses":[["①","落叶藤本植物","赛 5:2","出现 2 次"]],"bverse":"他刨挖园子，捡去石头，栽种上等的葡萄树，在园中盖了一座楼，又凿出压酒池；指望结好葡萄，反倒结了野葡萄。","bref":"以赛亚书 5:2"},{"no":7910,"w":"必命","py":"bì mìng","pos":"副词","orig":"","freq":6,"verses":6,"vols":3,"chaps":5,"ot":6,"nt":0,"first":"以赛亚书 5:6","top":[["阿摩司书",3],["以西结书",2]],"rest":[1,1],"co":[["饥荒",2],["刀剑",2],["耶和华",2],["不再",1]],"books":{"阿摩司书":3,"以西结书":2,"以赛亚书":1},"verse":"虽被仇敌掳去，我必命刀剑杀戮他们；我必向他们定住眼目，降祸不降福。","ref":"阿摩司书 9:4","def":"和合本用词；常见搭配：饥荒 2、刀剑 2、耶和华 2。","senses":[],"bverse":"虽然藏在迦密山顶，我必搜寻，捉出他们来；虽然从我眼前藏在海底，我必命蛇咬他们；","bref":"阿摩司书 9:3"},{"no":7911,"w":"祸哉","py":"huò zāi","pos":"名词","orig":"","freq":25,"verses":23,"vols":7,"chaps":16,"ot":22,"nt":3,"first":"以赛亚书 5:8","top":[["以赛亚书",15],["以西结书",3]],"rest":[5,7],"co":[["耶和华",6],["人血",3],["这流",3],["如此",3]],"books":{"以赛亚书":15,"以西结书":3,"启示录":3,"耶利米书":1,"弥迦书":1,"那鸿书":1,"哈巴谷书":1},"verse":"祸哉！那些勇于饮酒，以能力调浓酒的人。","ref":"以赛亚书 5:22","def":"灾祸临到的哀叹；先知书多用。","senses":[],"bverse":"祸哉！那些自以为有智慧，自看为通达的人。","bref":"以赛亚书 5:21"},{"no":7912,"w":"耳闻","py":"ěr wén","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":4,"nt":0,"first":"以赛亚书 5:9","top":[["以赛亚书",3],["以西结书",1]],"rest":[0,0],"co":[["眼见",2],["许多",1],["房屋",1],["荒凉",1]],"books":{"以赛亚书":3,"以西结书":1},"verse":"他必以敬畏耶和华为乐；行审判不凭眼见，断是非也不凭耳闻；","ref":"以赛亚书 11:3","def":"和合本用词；常见搭配：眼见 2、许多 1、房屋 1。","senses":[["①","听说～不如目见ㄧ这事","赛 5:9","出现 4 次"]],"bverse":"我耳闻万军之耶和华说：必有许多又大又美的房屋成为荒凉，无人居住。","bref":"以赛亚书 5:9"},{"no":7913,"w":"因酒","py":"yīn jiǔ","pos":"介词","orig":"","freq":9,"verses":9,"vols":5,"chaps":9,"ot":7,"nt":2,"first":"以赛亚书 5:11","top":[["以赛亚书",5],["何西阿书",1]],"rest":[3,3],"co":[["浓酒",3],["东倒西歪",2],["宴乐",2],["打人",2]],"books":{"以赛亚书":5,"何西阿书":1,"哈巴谷书":1,"提摩太（前书）":1,"提多书":1},"verse":"因此，你这困苦却非因酒而醉的，要听我言。","ref":"以赛亚书 51:21","def":"和合本用词；常见搭配：浓酒 3、东倒西歪 2、宴乐 2。","senses":[],"bverse":"祸哉！那些清早起来追求浓酒，留连到夜深，甚至因酒发烧的人。","bref":"以赛亚书 5:11"},{"no":7914,"w":"大旗","py":"dà qí","pos":"名词","orig":"","freq":15,"verses":15,"vols":3,"chaps":12,"ot":15,"nt":0,"first":"以赛亚书 5:26","top":[["以赛亚书",9],["耶利米书",5]],"rest":[1,1],"co":[["竖立",10],["万民",3],["列国",3],["耶和华",3]],"books":{"以赛亚书":9,"耶利米书":5,"以西结书":1},"verse":"应当在净光的山竖立大旗，向群众扬声招手，使他们进入贵胄的门。","ref":"以赛亚书 13:2","def":"大旗；也指立大旗招聚列国。","senses":[],"bverse":"到那日，耶西的根立作万民的大旗；外邦人必寻求他，他安息之所大有荣耀。","bref":"以赛亚书 11:10"},{"no":7915,"w":"咆哮","py":"páo xiāo","pos":"动词","orig":"","freq":12,"verses":11,"vols":6,"chaps":11,"ot":12,"nt":0,"first":"以赛亚书 5:29","top":[["以赛亚书",5],["耶利米书",2]],"rest":[4,5],"co":[["狮子",8],["少壮",6],["声音",3],["吼叫",2]],"books":{"以赛亚书":5,"耶利米书":2,"以西结书":2,"阿摩司书":1,"西番雅书":1,"撒迦利亚书":1},"verse":"我们咆哮如熊，哀鸣如鸽；指望公平，却是没有；指望救恩，却远离我们。","ref":"以赛亚书 59:11","def":"和合本用词；常见搭配：狮子 8、少壮 6、声音 3。","senses":[],"bverse":"他们要吼叫，像母狮子，咆哮，像少壮狮子；他们要咆哮抓食，坦然叼去，无人救回。","bref":"以赛亚书 5:29"},{"no":7916,"w":"只见","py":"zhǐ jiàn","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"以赛亚书 5:30","top":[["以赛亚书",1],["马太福音",1]],"rest":[2,2],"co":[["耶稣",3],["一人",3],["那里",3],["门徒",2]],"books":{"以赛亚书":1,"马太福音":1,"马可福音":1,"路加福音":1},"verse":"他们举目不见一人，只见耶稣在那里。","ref":"马太福音 17:8","def":"和合本用词；常见搭配：耶稣 3、一人 3、那里 3。","senses":[["①","犹言只觉得","赛 5:30","出现 4 次"]],"bverse":"门徒忽然周围一看，不再见一人，只见耶稣同他们在那里。","bref":"马可福音 9:8"},{"no":7917,"w":"撒拉弗","py":"sā lā fú","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以赛亚书 6:2","top":[["以赛亚书",2]],"rest":[0,0],"co":[["翅膀",1],["六个",1],["侍立",1],["飞翔",1]],"books":{"以赛亚书":2},"verse":"有一撒拉弗飞到我跟前，手里拿着红炭，是用火剪从坛上取下来的，","ref":"以赛亚书 6:6","def":"有六翅的属天活物，在神宝座前颂赞","senses":[["①","有六翅的属天活物","赛 6:2","出现 2 次"]],"bverse":"其上有撒拉弗侍立，各有六个翅膀：用两个翅膀遮脸，两个翅膀遮脚，两个翅膀飞翔；","bref":"以赛亚书 6:2"},{"no":7918,"w":"圣哉","py":"shèng zāi","pos":"","orig":"","freq":6,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":3,"first":"以赛亚书 6:3","top":[["以赛亚书",3],["启示录",3]],"rest":[0,0],"co":[["充满",1],["彼此",1],["荣光",1],["呼喊",1]],"books":{"以赛亚书":3,"启示录":3},"verse":"彼此呼喊说：圣哉！圣哉！圣哉！万军之耶和华；他的荣光充满全地！","ref":"以赛亚书 6:3","def":"和合本用词；常见搭配：充满 1、彼此 1、荣光 1。","senses":[],"bverse":"四活物各有六个翅膀，遍体内外都满了眼睛。他们昼夜不住地说：圣哉！圣哉！圣哉！主神是昔在、今在、以后永在的全能者。","bref":"启示录 4:8"},{"no":7919,"w":"吹动","py":"chuī dòng","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"以赛亚书 7:2","top":[["以赛亚书",1],["马太福音",1]],"rest":[2,2],"co":[["耶稣",2],["看风",2],["旷野",2],["约翰",2]],"books":{"以赛亚书":1,"马太福音":1,"路加福音":1,"雅各书":1},"verse":"只要凭着信心求，一点不疑惑；因为那疑惑的人，就像海中的波浪，被风吹动翻腾。","ref":"雅各书 1:6","def":"和合本用词；常见搭配：耶稣 2、看风 2、旷野 2。","senses":[],"bverse":"有人告诉大卫家说：“亚兰与以法莲已经同盟。”王的心和百姓的心就都跳动，好像林中的树被风吹动一样。","bref":"以赛亚书 7:2"},{"no":7920,"w":"定然","py":"dìng rán","pos":"副词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 7:9","top":[["以赛亚书",1],["罗马书",1]],"rest":[0,0],"co":[["不信",1],["撒马利亚",1],["玛利",1],["立稳",1]],"books":{"以赛亚书":1,"罗马书":1},"verse":"以法莲的首城是撒马利亚；撒马利亚的首领是利玛利的儿子。你们若是不信，定然不得立稳。’”","ref":"以赛亚书 7:9","def":"和合本用词；常见搭配：不信 1、撒马利亚 1、玛利 1。","senses":[],"bverse":"所以人得为后嗣是本乎信，因此就属乎恩，叫应许定然归给一切后裔；不但归给那属乎律法的，也归给那效法亚伯拉罕之信的。","bref":"罗马书 4:16"},{"no":7921,"w":"神求","py":"shén qiú","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"以赛亚书 7:11","top":[["以赛亚书",2],["约翰福音",1]],"rest":[0,0],"co":[["兆头",1],["耶和华",1],["高处",1],["深处",1]],"books":{"以赛亚书":2,"约翰福音":1},"verse":"“你向耶和华─你的神求一个兆头：或求显在深处，或求显在高处。”","ref":"以赛亚书 7:11","def":"和合本用词；常见搭配：兆头 1、耶和华 1、高处 1。","senses":[],"bverse":"就是现在，我也知道，你无论向神求什么，神也必赐给你。”","bref":"约翰福音 11:22"},{"no":7922,"w":"以马内利","py":"yǐ mǎ nèi lì","pos":"名词","orig":"","freq":4,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":2,"first":"以赛亚书 7:14","top":[["以赛亚书",2],["马太福音",2]],"rest":[0,0],"co":[["童女",2],["生子",2],["怀孕",2],["意思",1]],"books":{"以赛亚书":2,"马太福音":2},"verse":"必冲入犹大，涨溢泛滥，直到颈项。以马内利啊，他展开翅膀，遍满你的地。”","ref":"以赛亚书 8:8","def":"「神与我们同在」，弥赛亚的称号","senses":[["①","「神与我们同在」","赛 7:14","出现 4 次"]],"bverse":"因此，主自己要给你们一个兆头，必有童女怀孕生子，给他起名叫以马内利（就是神与我们同在的意思）。","bref":"以赛亚书 7:14"},{"no":7923,"w":"弃恶","py":"qì è","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以赛亚书 7:15","top":[["以赛亚书",2]],"rest":[0,0],"co":[["晓得",2],["蜂蜜",1],["时候",1],["奶油",1]],"books":{"以赛亚书":2},"verse":"到他晓得弃恶择善的时候，他必吃奶油与蜂蜜。","ref":"以赛亚书 7:15","def":"和合本用词；常见搭配：晓得 2、蜂蜜 1、时候 1。","senses":[["①","丢弃怨恨","赛 7:15","出现 2 次"]],"bverse":"因为在这孩子还不晓得弃恶择善之先，你所憎恶的那二王之地必致见弃。","bref":"以赛亚书 7:16"},{"no":7924,"w":"常用","py":"cháng yòng","pos":"","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"以赛亚书 8:1","top":[["以赛亚书",1],["加拉太书",1]],"rest":[1,1],"co":[["抢夺",1],["沙拉",1],["所用",1],["快到",1]],"books":{"以赛亚书":1,"加拉太书":1,"希伯来书":1},"verse":"在善事上，常用热心待人原是好的，却不单我与你们同在的时候才这样。","ref":"加拉太书 4:18","def":"和合本用词；常见搭配：抢夺 1、沙拉 1、所用 1。","senses":[],"bverse":"耶和华对我说：“你取一个大牌，拿人所用的笔（或译：人常用的字），写上‘玛黑珥‧沙拉勒‧哈施‧罢斯’（就是掳掠速临、抢夺快到的意思）。","bref":"以赛亚书 8:1"},{"no":7925,"w":"快到","py":"kuài dào","pos":"形容词","orig":"","freq":10,"verses":10,"vols":10,"chaps":10,"ot":4,"nt":6,"first":"以赛亚书 8:1","top":[["以赛亚书",1],["以西结书",1]],"rest":[8,8],"co":[["耶和华",3],["日子",3],["那里",3],["耶稣",2]],"books":{"以赛亚书":1,"以西结书":1,"阿摩司书":1,"西番雅书":1,"马太福音":1,"路加福音":1,"使徒行传":1,"提摩太（前书）":1,"彼得后书":1,"启示录":1},"verse":"第二样灾祸过去，第三样灾祸快到了。","ref":"启示录 11:14","def":"和合本用词；常见搭配：耶和华 3、日子 3、那里 3。","senses":[],"bverse":"耶稣快到耶路撒冷，看见城，就为它哀哭，","bref":"路加福音 19:41"},{"no":7926,"w":"威势","py":"wēi shì","pos":"名词","orig":"","freq":7,"verses":7,"vols":4,"chaps":5,"ot":6,"nt":1,"first":"以赛亚书 8:7","top":[["以西结书",3],["以赛亚书",2]],"rest":[2,2],"co":[["相比",2],["猛然",1],["翻腾",1],["亚述",1]],"books":{"以西结书":3,"以赛亚书":2,"但以理书":1,"使徒行传":1},"verse":"“人子啊，你要向埃及王法老和他的众人说：在威势上谁能与你相比呢？","ref":"以西结书 31:2","def":"和合本用词；常见搭配：相比 2、猛然 1、翻腾 1。","senses":[["①","威严权势","赛 8:7","出现 7 次"]],"bverse":"我就必将他交给列国中大有威势的人；他必定办他。我因他的罪恶，已经驱逐他。","bref":"以西结书 31:11"},{"no":7927,"w":"腰来","py":"yāo lái","pos":"名词","orig":"","freq":5,"verses":4,"vols":3,"chaps":3,"ot":2,"nt":3,"first":"以赛亚书 8:9","top":[["以赛亚书",2],["约翰福音",2]],"rest":[1,1],"co":[["直起",3],["耶稣",2],["任凭",1],["喧嚷",1]],"books":{"以赛亚书":2,"约翰福音":2,"路加福音":1},"verse":"于是用两只手按著她；她立刻直起腰来，就归荣耀与神。","ref":"路加福音 13:13","def":"和合本用词；常见搭配：直起 3、耶稣 2、任凭 1。","senses":[],"bverse":"耶稣就直起腰来，对她说：“妇人，那些人在哪里呢？没有人定你的罪吗？”","bref":"约翰福音 8:10"},{"no":7928,"w":"跌人","py":"diē rén","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":1,"nt":3,"first":"以赛亚书 8:14","top":[["罗马书",2],["以赛亚书",1]],"rest":[1,1],"co":[["绊脚",4],["磐石",3],["石头",3],["居民",1]],"books":{"罗马书":2,"以赛亚书":1,"彼得前书":1},"verse":"所以，我们不可再彼此论断，宁可定意谁也不给弟兄放下绊脚跌人之物。","ref":"罗马书 14:13","def":"和合本用词；常见搭配：绊脚 4、磐石 3、石头 3。","senses":[],"bverse":"就如经上所记：我在锡安放一块绊脚的石头，跌人的磐石；信靠他的人必不至于羞愧。","bref":"罗马书 9:33"},{"no":7929,"w":"跌碎","py":"diē suì","pos":"动词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":3,"nt":2,"first":"以赛亚书 8:15","top":[["以赛亚书",2],["耶利米书",1]],"rest":[2,2],"co":[["网罗",2],["缠住",2],["跌倒",2],["陷入",2]],"books":{"以赛亚书":2,"耶利米书":1,"马太福音":1,"路加福音":1},"verse":"许多人必在其上绊脚跌倒，而且跌碎，并陷入网罗，被缠住。”","ref":"以赛亚书 8:15","def":"和合本用词；常见搭配：网罗 2、缠住 2、跌倒 2。","senses":[],"bverse":"谁掉在这石头上，必要跌碎；这石头掉在谁的身上，就要把谁砸得稀烂。”","bref":"马太福音 21:44"},{"no":7930,"w":"卷起","py":"juǎn qǐ","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 8:16","top":[["以赛亚书",3]],"rest":[0,0],"co":[["好像",2],["律法",1],["中间",1],["封住",1]],"books":{"以赛亚书":3},"verse":"你要卷起律法书，在我门徒中间封住训诲。","ref":"以赛亚书 8:16","def":"和合本用词；常见搭配：好像 2、律法 1、中间 1。","senses":[],"bverse":"天上的万象都要消没；天被卷起，好像书卷。其上的万象要残败，像葡萄树的叶子残败，又像无花果树的叶子残败一样。","bref":"以赛亚书 34:4"},{"no":7931,"w":"奇迹","py":"qí jì","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 8:18","top":[["以赛亚书",2]],"rest":[0,0],"co":[["预兆",2],["作为",2],["耶和华",2],["以色列",1]],"books":{"以赛亚书":2},"verse":"耶和华说：“我仆人以赛亚怎样露身赤脚行走三年，作为关乎埃及和古实的预兆奇迹。","ref":"以赛亚书 20:3","def":"和合本用词；常见搭配：预兆 2、作为 2、耶和华 2。","senses":[["①","亦作\"奇迹\"","赛 8:18","出现 2 次"]],"bverse":"看哪，我与耶和华所给我的儿女，就是从住在锡安山万军之耶和华来的，在以色列中作为预兆和奇迹。","bref":"以赛亚书 8:18"},{"no":7932,"w":"当求","py":"dāng qiú","pos":"动词","orig":"","freq":6,"verses":6,"vols":5,"chaps":5,"ot":1,"nt":5,"first":"以赛亚书 8:19","top":[["哥林多前书",2],["以赛亚书",1]],"rest":[3,3],"co":[["工人",2],["出去",2],["打发",2],["庄稼",2]],"books":{"哥林多前书":2,"以赛亚书":1,"马太福音":1,"路加福音":1,"歌罗西书":1},"verse":"所以那说方言的，就当求著能翻出来。","ref":"哥林多前书 14:13","def":"和合本用词；常见搭配：工人 2、出去 2、打发 2。","senses":[],"bverse":"你们也是如此，既是切慕属灵的恩赐，就当求多得造就教会的恩赐。","bref":"哥林多前书 14:12"},{"no":7933,"w":"微细","py":"wēi xì","pos":"形容词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 8:19","top":[["以赛亚书",2]],"rest":[0,0],"co":[["声音",2],["言语",2],["岂可",1],["回答",1]],"books":{"以赛亚书":2},"verse":"你必败落，从地中说话；你的言语必微细出于尘埃。你的声音必像那交鬼者的声音出于地；你的言语低低微微出于尘埃。","ref":"以赛亚书 29:4","def":"和合本用词；常见搭配：声音 2、言语 2、岂可 1。","senses":[["①","细小;琐屑","赛 8:19","出现 2 次"]],"bverse":"有人对你们说：“当求问那些交鬼的和行巫术的，就是声音绵蛮，言语微细的。”你们便回答说：“百姓不当求问自己的神吗？岂可为活人求问死人呢？”","bref":"以赛亚书 8:19"},{"no":7934,"w":"赶入","py":"gǎn rù","pos":"动词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以赛亚书 8:22","top":[["约珥书",2],["以赛亚书",1]],"rest":[0,0],"co":[["痛苦",1],["艰难",1],["乌黑",1],["上天",1]],"books":{"约珥书":2,"以赛亚书":1},"verse":"仰观上天，俯察下地，不料，尽是艰难、黑暗，和幽暗的痛苦。他们必被赶入乌黑的黑暗中去。","ref":"以赛亚书 8:22","def":"和合本用词；常见搭配：痛苦 1、艰难 1、乌黑 1。","senses":[],"bverse":"却要使北方来的军队远离你们，将他们赶到干旱荒废之地：前队赶入东海，后队赶入西海；因为他们所行的大恶（原文是事），臭气上升，腥味腾空。","bref":"约珥书 2:20"},{"no":7935,"w":"火柴","py":"huǒ chái","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以赛亚书 9:5","top":[["以赛亚书",2],["以西结书",1]],"rest":[0,0],"co":[["穿戴",1],["当作",1],["作为",1],["战士",1]],"books":{"以赛亚书":2,"以西结书":1},"verse":"因万军之耶和华的烈怒，地都烧遍；百姓成为火柴；无人怜爱弟兄。","ref":"以赛亚书 9:19","def":"用细小的木条蘸上磷或硫的化合物制成的取火的东西。现在常用的是安全火柴","senses":[["①","用细小的木条蘸上磷或","赛 9:5","出现 3 次"]],"bverse":"战士在乱杀之间所穿戴的盔甲，并那滚在血中的衣服，都必作为可烧的，当作火柴。","bref":"以赛亚书 9:5"},{"no":7936,"w":"政权","py":"zhèng quán","pos":"名词","orig":"","freq":5,"verses":5,"vols":3,"chaps":4,"ot":4,"nt":1,"first":"以赛亚书 9:6","top":[["以赛亚书",3],["耶利米书",1]],"rest":[1,1],"co":[["名称",1],["和平",1],["全能",1],["肩头",1]],"books":{"以赛亚书":3,"耶利米书":1,"路加福音":1},"verse":"于是窥探耶稣，打发奸细装作好人，要在他的话上得把柄，好将他交在巡抚的政权之下。","ref":"路加福音 20:20","def":"指国家权力，即统治阶级对被统治阶级实行政治统治的权力。具有强制性，由军队、警察、法庭、监狱等保证其实现。","senses":[["①","指国家权力","赛 9:6","出现 5 次"]],"bverse":"因有一婴孩为我们而生；有一子赐给我们。政权必担在他的肩头上；他名称为“奇妙策士、全能的神、永在的父、和平的君”。","bref":"以赛亚书 9:6"},{"no":7937,"w":"必罚","py":"bì fá","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 10:12","top":[["以赛亚书",1],["耶利米书",1]],"rest":[1,1],"co":[["亚述",2],["时候",1],["成就",1],["高傲",1]],"books":{"以赛亚书":1,"耶利米书":1,"西番雅书":1},"verse":"所以万军之耶和华─以色列的神如此说：“我必罚巴比伦王和他的地，像我从前罚亚述王一样。","ref":"耶利米书 50:18","def":"和合本用词；常见搭配：亚述 2、时候 1、成就 1。","senses":[],"bverse":"主在锡安山和耶路撒冷成就他一切工作的时候，主说：“我必罚亚述王自大的心和他高傲眼目的荣耀。”","bref":"以赛亚书 10:12"},{"no":7938,"w":"自大","py":"zì dà","pos":"形容词","orig":"","freq":6,"verses":6,"vols":4,"chaps":4,"ot":6,"nt":0,"first":"以赛亚书 10:12","top":[["以赛亚书",2],["西番雅书",2]],"rest":[2,2],"co":[["自夸",3],["骄傲",2],["摩押人",2],["毁谤",2]],"books":{"以赛亚书":2,"西番雅书":2,"耶利米书":1,"但以理书":1},"verse":"这事临到他们是因他们骄傲，自夸自大，毁谤万军之耶和华的百姓。","ref":"西番雅书 2:10","def":"自尊大;自负","senses":[["①","自尊大;自负","赛 10:12","出现 6 次"]],"bverse":"我们听说摩押人骄傲，是极其骄傲；听说他自高自傲，并且狂妄，居心自大。","bref":"耶利米书 48:29"},{"no":7939,"w":"目的","py":"mù dì","pos":"名词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":3,"nt":2,"first":"以赛亚书 10:12","top":[["以赛亚书",2],["耶利米哀歌",1]],"rest":[2,2],"co":[["时候",1],["成就",1],["必罚",1],["高傲",1]],"books":{"以赛亚书":2,"耶利米哀歌":1,"约翰（一书）":1,"启示录":1},"verse":"除了那受印记、有了兽名或有兽名数目的，都不得做买卖。","ref":"启示录 13:17","def":"所追求的目标;想达到的境地","senses":[["①","所追求的目标;想达到","赛 10:12","出现 5 次"]],"bverse":"主在锡安山和耶路撒冷成就他一切工作的时候，主说：“我必罚亚述王自大的心和他高傲眼目的荣耀。”","bref":"以赛亚书 10:12"},{"no":7940,"w":"已定","py":"yǐ dìng","pos":"副词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 10:22","top":[["以赛亚书",1],["耶利米书",1]],"rest":[1,1],"co":[["海沙",1],["剩下",1],["施行",1],["以色列",1]],"books":{"以赛亚书":1,"耶利米书":1,"西番雅书":1},"verse":"因此，地要悲哀，在上的天也必黑暗；因为我言已出，我意已定，必不后悔，也不转意不做。","ref":"耶利米书 4:28","def":"和合本用词；常见搭配：海沙 1、剩下 1、施行 1。","senses":[],"bverse":"以色列啊，你的百姓虽多如海沙，惟有剩下的归回。原来灭绝的事已定，必有公义施行，如水涨溢。","bref":"以赛亚书 10:22"},{"no":7941,"w":"定规","py":"dìng guī","pos":"动词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":4,"nt":2,"first":"以赛亚书 10:23","top":[["耶利米书",2],["使徒行传",2]],"rest":[2,2],"co":[["丛林",2],["我要",2],["上来",2],["日期",2]],"books":{"耶利米书":2,"使徒行传":2,"以赛亚书":1,"以西结书":1},"verse":"因为主─万军之耶和华在全地之中必成就所定规的结局。","ref":"以赛亚书 10:23","def":"一定的规矩；成规月底盘点，已成","senses":[["①","一定的规矩","赛 10:23","出现 6 次"]],"bverse":"仇敌必像狮子从约旦河边的丛林上来，攻击坚固的居所。转眼之间，我要使以东人逃跑，离开这地。谁蒙拣选，我就派谁治理这地。谁能比我呢？谁能给我定规日期呢？有何牧人能在我面前站立得住呢？","bref":"耶利米书 49:19"},{"no":7942,"w":"用棍","py":"yòng gùn","pos":"介词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"以赛亚书 10:24","top":[["以赛亚书",2],["使徒行传",1]],"rest":[0,0],"co":[["攻击",2],["不要",1],["击打",1],["亚述",1]],"books":{"以赛亚书":2,"使徒行传":1},"verse":"众人就一同起来攻击他们。官长吩咐剥了他们的衣裳，用棍打；","ref":"使徒行传 16:22","def":"和合本用词；常见搭配：攻击 2、不要 1、击打 1。","senses":[],"bverse":"所以，主─万军之耶和华如此说：“住锡安我的百姓啊，亚述王虽然用棍击打你，又照埃及的样子举杖攻击你，你却不要怕他。","bref":"以赛亚书 10:24"},{"no":7943,"w":"一点点","py":"yì diǎn diǎn","pos":"数词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"以赛亚书 10:25","top":[["以赛亚书",2],["希伯来书",1]],"rest":[0,0],"co":[["时候",3],["怒气",1],["发作",1],["完毕",1]],"books":{"以赛亚书":2,"希伯来书":1},"verse":"黎巴嫩变为肥田，肥田看如树林，不是只有一点点时候吗？","ref":"以赛亚书 29:17","def":"表示极小或极少","senses":[["①","表示极小或极少","赛 10:25","出现 3 次"]],"bverse":"因为还有一点点时候，向你们发的忿恨就要完毕，我的怒气要向他发作，使他灭亡。","bref":"以赛亚书 10:25"},{"no":7944,"w":"豺狼","py":"chái láng","pos":"名词","orig":"","freq":10,"verses":10,"vols":6,"chaps":10,"ot":9,"nt":1,"first":"以赛亚书 11:6","top":[["以赛亚书",4],["耶利米书",2]],"rest":[4,4],"co":[["狮子",4],["晚上",3],["羊羔",2],["豹子",2]],"books":{"以赛亚书":4,"耶利米书":2,"以西结书":1,"哈巴谷书":1,"西番雅书":1,"使徒行传":1},"verse":"我知道，我去之后必有凶暴的豺狼进入你们中间，不爱惜羊群。","ref":"使徒行传 20:29","def":"豺与狼。皆凶兽","senses":[],"bverse":"其中的首领仿佛豺狼抓撕掠物，杀人流血，伤害人命，要得不义之财。","bref":"以西结书 22:27"},{"no":7945,"w":"牵引","py":"qiān yǐn","pos":"动词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":3,"nt":2,"first":"以赛亚书 11:6","top":[["以赛亚书",2],["何西阿书",1]],"rest":[2,2],"co":[["小孩子",1],["同居",1],["肥畜",1],["狮子",1]],"books":{"以赛亚书":2,"何西阿书":1,"哥林多前书":1,"雅各书":1},"verse":"但各人被试探，乃是被自己的私欲牵引诱惑的。","ref":"雅各书 1:14","def":"和合本用词；常见搭配：小孩子 1、同居 1、肥畜 1。","senses":[],"bverse":"你的城门必时常开放，昼夜不关；使人把列国的财物带来归你，并将他们的君王牵引而来。","bref":"以赛亚书 60:11"},{"no":7946,"w":"遍处","py":"biàn chù","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 11:9","top":[["以赛亚书",2]],"rest":[0,0],"co":[["圣山",2],["耶和华",2],["伤人",2],["充满",1]],"books":{"以赛亚书":2},"verse":"在我圣山的遍处，这一切都不伤人，不害物；因为认识耶和华的知识要充满遍地，好像水充满洋海一般。","ref":"以赛亚书 11:9","def":"和合本用词；常见搭配：圣山 2、耶和华 2、伤人 2。","senses":[["①","到处;处处","赛 11:9","出现 2 次"]],"bverse":"豺狼必与羊羔同食；狮子必吃草与牛一样；尘土必作蛇的食物。在我圣山的遍处，这一切都不伤人，不害物。这是耶和华说的。","bref":"以赛亚书 65:25"},{"no":7947,"w":"我怒","py":"wǒ nù","pos":"代词","orig":"","freq":6,"verses":6,"vols":2,"chaps":5,"ot":6,"nt":0,"first":"以赛亚书 13:3","top":[["以西结书",5],["以赛亚书",1]],"rest":[0,0],"co":[["成就",6],["身上",4],["忿怒",3],["可憎",2]],"books":{"以西结书":5,"以赛亚书":1},"verse":"我吩咐我所挑出来的人；我招呼我的勇士─就是那矜夸高傲之辈，为要成就我怒中所定的。","ref":"以赛亚书 13:3","def":"和合本用词；常见搭配：成就 6、身上 4、忿怒 3。","senses":[],"bverse":"在远处的，必遭瘟疫而死；在近处的，必倒在刀剑之下；那存留被围困的，必因饥荒而死；我必这样在他们身上成就我怒中所定的。","bref":"以西结书 6:12"},{"no":7948,"w":"天边","py":"tiān biān","pos":"处所词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 13:5","top":[["以赛亚书",1],["马可福音",1]],"rest":[0,0],"co":[["恼恨",1],["毁灭",1],["兵器",1],["耶和华",1]],"books":{"以赛亚书":1,"马可福音":1},"verse":"他们从远方来，从天边来，就是耶和华并他恼恨的兵器要毁灭这全地。","ref":"以赛亚书 13:5","def":"谓天空与地平线交会的远处","senses":[["①","谓天空与地平线交会的","赛 13:5","出现 2 次"]],"bverse":"他要差遣天使，把他的选民，从四方（方：原文是风），从地极直到天边，都招聚了来。”","bref":"马可福音 13:27"},{"no":7949,"w":"相看","py":"xiāng kàn","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 13:8","top":[["以赛亚书",1],["耶利米书",1]],"rest":[0,0],"co":[["彼此",2],["抓住",1],["惊惶",1],["产难",1]],"books":{"以赛亚书":1,"耶利米书":1},"verse":"他们必惊惶悲痛；愁苦必将他们抓住。他们疼痛，好像产难的妇人一样，彼此惊奇相看，脸如火焰。","ref":"以赛亚书 13:8","def":"互相注视;共同观看","senses":[["①","互相注视;共同观看","赛 13:8","出现 2 次"]],"bverse":"犹大王西底家必不能逃脱迦勒底人的手，定要交在巴比伦王的手中，要口对口彼此说话，眼对眼彼此相看。","bref":"耶利米书 32:4"},{"no":7950,"w":"还少","py":"hái shǎo","pos":"副词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 13:12","top":[["以赛亚书",1],["提摩太（前书）",1]],"rest":[0,0],"co":[["精金",1],["必使",1],["纯金",1],["使人",1]],"books":{"以赛亚书":1,"提摩太（前书）":1},"verse":"我必使人比精金还少，使人比俄斐纯金更少。","ref":"以赛亚书 13:12","def":"恢复青春，变得年轻","senses":[["①","恢复青春","赛 13:12","出现 2 次"]],"bverse":"“操练身体，益处还少；惟独敬虔，凡事都有益处，因有今生和来生的应许。”","bref":"提摩太前书 4:8"},{"no":7951,"w":"人烟","py":"rén yān","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 13:20","top":[["以赛亚书",1],["耶利米书",1]],"rest":[0,0],"co":[["那里",2],["阿拉伯人",1],["羊群",1],["支搭",1]],"books":{"以赛亚书":1,"耶利米书":1},"verse":"所以旷野的走兽和豺狼必住在那里，鸵鸟也住在其中，永无人烟，世世代代无人居住。”","ref":"耶利米书 50:39","def":"人家；住家人烟稀少","senses":[],"bverse":"其内必永无人烟，世世代代无人居住。阿拉伯人也不在那里支搭帐棚；牧羊的人也不使羊群卧在那里。","bref":"以赛亚书 13:20"},{"no":7952,"w":"上盖","py":"shàng gài","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 14:11","top":[["以赛亚书",1],["但以理书",1]],"rest":[0,0],"co":[["威势",1],["声音",1],["阴间",1],["琴瑟",1]],"books":{"以赛亚书":1,"但以理书":1},"verse":"你的威势和你琴瑟的声音都下到阴间。你下铺的是虫，上盖的是蛆。","ref":"以赛亚书 14:11","def":"和合本用词；常见搭配：威势 1、声音 1、阴间 1。","senses":[["①","外衣;罩衫","赛 14:11","出现 2 次"]],"bverse":"他们便进到王前，提王的禁令，说：“王啊，三十日内不拘何人，若在王以外，或向神或向人求什么，必被扔在狮子坑中。王不是在这禁令上盖了玉玺么？”王回答说：“实有这事，照玛代和波斯人的例是不可更改的。”","bref":"但以理书 6:12"},{"no":7953,"w":"升到","py":"shēng dào","pos":"动词","orig":"","freq":6,"verses":6,"vols":5,"chaps":5,"ot":3,"nt":3,"first":"以赛亚书 14:13","top":[["以赛亚书",2],["以西结书",1]],"rest":[3,3],"co":[["心里",2],["我要",2],["天上",2],["宝座",1]],"books":{"以赛亚书":2,"以西结书":1,"约翰福音":1,"罗马书":1,"启示录":1},"verse":"我要升到高云之上；我要与至上者同等。","ref":"以赛亚书 14:14","def":"和合本用词；常见搭配：心里 2、我要 2、天上 2。","senses":[],"bverse":"倘或你们看见人子升到他原来所在之处，怎么样呢？","bref":"约翰福音 6:62"},{"no":7954,"w":"同等","py":"tóng děng","pos":"","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"以赛亚书 14:14","top":[["以赛亚书",2],["腓立比书",1]],"rest":[0,0],"co":[["升到",1],["至上",1],["我要",1],["相同",1]],"books":{"以赛亚书":2,"腓立比书":1},"verse":"我要升到高云之上；我要与至上者同等。","ref":"以赛亚书 14:14","def":"和合本用词；常见搭配：升到 1、至上 1、我要 1。","senses":[],"bverse":"你们将谁与我相比，与我同等，可以与我比较，使我们相同呢？","bref":"以赛亚书 46:5"},{"no":7955,"w":"中极","py":"zhōng jí","pos":"方位词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 14:15","top":[["以赛亚书",1],["以西结书",1]],"rest":[0,0],"co":[["坠落",1],["阴间",1],["活人",1],["坟墓",1]],"books":{"以赛亚书":1,"以西结书":1},"verse":"然而，你必坠落阴间，到坑中极深之处。","ref":"以赛亚书 14:15","def":"和合本用词；常见搭配：坠落 1、阴间 1、活人 1。","senses":[["①","指北极星","赛 14:15","出现 2 次"]],"bverse":"他们的坟墓在坑中极深之处。他的众民在他坟墓的四围，都是被杀倒在刀下的；他们曾在活人之地使人惊恐。","bref":"以西结书 32:23"},{"no":7956,"w":"抛弃","py":"pāo qì","pos":"动词","orig":"","freq":12,"verses":12,"vols":6,"chaps":11,"ot":11,"nt":1,"first":"以赛亚书 14:19","top":[["以赛亚书",4],["以西结书",3]],"rest":[4,5],"co":[["尸首",4],["偶像",4],["耶和华",4],["可憎",3]],"books":{"以赛亚书":4,"以西结书":3,"耶利米书":2,"阿摩司书":1,"西番雅书":1,"使徒行传":1},"verse":"被杀的必然抛弃，尸首臭气上腾；诸山被他们的血融化。","ref":"以赛亚书 34:3","def":"丢弃；扔掉抛弃旧观念","senses":[],"bverse":"到那日，各人必将他金偶像银偶像，就是亲手所造、陷自己在罪中的，都抛弃了。","bref":"以赛亚书 31:7"},{"no":7957,"w":"坑中","py":"kēng zhōng","pos":"名词","orig":"","freq":6,"verses":6,"vols":3,"chaps":3,"ot":5,"nt":1,"first":"以赛亚书 14:19","top":[["但以理书",4],["以赛亚书",1]],"rest":[1,1],"co":[["狮子",4],["不拘",2],["人求",2],["以外",2]],"books":{"但以理书":4,"以赛亚书":1,"彼得后书":1},"verse":"就是天使犯了罪，神也没有宽容，曾把他们丢在地狱，交在黑暗坑中，等候审判。","ref":"彼得后书 2:4","def":"和合本用词；常见搭配：狮子 4、不拘 2、人求 2。","senses":[],"bverse":"惟独你被抛弃，不得入你的坟墓，好像可憎的枝子，以被杀的人为衣，就是被刀刺透，坠落坑中石头那里的；你又像被践踏的尸首一样。","bref":"以赛亚书 14:19"},{"no":7958,"w":"箭猪","py":"jiàn zhū","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 14:23","top":[["以赛亚书",2],["西番雅书",1]],"rest":[0,0],"co":[["鹈鹕",2],["我要",1],["必使",1],["所得",1]],"books":{"以赛亚书":2,"西番雅书":1},"verse":"我必使巴比伦为箭猪所得，又变为水池；我要用灭亡的扫帚扫净它。这是万军之耶和华说的。","ref":"以赛亚书 14:23","def":"和合本用词；常见搭配：鹈鹕 2、我要 1、必使 1。","senses":[],"bverse":"鹈鹕、箭猪却要得为业；猫头鹰、乌鸦要住在其间。耶和华必将空虚的准绳，混沌的线铊，拉在其上。","bref":"以赛亚书 34:11"},{"no":7959,"w":"亚述人","py":"yà shù rén","pos":"名词","orig":"","freq":17,"verses":16,"vols":5,"chaps":12,"ot":17,"nt":0,"first":"以赛亚书 14:25","top":[["以赛亚书",7],["以西结书",6]],"rest":[3,4],"co":[["践踏",3],["进入",3],["耶和华",3],["埃及",3]],"books":{"以赛亚书":7,"以西结书":6,"弥迦书":2,"耶利米哀歌":1,"何西阿书":1},"verse":"亚述人必因耶和华的声音惊惶；耶和华必用杖击打他。","ref":"以赛亚书 30:31","def":"亚述帝国的民族","senses":[["①","亚述帝国的民族","赛 14:25","出现 17 次"]],"bverse":"主耶和华如此说：起先我的百姓下到埃及，在那里寄居，又有亚述人无故欺压他们。","bref":"以赛亚书 52:4"},{"no":7960,"w":"他加","py":"tā jiā","pos":"代词","orig":"","freq":3,"verses":2,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"以赛亚书 14:25","top":[["以赛亚书",3]],"rest":[0,0],"co":[["践踏",1],["重担",1],["以色列人",1],["肩头",1]],"books":{"以赛亚书":3},"verse":"疲乏的，他赐能力；软弱的，他加力量。","ref":"以赛亚书 40:29","def":"和合本用词；常见搭配：践踏 1、重担 1、以色列人 1。","senses":[],"bverse":"就是在我地上打折亚述人，在我山上将他践踏。他加的轭必离开以色列人；他加的重担必离开他们的肩头。","bref":"以赛亚书 14:25"},{"no":7961,"w":"飞龙","py":"fēi lóng","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 14:29","top":[["以赛亚书",2]],"rest":[0,0],"co":[["火焰",2],["非利士",1],["不要",1],["击打",1]],"books":{"以赛亚书":2},"verse":"非利士全地啊，不要因击打你的杖折断就喜乐。因为从蛇的根必生出毒蛇；它所生的是火焰的飞龙。","ref":"以赛亚书 14:29","def":"和合本用词；常见搭配：火焰 2、非利士 1、不要 1。","senses":[],"bverse":"论南方牲畜的默示：他们把财物驮在驴驹的脊背上，将宝物驮在骆驼的肉鞍上，经过艰难困苦之地，就是公狮、母狮、蝮蛇、火焰的飞龙之地，往那不利于他们的民那里去。","bref":"以赛亚书 30:6"},{"no":7962,"w":"逃民","py":"táo mín","pos":"动词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":4,"nt":0,"first":"以赛亚书 15:5","top":[["以赛亚书",2],["耶利米书",2]],"rest":[0,0],"co":[["我心",1],["摩押",1],["哀声",1],["琐珥",1]],"books":{"以赛亚书":2,"耶利米书":2},"verse":"求你献谋略，行公平，使你的影子在午间如黑夜，隐藏被赶散的人，不可显露逃民。","ref":"以赛亚书 16:3","def":"和合本用词；常见搭配：我心 1、摩押 1、哀声 1。","senses":[],"bverse":"我心为摩押悲哀；他的贵胄（或译：逃民）逃到琐珥，到伊基拉‧施利施亚。他们上鲁希坡，随走随哭；在何罗念的路上，因毁灭举起哀声。","bref":"以赛亚书 15:5"},{"no":7963,"w":"随走","py":"suí zǒu","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":3,"nt":1,"first":"以赛亚书 15:5","top":[["耶利米书",2],["以赛亚书",1]],"rest":[1,1],"co":[["随哭",3],["我心",1],["摩押",1],["哀声",1]],"books":{"耶利米书":2,"以赛亚书":1,"马太福音":1},"verse":"随走随传，说‘天国近了！’","ref":"马太福音 10:7","def":"和合本用词；常见搭配：随哭 3、我心 1、摩押 1。","senses":[],"bverse":"我心为摩押悲哀；他的贵胄（或译：逃民）逃到琐珥，到伊基拉‧施利施亚。他们上鲁希坡，随走随哭；在何罗念的路上，因毁灭举起哀声。","bref":"以赛亚书 15:5"},{"no":7964,"w":"随哭","py":"suí kū","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 15:5","top":[["耶利米书",2],["以赛亚书",1]],"rest":[0,0],"co":[["随走",3],["我心",1],["摩押",1],["哀声",1]],"books":{"耶利米书":2,"以赛亚书":1},"verse":"耶和华说：“当那日子、那时候，以色列人要和犹大人同来，随走随哭，寻求耶和华─他们的神。","ref":"耶利米书 50:4","def":"和合本用词；常见搭配：随走 3、我心 1、摩押 1。","senses":[],"bverse":"我心为摩押悲哀；他的贵胄（或译：逃民）逃到琐珥，到伊基拉‧施利施亚。他们上鲁希坡，随走随哭；在何罗念的路上，因毁灭举起哀声。","bref":"以赛亚书 15:5"},{"no":7965,"w":"哀鸣","py":"āi míng","pos":"动词","orig":"","freq":8,"verses":8,"vols":6,"chaps":8,"ot":8,"nt":0,"first":"以赛亚书 16:11","top":[["以赛亚书",3],["耶利米书",1]],"rest":[4,4],"co":[["心肠",2],["摩押",2],["心腹",2],["如此",2]],"books":{"以赛亚书":3,"耶利米书":1,"以西结书":1,"约珥书":1,"弥迦书":1,"那鸿书":1},"verse":"因此，我心腹为摩押哀鸣如琴；我心肠为吉珥‧哈列设也是如此。","ref":"以赛亚书 16:11","def":"和合本用词；常见搭配：心肠 2、摩押 2、心腹 2。","senses":[],"bverse":"我们咆哮如熊，哀鸣如鸽；指望公平，却是没有；指望救恩，却远离我们。","bref":"以赛亚书 59:11"},{"no":7966,"w":"为城","py":"wèi chéng","pos":"介词","orig":"","freq":4,"verses":4,"vols":2,"chaps":3,"ot":2,"nt":2,"first":"以赛亚书 17:1","top":[["以赛亚书",2],["启示录",2]],"rest":[0,0],"co":[["不再",2],["羔羊",2],["城内",2],["作乱",1]],"books":{"以赛亚书":2,"启示录":2},"verse":"论大马士革的默示：看哪，大马士革已被废弃，不再为城，必变作乱堆。","ref":"以赛亚书 17:1","def":"和合本用词；常见搭配：不再 2、羔羊 2、城内 2。","senses":[],"bverse":"你使城变为乱堆，使坚固城变为荒场，使外邦人宫殿的城不再为城，永远不再建造。","bref":"以赛亚书 25:2"},{"no":7967,"w":"作乱","py":"zuò luàn","pos":"动词","orig":"","freq":5,"verses":5,"vols":4,"chaps":4,"ot":1,"nt":4,"first":"以赛亚书 17:1","top":[["路加福音",2],["以赛亚书",1]],"rest":[2,2],"co":[["杀人",2],["监里",2],["不再",1],["为城",1]],"books":{"路加福音":2,"以赛亚书":1,"马可福音":1,"使徒行传":1},"verse":"这巴拉巴是因在城里作乱杀人，下在监里的。","ref":"路加福音 23:19","def":"暴乱；发动叛乱制止作乱","senses":[],"bverse":"把他们所求的那作乱杀人、下在监里的释放了，把耶稣交给他们，任凭他们的意思行。","bref":"路加福音 23:25"},{"no":7968,"w":"伤痛","py":"shāng tòng","pos":"形容词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":2,"nt":3,"first":"以赛亚书 17:11","top":[["以赛亚书",1],["耶利米哀歌",1]],"rest":[3,3],"co":[["日子",1],["收割",1],["愁苦",1],["篱笆",1]],"books":{"以赛亚书":1,"耶利米哀歌":1,"路加福音":1,"罗马书":1,"彼得后书":1},"verse":"我是大有忧愁，心里时常伤痛；","ref":"罗马书 9:2","def":"因受伤而疼痛","senses":[["①","因受伤而疼痛","赛 17:11","出现 5 次"]],"bverse":"因我本城的众民，我的眼，使我的心伤痛。","bref":"耶利米哀歌 3:51"},{"no":7969,"w":"滔滔","py":"tāo tāo","pos":"","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以赛亚书 17:12","top":[["以赛亚书",2],["阿摩司书",1]],"rest":[0,0],"co":[["好像",2],["列邦",2],["奔腾",2],["海浪",1]],"books":{"以赛亚书":2,"阿摩司书":1},"verse":"唉！多民哄嚷，好像海浪匉訇；列邦奔腾，好像猛水滔滔；","ref":"以赛亚书 17:12","def":"和合本用词；常见搭配：好像 2、列邦 2、奔腾 2。","senses":[["①","大水奔流貌","赛 17:12","出现 3 次"]],"bverse":"惟愿公平如大水滚滚，使公义如江河滔滔。","bref":"阿摩司书 5:24"},{"no":7970,"w":"多水","py":"duō shuǐ","pos":"数词","orig":"","freq":5,"verses":5,"vols":3,"chaps":5,"ot":5,"nt":0,"first":"以赛亚书 17:13","top":[["耶利米书",2],["以西结书",2]],"rest":[1,1],"co":[["如同",2],["空中",2],["发声",2],["府库",2]],"books":{"耶利米书":2,"以西结书":2,"以赛亚书":1},"verse":"这树栽于肥田多水的旁边，好生枝子，结果子，成为佳美的葡萄树。","ref":"以西结书 17:8","def":"和合本用词；常见搭配：如同 2、空中 2、发声 2。","senses":[],"bverse":"以色列神的荣光从东而来。他的声音如同多水的声音；地就因他的荣耀发光。","bref":"以西结书 43:2"},{"no":7971,"w":"快行","py":"kuài xíng","pos":"形容词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 18:2","top":[["以赛亚书",2],["耶利米书",1]],"rest":[0,0],"co":[["践踏",1],["分开",1],["蒲草",1],["那里",1]],"books":{"以赛亚书":2,"耶利米书":1},"verse":"到那日，耶和华必用他刚硬有力的大刀刑罚鳄鱼─就是那快行的蛇，刑罚鳄鱼─就是那曲行的蛇，并杀海中的大鱼。","ref":"以赛亚书 27:1","def":"和合本用词；常见搭配：践踏 1、分开 1、蒲草 1。","senses":[],"bverse":"差遣使者在水面上，坐蒲草船过海。先知说：你们快行的使者，要到高大光滑的民那里去。自从开国以来，那民极其可畏，是分地界践踏人的；他们的地有江河分开。","bref":"以赛亚书 18:2"},{"no":7972,"w":"念咒","py":"niàn zhòu","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 19:3","top":[["以赛亚书",1],["使徒行传",1]],"rest":[0,0],"co":[["耗尽",1],["谋略",1],["里面",1],["交鬼",1]],"books":{"以赛亚书":1,"使徒行传":1},"verse":"埃及人的心神必在里面耗尽；我必败坏他们的谋略。他们必求问偶像和念咒的、交鬼的、行巫术的。","ref":"以赛亚书 19:3","def":"一种迷信行为。即念诵自认为可以产生神奇力量的神秘语句","senses":[["①","一种迷信行为","赛 19:3","出现 2 次"]],"bverse":"那时，有几个游行各处、念咒赶鬼的犹太人，向那被恶鬼附的人擅自称主耶稣的名，说：“我奉保罗所传的耶稣敕令你们出来！”","bref":"使徒行传 19:13"},{"no":7973,"w":"苇子","py":"wěi zi","pos":"名词","orig":"","freq":10,"verses":10,"vols":4,"chaps":6,"ot":2,"nt":8,"first":"以赛亚书 19:6","top":[["马太福音",3],["启示录",3]],"rest":[2,4],"co":[["一根",3],["唾沫",2],["脸上",2],["送给",2]],"books":{"马太福音":3,"启示录":3,"以赛亚书":2,"马可福音":2},"verse":"又吐唾沫在他脸上，拿苇子打他的头。","ref":"马太福音 27:30","def":"和合本用词；常见搭配：一根 3、唾沫 2、脸上 2。","senses":[],"bverse":"内中有一个人赶紧跑去，拿海绒蘸满了醋，绑在苇子上，送给他喝。","bref":"马太福音 27:48"},{"no":7974,"w":"尼罗河","py":"ní luó hé","pos":"名词","orig":"","freq":11,"verses":10,"vols":5,"chaps":7,"ot":11,"nt":0,"first":"以赛亚书 19:7","top":[["以赛亚书",5],["耶利米书",2]],"rest":[3,4],"co":[["埃及",4],["枯干",2],["庄稼",2],["翻腾",2]],"books":{"以赛亚书":5,"耶利米书":2,"阿摩司书":2,"那鸿书":1,"撒迦利亚书":1},"verse":"打鱼的必哀哭。在尼罗河一切钓鱼的必悲伤；在水上撒网的必都衰弱。","ref":"以赛亚书 19:8","def":"圣经专名（人名／地名／族名），首见 以赛亚书 19:7。","senses":[],"bverse":"靠尼罗河旁的草田，并沿尼罗河所种的田，都必枯干。庄稼被风吹去，归于无有。","bref":"以赛亚书 19:7"},{"no":7975,"w":"打鱼","py":"dǎ yú","pos":"动词","orig":"","freq":7,"verses":7,"vols":6,"chaps":6,"ot":2,"nt":5,"first":"以赛亚书 19:8","top":[["路加福音",2],["以赛亚书",1]],"rest":[4,4],"co":[["西门",4],["撒网",3],["彼得",2],["耶稣",2]],"books":{"路加福音":2,"以赛亚书":1,"耶利米书":1,"马太福音":1,"马可福音":1,"约翰福音":1},"verse":"他见有两只船湾在湖边；打鱼的人却离开船洗网去了。","ref":"路加福音 5:2","def":"和合本用词；常见搭配：西门 4、撒网 3、彼得 2。","senses":[],"bverse":"讲完了，对西门说：“把船开到水深之处，下网打鱼。”","bref":"路加福音 5:4"},{"no":7976,"w":"钓鱼","py":"diào yú","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 19:8","top":[["以赛亚书",1],["马太福音",1]],"rest":[0,0],"co":[["哀哭",1],["水上",1],["打鱼",1],["悲伤",1]],"books":{"以赛亚书":1,"马太福音":1},"verse":"打鱼的必哀哭。在尼罗河一切钓鱼的必悲伤；在水上撒网的必都衰弱。","ref":"以赛亚书 19:8","def":"和合本用词；常见搭配：哀哭 1、水上 1、打鱼 1。","senses":[["①","垂竿取鱼","赛 19:8","出现 2 次"]],"bverse":"但恐怕触犯（触犯：原文是绊倒）他们，你且往海边去钓鱼，把先钓上来的鱼拿起来，开了它的口，必得一块钱，可以拿去给他们，作你我的税银。”","bref":"马太福音 17:27"},{"no":7977,"w":"撒网","py":"sā wǎng","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"以赛亚书 19:8","top":[["以赛亚书",1],["马太福音",1