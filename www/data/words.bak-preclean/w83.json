音 20:21"},{"no":8255,"w":"涨起","py":"zhǎng qǐ","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"耶利米书 51:42","top":[["阿摩司书",2],["耶利米书",1]],"rest":[1,1],"co":[["如同",2],["悲哀",2],["全然",2],["尼罗河",2]],"books":{"阿摩司书":2,"耶利米书":1,"以西结书":1},"verse":"海水涨起，漫过巴比伦；她被许多海浪遮盖。","ref":"耶利米书 51:42","def":"和合本用词；常见搭配：如同 2、悲哀 2、全然 2。","senses":[],"bverse":"又量了一千肘，水便成了河，使我不能蹚过。因为水势涨起，成为可洑的水，不可蹚的河。","bref":"以西结书 47:5"},{"no":8256,"w":"独坐","py":"dú zuò","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"耶利米哀歌 1:1","top":[["耶利米哀歌",2]],"rest":[0,0],"co":[["中为",1],["人民",1],["成为",1],["列国",1]],"books":{"耶利米哀歌":2},"verse":"他当独坐无言，因为这是耶和华加在他身上的。","ref":"耶利米哀歌 3:28","def":"和合本用词；常见搭配：中为 1、人民 1、成为 1。","senses":[["①","一个人坐着","哀 1:1","出现 2 次"]],"bverse":"先前满有人民的城，现在何竟独坐！先前在列国中为大的，现在竟如寡妇；先前在诸省中为王后的，现在成为进贡的。","bref":"耶利米哀歌 1:1"},{"no":8257,"w":"救济","py":"jiù jì","pos":"名词","orig":"","freq":4,"verses":3,"vols":2,"chaps":2,"ot":1,"nt":3,"first":"耶利米哀歌 1:7","top":[["提摩太（前书）",3],["耶利米哀歌",1]],"rest":[0,0],"co":[["手中",1],["敌人",1],["荒凉",1],["困苦",1]],"books":{"提摩太（前书）":3,"耶利米哀歌":1},"verse":"又有行善的名声，就如养育儿女，接待远人，洗圣徒的脚，救济遭难的人，竭力行各样善事。","ref":"提摩太前书 5:10","def":"用金钱或物资帮助灾区或生活困难的人","senses":[["①","用金钱或物资帮助灾区","哀 1:7","出现 4 次"]],"bverse":"耶路撒冷在困苦窘迫之时，就追想古时一切的乐境。她百姓落在敌人手中，无人救济；敌人看见，就因她的荒凉嗤笑。","bref":"耶利米哀歌 1:7"},{"no":8258,"w":"张弓","py":"zhāng gōng","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"耶利米哀歌 2:4","top":[["耶利米哀歌",2],["撒迦利亚书",1]],"rest":[0,0],"co":[["锡安",2],["举起",1],["杀戮",1],["敌人",1]],"books":{"耶利米哀歌":2,"撒迦利亚书":1},"verse":"他张弓将我当作箭靶子。","ref":"耶利米哀歌 3:12","def":"和合本用词；常见搭配：锡安 2、举起 1、杀戮 1。","senses":[],"bverse":"他张弓好像仇敌；他站着举起右手，如同敌人将悦人眼目的，尽行杀戮。在锡安百姓的帐棚上倒出他的忿怒，像火一样。","bref":"耶利米哀歌 2:4"},{"no":8259,"w":"掩耳","py":"yǎn ěr","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"耶利米哀歌 3:56","top":[["耶利米哀歌",1],["弥迦书",1]],"rest":[1,1],"co":[["不要",1],["声音",1],["解救",1],["听见",1]],"books":{"耶利米哀