示录",1]],"rest":[0,0],"co":[["叹息",1],["哀号",1],["书卷",1],["展开",1]],"books":{"以西结书":1,"启示录":1},"verse":"他将书卷在我面前展开，内外都写着字，其上所写的有哀号、叹息、悲痛的话。","ref":"以西结书 2:10","def":"内部和外部;里面和外面","senses":[["①","内部和外部;里面和外","结 2:10","出现 2 次"]],"bverse":"四活物各有六个翅膀，遍体内外都满了眼睛。他们昼夜不住地说：圣哉！圣哉！圣哉！主神是昔在、今在、以后永在的全能者。","bref":"启示录 4:8"},{"no":8270,"w":"心硬","py":"xīn yìng","pos":"形容词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"以西结书 3:7","top":[["以西结书",1],["撒迦利亚书",1]],"rest":[2,2],"co":[["耶稣",2],["摩西",2],["全家",1],["以色列",1]],"books":{"以西结书":1,"撒迦利亚书":1,"马太福音":1,"马可福音":1},"verse":"以色列家却不肯听从你，因为他们不肯听从我；原来以色列全家是额坚心硬的人。","ref":"以西结书 3:7","def":"不容易受感动而产生怜悯或同情","senses":[["①","不容易受感动而产生怜","结 3:7","出现 4 次"]],"bverse":"耶稣说：“摩西因为你们的心硬，所以写这条例给你们；","bref":"马可福音 10:5"},{"no":8271,"w":"哑口","py":"yǎ kǒu","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以西结书 3:26","top":[["以西结书",2]],"rest":[0,0],"co":[["贴住",1],["以致",1],["必使",1],["上膛",1]],"books":{"以西结书":2},"verse":"我必使你的舌头贴住上膛，以致你哑口，不能作责备他们的人；他们原是悖逆之家。","ref":"以西结书 3:26","def":"沉默不语;无话可说","senses":[["①","沉默不语;无话可说","结 3:26","出现 2 次"]],"bverse":"你必向逃脱的人开口说话，不再哑口。你必这样为他们作预兆，他们就知道我是耶和华。”","bref":"以西结书 24:27"},{"no":8272,"w":"左侧","py":"zuǒ cè","pos":"方位词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 4:4","top":[["以西结书",3]],"rest":[0,0],"co":[["罪孽",2],["担当",2],["以色列",2],["承当",1]],"books":{"以西结书":3},"verse":"你要向左侧卧，承当以色列家的罪孽；要按你向左侧卧的日数，担当他们的罪孽。","ref":"以西结书 4:4","def":"和合本用词；常见搭配：罪孽 2、担当 2、以色列 2。","senses":[],"bverse":"因为我已将他们作孽的年数定为你向左侧卧的日数，就是三百九十日，你要这样担当以色列家的罪孽。","bref":"以西结书 4:5"},{"no":8273,"w":"侧卧","py":"cè wò","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以西结书 4:6","top":[["以西结书",2]],"rest":[0,0],"co":[["罪孽",1],["日子",1],["担当",1],["一年",1]],"books":{"以西结书":2},"verse":"再者，你满了这些日子，还要向右侧卧，担当犹大家的罪孽。我给你定规侧卧四十日，一日顶一年。","ref":"以西结书 4:6","def":"和合本用词；常见搭配：罪孽 1、日子 1、担当 1。","senses":[["①","侧体而卧","结 4:6","出现 2 次"]],"bverse":"你要取小麦、大麦、豆子、红豆、小米、粗麦，装在一个器皿中，用以为自己做饼；要按你侧卧的三百九十日吃这饼。","bref":"以西结书 4:9"},{"no":8274,"w":"制子","py":"zhì zi","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以西结书 4:11","top":[["以西结书",2]],"rest":[0,0],"co":[["喝水",2],["一欣",1],["按时",1],["每日",1]],"books":{"以西结书":2},"verse":"你喝水也要按制子，每日喝一欣六分之一，按时而喝。","ref":"以西结书 4:11","def":"练武举重的器械。因每具都有规定的重量，故称","senses":[["①","练武举重的器械","结 4:11","出现 2 次"]],"bverse":"他又对我说：“人子啊，我必在耶路撒冷折断他们的杖，就是断绝他们的粮。他们吃饼要按分两，忧虑而吃；喝水也要按制子，惊惶而喝；","bref":"以西结书 4:16"},{"no":8275,"w":"几根","py":"jǐ gēn","pos":"数词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":2,"nt":1,"first":"以西结书 5:3","top":[["以西结书",2],["罗马书",1]],"rest":[0,0],"co":[["其中",2],["衣襟",1],["火中",1],["里面",1]],"books":{"以西结书":2,"罗马书":1},"verse":"你要从其中取几根包在衣襟里，","ref":"以西结书 5:3","def":"和合本用词；常见搭配：其中 2、衣襟 1、火中 1。","senses":[],"bverse":"再从这几根中取些扔在火中焚烧，从里面必有火出来烧入以色列全家。","bref":"以西结书 5:4"},{"no":8276,"w":"满意","py":"mǎn yì","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"以西结书 5:7","top":[["以西结书",3]],"rest":[0,0],"co":[["四围",1],["过于",1],["谨守",1],["列国",1]],"books":{"以西结书":3},"verse":"并且多行淫乱，直到那贸易之地，就是迦勒底，你仍不满意。","ref":"以西结书 16:29","def":"决意，一心一意","senses":[],"bverse":"你因贪色无厌，又与亚述人行淫，与他们行淫之后，仍不满意，","bref":"以西结书 16:28"},{"no":8277,"w":"怒中","py":"nù zhōng","pos":"动词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以西结书 5:13","top":[["以西结书",2],["何西阿书",1]],"rest":[0,0],"co":[["我要",1],["成就",1],["知道",1],["热心",1]],"books":{"以西结书":2,"何西阿书":1},"verse":"我必不发猛烈的怒气，也不再毁灭以法莲。因我是神，并非世人，是你们中间的圣者；我必不在怒中临到你们。","ref":"何西阿书 11:9","def":"和合本用词；常见搭配：我要 1、成就 1、知道 1。","senses":[],"bverse":"“我要这样成就怒中所定的；我向他们发的忿怒止息了，自己就得着安慰。我在他们身上成就怒中所定的那时，他们就知道我─耶和华所说的是出于热心；","bref":"以西结书 5:13"},{"no":8278,"w":"淫心","py":"yín xīn","pos":"形容词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"以西结书 6:9","top":[["何西阿书",2],["以西结书",1]],"rest":[0,0],"co":[["因行",1],["伤破",1],["可憎",1],["恶事",1]],"books":{"何西阿书":2,"以西结书":1},"verse":"他们所行的使他们不能归向神；因有淫心在他们里面，他们也不认识耶和华。","ref":"何西阿书 5:4","def":"邪乱的思想;贪心","senses":[["①","邪乱的思想;贪心","结 6:9","出现 3 次"]],"bverse":"那脱离刀剑的人必在所掳到的各国中记念我，为他们心中何等伤破，是因他们起淫心，远离我，眼对偶像行邪淫。他们因行一切可憎的恶事，必厌恶自己。","bref":"以西结书 6:9"},{"no":8279,"w":"有形","py":"yǒu xíng","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以西结书 8:2","top":[["以西结书",1],["歌罗西书",1]],"rest":[0,0],"co":[["仿佛",1],["精金",1],["光辉",1],["光耀",1]],"books":{"以西结书":1,"歌罗西书":1},"verse":"因为神本性一切的丰盛都有形有体地居住在基督里面，","ref":"歌罗西书 2:9","def":"有形状的﹑感官能感觉到的","senses":[["①","有形状的﹑感官能感觉","结 8:2","出现 2 次"]],"bverse":"我观看，见有形像仿佛火的形状，从他腰以下的形状有火，从他腰以上有光辉的形状，仿佛光耀的精金。","bref":"以西结书 8:2"},{"no":8280,"w":"朝北","py":"cháo běi","pos":"名词","orig":"","freq":8,"verses":8,"vols":1,"chaps":4,"ot":8,"nt":0,"first":"以西结书 8:3","top":[["以西结书",8]],"rest":[0,0],"co":[["门口",3],["那里",2],["耶和华",2],["外院",2]],"books":{"以西结书":8},"verse":"他量外院朝北的门，长宽若干。","ref":"以西结书 40:20","def":"和合本用词；常见搭配：门口 3、那里 2、耶和华 2。","senses":[],"bverse":"上到朝北的门口，这边有两张桌子，门廊那边也有两张桌子。","bref":"以西结书 40:40"},{"no":8281,"w":"主怒","py":"zhǔ nù","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"以西结书 8:3","top":[["以西结书",1],["何西阿书",1]],"rest":[1,1],"co":[["惹动",2],["头发",1],["一只",1],["样式",1]],"books":{"以西结书":1,"何西阿书":1,"罗马书":1},"verse":"以法莲大大惹动主怒，所以他流血的罪必归在他身上。主必将那因以法莲所受的羞辱归还他。","ref":"何西阿书 12:14","def":"和合本用词；常见搭配：惹动 2、头发 1、一只 1。","senses":[],"bverse":"他伸出仿佛一只手的样式，抓住我的一绺头发，灵就将我举到天地中间，在神的异象中，带我到耶路撒冷朝北的内院门口，在那里有触动主怒偶像的坐位，就是惹动忌邪的。","bref":"以西结书 8:3"},{"no":8282,"w":"一门","py":"yī mén","pos":"数词","orig":"","freq":3,"verses":2,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"以西结书 8:8","top":[["以西结书",3]],"rest":[0,0],"co":[["人子",1],["向南",1],["旁屋",1],["向北",1]],"books":{"以西结书":3},"verse":"他对我说：“人子啊，你要挖墙。”我一挖墙，见有一门。","ref":"以西结书 8:8","def":"和合本用词；常见搭配：人子 1、向南 1、旁屋 1。","senses":[["①","一道门户","结 8:8","出现 3 次"]],"bverse":"旁屋的门都向余地：一门向北，一门向南。周围的余地宽五肘。","bref":"以西结书 41:11"},{"no":8283,"w":"着墨","py":"zhuó mò","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 9:2","top":[["以西结书",3]],"rest":[0,0],"co":[["盒子",3],["腰间",3],["麻衣",3],["身穿",2]],"books":{"以西结书":3},"verse":"那穿细麻衣、腰间带着墨盒子的人将这事回复说：“我已经照你所吩咐的行了。”","ref":"以西结书 9:11","def":"犹着笔。指写作或书画创作等","senses":[],"bverse":"忽然有六个人从朝北的上门而来，各人手拿杀人的兵器；内中有一人身穿细麻衣，腰间带着墨盒子。他们进来，站在铜祭坛旁。","bref":"以西结书 9:2"},{"no":8284,"w":"盒子","py":"hé zi","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 9:2","top":[["以西结书",3]],"rest":[0,0],"co":[["着墨",3],["腰间",3],["麻衣",3],["身穿",2]],"books":{"以西结书":3},"verse":"那穿细麻衣、腰间带着墨盒子的人将这事回复说：“我已经照你所吩咐的行了。”","ref":"以西结书 9:11","def":"和合本用词；常见搭配：着墨 3、腰间 3、麻衣 3。","senses":[],"bverse":"忽然有六个人从朝北的上门而来，各人手拿杀人的兵器；内中有一人身穿细麻衣，腰间带着墨盒子。他们进来，站在铜祭坛旁。","bref":"以西结书 9:2"},{"no":8285,"w":"何方","py":"hé fāng","pos":"代词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以西结书 10:11","top":[["以西结书",2],["但以理书",1]],"rest":[0,0],"co":[["掉转",1],["时候",1],["行走",1],["四方",1]],"books":{"以西结书":2,"但以理书":1},"verse":"轮行走的时候，向四方都能直行，并不掉转。头向何方，他们也随向何方，行走的时候并不掉转。","ref":"以西结书 10:11","def":"和合本用词；常见搭配：掉转 1、时候 1、行走 1。","senses":[],"bverse":"现在我降旨，无论何方、何国、何族的人，谤讟沙得拉、米煞、亚伯尼歌之神的，必被凌迟，他的房屋必成粪堆，因为没有别神能这样施行拯救。”","bref":"但以理书 3:29"},{"no":8286,"w":"恶规","py":"è guī","pos":"","orig":"","freq":4,"verses":4,"vols":2,"chaps":3,"ot":4,"nt":0,"first":"以西结书 11:12","top":[["以西结书",3],["弥迦书",1]],"rest":[0,0],"co":[["遵行",3],["律例",3],["顺从",2],["谨守",2]],"books":{"以西结书":3,"弥迦书":1},"verse":"我也任他们遵行不美的律例，谨守不能使人活着的恶规。","ref":"以西结书 20:25","def":"和合本用词；常见搭配：遵行 3、律例 3、顺从 2。","senses":[],"bverse":"你们就知道我是耶和华；因为你们没有遵行我的律例，也没有顺从我的典章，却随从你们四围列国的恶规。”","bref":"以西结书 11:12"},{"no":8287,"w":"新灵","py":"xīn líng","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"以西结书 11:19","top":[["以西结书",3]],"rest":[0,0],"co":[["里面",2],["肉体",2],["石心",2],["赐给",2]],"books":{"以西结书":3},"verse":"你们要将所犯的一切罪过尽行抛弃，自做一个新心和新灵。以色列家啊，你们何必死亡呢？","ref":"以西结书 18:31","def":"和合本用词；常见搭配：里面 2、肉体 2、石心 2。","senses":[],"bverse":"我要使他们有合一的心，也要将新灵放在他们里面，又从他们肉体中除掉石心，赐给他们肉心，","bref":"以西结书 11:19"},{"no":8288,"w":"石心","py":"shí xīn","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以西结书 11:19","top":[["以西结书",2]],"rest":[0,0],"co":[["里面",2],["肉体",2],["新灵",2],["赐给",2]],"books":{"以西结书":2},"verse":"我要使他们有合一的心，也要将新灵放在他们里面，又从他们肉体中除掉石心，赐给他们肉心，","ref":"以西结书 11:19","def":"和合本用词；常见搭配：里面 2、肉体 2、新灵 2。","senses":[["①","石的中心","结 11:19","出现 2 次"]],"bverse":"我也要赐给你们一个新心，将新灵放在你们里面，又从你们的肉体中除掉石心，赐给你们肉心。","bref":"以西结书 36:26"},{"no":8289,"w":"那座","py":"nà zuò","pos":"代词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"以西结书 11:23","top":[["以西结书",1],["使徒行传",1]],"rest":[1,1],"co":[["城中",1],["荣耀",1],["上升",1],["山上",1]],"books":{"以西结书":1,"使徒行传":1,"希伯来书":1},"verse":"耶和华的荣耀从城中上升，停在城东的那座山上。","ref":"以西结书 11:23","def":"和合本用词；常见搭配：城中 1、荣耀 1、上升 1。","senses":[],"bverse":"我们聚会的那座楼上，有好些灯烛。","bref":"使徒行传 20:8"},{"no":8290,"w":"挖通","py":"wā tōng","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 12:5","top":[["以西结书",3]],"rest":[0,0],"co":[["出去",3],["物件",3],["眼前",2],["其中",2]],"books":{"以西结书":3},"verse":"你要在他们眼前挖通了墙，从其中将物件带出去。","ref":"以西结书 12:5","def":"和合本用词；常见搭配：出去 3、物件 3、眼前 2。","senses":[],"bverse":"我就照着所吩咐的去行，白日带出我的物件，好像预备掳去使用的物件。到了晚上，我用手挖通了墙。天黑的时候，就当他们眼前搭在肩头上带出去。","bref":"以西结书 12:7"},{"no":8291,"w":"俗语","py":"sú yǔ","pos":"名词","orig":"","freq":8,"verses":6,"vols":3,"chaps":5,"ot":7,"nt":1,"first":"以西结书 12:22","top":[["以西结书",6],["哈巴谷书",1]],"rest":[1,1],"co":[["以色列",3],["日子",2],["异象",2],["不再",2]],"books":{"以西结书":6,"哈巴谷书":1,"路加福音":1},"verse":"“凡说俗语的必用俗语攻击你，说：‘母亲怎样，女儿也怎样。’","ref":"以西结书 16:44","def":"和合本用词；常见搭配：以色列 3、日子 2、异象 2。","senses":[],"bverse":"“人子啊，在你们以色列地怎么有这俗语，说‘日子迟延，一切异象都落了空’呢？","bref":"以西结书 12:22"},{"no":8292,"w":"谎诈","py":"huǎng zhà","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":2,"ot":4,"nt":0,"first":"以西结书 13:6","top":[["以西结书",3],["那鸿书",1]],"rest":[0,0],"co":[["虚假",3],["耶和华",3],["其实",2],["占卜",2]],"books":{"以西结书":3,"那鸿书":1},"verse":"祸哉！这流人血的城，充满谎诈和强暴─抢夺的事总不止息。","ref":"那鸿书 3:1","def":"和合本用词；常见搭配：虚假 3、耶和华 3、其实 2。","senses":[["①","谎骗欺诈","结 13:6","出现 4 次"]],"bverse":"这些人所见的是虚假，是谎诈的占卜。他们说是耶和华说的，其实耶和华并没有差遣他们，他们倒使人指望那话必然立定。","bref":"以西结书 13:6"},{"no":8293,"w":"泡透","py":"pào tòu","pos":"名词","orig":"","freq":6,"verses":6,"vols":1,"chaps":2,"ot":6,"nt":0,"first":"以西结书 13:10","top":[["以西结书",6]],"rest":[0,0],"co":[["倒塌",3],["其实",2],["百姓",2],["这墙",2]],"books":{"以西结书":6},"verse":"这墙倒塌之后，人岂不问你们说：‘你们抹上未泡透的灰在哪里呢？’”","ref":"以西结书 13:12","def":"和合本用词；常见搭配：倒塌 3、其实 2、百姓 2。","senses":[],"bverse":"因为他们诱惑我的百姓，说：‘平安！’其实没有平安，就像有人立起墙壁，他们倒用未泡透的灰抹上。","bref":"以西结书 13:10"},{"no":8294,"w":"不问","py":"bù wèn","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以西结书 13:12","top":[["以西结书",1],["约翰福音",1]],"rest":[0,0],"co":[["这墙",1],["之后",1],["泡透",1],["哪里",1]],"books":{"以西结书":1,"约翰福音":1},"verse":"这墙倒塌之后，人岂不问你们说：‘你们抹上未泡透的灰在哪里呢？’”","ref":"以西结书 13:12","def":"和合本用词；常见搭配：这墙 1、之后 1、泡透 1。","senses":[],"bverse":"到那日，你们什么也就不问我了。我实实在在地告诉你们，你们若向父求什么，他必因我的名赐给你们。","bref":"约翰福音 16:23"},{"no":8295,"w":"抹墙","py":"mò qiáng","pos":"名词","orig":"","freq":4,"verses":3,"vols":1,"chaps":2,"ot":4,"nt":0,"first":"以西结书 13:15","top":[["以西结书",4]],"rest":[0,0],"co":[["泡透",2],["先知",2],["其实",2],["耶和华",2]],"books":{"以西结书":4},"verse":"我要这样向墙和用未泡透灰抹墙的人成就我怒中所定的，并要对你们说：‘墙和抹墙的人都没有了。’","ref":"以西结书 13:15","def":"和合本用词；常见搭配：泡透 2、先知 2、其实 2。","senses":[],"bverse":"这抹墙的就是以色列的先知，他们指著耶路撒冷说预言，为这城见了平安的异象，其实没有平安。这是主耶和华说的。”","bref":"以西结书 13:16"},{"no":8296,"w":"说主","py":"shuō zhǔ","pos":"动词","orig":"","freq":10,"verses":10,"vols":2,"chaps":9,"ot":9,"nt":1,"first":"以西结书 13:18","top":[["以西结书",9],["帖撒罗尼迦（后书）",1]],"rest":[0,0],"co":[["如此",9],["耶和华",9],["人子",3],["预言",2]],"books":{"以西结书":9,"帖撒罗尼迦（后书）":1},"verse":"说主耶和华如此说：罗施、米设、土巴的王歌革啊，我与你为敌。","ref":"以西结书 38:3","def":"和合本用词；常见搭配：如此 9、耶和华 9、人子 3。","senses":[],"bverse":"“人子啊，你为泰尔王作起哀歌，说主耶和华如此说：你无所不备，智慧充足，全然美丽。","bref":"以西结书 28:12"},{"no":8297,"w":"靠枕","py":"kào zhěn","pos":"动词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 13:18","top":[["以西结书",3]],"rest":[0,0],"co":[["膀臂",2],["猎取",2],["如此",2],["性命",2]],"books":{"以西结书":3},"verse":"所以主耶和华如此说：“看哪，我与你们的靠枕反对，就是你们用以猎取人、使人的性命如鸟飞的。我要将靠枕从你们的膀臂上扯去，释放你们猎取如鸟飞的人。","ref":"以西结书 13:20","def":"和合本用词；常见搭配：膀臂 2、猎取 2、如此 2。","senses":[],"bverse":"说主耶和华如此说：‘这些妇女有祸了！她们为众人的膀臂缝靠枕，给高矮之人做下垂的头巾，为要猎取人的性命。难道你们要猎取我百姓的性命，为利己将人救活吗？","bref":"以西结书 13:18"},{"no":8298,"w":"心事","py":"xīn shì","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以西结书 14:5","top":[["以西结书",1],["希伯来书",1]],"rest":[0,0],"co":[["捉住",1],["以色列",1],["假神",1],["生疏",1]],"books":{"以西结书":1,"希伯来书":1},"verse":"好在以色列家的心事上捉住他们，因为他们都借着假神与我生疏。’","ref":"以西结书 14:5","def":"心里所想的事；看法欲将心事寄瑶琴，知音少，弦断有谁听","senses":[["①","心里所想的事","结 14:5","出现 2 次"]],"bverse":"所以我们既得了不能震动的国，就当感恩，照神所喜悦的，用虔诚、敬畏的心事奉神。","bref":"希伯来书 12:28"},{"no":8299,"w":"走迷","py":"zǒu mí","pos":"动词","orig":"","freq":7,"verses":5,"vols":2,"chaps":4,"ot":7,"nt":0,"first":"以西结书 14:11","top":[["以西结书",6],["阿摩司书",1]],"rest":[0,0],"co":[["耶和华",3],["离开",3],["时候",3],["以色列人",3]],"books":{"以西结书":6,"阿摩司书":1},"verse":"“当以色列人走迷的时候，有利未人远离我，就是走迷离开我、随从他们的偶像，他们必担当自己的罪孽。","ref":"以西结书 44:10","def":"和合本用词；常见搭配：耶和华 3、离开 3、时候 3。","senses":[],"bverse":"好使以色列家不再走迷离开我，不再因各样的罪过玷污自己，只要作我的子民，我作他们的神。这是主耶和华说的。”","bref":"以西结书 14:11"},{"no":8300,"w":"连儿","py":"lián ér","pos":"名词","orig":"","freq":4,"verses":4,"vols":1,"chaps":1,"ot":4,"nt":0,"first":"以西结书 14:16","top":[["以西结书",4]],"rest":[0,0],"co":[["其中",4],["起誓",3],["永生",3],["只能",3]],"books":{"以西结书":4},"verse":"虽有这三人在其中，主耶和华说：我指着我的永生起誓，他们连儿带女都不能得救，只能自己得救。","ref":"以西结书 14:18","def":"和合本用词；常见搭配：其中 4、起誓 3、永生 3。","senses":[],"bverse":"虽有这三人在其中，主耶和华说：我指着我的永生起誓，他们连儿带女都不能得救，只能自己得救，那地仍然荒凉。","bref":"以西结书 14:16"}]