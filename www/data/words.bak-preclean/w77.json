[{"no":7601,"w":"必站","py":"bì zhàn","pos":"副词","orig":"","freq":6,"verses":6,"vols":5,"chaps":6,"ot":6,"nt":0,"first":"诗篇 109:31","top":[["但以理书",2],["诗篇",1]],"rest":[3,3],"co":[["面前",2],["原文",2],["右边",1],["脱离",1]],"books":{"但以理书":2,"诗篇":1,"箴言":1,"以西结书":1,"撒迦利亚书":1},"verse":"因为他必站在穷乏人的右边，要救他脱离审判他灵魂的人。","ref":"诗篇 109:31","def":"和合本用词；常见搭配：面前 2、原文 2、右边 1。","senses":[],"bverse":"你看见办事殷勤的人吗？他必站在君王面前，必不站在下贱人面前。","bref":"箴言 22:29"},{"no":7602,"w":"光耀","py":"guāng yào","pos":"名词","orig":"","freq":7,"verses":7,"vols":4,"chaps":6,"ot":7,"nt":0,"first":"诗篇 110:3","top":[["以西结书",3],["但以理书",2]],"rest":[2,2],"co":[["精金",3],["光辉",3],["形状",3],["观看",2]],"books":{"以西结书":3,"但以理书":2,"诗篇":1,"哈巴谷书":1},"verse":"因你的箭射出发光，你的枪闪出光耀，日月都在本宫停住。","ref":"哈巴谷书 3:11","def":"和合本用词；常见搭配：精金 3、光辉 3、形状 3。","senses":[],"bverse":"“王啊，你梦见一个大像，这像甚高，极其光耀，站在你面前，形状甚是可怕。","bref":"但以理书 2:31"},{"no":7603,"w":"公会","py":"gōng huì","pos":"名词","orig":"","freq":25,"verses":25,"vols":6,"chaps":15,"ot":1,"nt":24,"first":"诗篇 111:1","top":[["使徒行传",16],["马太福音",3]],"rest":[4,6],"co":[["祭司",6],["耶稣",5],["保罗",5],["长老",4]],"books":{"使徒行传":16,"马太福音":3,"马可福音":3,"诗篇":1,"路加福音":1,"约翰福音":1},"verse":"公会的人听见就极其恼怒，想要杀他们。","ref":"使徒行传 5:33","def":"犹太最高议会；耶稣在公会前受审。","senses":[["①","同业公会","诗 111:1","出现 25 次"]],"bverse":"于是吩咐他们从公会出去，就彼此商议说：","bref":"使徒行传 4:15"},{"no":7604,"w":"开端","py":"kāi duān","pos":"名词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":4,"nt":2,"first":"诗篇 111:10","top":[["箴言",2],["希伯来书",2]],"rest":[2,2],"co":[["智慧",3],["耶和华",3],["敬畏",3],["赞美",1]],"books":{"箴言":2,"希伯来书":2,"诗篇":1,"传道书":1},"verse":"敬畏耶和华是智慧的开端；认识至圣者便是聪明。","ref":"箴言 9:10","def":"起头；开头良好的","senses":[],"bverse":"敬畏耶和华是知识的开端；愚妄人藐视智慧和训诲。","bref":"箴言 1:7"},{"no":7605,"w":"从今","py":"cóng jīn","pos":"时间词","orig":"","freq":9,"verses":9,"vols":4,"chaps":9,"ot":8,"nt":1,"first":"诗篇 113:2","top":[["诗篇",5],["以赛亚书",2]],"rest":[2,2],"co":[["永远",9],["耶和华",7],["称颂",2],["治理",2]],"books":{"诗篇":5,"以赛亚书":2,"弥迦书":1,"彼得后书":1},"verse":"耶和华的名是应当称颂的，从今时直到永远！","ref":"诗篇 113:2",