人为",1],["律法",1]],"books":{"雅各书":2,"诗篇":1,"何西阿书":1},"verse":"心怀二意的人，在他一切所行的路上都没有定见。","ref":"雅各书 1:8","def":"和合本用词；常见搭配：心怀 4、有罪 2、人为 1。","senses":[],"bverse":"心怀二意的人为我所恨；但你的律法为我所爱。","bref":"诗篇 119:113"},{"no":7625,"w":"发抖","py":"fā dǒu","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 119:120","top":[["诗篇",1],["以西结书",1]],"rest":[1,1],"co":[["惧怕",1],["判语",1],["时刻",1],["战兢",1]],"books":{"诗篇":1,"以西结书":1,"马可福音":1},"verse":"我因惧怕你，肉就发抖；我也怕你的判语。","ref":"诗篇 119:120","def":"和合本用词；常见搭配：惧怕 1、判语 1、时刻 1。","senses":[],"bverse":"她们就出来，从坟墓那里逃跑，又发抖又惊奇，什么也不告诉人，因为她们害怕。","bref":"马可福音 16:8"},{"no":7626,"w":"久已","py":"jiǔ yǐ","pos":"副词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":3,"nt":1,"first":"诗篇 119:152","top":[["诗篇",1],["以赛亚书",1]],"rest":[2,2],"co":[["居住",2],["知道",1],["永远",1],["立定",1]],"books":{"诗篇":1,"以赛亚书":1,"以西结书":1,"路加福音":1},"verse":"我因学你的法度，久已知道是你永远立定的。","ref":"诗篇 119:152","def":"很久以前已经；早就这件事我","senses":[["①","很久以前已经","诗 119:152","出现 4 次"]],"bverse":"希律看见耶稣，就很欢喜；因为听见过他的事，久已想要见他，并且指望看他行一件神迹，","bref":"路加福音 23:8"},{"no":7627,"w":"总纲","py":"zǒng gāng","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 119:160","top":[["诗篇",1],["马太福音",1]],"rest":[0,0],"co":[["公义",1],["永远",1],["长存",1],["典章",1]],"books":{"诗篇":1,"马太福音":1},"verse":"你话的总纲是真实；你一切公义的典章是永远长存。","ref":"诗篇 119:160","def":"犹大纲。引申指政治法度","senses":[],"bverse":"这两条诫命是律法和先知一切道理的总纲。”","bref":"马太福音 22:40"},{"no":7628,"w":"绊脚","py":"bàn jiǎo","pos":"名词","orig":"","freq":7,"verses":7,"vols":4,"chaps":6,"ot":4,"nt":3,"first":"诗篇 119:165","top":[["以赛亚书",3],["罗马书",2]],"rest":[2,2],"co":[["跌人",4],["磐石",3],["石头",3],["网罗",2]],"books":{"以赛亚书":3,"罗马书":2,"诗篇":1,"彼得前书":1},"verse":"许多人必在其上绊脚跌倒，而且跌碎，并陷入网罗，被缠住。”","ref":"以赛亚书 8:15","def":"和合本用词；常见搭配：跌人 4、磐石 3、石头 3。","senses":[],"bverse":"爱你律法的人有大平安，什么都不能使他们绊脚。","bref":"诗篇 119:165"},{"no":7629,"w":"或作","py":"huò zuò","pos":"连词","orig":"","freq":7,"verses":6,"vols":4,"chaps":5,"ot":3,"nt":4,"first":"诗篇 120:1","top":[["罗马书",4],["诗篇",1]],"rest":[2,2],"co":[["耶和华",3],["专一",2],["应允",1],["上行",1]],"books":{"罗马书":4,"诗篇":1,"以赛亚书":1,"耶利米书":1},"verse":"或作执事，就当专一执事；或作教导的，就当专一教导；","ref":"罗马书 12:7","def":"和合本用词；常见搭配：耶和华 3、专一 2、应允 1。","senses":[],"bverse":"（上行（或作登阶，下同）之诗。）我在急难中求告耶和华，他就应允我。","bref":"诗篇 120:1"},{"no":7630,"w":"加给","py":"jiā gěi","pos":"动词","orig":"","freq":7,"verses":7,"vols":5,"chaps":7,"ot":2,"nt":5,"first":"诗篇 120:3","top":[["马太福音",2],["路加福音",2]],"rest":[3,3],"co":[["所有",3],["夺去",2],["有余",2],["诡诈",1]],"books":{"马太福音":2,"路加福音":2,"诗篇":1,"箴言":1,"提摩太（后书）":1},"verse":"凡有的，还要加给他，叫他有余；凡没有的，连他所有的，也要夺去。","ref":"马太福音 13:12","def":"和合本用词；常见搭配：所有 3、夺去 2、有余 2。","senses":[],"bverse":"因为凡有的，还要加给他，叫他有余；没有的，连他所有的也要夺过来。","bref":"马太福音 25:29"},{"no":7631,"w":"打盹","py":"dǎ dǔn","pos":"动词","orig":"","freq":10,"verses":10,"vols":6,"chaps":8,"ot":7,"nt":3,"first":"诗篇 121:3","top":[["诗篇",3],["箴言",3]],"rest":[4,4],"co":[["睡觉",4],["保护",2],["眼睛",2],["片时",2]],"books":{"诗篇":3,"箴言":3,"以赛亚书":1,"马太福音":1,"路加福音":1,"彼得后书":1},"verse":"保护以色列的，也不打盹也不睡觉。","ref":"诗篇 121:4","def":"小睡。多指坐着或靠着断续地入睡","senses":[],"bverse":"他必不叫你的脚摇动；保护你的必不打盹！","bref":"诗篇 121:3"},{"no":7632,"w":"求福","py":"qiú fú","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 122:9","top":[["诗篇",1],["以赛亚书",1]],"rest":[0,0],"co":[["我要",1],["缘故",1],["神殿",1],["耶和华",1]],"books":{"诗篇":1,"以赛亚书":1},"verse":"因耶和华─我们神殿的缘故，我要为你求福！","ref":"诗篇 122:9","def":"和合本用词；常见搭配：我要 1、缘故 1、神殿 1。","senses":[["①","求神赐福","诗 122:9","出现 2 次"]],"bverse":"这样，在地上为自己求福的，必凭真实的神求福；在地上起誓的，必指真实的神起誓。因为，从前的患难已经忘记，也从我眼前隐藏了。","bref":"以赛亚书 65:16"},{"no":7633,"w":"已到","py":"yǐ dào","pos":"副词","orig":"","freq":4,"verses":4,"vols":2,"chaps":2,"ot":4,"nt":0,"first":"诗篇 123:3","top":[["诗篇",2],["以西结书",2]],"rest":[0,0],"co":[["藐视",2],["极处",2],["罪孽",2],["受报",2]],"books":{"诗篇":2,"以西结书":2},"verse":"我们被那些安逸人的讥诮和骄傲人的藐视，已到极处。","ref":"诗篇 123:4","def":"和合本用词；常见搭配：藐视 2、极处 2、罪孽 2。","senses":[],"bverse":"耶和华啊，求你怜悯我们，怜悯我们！因为我们被藐视，已到极处。","bref":"诗篇 123:3"},{"no":7634,"w":"众山","py":