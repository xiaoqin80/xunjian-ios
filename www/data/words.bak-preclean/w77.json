"诗篇 140:5","top":[["路加福音",2],["诗篇",1]],"rest":[1,1],"co":[["西门",2],["骄傲",1],["人为",1],["网罗",1]],"books":{"路加福音":2,"诗篇":1,"约翰福音":1},"verse":"讲完了，对西门说：“把船开到水深之处，下网打鱼。”","ref":"路加福音 5:4","def":"和合本用词；常见搭配：西门 2、骄傲 1、人为 1。","senses":[],"bverse":"西门说：“夫子，我们整夜劳力，并没有打着什么。但依从你的话，我就下网。”","bref":"路加福音 5:5"},{"no":7654,"w":"审问","py":"shěn wèn","pos":"动词","orig":"","freq":19,"verses":17,"vols":8,"chaps":16,"ot":11,"nt":8,"first":"诗篇 143:2","top":[["使徒行传",6],["以西结书",5]],"rest":[6,8],"co":[["耶和华",4],["律法",4],["知道",3],["可憎",3]],"books":{"使徒行传":6,"以西结书":5,"传道书":2,"耶利米书":2,"诗篇":1,"以赛亚书":1,"路加福音":1,"约翰福音":1},"verse":"他们审问了我，就愿意释放我；因为在我身上，并没有该死的罪。","ref":"使徒行传 28:18","def":"详细地问。谓在学问的探究上，深入追求","senses":[["①","详细地问","诗 143:2","出现 19 次"]],"bverse":"连圣殿他也想要污秽；我们把他捉住了。（有古卷加：要按我们的律法审问，","bref":"使徒行传 24:6"},{"no":7655,"w":"凄惨","py":"qī cǎn","pos":"形容词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"诗篇 143:4","top":[["诗篇",1],["以赛亚书",1]],"rest":[1,1],"co":[["发昏",2],["里面",1],["叹息",1],["底亚",1]],"books":{"诗篇":1,"以赛亚书":1,"以西结书":1},"verse":"所以，我的灵在我里面发昏；我的心在我里面凄惨。","ref":"诗篇 143:4","def":"凄凉悲惨凄惨的叫声增加了夜的恐怖","senses":[["①","凄凉悲惨凄惨的叫声增","诗 143:4","出现 3 次"]],"bverse":"令人凄惨的异象已默示于我。诡诈的行诡诈，毁灭的行毁灭。以拦哪，你要上去！米底亚啊，你要围困！主说：我使一切叹息止住。","bref":"以赛亚书 21:2"},{"no":7656,"w":"心神","py":"xīn shén","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 143:7","top":[["诗篇",1],["以赛亚书",1]],"rest":[0,0],"co":[["耗尽",2],["速速",1],["不要",1],["下坑",1]],"books":{"诗篇":1,"以赛亚书":1},"verse":"耶和华啊，求你速速应允我！我心神耗尽！不要向我掩面，免得我像那些下坑的人一样。","ref":"诗篇 143:7","def":"心思精力。语出《庄子．在宥》\"解心释神，莫然无魂。\"","senses":[["①","心思精力","诗 143:7","出现 2 次"]],"bverse":"埃及人的心神必在里面耗尽；我必败坏他们的谋略。他们必求问偶像和念咒的、交鬼的、行巫术的。","bref":"以赛亚书 19:3"},{"no":7657,"w":"起假","py":"qǐ jiǎ","pos":"动词","orig":"","freq":6,"verses":6,"vols":5,"chaps":5,"ot":6,"nt":0,"first":"诗篇 144:8","top":[["诗篇",2],["耶利米书",1]],"rest":[3,3],"co":[["谎话",2],["口说",2],["右手",2],["奸淫",2]],"books":{"诗篇":2,"耶利米书":1,"何西阿书":1,"撒迦利亚书":1,"玛拉基书":1},"verse":"他们的口说谎话；他们的右手起假誓。","ref":"诗篇 144:8","def":"和合本用词；常见搭配：谎话 2、口说 2、右手 2。","senses":[],"bverse":"求你救拔我，救我脱离外邦人的手。他们的口说谎话；他们的右手起假誓。","bref":"诗篇 144:11"},{"no":7658,"w":"害命","py":"hài mìng","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 144:10","top":[["诗篇",1],["马可福音",1]],"rest":[1,1],"co":[["安息日",2],["救命",2],["善行",2],["仆人",1]],"books":{"诗篇":1,"马可福音":1,"路加福音":1},"verse":"你是那拯救君王的；你是那救仆人大卫脱离害命之刀的。","ref":"诗篇 144:10","def":"和合本用词；常见搭配：安息日 2、救命 2、善行 2。","senses":[["①","伤人性命","诗 144:10","出现 3 次"]],"bverse":"耶稣对他们说：“我问你们，在安息日行善行恶，救命害命，哪样是可以的呢？”","bref":"路加福音 6:9"},{"no":7659,"w":"覆庇","py":"fù bì","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 145:9","top":[["诗篇",1],["哥林多后书",1]],"rest":[1,1],"co":[["万民",1],["善待",1],["耶和华",1],["慈悲",1]],"books":{"诗篇":1,"哥林多后书":1,"启示录":1},"verse":"耶和华善待万民；他的慈悲覆庇他一切所造的。","ref":"诗篇 145:9","def":"和合本用词；常见搭配：万民 1、善待 1、耶和华 1。","senses":[["①","覆盖荫庇","诗 145:9","出现 3 次"]],"bverse":"所以，他们在神宝座前，昼夜在他殿中事奉他。坐宝座的要用帐幕覆庇他们。","bref":"启示录 7:15"},{"no":7660,"w":"你国","py":"nǐ guó","pos":"代词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"诗篇 145:11","top":[["诗篇",1],["但以理书",1]],"rest":[1,1],"co":[["传说",1],["荣耀",1],["谈论",1],["大能",1]],"books":{"诗篇":1,"但以理书":1,"那鸿书":1},"verse":"传说你国的荣耀，谈论你的大能，","ref":"诗篇 145:11","def":"和合本用词；常见搭配：传说 1、荣耀 1、谈论 1。","senses":[],"bverse":"讲解是这样：弥尼，就是神已经数算你国的年日到此完毕。","bref":"但以理书 5:26"},{"no":7661,"w":"扶起","py":"fú qǐ","pos":"动词","orig":"","freq":6,"verses":5,"vols":4,"chaps":5,"ot":5,"nt":1,"first":"诗篇 145:14","top":[["诗篇",2],["传道书",2]],"rest":[2,2],"co":[["压下",2],["跌倒",2],["耶和华",2],["他来",2]],"books":{"诗篇":2,"传道书":2,"耶利米书":1,"使徒行传":1},"verse":"凡跌倒的，耶和华将他们扶持；凡被压下的，将他们扶起。","ref":"诗篇 145:14","def":"和合本用词；常见搭配：压下 2、跌倒 2、耶和华 2。","senses":[],"bverse":"耶和华开了瞎子的眼睛；耶和华扶起被压下的人。耶和华喜爱义人。","bref":"诗篇 146:8"},{"no":7662,"w":"打算","py":"dǎ suàn","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"诗篇 146:4","top":[["诗篇",1],["以赛亚书",1]],"r