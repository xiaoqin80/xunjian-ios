,{"no":6310,"w":"人论","py":"rén lùn","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"列王纪下 19:9","top":[["以赛亚书",2],["列王记（下）",1]],"rest":[0,0],"co":[["争战",2],["亚述",2],["使者",2],["吩咐",2]],"books":{"以赛亚书":2,"列王记（下）":1},"verse":"人论我说，公义、能力，惟独在乎耶和华；人都必归向他。凡向他发怒的必至蒙羞。","ref":"以赛亚书 45:24","def":"和合本用词；常见搭配：争战 2、亚述 2、使者 2。","senses":[],"bverse":"亚述王听见人论古实王特哈加说：“他出来要与你争战。”于是亚述王又打发使者去见希西家，吩咐他们说：","bref":"列王纪下 19:9"},{"no":6311,"w":"利色","py":"lì sè","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"列王纪下 19:12","top":[["列王记（下）",1],["以赛亚书",1]],"rest":[0,0],"co":[["拯救",2],["哈兰",2],["拉撒",2],["毁灭",2]],"books":{"列王记（下）":1,"以赛亚书":1},"verse":"我列祖所毁灭的，就是歌散、哈兰、利色，和属提．拉撒的伊甸人，这些国的神何曾拯救这些国呢？","ref":"列王纪下 19:12","def":"和合本用词；常见搭配：拯救 2、哈兰 2、拉撒 2。","senses":[["①","私利与情欲","王下 19:12","出现 2 次"]],"bverse":"我列祖所毁灭的，就是歌散、哈兰、利色，和属提‧拉撒的伊甸人；这些国的神何曾拯救这些国呢？","bref":"以赛亚书 37:12"},{"no":6312,"w":"书信","py":"shū xìn","pos":"名词","orig":"","freq":11,"verses":8,"vols":5,"chaps":8,"ot":6,"nt":5,"first":"列王纪下 19:14","top":[["列王记（下）",3],["以赛亚书",3]],"rest":[3,5],"co":[["希西家",4],["手里",2],["展开",2],["面前",2]],"books":{"列王记（下）":3,"以赛亚书":3,"使徒行传":2,"歌罗西书":2,"帖撒罗尼迦（后书）":1},"verse":"他们既奉了差遣，就下安提阿去，聚集众人，交付书信。","ref":"使徒行传 15:30","def":"和合本用词；常见搭配：希西家 4、手里 2、展开 2。","senses":[],"bverse":"希西家从使者手里接过书信来，看完了，就上耶和华的殿，将书信在耶和华面前展开。","bref":"列王纪下 19:14"},{"no":6313,"w":"展开","py":"zhǎn kāi","pos":"动词","orig":"","freq":27,"verses":25,"vols":10,"chaps":18,"ot":19,"nt":8,"first":"列王纪下 19:14","top":[["启示录",8],["以西结书",5]],"rest":[8,14],"co":[["翅膀",10],["书卷",7],["面前",4],["耶和华",4]],"books":{"启示录":8,"以西结书":5,"以赛亚书":3,"尼希米记":2,"约伯记":2,"雅歌":2,"耶利米书":2,"列王记（下）":1,"诗篇":1,"但以理书":1},"verse":"因为没有配展开、配观看那书卷的，我就大哭。","ref":"启示录 5:4","def":"铺开、张开；诗篇「展开诸天」。","senses":[["①","铺开;张开","王下 19:14","出现 27 次"]],"bverse":"在天上、地上、地底下，没有能展开、能观看那书卷的。","bref":"启示录 5:3"},{"no":6314,"w":"睁眼","py":"zhēng yǎn","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"列王纪下 19:16",