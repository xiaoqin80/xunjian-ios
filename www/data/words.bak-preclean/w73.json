","诗 5:9","出现 12 次"]],"bverse":"能保你远离恶妇，远离外女谄媚的舌头。","bref":"箴言 6:24"},{"no":7285,"w":"护庇","py":"hù bì","pos":"动词","orig":"","freq":6,"verses":5,"vols":5,"chaps":5,"ot":5,"nt":1,"first":"诗篇 5:11","top":[["传道书",2],["诗篇",1]],"rest":[3,3],"co":[["欢欣",1],["时常",1],["欢呼",1],["喜乐",1]],"books":{"传道书":2,"诗篇":1,"箴言":1,"但以理书":1,"使徒行传":1},"verse":"为要保守公平人的路，护庇虔敬人的道。","ref":"箴言 2:8","def":"和合本用词；常见搭配：欢欣 1、时常 1、欢呼 1。","senses":[],"bverse":"他护庇人，搭救人，在天上地下施行神迹奇事，救了但以理脱离狮子的口。”","bref":"但以理书 6:27"},{"no":7286,"w":"每夜","py":"měi yè","pos":"副词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"诗篇 6:6","top":[["诗篇",2],["路加福音",1]],"rest":[0,0],"co":[["褥子",1],["流泪",1],["床榻",1],["困乏",1]],"books":{"诗篇":2,"路加福音":1},"verse":"我因唉哼而困乏；我每夜流泪，把床榻漂起，把褥子湿透。","ref":"诗篇 6:6","def":"和合本用词；常见搭配：褥子 1、流泪 1、床榻 1。","senses":[],"bverse":"耶稣每日在殿里教训人，每夜出城在一座山，名叫橄榄山住宿。","bref":"路加福音 21:37"},{"no":7287,"w":"褥子","py":"rù zi","pos":"名词","orig":"","freq":21,"verses":21,"vols":7,"chaps":9,"ot":2,"nt":19,"first":"诗篇 6:6","top":[["马可福音",5],["约翰福音",5]],"rest":[5,11],"co":[["起来",8],["瘫子",6],["耶稣",5],["躺卧",4]],"books":{"马可福音":5,"约翰福音":5,"路加福音":4,"使徒行传":3,"马太福音":2,"诗篇":1,"耶利米哀歌":1},"verse":"“我吩咐你，起来！拿你的褥子回家去吧。”","ref":"马可福音 2:11","def":"坐卧时的垫具。用棉胎或兽皮等制成","senses":[["①","坐卧时的垫具","诗 6:6","出现 21 次"]],"bverse":"就跑遍那一带地方，听见他在何处，便将有病的人用褥子抬到那里。","bref":"马可福音 6:55"},{"no":7288,"w":"暴怒","py":"bào nù","pos":"动词","orig":"","freq":8,"verses":7,"vols":3,"chaps":7,"ot":8,"nt":0,"first":"诗篇 7:6","top":[["箴言",5],["以赛亚书",2]],"rest":[1,1],"co":[["耶和华",2],["止息",2],["争端",2],["挑启",2]],"books":{"箴言":5,"以赛亚书":2,"诗篇":1},"verse":"暴怒的人挑启争端；忍怒的人止息纷争。","ref":"箴言 15:18","def":"和合本用词；常见搭配：耶和华 2、止息 2、争端 2。","senses":[],"bverse":"好气的人挑启争端；暴怒的人多多犯罪。","bref":"箴言 29:22"},{"no":7289,"w":"磨快","py":"mó kuài","pos":"动词","orig":"","freq":4,"verses":4,"vols":2,"chaps":2,"ot":4,"nt":0,"first":"诗篇 7:12","top":[["以西结书",3],["诗篇",1]],"rest":[0,0],"co":[["擦亮",3],["杀戮",2],["有人",1],["预备",1]],"books":{"以西结书":3,"诗篇":1},"verse":"“人子啊，你要预言。耶和华吩咐我如此说：有刀、有刀，是磨快擦亮的；","ref":"以西结书 21:9","def":"和合本用词；常见搭配：擦亮 3、杀戮 2、有人 1。","senses":[],"bverse":"磨快为要行杀戮，擦亮为要像闪电。我们岂可快乐吗？罚我子的杖藐视各树。","bref":"以西结书 21:10"},{"no":7290,"w":"上弦","py":"shàng xián","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 7:12","top":[["诗篇",1],["撒迦利亚书",1]],"rest":[0,0],"co":[["磨快",1],["有人",1],["预备",1],["妥当",1]],"books":{"诗篇":1,"撒迦利亚书":1},"verse":"若有人不回头，他的刀必磨快，弓必上弦，预备妥当了。","ref":"诗篇 7:12","def":"发生于新月以后的月相。月球在太阳之东90°时，在地球上看到的月球西边的一半。发生在夏历每月初七或初八","senses":[["①","发生于新月以后的月相","诗 7:12","出现 2 次"]],"bverse":"我拿犹大作上弦的弓；我拿以法莲为张弓的箭。锡安哪，我要激发你的众子，攻击希腊（原文是雅完）的众子，使你如勇士的刀。","bref":"撒迦利亚书 9:13"},{"no":7291,"w":"妥当","py":"tuǒ dàng","pos":"形容词","orig":"","freq":8,"verses":8,"vols":5,"chaps":5,"ot":1,"nt":7,"first":"诗篇 7:12","top":[["马太福音",3],["哥林多后书",2]],"rest":[3,3],"co":[["预备",3],["把守",3],["看守",3],["坟墓",2]],"books":{"马太福音":3,"哥林多后书":2,"诗篇":1,"使徒行传":1,"腓立比书":1},"verse":"他们就带着看守的兵同去，封了石头，将坟墓把守妥当。","ref":"马太福音 27:66","def":"和合本用词；常见搭配：预备 3、把守 3、看守 3。","senses":[["①","稳妥适当","诗 7:12","出现 8 次"]],"bverse":"彼拉多说：“你们有看守的兵，去吧！尽你们所能的把守妥当。”","bref":"马太福音 27:65"},{"no":7292,"w":"火箭","py":"huǒ jiàn","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"诗篇 7:13","top":[["诗篇",2],["以弗所书",1]],"rest":[0,0],"co":[["盾牌",2],["器械",1],["杀人",1],["预备",1]],"books":{"诗篇":2,"以弗所书":1},"verse":"他也预备了杀人的器械；他所射的是火箭。","ref":"诗篇 7:13","def":"利用反冲力推进的飞行器，速度很快，用来运载人造卫星、宇宙飞船等，也可以装上弹头制成导弹","senses":[["①","利用反冲力推进的飞行","诗 7:13","出现 3 次"]],"bverse":"他在那里折断弓上的火箭，并盾牌、刀剑，和争战的兵器。（细拉）","bref":"诗篇 76:3"},{"no":7293,"w":"试看","py":"shì kàn","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 7:14","top":[["诗篇",1],["但以理书",1]],"rest":[0,0],"co":[["虚假",1],["奸恶",1],["所生",1],["恶人",1]],"books":{"诗篇":1,"但以理书":1},"verse":"试看恶人因奸恶而劬劳，所怀的是毒害，所生的是虚假。","ref":"诗篇 7:14","def":"试着看看﹔且看","senses":[["①","试着看看﹔且看","诗 7:14","出现 2 次"]],"bverse":"委办便允准他们这件事，试看他们十天。","bref":"但以理书 1:14"},{"no":7294,"w":"落到","py":"luò dào","pos":"动词","orig":"","freq":7,"verses":7,"vols":3,"chaps":7,"ot":4,"nt":3,"first":"诗篇 7:16","top":[["诗篇",4],["马可福音",2]],"rest":[1,1],"co":[["卑微",2],["临到",1],["头上",1],["毒害",1]],"books":{"诗篇":4,"马可福音":2,"启示录":1},"verse":"耶和华保护愚人；我落到卑微的地步，他救了我。","ref":"诗篇 116:6","def":"和合本用词；常见搭配：卑微 2、临到 1、头上 1。","senses":[],"bverse":"他的毒害必临到他自己的头上；他的强暴必落到他自己的脑袋上。","bref":"诗篇 7:16"},{"no":7295,"w":"辨屈","py":"biàn qū","pos":"动词","orig":"","freq":10,"verses":10,"vols":5,"chaps":10,"ot":10,"nt":0,"first":"诗篇 9:4","top":[["诗篇",3],["箴言",3]],"rest":[3,4],"co":[["伸冤",4],["公义",3],["耶和华",3],["救赎",2]],"books":{"诗篇":3,"箴言":3,"以赛亚书":2,"耶利米书":1,"弥迦书":1},"verse":"求你为我辨屈，救赎我，照你的话将我救活。","ref":"诗篇 119:154","def":"和合本用词；常见搭配：伸冤 4、公义 3、耶和华 3。","senses":[],"bverse":"因你已经为我伸冤，为我辨屈；你坐在宝座上，按公义审判。","bref":"诗篇 9:4"},{"no":7296,"w":"美德","py":"měi dé","pos":"名词","orig":"","freq":7,"verses":7,"vols":4,"chaps":7,"ot":5,"nt":2,"first":"诗篇 9:14","top":[["诗篇",3],["以赛亚书",2]],"rest":[2,2],"co":[["述说",3],["耶和华",3],["奇妙",2],["赐给",2]],"books":{"诗篇":3,"以赛亚书":2,"彼得前书":1,"彼得后书":1},"verse":"谁能传说耶和华的大能？谁能表明他一切的美德？","ref":"诗篇 106:2","def":"指高尚的道德行为和优良的道德品质。不同时代和社会有不同的具体内容。古希腊奴隶主把智慧、勇敢、节制与正义这","senses":[["①","指高尚的道德行为和优","诗 9:14","出现 7 次"]],"bverse":"好叫我述说你一切的美德；我必在锡安城（原文是女子）的门因你的救恩欢乐。","bref":"诗篇 9:14"},{"no":7297,"w":"暗设","py":"àn shè","pos":"动词","orig":"","freq":8,"verses":8,"vols":2,"chaps":7,"ot":8,"nt":0,"first":"诗篇 9:15","top":[["诗篇",7],["耶利米书",1]],"rest":[0,0],"co":[["网罗",7],["缠住",2],["人为",2],["挖坑",2]],"books":{"诗篇":7,"耶利米书":1},"verse":"求你救我脱离人为我暗设的网罗，因为你是我的保障。","ref":"诗篇 31:4","def":"和合本用词；常见搭配：网罗 7、缠住 2、人为 2。","senses":[],"bverse":"因他们无故地为我暗设网罗，无故地挖坑，要害我的性命。","bref":"诗篇 35:7"},{"no":7298,"w":"贪财","py":"tān cái","pos":"动词","orig":"","freq":6,"verses":5,"vols":4,"chaps":5,"ot":3,"nt":3,"first":"诗篇 10:3","top":[["诗篇",2],["提摩太（前书）",2]],"rest":[2,2],"co":[["祝福",1],["心愿",1],["背弃",1],["恶人",1]],"books":{"诗篇":2,"提摩太（前书）":2,"箴言":1,"彼得前书":1},"verse":"无知的君多行暴虐；以贪财为可恨的，必年长日久。","ref":"箴言 28:16","def":"和合本用词；常见搭配：祝福 1、心愿 1、背弃 1。","senses":[["①","贪图财货","诗 10:3","出现 6 次"]],"bverse":"不因酒滋事，不打人，只要温和，不争竞，不贪财；","bref":"提摩太前书 3:3"},{"no":7299,"w":"追究","py":"zhuī jiū","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"诗篇 10:4","top":[["诗篇",3]],"rest":[0,0],"co":[["恶人",3],["骄傲",1],["以为",1],["耶和华",1]],"books":{"诗篇":3},"verse":"恶人为何轻慢神，心里说：你必不追究？","ref":"诗篇 10:13","def":"追问根由；事后追查推究原因、责任等追究责任","senses":[["①","追问根由","诗 10:4","出现 3 次"]],"bverse":"愿你打断恶人的膀臂；至于坏人，愿你追究他的恶，直到净尽。","bref":"诗篇 10:15"},{"no":7300,"w":"无倚无靠","py":"wú yǐ wú kào","pos":"","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"诗篇 10:8","top":[["诗篇",3]],"rest":[0,0],"co":[["等候",1],["窥探",1],["隐密",1],["无辜",1]],"books":{"诗篇":3},"verse":"他屈身蹲伏，无倚无靠的人就倒在他爪牙（爪牙：或译强暴人）之下。","ref":"诗篇 10:10","def":"同\"无依无靠\"","senses":[["①","同\"无依无靠\"","诗 10:8","出现 3 次"]],"bverse":"他在村庄埋伏等候；他在隐密处杀害无辜的人。他的眼睛窥探无倚无靠的人；","bref":"诗篇 10:8"}]