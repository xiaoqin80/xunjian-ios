:"路加福音 12:13","def":"和合本用词；常见搭配：军兵 1、阿拉伯人 1、居民 1。","senses":[],"bverse":"耶路撒冷的居民立约兰的小儿子亚哈谢接续他作王；因为跟随阿拉伯人来攻营的军兵曾杀了亚哈谢的众兄长。这样，犹大王约兰的儿子亚哈谢作了王。","bref":"历代志下 22:1"},{"no":6628,"w":"主谋","py":"zhǔ móu","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"历代志下 22:3","top":[["历代志（下）",2]],"rest":[0,0],"co":[["亚哈",2],["行恶",1],["母亲",1],["父亲",1]],"books":{"历代志（下）":2},"verse":"亚哈谢也行亚哈家的道；因为他母亲给他主谋，使他行恶。","ref":"历代志下 22:3","def":"和合本用词；常见搭配：亚哈 2、行恶 1、母亲 1。","senses":[["①","为首策划","代下 22:3","出现 2 次"]],"bverse":"他行耶和华眼中看为恶的事，像亚哈家一样；因他父亲死后有亚哈家的人给他主谋，以致败坏。","bref":"历代志下 22:4"},{"no":6629,"w":"马门","py":"mǎ mén","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"历代志下 23:15","top":[["历代志（下）",1],["尼希米记",1]],"rest":[1,1],"co":[["那里",1],["王宫",1],["闪开",1],["众兵",1]],"books":{"历代志（下）":1,"尼希米记":1,"耶利米书":1},"verse":"众兵就闪开，让她去；她走到王宫的马门，便在那里把她杀了。","ref":"历代志下 23:15","def":"和合本用词；常见搭配：那里 1、王宫 1、闪开 1。","senses":[],"bverse":"从马门往上，众祭司各对自己的房屋修造。","bref":"尼希米记 3:28"},{"no":6630,"w":"捐项","py":"juān xiàng","pos":"动词","orig":"","freq":7,"verses":7,"vols":4,"chaps":4,"ot":2,"nt":5,"first":"历代志下 24:6","top":[["历代志（下）",2],["路加福音",2]],"rest":[2,3],"co":[["耶路撒冷",4],["犹大",2],["仆人",2],["摩西",2]],"books":{"历代志（下）":2,"路加福音":2,"罗马书":2,"使徒行传":1},"verse":"耶稣抬头观看，见财主把捐项投在库里，","ref":"路加福音 21:1","def":"旧指捐官缴纳的款项","senses":[["①","旧指捐官缴纳的款项","代下 24:6","出现 7 次"]],"bverse":"过了几年，我带着赒济本国的捐项和供献的物上去。","bref":"使徒行传 24:17"},{"no":6631,"w":"费用","py":"fèi yòng","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":2,"nt":2,"first":"历代志下 24:6","top":[["路加福音",2],["历代志（下）",1]],"rest":[1,1],"co":[["带来",1],["捐项",1],["犹大",1],["王召",1]],"books":{"路加福音":2,"历代志（下）":1,"尼希米记":1},"verse":"第二天拿出二钱银子来，交给店主，说：‘你且照应他；此外所费用的，我回来必还你。’","ref":"路加福音 10:35","def":"和合本用词；常见搭配：带来 1、捐项 1、犹大 1。","senses":[],"bverse":"王召了大祭司耶何耶大来，对他说：“从前耶和华的仆人摩西，为法柜的帐幕与以色列会众所定的捐项，你为何不叫利未人照这例从犹大和耶路撒冷带来作殿的费用呢？","bref":"历代志下 24:6"},{"no":6632,"w":"通告","py":"tōng gào","pos":"名词","orig":"","freq":4,"verses":