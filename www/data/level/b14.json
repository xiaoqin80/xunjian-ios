的话试问所罗门；跟随她的人甚多，又有骆驼驮著香料、宝石，和许多金子。她来见了所罗门，就把心里所有的对所罗门都说出来。","n":31,"han":1043},{"no":377,"c":10,"first":"罗波安往示剑去，因为以色列人都到了示剑，要立他作王。","n":19,"han":705},{"no":378,"c":11,"first":"罗波安来到耶路撒冷，招聚犹大家和便雅悯家，共十八万人，都是挑选的战士，要与以色列人争战，好将国夺回再归自己。","n":23,"han":671},{"no":379,"c":12,"first":"罗波安的国坚立，他强盛的时候就离弃耶和华的律法，以色列人也都随从他。","n":16,"han":580},{"no":380,"c":13,"first":"耶罗波安王十八年，亚比雅登基作犹大王，","n":22,"han":846},{"no":381,"c":14,"first":"亚比雅与他列祖同睡，葬在大卫城里。他儿子亚撒接续他作王。亚撒年间，国中太平十年。","n":15,"han":533},{"no":382,"c":15,"first":"神的灵感动俄德的儿子亚撒利雅。","n":19,"han":587},{"no":383,"c":16,"first":"亚撒三十六年，以色列王巴沙上来攻击犹大，修筑拉玛，不许人从犹大王亚撒那里出入。","n":14,"han":486},{"no":384,"c":17,"first":"亚撒的儿子约沙法接续他作王，奋勇自强，防备以色列人，","n":19,"han":535},{"no":385,"c":18,"first":"约沙法大有尊荣资财，就与亚哈结亲。","n":34,"han":1212},{"no":386,"c":19,"first":"犹大王约沙法平平安安地回耶路撒冷，到宫里去了。","n":11,"han":450},{"no":387,"c":20,"first":"此后，摩押人和亚扪人，又有米乌尼人，一同来攻击约沙法。","n":37,"han":1371},{"no":388,"c":21,"first":"约沙法与他列祖同睡，葬在大卫城他列祖的坟地里。他儿子约兰接续他作王。","n":20,"han":691},{"no":389,"c":22,"first":"耶路撒冷的居民立约兰的小儿子亚哈谢接续他作王；因为跟随阿拉伯人来攻营的军兵曾杀了亚哈谢的众兄长。这样，犹大王约兰的儿子亚哈谢作了王。","n":12,"han":568},{"no":390,"c":23,"first":"第七年，耶何耶大奋勇自强，将百夫长耶罗罕的儿子亚撒利雅，约哈难的儿子以实玛利，俄备得的儿子亚撒利雅，亚大雅的儿子玛西雅，细基利的儿子以利沙法召来，与他们立约。","n":21,"han":824},{"no":391,"c":24,"first":"约阿施登基的时候年七岁，在耶路撒冷作王四十年。他母亲名叫西比亚，是别是巴人。","n":27,"han":1069},{"no":392,"c":25,"first":"亚玛谢登基的时候年二十五岁，在耶路撒冷作王二十九年。他母亲名叫约耶但，是耶路撒冷人。","n":28,"han":1090},{"no":393,"c":26,"first":"犹大众民立亚玛谢的儿子乌西雅（又名亚撒利雅）接续他父作王，那时他年十六岁。","n":23,"han":817},{"no":394,"c":27,"first":"约坦登基的时候年二十五岁，在耶路撒冷作王十六年，他母亲名叫耶路沙，是撒督的女儿。","n":9,"han":262},{"no":395,"c":28,"first":"亚哈斯登基的时候年二十岁，在耶路撒冷作王十六年；不像他祖大卫行耶和华眼中看为正的事，","n":27,"han":1062},{"no":396,"c":29,"first":"希西家登基的时候年二十五岁，在耶路撒冷作王二十九年。他母亲名叫亚比雅，是撒迦利雅的女儿。","n":36,"han":1256},{"no":397,"c":30,"first":"希西家差遣人去见以色列和犹大众人，又写信给以法莲和玛拿西人，叫他们到耶路撒冷耶和华的殿，向耶和华─以色列的神守逾越节；","n":27,"han":1074},{"no":398,"c":31,"first":"这事既都完毕，在那里的以色列众人就到犹大的城邑，打碎柱像，砍断木偶，又在犹大、便雅悯、以法莲、玛拿西遍地将邱坛和祭坛拆毁净尽。于是以色列众人各回各城，各归各地。","n":21,"han":819},{"no":399,"c":32,"first":"这虔诚的事以后，亚述王西拿基立来侵入犹大，围困一切坚固城，想要攻破占据。","n":33,"han":1253},{"no":400,"c":33,"first":"玛拿西登基的时候年十二岁，在耶路撒冷作王五十五年。","n":25,"han":855},{"no":401,"c":34,"first":"约西亚登基的时候年八岁，在耶路撒冷作王三十一年。","n":33,"han":1290},{"no":402,"c":35,"first":"约西亚在耶路撒冷向耶和华守逾越节。正月十四日，就宰了逾越节的羊羔。","n":27,"han":1105},{"no":403,"c":36,"first":"国民立约西亚的儿子约哈斯在耶路撒冷接续他父作王。","n":23,"han":897}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"王":[[1768,"作王","zuò wáng",208],[4742,"大王","dà wáng",172],[885,"君王","jūn wáng",169],[2561,"王说","wáng shuō",99]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"约":[[1529,"约瑟","yuē sè",307],[2676,"约书亚","yuē shū yà",236],[719,"约旦河","yuē dàn hé",195],[3701,"约柜","yuē guì",180]],"殿":[[1469,"神殿","shén diàn",68],[5914,"这殿","zhè diàn",63],[5918,"殿里","diàn lǐ",53],[5609,"殿宇","diàn yǔ",49]],"犹":[[1507,"犹大","yóu dà",538],[3691,"犹大人","yóu dà rén",234],[8549,"犹太人","yóu tài rén",198],[3171,"犹大支派","yóu dà zhī pài",22]],"祭":[[783,"祭司","jì sī",856],[494,"燔祭","fán jì",299],[3142,"素祭","sù jì",140],[3117,"赎罪祭","shú zuì jì",129]],"西":[[2263,"摩西","mó xī",870],[1951,"玛拿西","mǎ ná xī",157],[6272,"希西家","xī xī jiā",140],[6549,"西门","xī mén",78]],"罗":[[1778,"扫罗","sǎo luó",467],[5585,"所罗门","suǒ luó mén",316],[8950,"保罗","bǎo luó",214],[6026,"耶罗波安","yé luó bō ān",103]],"路":[[4729,"耶路撒冷","yé lù sā lěng",827],[597,"路上","lù shàng",108],[259,"基路伯","jī lù bó",94],[264,"道路","dào lù",81]],"儿":[[312,"儿子","ér zi",2399],[372,"女儿","nǚ ér",297],[230,"儿女","ér nǚ",262],[1153,"我儿","wǒ ér",64]],"门":[[6114,"门徒","mén tú",375],[5585,"所罗门","suǒ luó mén",316],[1170,"城门","chéng mén",85],[913,"门口","mén kǒu",84]],"十":[[907,"十二个","shí èr gè",65],[418,"五十","wǔ shí",61],[1323,"十二","shí èr",56],[8621,"十字架","shí zì jià",54]],"事":[[216,"这事","zhè shì",204],[3629,"行事","xíng shì",