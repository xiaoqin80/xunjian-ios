"freq":205,"here":14},{"no":171,"w":"因此","py":"yīn cǐ","freq":217,"here":14},{"no":1954,"w":"以法莲","py":"yǐ fǎ lián","freq":193,"here":14},{"no":2127,"w":"不致","py":"bù zhì","freq":76,"here":14},{"no":2389,"w":"击打","py":"jī dǎ","freq":62,"here":14},{"no":284,"w":"发怒","py":"fā nù","freq":170,"here":14},{"no":289,"w":"说话","py":"shuō huà","freq":269,"here":14},{"no":374,"w":"女子","py":"nǚ zǐ","freq":231,"here":14},{"no":4267,"w":"悖逆","py":"bèi nì","freq":81,"here":14},{"no":557,"w":"居住","py":"jū zhù","freq":143,"here":14},{"no":885,"w":"君王","py":"jūn wáng","freq":169,"here":14},{"no":2,"w":"创造","py":"chuàng zào","freq":44,"here":13},{"no":1171,"w":"有人","py":"yǒu rén","freq":428,"here":13},{"no":1441,"w":"怒气","py":"nù qì","freq":123,"here":13},{"no":2615,"w":"吞灭","py":"tūn miè","freq":57,"here":13},{"no":2717,"w":"国民","py":"guó mín","freq":90,"here":13},{"no":3439,"w":"人必","py":"rén bì","freq":86,"here":13},{"no":3594,"w":"余剩","py":"yú shèng","freq":41,"here":13},{"no":3754,"w":"远方","py":"yuǎn fāng","freq":41,"here":13},{"no":3812,"w":"蒙羞","py":"méng xiū","freq":66,"here":13},{"no":367,"w":"手中","py":"shǒu zhōng","freq":240,"here":13},{"no":4372,"w":"树林","py":"shù lín","freq":39,"here":13},{"no":4666,"w":"必然","py":"bì rán","freq":64,"here":13},{"no":405,"w":"强暴","py":"qiáng bào","freq":86,"here":13}],"cp":[{"no":680,"c":1,"first":"当乌西雅、约坦、亚哈斯、希西家作犹大王的时候，亚摩斯的儿子以赛亚得默示，论到犹大和耶路撒冷。","n":31,"han":974},{"no":681,"c":2,"first":"亚摩斯的儿子以赛亚得默示，论到犹大和耶路撒冷。","n":22,"han":605},{"no":682,"c":3,"first":"主─万军之耶和华从耶路撒冷和犹大，除掉众人所倚靠的，所仗赖的，就是所倚靠的粮，所仗赖的水；","n":26,"han":643},{"no":683,"c":4,"first":"在那日，七个女人必拉住一个男人，说：“我们吃自己的食物，穿自己的衣服，但求你许我们归你名下；求你除掉我们的羞耻。”","n":6,"han":218},{"no":684,"c":5,"first":"我要为我所亲爱的唱歌，是我所爱者的歌，论他葡萄园的事：我所亲爱的有葡萄园在肥美的山冈上。","n":30,"han":975},{"no":685,"c":6,"first":"当乌西雅王崩的那年，我见主坐在高高的宝座上。他的衣裳垂下，遮满圣殿。","n":13,"han":417},{"no":686,"c":7,"first":"乌西雅的孙子、约坦的儿子、犹大王亚哈斯在位的时候，亚兰王利汛和利玛利的儿子、以色列王比加上来攻打耶路撒冷，却不能攻取。","n":25,"han":772},{"no":687,"c":8,"first":"耶和华对我说：“你取一个大牌，拿人所用的笔（或译：人常用的字），写上‘玛黑珥‧沙拉勒‧哈施‧罢斯’（就是掳掠速临、抢夺快到的意思）。","n":22,"han":718},{"no":688,"c":9,"first":"但那受过痛苦的必不再见幽暗。从前神使西布伦地和拿弗他利地被藐视，末后却使这沿海的路，约旦河外，外邦人的加利利地得着荣耀。","n":21,"han":738},{"no":689,"c":10,"first":"祸哉！那些设立不义之律例的和记录奸诈之判语的，","n":34,"han":1130},{"no":690,"c":11,"first":"从耶西的本（原文是丕）必发一条；从他根生的枝子必结果实。","n":16,"han":539},{"no":691,"c":12,"first":"到那日，你必说：耶和华啊，我要称谢你！因为你虽然向我发怒，你的怒气却已转消；你又安慰了我。","n":6,"han":186},{"no":692,"c":13,"first":"亚摩斯的儿子以赛亚得默示，论巴比伦。","n":22,"han":645},{"no":693,"c":14,"first":"耶和华要怜恤雅各，必再拣选以色列，将他们安置在本地。寄居的必与他们联合，紧贴雅各家。","n":32,"han":999},{"no":694,"c":15,"first":"论摩押的默示：一夜之间，摩押的亚珥变为荒废，归于无有；一夜之间，摩押的基珥变为荒废，归于无有。","n":9,"han":305},{"no":695,"c":16,"first":"你们当将羊羔奉给那地掌权的，从西拉往旷野，送到锡安城（原文是女子）的山。","n":14,"han":529},{"no":696,"c":17,"first":"论大马士革的默示：看哪，大马士革已被废弃，不再为城，必变作乱堆。","n":14,"han":494},{"no":697,"c":18,"first":"唉！古实河外翅膀刷刷响声之地，","n":7,"han":289},{"no":698,"c":19,"first":"论埃及的默示：看哪，耶和华乘驾快云，临到埃及。埃及的偶像在他面前战兢；埃及人的心在里面消化。","n":25,"han":849},{"no":699,"c":20,"first":"亚述王撒珥根打发他珥探到亚实突的那年，他珥探就攻打亚实突，将城攻取。","n":6,"han":217},{"no":700,"c":21,"first":"论海旁旷野的默示：有仇敌从旷野，从可怕之地而来，好像南方的旋风，猛然扫过。","n":17,"han":519},{"no":701,"c":22,"first":"论异象谷的默示：有什么事使你这满城的人都上房顶呢？","n":25,"han":750},{"no":702,"c":23,"first":"论泰尔的默示：他施的船只都要哀号；因为泰尔变为荒场，甚至没有房屋，没有可进之路。这消息是从基提地得来的。","n":18,"han":603},{"no":703,"c":24,"first":"看哪，耶和华使地空虚，变为荒凉；又翻转大地，将居民分散。","n":23,"han":642},{"no":704,"c":25,"first":"耶和华啊，你是我的神；我要尊崇你，我要称赞你的名。因为你以忠信诚实行过奇妙的事，成就你古时所定的。","n":12,"han":445},{"no":705,"c":26,"first":"当那日，在犹大地人必唱这歌说：我们有坚固的城。耶和华要将救恩定为城墙，为外郭。","n":21,"han":661},{"no":706,"c":27,"first":"到那日，耶和华必用他刚硬有力的大刀刑罚鳄鱼─就是那快行的蛇，刑罚鳄鱼─就是那曲行的蛇，并杀海中的大鱼。","n":13,"han":458},{"no":707,"c":28,"first":"祸哉！以法莲的酒徒，住在肥美谷的山上，他们心里高傲，以所夸的为冠冕，犹如将残之花。","n":29,"han":980},{"no":708,"c":29,"first":"唉！亚利伊勒，亚利伊勒，大卫安营的城，任凭你年上加年，节期照常周流。","n":24,"han":813},{"no":709,"c":30,"first":"耶和华说：祸哉！这悖逆的儿女。他们同谋，却不由于我，结盟，却不由于我的灵，以致罪上加罪；","n":33,"han":1176},{"no":710,"c":31,"first":"祸哉！那些下埃及求帮助的，是因仗赖马匹，倚靠甚多的车辆，并倚靠强壮的马兵，却不仰望以色列的圣者，也不求问耶和华。","n":9,"han":384},{"no":711,"c":32,"first":"看哪，必有一王凭公义行政；必有首领藉公平掌权。","n":20,"han":511},{"no":712,"c":33,"first":"祸哉！你这毁灭人的，自己倒不被毁灭；行事诡诈的，人倒不以诡诈待你。你毁灭罢休了，自己必被毁灭；你行完了诡诈，人必以诡诈待你。","n":24,"han":745},{"no":713,"c":34,"first":"列国啊，要近前来听！众民哪，要侧耳而听！地和其上所充满的，世界和其中一切所出的都应当听！","n":17,"han":562},{"no":714,"c":35,"first":"旷野和干旱之地必然欢喜；沙漠也必快乐；又像玫瑰开花，","n":10,"han":331},{"no":715,"c":36,"first":"希西家王十四年，亚述王西拿基立上来攻击犹大的一切坚固城，将城攻取。","n":22,"han":855},{"no":716,"c":37,"first":"希西家王听见就撕裂衣服，披上麻布，进了耶和华的殿，","n":38,"han":1302},{"no":717,"c":38,"first":"那时希西家病得要死，亚摩斯的儿子先知以赛亚去见他，对他说：“耶和华如此说：你当留遗命与你的家，因为你必死不能活了。”","n":22,"han":692},{"no":718,"c":39,"first":"那时，巴比伦王巴拉但的儿子米罗达‧巴拉但听见希西家病而痊愈，就送书信和礼物给他。","n":8,"han":321},{"no":719,"c":40,"first":"你们的神说：你们要安慰，安慰我的百姓。","n":31,"han":983},{"no":720,"c":41,"first":"众海岛啊，当在我面前静默；众民当重新得力，都要近前来才可以说话，我们可以彼此辩论。","n":29,"han":976},{"no":721,"c":42,"first":"看哪，我的仆人─我所扶持所拣选、心里所喜悦的！我已将我的灵赐给他；他必将公理传给外邦。","n":25,"han":812},{"no":722,"c":43,"first":"雅各啊，创造你的耶和华，以色列啊，造成你的那位，现在如此说：你不要害怕！因为我救赎了你。我曾提你的名召你，你是属我的。","n":28,"han":921},{"no":723,"c":44,"first":"我的仆人雅各，我所拣选的以色列啊，现在你当听。","n":28,"han":1065},{"no":724,"c":45,"first":"我─耶和华所膏的塞鲁士；我搀扶他的右手，使列国降伏在他面前。我也要放松列王的腰带，使城门在他面前敞开，不得关闭。我对他如此说：","n":25,"han":967},{"no":725,"c":46,"first":"彼勒屈身，尼波弯腰；巴比伦的偶像驮在兽和牲畜上。他们所抬的如今成了重驮，使牲畜疲乏，","n":13,"han":403},{"no":726,"c":47,"first":"巴比伦的处女啊，下来坐在尘埃；迦勒底的闺女啊，没有宝座，要坐在地上；因为你不再称为柔弱娇嫩的。","n":15,"han":542},{"no":727,"c":48,"first":"雅各家，称为以色列名下，从犹大水源出来的，当听我言！你们指著耶和华的名起誓，提说以色列的神，却不凭诚实，不凭公义。","n":22,"han":778},{"no":728,"c":49,"first":"众海岛啊，当听我言！远方的众民哪，留心而听！自我出胎，耶和华就选召我；自出母腹，他就提我的名。","n":26,"han":1027},{"no":729,"c":50,"first":"耶和华如此说：我休你们的母亲，休书在哪里呢？我将你们卖给我哪一个债主呢？你们被卖，是因你们的罪孽；你们的母亲被休，是因你们的过犯。","n":11,"han":438},{"no":730,"c":51,"first":"你们这追求公义、寻求耶和华的，当听我言！你们要追想被凿而出的磐石，被挖而出的岩穴。","n":23,"han":892},{"no":731,"c":52,"first":"锡安哪，兴起！兴起！披上你的能力！圣城耶路撒冷啊，穿上你华美的衣服！因为从今以后，未受割礼、不洁净的必不再进入你中间。","n":15,"han":535},{"no":732,"c":53,"first":"我们所传的（或译：所传与我们的）有谁信呢？耶和华的膀臂向谁显露呢？","n":12,"han":505},{"no":733,"c":54,"first":"你这不怀孕、不生养的要歌唱；你这未曾经过产难的要发声歌唱，扬声欢呼；因为没有丈夫的比有丈夫的儿女更多。这是耶和华说的。","n":17,"han":610},{"no":734,"c":55,"first":"你们一切干渴的都当就近水来；没有银钱的也可以来。你们都来，买了吃；不用银钱，不用价值，也来买酒和奶。","n":13,"han":490},{"no":735,"c":56,"first":"耶和华如此说：你们当守公平，行公义；因我的救恩临近，我的公义将要显现。","n":12,"han":425},{"no":736,"c":57,"first":"义人死亡，无人放在心上；虔诚人被收去，无人思念。这义人被收去是免了将来的祸患；","n":21,"han":674},{"no":737,"c":58,"first":"你要大声喊叫，不可止息；扬起声来，好像吹角。向我百姓说明他们的过犯；向雅各家说明他们的罪恶。","n":14,"han":643},{"no":738,"c":59,"first":"耶和华的膀臂并非缩短，不能拯救，耳朵并非发沉，不能听见，","n":21,"han":722},{"no":739,"c":60,"first":"兴起，发光！因为你的光已经来到！耶和华的荣耀发现照耀你。","n":22,"han":792},{"no":740,"c":61,"first":"主耶和华的灵在我身上；因为耶和华用膏膏我，叫我传好信息给谦卑的人（或译：传福音给贫穷的人），差遣我医好伤心的人，报告被掳的得释放，被囚的出监牢；","n":11,"han":466},{"no":741,"c":62,"first":"我因锡安必不静默，为耶路撒冷必不息声，直到他的公义如光辉发出，他的救恩如明灯发亮。","n":12,"han":439},{"no":742,"c":63,"first":"这从以东的波斯拉来，穿红衣服，装扮华美，能力广大，大步行走的是谁呢？就是我，是凭公义说话，以大能施行拯救。","n":19,"han":716},{"no":743,"c":64,"first":"愿你裂天而降；愿山在你面前震动─","n":12,"han":364},{"no":744,"c":65,"first":"素来没有访问我的，现在求问我；没有寻找我的，我叫他们遇见；没有称为我名下的，我对他们说：我在这里！我在这里！","n":25,"han":927},{"no":745,"c":66,"first":"耶和华如此说：天是我的座位；地是我的脚凳。你们要为我造何等的殿宇？哪里是我安息的地方呢？","n":24,"han":1035}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"像":[[1874,"好像","hǎo xiàng",358],[2741,"偶像","ǒu xiàng",172],[1563,"神像","shén xiàng",46],[870,"必像","bì xiàng",43]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"如":[[511,"如此","rú cǐ",688],[505,"如同","rú tóng",255],[301,"如今","rú jīn",193],[448,"正如","zhèng rú",154]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"看":[[373,"看见","kàn jiàn",832],[406,"观看","guān kàn",164],[1826,"看为","kàn wèi",118],[142,"看守","kān shǒu",101]],"民":[[1052,"居民","jū mín",247],[1960,"众民","zhòng mín",151],[2174,"万民","wàn mín",118],[2717,"国民","guó mín",90]],"日":[[39,"日子","rì zi",566],[1005,"今日","jīn rì",319],[457,"那日","nà rì",196],[2656,"安息日","ā