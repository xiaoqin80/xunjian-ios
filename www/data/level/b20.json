":13,"first":"智慧子听父亲的教训；亵慢人不听责备。","n":25,"han":462},{"no":642,"c":14,"first":"智慧妇人建立家室；愚妄妇人亲手拆毁。","n":35,"han":655},{"no":643,"c":15,"first":"回答柔和，使怒消退；言语暴戾，触动怒气。","n":33,"han":576},{"no":644,"c":16,"first":"心中的谋算在乎人；舌头的应对由于耶和华。","n":33,"han":611},{"no":645,"c":17,"first":"设筵满屋，大家相争，不如有块干饼，大家相安。","n":28,"han":507},{"no":646,"c":18,"first":"与众寡合的，独自寻求心愿，并恼恨一切真智慧。","n":24,"han":429},{"no":647,"c":19,"first":"行为纯正的贫穷人胜过乖谬愚妄的富足人。","n":29,"han":560},{"no":648,"c":20,"first":"酒能使人亵慢，浓酒使人喧嚷；凡因酒错误的，就无智慧。","n":30,"han":554},{"no":649,"c":21,"first":"王的心在耶和华手中，好像陇沟的水随意流转。","n":31,"han":579},{"no":650,"c":22,"first":"美名胜过大财；恩宠强如金银。","n":29,"han":543},{"no":651,"c":23,"first":"你若与官长坐席，要留意在你面前的是谁。","n":35,"han":657},{"no":652,"c":24,"first":"你不要嫉妒恶人，也不要起意与他们相处；","n":34,"han":675},{"no":653,"c":25,"first":"以下也是所罗门的箴言，是犹大王希西家的人所誊录的。","n":28,"han":562},{"no":654,"c":26,"first":"夏天落雪，收割时下雨，都不相宜；愚昧人得尊荣也是如此。","n":28,"han":553},{"no":655,"c":27,"first":"不要为明日自夸，因为一日要生何事，你尚且不能知道。","n":27,"han":550},{"no":656,"c":28,"first":"恶人虽无人追赶也逃跑；义人却胆壮像狮子。","n":28,"han":545},{"no":657,"c":29,"first":"人屡次受责罚，仍然硬著颈项；他必顷刻败坏，无法可治。","n":27,"han":502},{"no":658,"c":30,"first":"雅基的儿子亚古珥的言语就是真言。这人对以铁和乌甲说：","n":33,"han":673},{"no":659,"c":31,"first":"利慕伊勒王的言语，是他母亲教训他的真言。","n":31,"han":566}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"恶":[[976,"恶人","è rén",302],[387,"罪恶","zuì è",89],[3486,"憎恶","zēng wù",80],[3625,"恨恶","hèn è",80]],"心":[[496,"心里","xīn lǐ",429],[392,"心中","xīn zhōng",143],[8590,"信心","xìn xīn",105],[2632,"留心","liú xīn",52]],"愚":[[1573,"愚昧","yú mèi",117],[4702,"愚妄","yú wàng",49],[5485,"愚顽","yú wán",27],[5717,"愚拙","yú zhuō",19]],"义":[[980,"公义","gōng yì",276],[438,"义人","yì rén",135],[6949,"不义","bú yì",43],[2858,"为义","wèi yì",37]],"明":[[1265,"明白","míng bái",161],[1923,"聪明","cōng míng",105],[1916,"显明","xiǎn míng",70],[7013,"光明","guāng míng",59]],"言":[[622,"言语","yán yǔ",204],[3794,"预言","yù yán",145],[5081,"谎言","huǎng yán"