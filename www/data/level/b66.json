必将","py":"bì jiāng","freq":187,"here":5},{"no":1477,"w":"聚集","py":"jù jí","freq":252,"here":5},{"no":106,"w":"起来","py":"qǐ lái","freq":623,"here":5},{"no":115,"w":"名叫","py":"míng jiào","freq":247,"here":5},{"no":136,"w":"珍珠","py":"zhēn zhū","freq":15,"here":5},{"no":188,"w":"所有","py":"suǒ yǒu","freq":303,"here":5},{"no":1934,"w":"麻衣","py":"má yī","freq":30,"here":5},{"no":1976,"w":"伤害","py":"shāng hài","freq":15,"here":5},{"no":2146,"w":"患难","py":"huàn nàn","freq":86,"here":5},{"no":2301,"w":"尾巴","py":"wěi ba","freq":13,"here":5},{"no":2716,"w":"圣洁","py":"shèng jié","freq":101,"here":5},{"no":2885,"w":"等到","py":"děng dào","freq":71,"here":5},{"no":242,"w":"归于","py":"guī yú","freq":96,"here":5},{"no":3225,"w":"祭坛","py":"jì tán","freq":56,"here":5},{"no":3328,"w":"可憎","py":"kě zēng","freq":121,"here":5},{"no":3688,"w":"忿怒","py":"fèn nù","freq":131,"here":5},{"no":3713,"w":"各族","py":"gè zú","freq":52,"here":5},{"no":3768,"w":"末后","py":"mò hòu","freq":37,"here":5},{"no":3877,"w":"一匹","py":"yì pǐ","freq":12,"here":5},{"no":329,"w":"或译","py":"huò yì","freq":406,"here":5},{"no":5051,"w":"狮子","py":"shī zi","freq":129,"here":5}],"cp":[{"no":1168,"c":1,"first":"耶稣基督的启示，就是神赐给他，叫他将必要快成的事指示他的众仆人。他就差遣使者晓谕他的仆人约翰。","n":20,"han":684},{"no":1169,"c":2,"first":"“你要写信给以弗所教会的使者，说：‘那右手拿着七星、在七个金灯台中间行走的，说：","n":29,"han":1023},{"no":1170,"c":3,"first":"“你要写信给撒狄教会的使者，说：‘那有神的七灵和七星的，说：我知道你的行为，按名你是活的，其实是死的。","n":22,"han":799},{"no":1171,"c":4,"first":"此后，我观看，见天上有门开了。我初次听见好像吹号的声音，对我说：“你上到这里来，我要将以后必成的事指示你。”","n":11,"han":389},{"no":1172,"c":5,"first":"我看见坐宝座的右手中有书卷，里外都写着字，用七印封严了。","n":14,"han":445},{"no":1173,"c":6,"first":"我看见羔羊揭开七印中第一印的时候，就听见四活物中的一个活物，声音如雷，说：“你来！”","n":17,"han":572},{"no":1174,"c":7,"first":"此后，我看见四位天使站在地的四角，执掌地上四方的风，叫风不吹在地上、海上，和树上。","n":17,"han":542},{"no":1175,"c":8,"first":"羔羊揭开第七印的时候，天上寂静约有二刻。","n":13,"han":416},{"no":1176,"c":9,"first":"第五位天使吹号，我就看见一个星从天落到地上，有无底坑的钥匙赐给它。","n":21,"han":605},{"no":1177,"c":10,"first":"我又看见另有一位大力的天使从天降下，披着云彩，头上有虹，脸面像日头，两脚像火柱。","n":11,"han":364},{"no":1178,"c":11,"first":"有一根苇子赐给我，当作量度的杖；且有话说：“起来！将神的殿和祭坛，并在殿中礼拜的人都量一量。","n":19,"han":672},{"no":1179,"c":12,"first":"天上现出大异象来：有一个妇人身披日头，脚踏月亮，头戴十二星的冠冕。","n":18,"han":567},{"no":1180,"c":13,"first":"我又看见一个兽从海中上来，有十角七头，在十角上戴着十个冠冕，七头上有亵渎的名号。","n":18,"han":549},{"no":1181,"c":14,"first":"我又观看，见羔羊站在锡安山，同他又有十四万四千人，都有他的名和他父的名写在额上。","n":20,"han":735},{"no":1182,"c":15,"first":"我又看见在天上有异象，大而且奇，就是七位天使掌管末了的七灾，因为神的大怒在这七灾中发尽了。","n":8,"han":310},{"no":1183,"c":16,"first":"我听见有大声音从殿中出来，向那七位天使说：“你们去，把盛神大怒的七碗倒在地上。”","n":21,"han":628},{"no":1184,"c":17,"first":"拿着七碗的七位天使中，有一位前来对我说：“你到这里来，我将坐在众水上的大淫妇所要受的刑罚指给你看。","n":18,"han":624},{"no":1185,"c":18,"first":"此后，我看见另有一位有大权柄的天使从天降下，地就因他的荣耀发光。","n":24,"han":908},{"no":1186,"c":19,"first":"此后，我听见好像群众在天上大声说：哈利路亚（就是要赞美耶和华的意思）！救恩、荣耀、权能都属乎我们的神！","n":21,"han":712},{"no":1187,"c":20,"first":"我又看见一位天使从天降下，手里拿着无底坑的钥匙和一条大链子。","n":15,"han":569},{"no":1188,"c":21,"first":"我又看见一个新天新地；因为先前的天地已经过去了，海也不再有了。","n":27,"han":837},{"no":1189,"c":22,"first":"天使又指示我在城内街道当中一道生命水的河，明亮如水晶，从神和羔羊的宝座流出来。","n":21,"han":651}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"天":[[35,"天上","tiān shàng",312],[991,"天使","tiān shǐ",181],[22,"天下","tiān xià",67],[3,"天地","tiān dì",49]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"看":[[373,"看见","kàn jiàn",832],[406,"观看","guān kàn",164],[1826,"看为","kàn wèi",118],[142,"看守","kān shǒu",101]],"位":[[935,"一位","yī wèi",118],[4356,"国位","guó wèi",41],[5576,"在位","zài wèi",29],[4899,"座位","zuò wèi",18]],"七":[[1893,"七个","qī gè",82],[1497,"七日","qī rì",69],[2108,"七十","qī shí",43],[442,"七天","qī tiān",42]],"像":[[1874,"好像","hǎo xiàng",358],[2741,"偶像","ǒu xiàng",172],[1563,"神像","shén xiàng",46],[870,"必像","bì xiàng",43]],"声":[[205,"声音","shēng yīn",320],[3763,"大声","dà shēng",91],[3094,"响声","xiǎng shēng",44],[3845,"名声","míng shēng",38]],"宝":[[1931,"宝座","bǎo zuò",113],[2012,"财宝","cái bǎo",53],[2914,"宝石","bǎo sh