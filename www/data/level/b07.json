,"han":559},{"no":222,"c":11,"first":"基列人耶弗他是个大能的勇士，是妓女的儿子。耶弗他是基列所生的。","n":40,"han":1465},{"no":223,"c":12,"first":"以法莲人聚集，到了北方，对耶弗他说：“你去与亚扪人争战，为什么没有招我们同去呢？我们必用火烧你和你的房屋。”","n":15,"han":519},{"no":224,"c":13,"first":"以色列人又行耶和华眼中看为恶的事，耶和华将他们交在非利士人手中四十年。","n":25,"han":881},{"no":225,"c":14,"first":"参孙下到亭拿，在那里看见一个女子，是非利士人的女儿。","n":20,"han":790},{"no":226,"c":15,"first":"过了些日子，到割麦子的时候，参孙带着一只山羊羔去看他的妻，说：“我要进内室见我的妻。”他岳父不容他进去，","n":20,"han":743},{"no":227,"c":16,"first":"参孙到了迦萨，在那里看见一个妓女，就与她亲近。","n":31,"han":1289},{"no":228,"c":17,"first":"以法莲山地有一个人名叫米迦。","n":13,"han":438},{"no":229,"c":18,"first":"那时，以色列中没有王。但支派的人仍是寻地居住；因为到那日子，他们还没有在以色列支派中得地为业。","n":31,"han":1104},{"no":230,"c":19,"first":"当以色列中没有王的时候，有住以法莲山地那边的一个利未人，娶了一个犹大伯利恒的女子为妾。","n":30,"han":1067},{"no":231,"c":20,"first":"于是以色列从但到别是巴，以及住基列地的众人都出来，如同一人，聚集在米斯巴耶和华面前。","n":48,"han":1587},{"no":232,"c":21,"first":"以色列人在米斯巴曾起誓说：“我们都不将女儿给便雅悯人为妻。”","n":25,"han":841}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"基":[[8544,"基督","jī dū",349],[1181,"基列","jī liè",183],[8542,"耶稣基督","yē sū jī dū",143],[259,"基路伯","jī lù bó",94]],"西":[[2263,"摩西","mó xī",870],[1951,"玛拿西","mǎ ná xī",157],[6272,"希西家","xī xī jiā",140],[6549,"西门","xī mén",78]],"比":[[6281,"巴比伦","bā bǐ lún",317],[616,"亚比","yà bǐ",92],[4794,"比亚","bǐ yà",86],[7429,"比喻","bǐ yù",55]],"甸":[[4953,"基甸","jī diān",64],[1297,"米甸","mǐ diān",35],[1776,"米甸人","mǐ diān rén",35],[118,"伊甸","yī diān",13]],"住":[[557,"居住","jū zhù",143],[2427,"不住","bú zhù",61],[1324,"住处","zhù chù",60],[1336,"抓住","zhuā zhù",43]],"手":[[367,"手中","shǒu zhōng",240],[293,"手里","shǒu lǐ",210],[2143,"右手","yòu shǒu",85],[251,"伸手","shēn shǒu",76]],"勒":[[1201,"舍客勒","shě kè lēi",128],[1079,"米勒","mǐ lēi",117],[3816,"迦勒","jiā lēi",73],[6385,"迦勒底人","jiā lēi dǐ rén",73]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469