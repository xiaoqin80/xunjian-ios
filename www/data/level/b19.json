:"穷乏","py":"qióng fá","freq":64,"here":19},{"no":389,"w":"思想","py":"sī xiǎng","freq":54,"here":19},{"no":21,"w":"这样","py":"zhè yàng","freq":893,"here":18},{"no":912,"w":"一同","py":"yī tóng","freq":353,"here":18},{"no":1931,"w":"宝座","py":"bǎo zuò","freq":113,"here":18},{"no":2128,"w":"死亡","py":"sǐ wáng","freq":148,"here":18},{"no":2288,"w":"欺压","py":"qī yā","freq":96,"here":18},{"no":2461,"w":"网罗","py":"wǎng luó","freq":75,"here":18},{"no":4729,"w":"耶路撒冷","py":"yé lù sā lěng","freq":827,"here":18},{"no":503,"w":"惧怕","py":"jù pà","freq":212,"here":18},{"no":695,"w":"平安","py":"píng ān","freq":235,"here":18},{"no":1441,"w":"怒气","py":"nù qì","freq":123,"here":17},{"no":195,"w":"智慧","py":"zhì huì","freq":425,"here":17},{"no":2145,"w":"救赎","py":"jiù shú","freq":79,"here":17},{"no":2601,"w":"发出","py":"fā chū","freq":103,"here":17},{"no":2616,"w":"圣所","py":"shèng suǒ","freq":176,"here":17},{"no":264,"w":"道路","py":"dào lù","freq":81,"here":17},{"no":3625,"w":"恨恶","py":"hèn è","freq":80,"here":17},{"no":3997,"w":"高者","py":"gāo zhě","freq":38,"here":17},{"no":4163,"w":"侧耳","py":"cè ěr","freq":63,"here":17},{"no":5201,"w":"嘴唇","py":"zuǐ chún","freq":44,"here":17},{"no":6,"w":"黑暗","py":"hēi àn","freq":133,"here":16},{"no":1036,"w":"怜恤","py":"lián xù","freq":69,"here":16},{"no":1729,"w":"灵魂","py":"líng hún","freq":60,"here":16}],"cp":[{"no":479,"c":1,"first":"不从恶人的计谋，不站罪人的道路，不坐亵慢人的座位，","n":6,"han":136},{"no":480,"c":2,"first":"外邦为什么争闹？万民为什么谋算虚妄的事？","n":12,"han":262},{"no":481,"c":3,"first":"（大卫逃避他儿子押沙龙的时候作的诗。）耶和华啊，我的敌人何其加增；有许多人起来攻击我。","n":8,"han":192},{"no":482,"c":4,"first":"（大卫的诗，交与伶长。用丝弦的乐器。）显我为义的神啊，我呼吁的时候，求你应允我！我在困苦中，你曾使我宽广；现在求你怜恤我，听我的祷告！","n":8,"han":234},{"no":483,"c":5,"first":"（大卫的诗，交与伶长。用吹的乐器。）耶和华啊，求你留心听我的言语，顾念我的心思！","n":12,"han":356},{"no":484,"c":6,"first":"（大卫的诗，交与伶长。用丝弦的乐器，调用第八。）耶和华啊，求你不要在怒中责备我，也不要在烈怒中惩罚我！","n":10,"han":241},{"no":485,"c":7,"first":"（大卫指著便雅悯人古实的话，向耶和华唱的流离歌。）耶和华─我的神啊，我投靠你！求你救我脱离一切追赶我的人，将我救拔出来！","n":17,"han":423},{"no":486,"c":8,"first":"（大卫的诗，交与伶长。用迦特乐器。）耶和华─我们的主啊，你的名在全地何其美！你将你的荣耀彰显于天。","n":9,"han":198},{"no":487,"c":9,"first":"（大卫的诗，交与伶长。调用慕拉便。）我要一心称谢耶和华；我要传扬你一切奇妙的作为。","n":20,"han":522},{"no":488,"c":10,"first":"耶和华啊，你为什么站在远处？在患难的时候为什么隐藏？","n":18,"han":475},{"no":489,"c":11,"first":"（大卫的诗，交与伶长。）我是投靠耶和华；你们怎么对我说：你当像鸟飞往你的山去。","n":7,"han":164},{"no":490,"c":12,"first":"（大卫的诗，交与伶长。调用第八。）耶和华啊，求你帮助，因虔诚人断绝了；世人中间的忠信人没有了。","n":8,"han":214},{"no":491,"c":13,"first":"（大卫的诗，交与伶长。）耶和华啊，你忘记我要到几时呢？要到永远吗？你掩面不顾我要到几时呢？","n":6,"han":152},{"no":492,"c":14,"first":"（大卫的诗，交与伶长。）愚顽人心里说：没有神。他们都是邪恶，行了可憎恶的事；没有一个人行善。","n":7,"han":198},{"no":493,"c":15,"first":"（大卫的诗。）耶和华啊，谁能寄居你的帐幕？谁能住在你的圣山？","n":5,"han":119},{"no":494,"c":16,"first":"（大卫的金诗。）神啊，求你保佑我，因为我投靠你。","n":11,"han":285},{"no":495,"c":17,"first":"（大卫的祈祷。）耶和华啊，求你听闻公义，侧耳听我的呼吁！求你留心听我这不出于诡诈嘴唇的祈祷！","n":15,"han":431},{"no":496,"c":18,"first":"（耶和华的仆人大卫的诗，交与伶长。当耶和华救他脱离一切仇敌和扫罗之手的日子，他向耶和华念这诗的话。说：）耶和华，我的力量啊，我爱你！","n":50,"han":1186},{"no":497,"c":19,"first":"（大卫的诗，交与伶长。）诸天述说神的荣耀；穹苍传扬他的手段。","n":14,"han":335},{"no":498,"c":20,"first":"（大卫的诗，交与伶长。）愿耶和华在你遭难的日子应允你；愿名为雅各神的高举你。","n":9,"han":205},{"no":499,"c":21,"first":"（大卫的诗，交与伶长。）耶和华啊，王必因你的能力欢喜；因你的救恩，他的快乐何其大！","n":13,"han":318},{"no":500,"c":22,"first":"（大卫的诗，交与伶长。调用朝鹿。）我的神，我的神！为什么离弃我？为什么远离不救我？不听我唉哼的言语？","n":31,"han":740},{"no":501,"c":23,"first":"（大卫的诗。）耶和华是我的牧者，我必不致缺乏。","n":6,"han":145},{"no":502,"c":24,"first":"（大卫的诗。）地和其中所充满的，世界和住在其间的，都属耶和华。","n":10,"han":223},{"no":503,"c":25,"first":"（大卫的诗。）耶和华啊，我的心仰望你。","n":22,"han":467},{"no":504,"c":26,"first":"（大卫的诗。）耶和华啊，求你为我伸冤，因我向来行事纯全；我又倚靠耶和华，并不摇动。","n":12,"han":245},{"no":505,"c":27,"first":"（大卫的诗。）耶和华是我的亮光，是我的拯救，我还怕谁呢？耶和华是我性命的保障（或译：力量），我还惧谁呢？","n":14,"han":423},{"no":506,"c":28,"first":"（大卫的诗。）耶和华啊，我要求告你！我的磐石啊，不要向我缄默！倘若你向我闭口，我就如将死的人一样。","n":9,"han":277},{"no":507,"c":29,"first":"（大卫的诗。）神的众子啊，你们要将荣耀、能力归给耶和华，归给耶和华！","n":11,"han":263},{"no":508,"c":30,"first":"（大卫在献殿的时候，作这诗歌。）耶和华啊，我要尊崇你，因为你曾提拔我，不叫仇敌向我夸耀。","n":12,"han":299},{"no":509,"c":31,"first":"（大卫的诗，交与伶长。）耶和华啊，我投靠你；求你使我永不羞愧；凭你的公义搭救我！","n":24,"han":680},{"no":510,"c":32,"first":"（大卫的训诲诗。）得赦免其过、遮盖其罪的，这人是有福的！","n":11,"han":290},{"no":511,"c":33,"first":"义人哪，你们应当靠耶和华欢乐；正直人的赞美是合宜的。","n":22,"han":422},{"no":512,"c":34,"first":"（大卫在亚比米勒面前装疯，被他赶出去，就作这诗。）我要时时称颂耶和华；赞美他的话必常在我口中。","n":22,"han":446},{"no":513,"c":35,"first":"（大卫的诗。）耶和华啊，与我相争的，求你与他们相争！与我相战的，求你与他们相战！","n":28,"han":724},{"no":514,"c":36,"first":"（耶和华的仆人大卫的诗，交与伶长。）恶人的罪过在他心里说：我眼中不怕神！","n":12,"han":273},{"no":515,"c":37,"first":"（大卫的诗。）不要为作恶的心怀不平，也不要向那行不义的生出嫉妒。","n":40,"han":860},{"no":516,"c":38,"first":"（大卫的记念诗。）耶和华啊，求你不要在怒中责备我，不要在烈怒中惩罚我！","n":22,"han":401},{"no":517,"c":39,"first":"（大卫的诗，交与伶长耶杜顿。）我曾说：我要谨慎我的言行，免得我舌头犯罪；恶人在我面前的时候，我要用嚼环勒住我的口。","n":13,"han":380},{"no":518,"c":40,"first":"（大卫的诗，交与伶长。）我曾耐性等候耶和华；他垂听我的呼求。","n":17,"han":494},{"no":519,"c":41,"first":"（大卫的诗，交与伶长。）眷顾贫穷的有福了！他遭难的日子，耶和华必搭救他。","n":13,"han":294},{"no":520,"c":42,"first":"（可拉后裔的训诲诗，交与伶长。）神啊，我的心切慕你，如鹿切慕溪水。","n":11,"han":328},{"no":521,"c":43,"first":"神啊，求你伸我的冤，向不虔诚的国为我辨屈；求你救我脱离诡诈不义的人。","n":5,"han":162},{"no":522,"c":44,"first":"（可拉后裔的训诲诗，交与伶长。）神啊，你在古时，我们列祖的日子所行的事，我们亲耳听见了；我们的列祖也给我们述说过。","n":26,"han":592},{"no":523,"c":45,"first":"（可拉后裔的训诲诗，又是爱慕歌，交与伶长。调用百合花。）我心里涌出美辞；我论到我为王做的事，我的舌头是快手笔。","n":17,"han":422},{"no":524,"c":46,"first":"（可拉后裔的诗歌，交与伶长。调用女音。）神是我们的避难所，是我们的力量，是我们在患难中随时的帮助。","n":11,"han":254},{"no":525,"c":47,"first":"（可拉后裔的诗，交与伶长。）万民哪，你们都要拍掌！要用夸胜的声音向神呼喊！","n":9,"han":192},{"no":526,"c":48,"first":"（可拉后裔的诗歌。）耶和华本为大！在我们神的城中，在他的圣山上，该受大赞美。","n":14,"han":292},{"no":527,"c":49,"first":"（可拉后裔的诗，交与伶长。）万民哪，你们都当听这话！世上一切的居民，","n":20,"han":438},{"no":528,"c":50,"first":"（亚萨的诗。）大能者神─耶和华已经发言招呼天下，从日出之地到日落之处。","n":23,"han":498},{"no":529,"c":51,"first":"（大卫与拔示巴同室以后，先知拿单来见他；他作这诗，交与伶长。）神啊，求你按你的慈爱怜恤我！按你丰盛的慈悲涂抹我的过犯！","n":19,"han":471},{"no":530,"c":52,"first":"（以东人多益来告诉扫罗说：大卫到了亚希米勒家。那时，大卫作这训诲诗，交与伶长。）勇士啊，你为何以作恶自夸？神的慈爱是常存的。","n":9,"han":242},{"no":531,"c":53,"first":"（大卫的训诲诗，交与伶长。调用麻哈拉。）愚顽人心里说：没有神。他们都是邪恶，行了可憎恶的罪孽；没有一个人行善。","n":6,"han":201},{"no":532,"c":54,"first":"（西弗人来对扫罗说：大卫岂不是在我们那里藏身吗？那时，大卫作这训诲诗，交与伶长。用丝弦的乐器。）神啊，求你以你的名救我，凭你的大能为我伸冤。","n":7,"han":189},{"no":533,"c":55,"first":"（大卫的训诲诗，交与伶长。用丝弦的乐器。）神啊，求你留心听我的祷告，不要隐藏不听我的恳求！","n":23,"han":534},{"no":534,"c":56,"first":"（非利士人在迦特拿住大卫。那时，他作这金诗，交与伶长。调用远方无声鸽。）神啊，求你怜悯我，因为人要把我吞了，终日攻击欺压我。","n":13,"han":332},{"no":535,"c":57,"first":"（大卫逃避扫罗，藏在洞里。那时，他作这金诗，交与伶长。调用休要毁坏。）神啊，求你怜悯我，怜悯我！因为我的心投靠你。我要投靠在你翅膀的荫下，等到灾害过去。","n":11,"han":304},{"no":536,"c":58,"first":"（大卫的金诗，交与伶长。调用休要毁坏。）世人哪，你们默然不语，真合公义吗？施行审判，岂按正直吗？","n":11,"han":269},{"no":537,"c":59,"first":"（扫罗打发人窥探大卫的房屋，要杀他。那时，大卫作这金诗，交与伶长。调用休要毁坏。）我的神啊，求你救我脱离仇敌，把我安置在高处，得脱那些起来攻击我的人。","n":17,"han":480},{"no":538,"c":60,"first":"（大卫与两河间的亚兰并琐巴的亚兰争战的时候，约押转回，在盐谷攻击以东，杀了一万二千人。那时，大卫作这金诗叫人学习，交与伶长。调用为证的百合花。）神啊，你丢弃了我们，使我们破败；你向我们发怒，求你使我们复兴！","n":12,"han":344},{"no":539,"c":61,"first":"（大卫的诗，交与伶长。用丝弦的乐器。）神啊，求你听我的呼求，侧耳听我的祷告！","n":8,"han":190},{"no":540,"c":62,"first":"（大卫的诗，照耶杜顿的作法，交与伶长。）我的心默默无声，专等候神；我的救恩是从他而来。","n":12,"han":324},{"no":541,"c":63,"first":"（大卫在犹大旷野的时候，作了这诗。）神啊，你是我的神，我要切切地寻求你，在干旱疲乏无水之地，我渴想你；我的心切慕你。","n":11,"han":243},{"no":542,"c":64,"first":"（大卫的诗，交与伶长。）神啊，我哀叹的时候，求你听我的声音！求你保护我的性命，不受仇敌的惊恐！","n":10,"han":235},{"no":543,"c":65,"first":"（大卫的诗歌，交与伶长。）神啊，锡安的人都等候赞美你；所许的愿也要向你偿还。","n":13,"han":319},{"no":544,"c":66,"first":"（一篇诗歌，交与伶长。）全地都当向神欢呼！","n":20,"han":407},{"no":545,"c":67,"first":"（一篇诗歌，交与伶长。用丝弦的乐器。）愿神怜悯我们，赐福与我们，用脸光照我们，（细拉）","n":7,"han":145},{"no":546,"c":68,"first":"（大卫的诗歌，交与伶长。）愿神兴起，使他的仇敌四散，叫那恨他的人从他面前逃跑。","n":35,"han":868},{"no":547,"c":69,"first":"（大卫的诗，交与伶长。调用百合花。）神啊，求你救我！因为众水要淹没我。","n":36,"han":861},{"no":548,"c":70,"first":"（大卫的记念诗，交与伶长。）神啊，求你快快搭救我！耶和华啊，求你速速帮助我！","n":5,"han":139},{"no":549,"c":71,"first":"耶和华啊，我投靠你；求你叫我永不羞愧！","n":24,"han":552},{"no":550,"c":72,"first":"（所罗门的诗。）神啊，求你将判断的权柄赐给王，将公义赐给王的儿子。","n":20,"han":449},{"no":551,"c":73,"first":"（亚萨的诗。）神实在恩待以色列那些清心的人！","n":28,"han":540},{"no":552,"c":74,"first":"（亚萨的训诲诗。）神啊，你为何永远丢弃我们呢？你为何向你草场的羊发怒，如烟冒出呢？","n":23,"han":546},{"no":553,"c":75,"first":"（亚萨的诗歌，交与伶长。调用休要毁坏。）神啊，我们称谢你，我们称谢你！因为你的名相近，人都述说你奇妙的作为。","n":10,"han":230},{"no":554,"c":76,"first":"（亚萨的诗歌，交与伶长。用丝弦的乐器。）在犹大，神为人所认识；在以色列，他的名为大。","n":12,"han":265},{"no":555,"c":77,"first":"（亚萨的诗，照耶杜顿的作法，交与伶长。）我要向神发声呼求；我向神发声，他必留心听我。","n":20,"han":405},{"no":556,"c":78,"first":"（亚萨的训诲诗。）我的民哪，你们要留心听我的训诲，侧耳听我口中的话。","n":72,"han":1521},{"no":557,"c":79,"first":"（亚萨的诗。）神啊，外邦人进入你的产业，污秽你的圣殿，使耶路撒冷变成荒堆，","n":13,"han":366},{"no":558,"c":80,"first":"（亚萨的诗，交与伶长。调用为证的百合花。）领约瑟如领羊群之以色列的牧者啊，求你留心听！坐在二基路伯上的啊，求你发出光来！","n":19,"han":442},{"no":559,"c":81,"first":"（亚萨的诗，交与伶长。用迦特乐器。）你们当向神─我们的力量大声欢呼，向雅各的神发声欢乐！","n":16,"han":360},{"no":560,"c":82,"first":"（亚萨的诗。）神站在有权力者的会中，在诸神中行审判，","n":8,"han":169},{"no":561,"c":83,"first":"（亚萨的诗歌。）神啊，求你不要静默！神啊，求你不要闭口，也不要不作声！","n":18,"han":370},{"no":562,"c":84,"first":"（可拉后裔的诗，交与伶长。用迦特乐器。）万军之耶和华啊，你的居所何等可爱！","n":12,"han":320},{"no":563,"c":85,"first":"（可拉后裔的诗，交与伶长。）耶和华啊，你已经向你的地施恩，救回被掳的雅各。","n":13,"han":293},{"no":564,"c":86,"first":"（大卫的祈祷。）耶和华啊，求你侧耳应允我，因我是困苦穷乏的。","n":17,"han":409},{"no":565,"c":87,"first":"（可拉后裔的诗歌。）耶和华所立的根基在圣山上。","n":7,"han":161},{"no":566,"c":88,"first":"（可拉后裔的诗歌，就是以斯拉人希幔的训诲诗，交与伶长。调用麻哈拉利暗俄。）耶和华─拯救我的神啊，我昼夜在你面前呼吁。","n":18,"han":421},{"no":567,"c":89,"first":"（以斯拉人以探的训诲诗。）我要歌唱耶和华的慈爱，直到永远；我要用口将你的信实传与万代。","n":52,"han":1153},{"no":568,"c":90,"first":"（神人摩西的祈祷）主啊，你世世代代作我们的居所。","n":17,"han":411},{"no":569,"c":91,"first":"住在至高者隐密处的，必住在全能者的荫下。","n":16,"han":347},{"no":570,"c":92,"first":"（安息日的诗歌。）称谢耶和华！歌颂你至高者的名！","n":15,"han":300},{"no":571,"c":93,"first":"耶和华作王！他以威严为衣穿上；耶和华以能力为衣，以能力束腰，世界就坚定，不得动摇。","n":5,"han":110},{"no":572,"c":94,"first":"耶和华啊，你是伸冤的神；伸冤的神啊，求你发出光来！","n":23,"han":480},{"no":573,"c":95,"first":"来啊，我们要向耶和华歌唱，向拯救我们的磐石欢呼！","n":11,"han":226},{"no":574,"c":96,"first":"你们要向耶和华唱新歌！全地都要向耶和华歌唱！","n":13,"han":303},{"no":575,"c":97,"first":"耶和华作王！愿地快乐！愿众海岛欢喜！","n":12,"han":255},{"no":576,"c":98,"first":"（一篇诗。）你们要向耶和华唱新歌！因为他行过奇妙的事；他的右手和圣臂施行救恩。","n":9,"han":204},{"no":577,"c":99,"first":"耶和华作王；万民当战抖！他坐在二基路伯上，地当动摇。","n":9,"han":227},{"no":578,"c":100,"first":"（称谢诗。）普天下当向耶和华欢呼！","n":5,"han":112},{"no":579,"c":101,"first":"（大卫的诗）。我要歌唱慈爱和公平；耶和华啊，我要向你歌颂！","n":8,"han":217},{"no":580,"c":102,"first":"（困苦人发昏的时候，在耶和华面前吐露苦情的祷告。）耶和华啊，求你听我的祷告，容我的呼求达到你面前！","n":28,"han":580},{"no":581,"c":103,"first":"（大卫的诗。）我的心哪，你要称颂耶和华！凡在我里面的，也要称颂他的圣名！","n":22,"han":483},{"no":582,"c":104,"first":"我的心哪，你要称颂耶和华！耶和华─我的神啊，你为至大！你以尊荣威严为衣服，","n":35,"han":678},{"no":583,"c":105,"first":"你们要称谢耶和华，求告他的名，在万民中传扬他的作为！","n":45,"han":859},{"no":584,"c":106,"first":"你们要赞美耶和华！要称谢耶和华，因他本为善；他的慈爱永远长存！","n":48,"han":988},{"no":585,"c":107,"first":"你们要称谢耶和华，因他本为善；他的慈爱永远长存！","n":43,"han":833},{"no":586,"c":108,"first":"（大卫的诗歌。）神啊，我心坚定；我口（原文是荣耀）要唱诗歌颂！","n":13,"han":283},{"no":587,"c":109,"first":"（大卫的诗，交与伶长。）我所赞美的神啊，求你不要闭口不言。","n":31,"han":639},{"no":588,"c":110,"first":"（大卫的诗。）耶和华对我主说：你坐在我的右边，等我使你仇敌作你的脚凳。","n":7,"han":208},{"no":589,"c":111,"first":"你们要赞美耶和华！我要在正直人的大会中，并公会中，一心称谢耶和华。","n":10,"han":215},{"no":590,"c":112,"first":"你们要赞美耶和华！敬畏耶和华，甚喜爱他命令的，这人便为有福！","n":10,"han":213},{"no":591,"c":113,"first":"你们要赞美耶和华！耶和华的仆人哪，你们要赞美，赞美耶和华的名！","n":9,"han":176},{"no":592,"c":114,"first":"以色列出了埃及，雅各家离开说异言之民；","n":8,"han":137},{"no":593,"c":115,"first":"耶和华啊，荣耀不要归与我们，不要归与我们；要因你的慈爱和诚实归在你的名下！","n":18,"han":353},{"no":594,"c":116,"first":"我爱耶和华，因为他听了我的声音和我的恳求。","n":19,"han":359},{"no":595,"c":117,"first":"万国啊，你们都当赞美耶和华！万民哪，你们都当颂赞他！","n":2,"han":50},{"no":596,"c":118,"first":"你们要称谢耶和华，因他本为善；他的慈爱永远长存！","n":29,"han":559},{"no":597,"c":119,"first":"行为完全、遵行耶和华律法的，这人便为有福！","n":176,"han":3304},{"no":598,"c":120,"first":"（上行（或作登阶，下同）之诗。）我在急难中求告耶和华，他就应允我。","n":7,"han":129},{"no":599,"c":121,"first":"（上行之诗。）我要向山举目；我的帮助从何而来？","n":8,"han":137},{"no":600,"c":122,"first":"（大卫上行之诗。）人对我说：我们往耶和华的殿去，我就欢喜。","n":9,"han":186},{"no":601,"c":123,"first":"（上行之诗。）坐在天上的主啊，我向你举目。","n":4,"han":112},{"no":602,"c":124,"first":"（大卫上行之诗。）以色列人要说：若不是耶和华帮助我们，","n":8,"han":155},{"no":603,"c":125,"first":"（上行之诗。）倚靠耶和华的人好像锡安山，永不动摇。","n":5,"han":125},{"no":604,"c":126,"first":"（上行之诗。）当耶和华将那些被掳的带回锡安的时候，我们好像做梦的人。","n":6,"han":130},{"no":605,"c":127,"first":"（所罗门上行之诗。）若不是耶和华建造房屋，建造的人就枉然劳力；若不是耶和华看守城池，看守的人就枉然警醒。","n":5,"han":150},{"no":606,"c":128,"first":"（上行之诗。）凡敬畏耶和华、遵行他道的人便为有福！","n":6,"han":128},{"no":607,"c":129,"first":"（上行之诗。）以色列当说：从我幼年以来，敌人屡次苦害我，","n":8,"han":147},{"no":608,"c":130,"first":"（上行之诗。）耶和华啊，我从深处向你求告！","n":8,"han":145},{"no":609,"c":131,"first":"（大卫上行之诗。）耶和华啊，我的心不狂傲，我的眼不高大；重大和测不透的事，我也不敢行。","n":3,"han":90},{"no":610,"c":132,"first":"（上行之诗。）耶和华啊，求你记念大卫所受的一切苦难！","n":18,"han":375},{"no":611,"c":133,"first":"（大卫上行之诗。）看哪，弟兄和睦同居是何等地善，何等地美！","n":3,"han":83},{"no":612,"c":134,"first":"（上行之诗。）耶和华的仆人夜间站在耶和华殿中的，你们当称颂耶和华！","n":3,"han":57},{"no":613,"c":135,"first":"你们要赞美耶和华！你们要赞美耶和华的名！耶和华的仆人站在耶和华殿中；站在我们神殿院中的，你们要赞美他！","n":21,"han":436},{"no":614,"c":136,"first":"你们要称谢耶和华，因他本为善；他的慈爱永远长存。","n":26,"han":499},{"no":615,"c":137,"first":"我们曾在巴比伦的河边坐下，一追想锡安就哭了。","n":9,"han":213},{"no":616,"c":138,"first":"（大卫的诗。）我要一心称谢你，在诸神面前歌颂你。","n":8,"han":223},{"no":617,"c":139,"first":"（大卫的诗，交与伶长。）耶和华啊，你已经鉴察我，认识我。","n":24,"han":533},{"no":618,"c":140,"first":"（大卫的诗，交与伶长。）耶和华啊，求你拯救我脱离凶恶的人，保护我脱离强暴的人！","n":13,"han":325},{"no":619,"c":141,"first":"（大卫的诗。）耶和华啊，我曾求告你，求你快快临到我这里！我求告你的时候，愿你留心听我的声音！","n":10,"han":265},{"no":620,"c":142,"first":"（大卫在洞里作的训诲诗，乃是祈祷。）我发声哀告耶和华，发声恳求耶和华。","n":7,"han":205},{"no":621,"c":143,"first":"（大卫的诗。）耶和华啊，求你听我的祷告，留心听我的恳求，凭你的信实和公义应允我。","n":12,"han":330},{"no":622,"c":144,"first":"（大卫的诗。）耶和华─我的磐石是应当称颂的！他教导我的手争战，教导我的指头打仗。","n":15,"han":388},{"no":623,"c":145,"first":"（大卫的赞美诗。）我的神我的王啊，我要尊崇你！我要永永远远称颂你的名！","n":21,"han":432},{"no":624,"c":146,"first":"你们要赞美耶和华！我的心哪，你要赞美耶和华！","n":10,"han":229},{"no":625,"c":147,"first":"你们要赞美耶和华！因歌颂我们的神为善为美；赞美的话是合宜的。","n":20,"han":361},{"no":626,"c":148,"first":"你们要赞美耶和华！从天上赞美耶和华，在高处赞美他！","n":14,"han":291},{"no":627,"c":149,"first":"你们要赞美耶和华！向耶和华唱新歌，在圣民的会中赞美他！","n":9,"han":184},{"no":628,"c":150,"first":"你们要赞美耶和华！在神的圣所赞美他！在他显能力的穹苍赞美他！","n":6,"han":120}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[