:14,"c":14,"first":"当暗拉非作示拿王，亚略作以拉撒王，基大老玛作以拦王，提达作戈印王的时候，","n":24,"han":779},{"no":15,"c":15,"first":"这事以后，耶和华在异象中有话对亚伯兰说：“亚伯兰，你不要惧怕！我是你的盾牌，必大大地赏赐你。”","n":21,"han":587},{"no":16,"c":16,"first":"亚伯兰的妻子撒莱不给他生儿女。撒莱有一个使女，名叫夏甲，是埃及人。","n":16,"han":507},{"no":17,"c":17,"first":"亚伯兰年九十九岁的时候，耶和华向他显现，对他说：“我是全能的神。你当在我面前作完全人，","n":27,"han":761},{"no":18,"c":18,"first":"耶和华在幔利橡树那里向亚伯拉罕显现出来。那时正热，亚伯拉罕坐在帐棚门口，","n":33,"han":1037},{"no":19,"c":19,"first":"那两个天使晚上到了所多玛；罗得正坐在所多玛城门口，看见他们，就起来迎接，脸伏于地下拜，","n":38,"han":1227},{"no":20,"c":20,"first":"亚伯拉罕从那里向南地迁去，寄居在加低斯和书珥中间的基拉耳。","n":18,"han":623},{"no":21,"c":21,"first":"耶和华按著先前的话眷顾撒拉，便照他所说的给撒拉成就。","n":34,"han":947},{"no":22,"c":22,"first":"这些事以后，神要试验亚伯拉罕，就呼叫他说：“亚伯拉罕！”他说：“我在这里。”","n":24,"han":765},{"no":23,"c":23,"first":"撒拉享寿一百二十七岁，这是撒拉一生的岁数。","n":20,"han":592},{"no":24,"c":24,"first":"亚伯拉罕年纪老迈，向来在一切事上耶和华都赐福给他。","n":67,"han":2102},{"no":25,"c":25,"first":"亚伯拉罕又娶了一妻，名叫基土拉。","n":34,"han":945},{"no":26,"c":26,"first":"在亚伯拉罕的日子，那地有一次饥荒；这时又有饥荒，以撒就往基拉耳去，到非利士人的王亚比米勒那里。","n":35,"han":1128},{"no":27,"c":27,"first":"以撒年老，眼睛昏花，不能看见，就叫了他大儿子以扫来，说：“我儿。”以扫说：“我在这里。”","n":46,"han":1407},{"no":28,"c":28,"first":"以撒叫了雅各来，给他祝福，并嘱咐他说：“你不要娶迦南的女子为妻。","n":22,"han":682},{"no":29,"c":29,"first":"雅各起行，到了东方人之地，","n":35,"han":967},{"no":30,"c":30,"first":"拉结见自己不给雅各生子，就嫉妒她姐姐，对雅各说：“你给我孩子，不然我就死了。”","n":43,"han":1277},{"no":31,"c":31,"first":"雅各听见拉班的儿子们有话说：“雅各把我们父亲所有的都夺了去，并借着我们父亲的，得了这一切的荣耀（或译：财）。”","n":55,"han":1700},{"no":32,"c":32,"first":"雅各仍旧行路，神的使者遇见他。","n":32,"han":941},{"no":33,"c":33,"first":"雅各举目观看，见以扫来了，后头跟着四百人，他就把孩子们分开交给利亚、拉结，和两个使女，","n":20,"han":604},{"no":34,"c":34,"first":"利亚给雅各所生的女儿底拿出去，要见那地的女子们。","n":31,"han":997},{"no":35,"c":35,"first":"神对雅各说：“起来！上伯特利去，住在那里；要在那里筑一座坛给神，就是你逃避你哥哥以扫的时候向你显现的那位。”","n":29,"han":838},{"no":36,"c":36,"first":"以扫就是以东，他的后代记在下面。","n":43,"han":1165},{"no":37,"c":37,"first":"雅各住在迦南地，就是他父亲寄居的地。","n":36,"han":1103},{"no":38,"c":38,"first":"那时，犹大离开他弟兄下去，到一个亚杜兰人名叫希拉的家里去。","n":30,"han":932},{"no":39,"c":39,"first":"约瑟被带下埃及去。有一个埃及人，是法老的内臣─护