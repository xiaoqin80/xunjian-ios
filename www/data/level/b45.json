e":5},{"no":5213,"w":"夸口","py":"kuā kǒu","freq":36,"here":5},{"no":6307,"w":"以赛亚","py":"yǐ sài yà","freq":61,"here":5},{"no":6816,"w":"良善","py":"liáng shàn","freq":30,"here":5},{"no":7208,"w":"定罪","py":"dìng zuì","freq":19,"here":5},{"no":7344,"w":"真理","py":"zhēn lǐ","freq":75,"here":5},{"no":8664,"w":"教会","py":"jiào huì","freq":112,"here":5},{"no":8665,"w":"体贴","py":"tǐ tiē","freq":8,"here":5},{"no":804,"w":"后嗣","py":"hòu sì","freq":12,"here":5},{"no":55,"w":"生命","py":"shēng mìng","freq":198,"here":4},{"no":90,"w":"食物","py":"shí wù","freq":181,"here":4},{"no":936,"w":"必要","py":"bì yào","freq":115,"here":4},{"no":980,"w":"公义","py":"gōng yì","freq":276,"here":4},{"no":1036,"w":"怜恤","py":"lián xù","freq":69,"here":4},{"no":1089,"w":"先知","py":"xiān zhī","freq":522,"here":4},{"no":1090,"w":"祷告","py":"dǎo gào","freq":247,"here":4},{"no":1103,"w":"预先","py":"yù xiān","freq":28,"here":4},{"no":1171,"w":"有人","py":"yǒu rén","freq":428,"here":4},{"no":1264,"w":"不吃","py":"bù chī","freq":20,"here":4},{"no":1270,"w":"只要","py":"zhǐ yào","freq":104,"here":4},{"no":1327,"w":"祈求","py":"qí qiú","freq":76,"here":4}],"cp":[{"no":1047,"c":1,"first":"耶稣基督的仆人保罗，奉召为使徒，特派传神的福音。","n":32,"han":971},{"no":1048,"c":2,"first":"你这论断人的，无论你是谁，也无可推诿。你在什么事上论断人，就在什么事上定自己的罪；因你这论断人的，自己所行却和别人一样。","n":29,"han":812},{"no":1049,"c":3,"first":"这样说来，犹太人有什么长处？割礼有什么益处呢？","n":31,"han":766},{"no":1050,"c":4,"first":"如此说来，我们的祖宗亚伯拉罕凭着肉体得了什么呢？","n":25,"han":759},{"no":1051,"c":5,"first":"我们既因信称义，就借着我们的主耶稣基督得与神相和。","n":21,"han":639},{"no":1052,"c":6,"first":"这样，怎么说呢？我们可以仍在罪中、叫恩典显多吗？","n":23,"han":666},{"no":1053,"c":7,"first":"弟兄们，我现在对明白律法的人说，你们岂不晓得律法管人是在活着的时候吗？","n":25,"han":787},{"no":1054,"c":8,"first":"如今，那些在基督耶稣里的就不定罪了。","n":39,"han":1192},{"no":1055,"c":9,"first":"我在基督里说真话，并不谎言，有我良心被圣灵感动，给我作见证：","n":33,"han":965},{"no":1056,"c":10,"first":"弟兄们，我心里所愿的，向神所求的，是要以色列人得救。","n":21,"han":538},{"no":1057,"c":11,"first":"我且说，神弃绝了他的百姓吗？断乎没有！因为我也是以色列人，亚伯拉罕的后裔，属便雅悯支派的。","n":36,"han":1042},{"no":1058,"c":12,"first":"所以，弟兄们，我以神的慈悲劝你们，将身体献上，当作活祭，是圣洁的，是神所喜悦的；你们如此事奉乃是理所当然的。","n":21,"han":525},{"no":1059,"c":13,"first":"在上有权柄的，人人当顺服他，因为没有权柄不是出于神的。凡掌权的都是神所命的。","n":14,"han":429},{"no":1060,"c":14,"first":"信心软弱的，你们要接纳，但不要辩论所疑惑的事。","n":23,"han":630},{"no":1061,"c":15,"first":"我们坚固的人应该担代不坚固人的软弱，不求自己的喜悦。","n":33,"han":927},{"no":1062,"c":16,"first":"我对你们举荐我们的姊妹非比；她是坚革哩教会中的女执事。","n":27,"han":752}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"律":[[2539,"律法","lǜ fǎ",387],[1353,"律例","lǜ lì",148],[5628,"希律","xī lǜ",55],[5838,"哈律","hā lǜ",4]],"信":[[8590,"信心","xìn xīn",105],[2307,"不信","bù xìn",63],[7612,"因信","yīn xìn",30],[4243,"信实","xìn shí",29]],"义":[[980,"公义","gōng yì",276],[438,"义人","yì rén",135],[6949,"不义","bú yì",43],[2858,"为义","wèi yì",37]],"罪":[[836,"罪孽","zuì niè",241],[3117,"赎罪祭","shú zuì jì",129],[2456,"犯罪","fàn zuì",115],[387,"罪恶","zuì è",89]],"基":[[8544,"基督","jī dū",349],[1181,"基列","jī liè",183],[8542,"耶稣基督","yē sū jī dū",143],[259,"基路伯","jī lù bó",94]],"心":[[496,"心里","xīn lǐ",429],[392,"心中","xīn zhōng",143],[8590,"信心","xìn xīn",105],[2632,"留心","liú xīn",52]],"死":[[2128,"死亡","sǐ wáng",148],[2265,"打死","dǎ sǐ",65],[1661,"必死","bì sǐ",51],[4378,"杀死","shā sǐ",46]],"督":[[8544,"基督","jī dū",349],[8542,"耶稣基督","yē sū jī dū",143],[9012,"基督耶稣","jī dū yē sū",87],[5631,"撒督","sā dū",53]],"作":[[1768,"作王","zuò wáng",208],[1101,"作为","zuò wéi",199],[1561,"当作","dàng zuò",82],[2034,"作恶","zuò è",53]],"叫":[[115,"名叫","míng jiào",247],[1004,"呼叫","hū jiào",71],[3409,"喊叫","hǎn jiào",37],[4579,"吼叫","hǒu jiào",23]],"主":[[1224,"主人","zhǔ rén",179],[916,"我主","wǒ zhǔ",146],[2044,"主说","zhǔ shuō",44],[5791,"救主","jiù zhǔ",39]],"如":[[511,"如此","rú cǐ",688],[505,"如同","rú tóng",255],[301,"如今","rú jīn",193],[448,"正如","zhèng rú",154]],"事":[[216,"这事","zhè shì",204],[3629,"行事","xíng shì",113],[827,"服事","fú shì",100],[744,"事奉","shì fèng",95]],"体":[[1