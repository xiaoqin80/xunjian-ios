,{"no":711,"w":"不能","py":"bù néng","freq":579,"here":12},{"no":60,"w":"各样","py":"gè yàng","freq":164,"here":11},{"no":936,"w":"必要","py":"bì yào","freq":115,"here":11},{"no":1259,"w":"房屋","py":"fáng wū","freq":171,"here":11},{"no":1337,"w":"雅各","py":"yǎ gè","freq":458,"here":11},{"no":1837,"w":"带子","py":"dài zi","freq":28,"here":11},{"no":134,"w":"金子","py":"jīn zi","freq":106,"here":11},{"no":146,"w":"只是","py":"zhǐ shì","freq":232,"here":11},{"no":2213,"w":"长老","py":"zhǎng lǎo","freq":188,"here":11},{"no":2242,"w":"做工","py":"zuò gōng","freq":62,"here":11},{"no":2980,"w":"钮扣","py":"niǔ kòu","freq":11,"here":11},{"no":2995,"w":"两卯","py":"liǎng mǎo","freq":11,"here":11},{"no":495,"w":"馨香","py":"xīn xiāng","freq":57,"here":11},{"no":627,"w":"石头","py":"shí tou","freq":246,"here":11},{"no":20,"w":"以上","py":"yǐ shàng","freq":75,"here":10},{"no":52,"w":"分别","py":"fēn bié","freq":104,"here":10},{"no":88,"w":"赐给","py":"cì gěi","freq":399,"here":10},{"no":1468,"w":"上面","py":"shàng miàn","freq":48,"here":10},{"no":135,"w":"并且","py":"bìng qiě","freq":454,"here":10}],"cp":[{"no":51,"c":1,"first":"以色列的众子，各带家眷，和雅各一同来到埃及。他们的名字记在下面。","n":22,"han":556},{"no":52,"c":2,"first":"有一个利未家的人娶了一个利未女子为妻。","n":25,"han":740},{"no":53,"c":3,"first":"摩西牧养他岳父米甸祭司叶忒罗的羊群；一日领羊群往野外去，到了神的山，就是何烈山。","n":22,"han":884},{"no":54,"c":4,"first":"摩西回答说：“他们必不信我，也不听我的话，必说：‘耶和华并没有向你显现。’”","n":31,"han":941},{"no":55,"c":5,"first":"后来摩西、亚伦去对法老说：“耶和华─以色列的神这样说：‘容我的百姓去，在旷野向我守节。’”","n":23,"han":687},{"no":56,"c":6,"first":"耶和华对摩西说：“现在你必看见我向法老所行的事，使他因我大能的手容以色列人去，且把他们赶出他的地。”","n":30,"han":881},{"no":57,"c":7,"first":"耶和华对摩西说：“我使你在法老面前代替神，你的哥哥亚伦是替你说话的。","n":25,"han":729},{"no":58,"c":8,"first":"耶和华吩咐摩西说：“你进去见法老，对他说：‘耶和华这样说：容我的百姓去，好事奉我。","n":32,"han":1063},{"no":59,"c":9,"first":"耶和华吩咐摩西说：“你进去见法老，对他说：‘耶和华─希伯来人的神这样说：容我的百姓去，好事奉我。","n":35,"han":1049},{"no":60,"c":10,"first":"耶和华对摩西说：“你进去见法老。我使他和他臣仆的心刚硬，为要在他们中间显我这些神迹，","n":29,"han":1032},{"no":61,"c":11,"first":"耶和华对摩西说：“我再使一样的灾殃临到法老和埃及，然后他必容你们离开这地。他容你们去的时候，总要催逼你们都从这地出去。","n":10,"han":351},{"no":62,"c":12,"first":"耶和华在埃及地晓谕摩西、亚伦说：","n":51,"han":1570},{"no":63,"c":13,"first":"耶和华晓谕摩西说：","n":22,"han":736},{"no":64,"c":14,"first":"耶和华晓谕摩西说：","n":31,"han":1003},{"no":65,"c":15,"first":"那时，摩西和以色列人向耶和华唱歌说：我要向耶和华歌唱，因他大大战胜，将马和骑马的投在海中。","n":27,"han":808},{"no":66,"c":16,"first":"以色列全会众从以琳起行，在出埃及后第二个月十五日到了以琳和西奈中间、汛的旷野。","n":36,"han":1154},{"no":67,"c":17,"first":"以色列全会众都遵耶和华的吩咐，按著站口从汛的旷野往前行，在利非订安营。百姓没有水喝，","n":16,"han":584},{"no":68,"c":18,"first":"摩西的岳父，米甸祭司叶忒罗，听见神为摩西和神的百姓以色列所行的一切事，就是耶和华将以色列从埃及领出来的事，","n":27,"han":890},{"no":69,"c":19,"first":"以色列人出埃及地以后，满了三个月的那一天，就来到西奈的旷野。","n":25,"han":772},{"no":70,"c":20,"first":"神吩咐这一切的话说：","n":26,"han":606},{"no":71,"c":21,"first":"“你在百姓面前所要立的典章是这样：","n":36,"han":929},{"no":72,"c":22,"first":"“人若偷牛或羊，无论是宰了，是卖了，他就要以五牛赔一牛，四羊赔一羊。","n":31,"han":887},{"no":73,"c":23,"first":"“不可随伙布散谣言；不可与恶人连手妄作见证。","n":33,"han":965},{"no":74,"c":24,"first":"耶和华对摩西说：“你和亚伦、拿答、亚比户，并以色列长老中的七十人，都要上到我这里来，远远地下拜。","n":18,"han":506},{"no":75,"c":25,"first":"耶和华晓谕摩西说：","n":40,"han":821},{"no":76,"c":26,"first":"“你要用十幅幔子做帐幕。这些幔子要用撚的细麻和蓝色、紫色、朱红色线制造，并用巧匠的手工绣上基路伯。","n":37,"han":918},{"no":77,"c":27,"first":"“你要用皂荚木做坛。这坛要四方的，长五肘，宽五肘，高三肘。","n":21,"han":576},{"no":78,"c":28,"first":"“你要从以色列人中，使你的哥哥亚伦和他的儿子拿答、亚比户、以利亚撒、以他玛一同就近你，给我供祭司的职分。","n":43,"han":1296},{"no":79,"c":29,"first":"“你使亚伦和他儿子成圣，给我供祭司的职分，要如此行：取一只公牛犊，两只无残疾的公绵羊，","n":46,"han":1345},{"no":80,"c":30,"first":"“你要用皂荚木做一座烧香的坛。","n":38,"han":1029},{"no":81,"c":31,"first":"耶和华晓谕摩西说：","n":18,"han":478},{"no":82,"c":32,"first":"百姓见摩西迟延不下山，就大家聚集到亚伦那里，对他说：“起来！为我们做神像，可以在我们前面引路；因为领我们出埃及地的那个摩西，我们不知道他遭了什么事。”","n":35,"han":1161},{"no":83,"c":33,"first":"耶和华吩咐摩西说：“我曾起誓应许亚伯拉罕、以撒、雅各说：‘要将迦南地赐给你的后裔。’现在你和你从埃及地所领出来的百姓，要从这里往那地去。","n":23,"han":806},{"no":84,"c":34,"first":"耶和华吩咐摩西说：“你要凿出两块石版，和先前你摔碎的那版一样；其上的字我要写在这版上。","n":35,"han":1140},{"no":85,"c":35,"first":"摩西招聚以色列全会众，对他们说：“这是耶和华所吩咐的话，叫你们照着行：","n":35,"han":884},{"no":86,"c":36,"first":"“比撒列和亚何利亚伯，并一切心里有智慧的，就是蒙耶和华赐智慧聪明、叫他知道做圣所各样使用之工的，都要照耶和华所吩咐的做工。”","n":38,"han":988},{"no":87,"c":37,"first":"比撒列用皂荚木做柜，长二肘半，宽一肘半，高一肘半。","n":29,"han":629},{"no":88,"c":38,"first":"他用皂荚木做燔祭坛，是四方的，长五肘，宽五肘，高三肘，","n":31,"han":924},{"no":89,"c":39,"first":"比撒列用蓝色、紫色、朱红色线做精致的衣服，在圣所用以供职，又为亚伦做圣衣，是照耶和华所吩咐摩西的。","n":43,"han":1140},{"no":90,"c":40,"first":"耶和华晓谕摩西说：","n":38,"han":792}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"西":[[2263,"摩西","mó xī",870],[1951,"玛拿西","mǎ ná xī",157],[6272,"希西家","xī xī jiā",140],[6549,"西门","xī mén",78]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"百":[[898,"百姓","bǎi xìng",829],[359,"一百","yì bǎi",63],[2707,"百夫长","bǎi fū zhǎng",53],[1175,"利百加","lì bǎi jiā",38]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"面":[[157,"面前","miàn qián",1183],[379,"里面","lǐ miàn",181],[2872,"前面","qián miàn",77],[914,"对面","duì miàn",54]],"老":[[697,"法老","fǎ lǎo",263],[2213,"长老","zhǎng lǎo",188],[940,"老迈","lǎo mài",30],[945,"年老","nián lǎo",26]],"两":[[46,"两个","liǎng gè",300],[1396,"两只","liǎng zhǐ",65],[2958,"两旁","liǎng páng",31],[3053,"两条","liǎng tiáo",26]],"坛":[[3635,"邱坛","qiū tán",73],[3225,"祭坛","jì tán",56],[3022,"这坛","zhè tán",11],[3165,"香坛","xiāng tán",10]],"金":[[134,"金子","jīn zi",106],[1267,"金银","jīn yín",75],[2924,"精金","jīng jīn",64],[1245,"金环","jīn huán",18]],"儿":[[312,"儿子","ér zi",2399],[372,"女儿","nǚ ér",297],[230,"儿女","ér nǚ",262],[1153,"我儿","wǒ ér",64]],"十":[[907,"十二个","shí èr gè",65],[418,"五十","wǔ shí",61],[1323,"十二","shí èr",56],[8621,"十字架","shí zì jià",54]],"圣":[[4040,"圣灵","shèng líng",211],[2616,"圣所","shèng suǒ",176],[2716,"圣洁","shèng jié",101],[4618,"圣者","shèng zhě",71]],"手":[[367,"手中","shǒu zhōng",240],[293,"手里","shǒu lǐ",210],[2143,"右手","yòu shǒu",85],[251,"伸手","shēn shǒu",76]],"带":[[156,"带到","dài dào",127],[1395,"带来","dài lái",51],[2993,"带卯","dài mǎo",39],[1837,"带子","dài zi",28]],"日":[[39,"日子","rì zi",566],[100