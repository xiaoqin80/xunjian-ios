no":1009,"c":12,"first":"逾越节前六日，耶稣来到伯大尼，就是他叫拉撒路从死里复活之处。","n":50,"han":1294},{"no":1010,"c":13,"first":"逾越节以前，耶稣知道自己离世归父的时候到了。他既然爱世间属自己的人，就爱他们到底。","n":38,"han":1043},{"no":1011,"c":14,"first":"“你们心里不要忧愁；你们信神，也当信我。","n":31,"han":962},{"no":1012,"c":15,"first":"“我是真葡萄树，我父是栽培的人。","n":27,"han":795},{"no":1013,"c":16,"first":"“我已将这些事告诉你们，使你们不至于跌倒。","n":33,"han":976},{"no":1014,"c":17,"first":"耶稣说了这话，就举目望天，说：“父啊，时候到了，愿你荣耀你的儿子，使儿子也荣耀你；","n":26,"han":813},{"no":1015,"c":18,"first":"耶稣说了这话，就同门徒出去，过了汲沦溪。在那里有一个园子，他和门徒进去了。","n":40,"han":1188},{"no":1016,"c":19,"first":"当下彼拉多将耶稣鞭打了。","n":42,"han":1356},{"no":1017,"c":20,"first":"七日的第一日清早，天还黑的时候，抹大拉的马利亚来到坟墓那里，看见石头从坟墓挪开了，","n":31,"han":917},{"no":1018,"c":21,"first":"这些事以后，耶稣在提比哩亚海边又向门徒显现。他怎样显现记在下面：","n":25,"han":860}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"父":[[525,"父亲","fù qīn",464],[174,"父母","fù mǔ",81],[1422,"我父","wǒ fù",77],[661,"父家","fù jiā",43]],"道":[[191,"知道","zhī dào",1085],[264,"道路","dào lù",81],[1787,"难道","nán dào",53],[6991,"道理","dào lǐ",44]],"门":[[6114,"门徒","mén tú",375],[5585,"所罗门","suǒ luó mén",316],[1170,"城门","chéng mén",85],[913,"门口","mén kǒu",84]],"看":[[373,"看见","kàn jiàn",832],[406,"观看","guān kàn",164],[1826,"看为","kàn wèi",118],[142,"看守","kān shǒu",101]],"知":[[191,"知道","zhī dào",1085],[1089,"先知","xiān zhī",522],[3174,"知识","zhī shí",117],[7215,"无知","wú zhī",37]],"话":[[289,"说话","shuō huà",269],[938,"这话","zhè huà",255],[7459,"谎话","huǎng huà",24],[333,"话语","huà yǔ",18]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"叫":[[115,"名叫","míng jiào",247],[1004,"呼叫","hū jiào",71],[3409,"喊叫","hǎn jiào",37],[4579,"吼叫","hǒu jiào",23]],"信":[[8590,"信心","xìn xīn",105],[2307,"不信","bù xìn",63],[7612,"因信","yīn xìn",30],[4243,"信实","xìn shí",29]],"犹":[[1507,"犹大","yóu dà",538],[3691,"犹大人","yóu dà rén",234],[8549,"犹太人","yóu tài rén",198],[3171,"犹大支派","yóu dà zhī pài",22]],"徒":[[6114,"门徒","mé