"n":27,"han":1066},{"no":246,"c":10,"first":"撒母耳拿瓶膏油倒在扫罗的头上，与他亲嘴，说：“这不是耶和华膏你作他产业的君吗？","n":27,"han":952},{"no":247,"c":11,"first":"亚扪人的王拿辖上来，对着基列．雅比安营。雅比众人对拿辖说：“你与我们立约，我们就服事你。”","n":15,"han":529},{"no":248,"c":12,"first":"撒母耳对以色列众人说：“你们向我所求的，我已应允了，为你们立了一个王；","n":25,"han":912},{"no":249,"c":13,"first":"扫罗登基年四十岁；作以色列王二年的时候，","n":23,"han":774},{"no":250,"c":14,"first":"有一日，扫罗的儿子约拿单对拿他兵器的少年人说：“我们不如过到那边，到非利士人的防营那里去。”但他没有告诉父亲。","n":52,"han":1873},{"no":251,"c":15,"first":"撒母耳对扫罗说：“耶和华差遣我膏你为王，治理他的百姓以色列；所以你当听从耶和华的话。","n":35,"han":1200},{"no":252,"c":16,"first":"耶和华对撒母耳说：“我既厌弃扫罗作以色列的王，你为他悲伤要到几时呢？你将膏油盛满了角，我差遣你往伯利恒人耶西那里去；因为我在他众子之内，预定一个作王的。”","n":23,"han":867},{"no":253,"c":17,"first":"非利士人招聚他们的军旅，要来争战；聚集在属犹大的梭哥，安营在梭哥和亚西加中间的以弗‧大悯。","n":58,"han":2012},{"no":254,"c":18,"first":"大卫对扫罗说完了话，约拿单的心与大卫的心深相契合。约拿单爱大卫，如同爱自己的性命。","n":30,"han":889},{"no":255,"c":19,"first":"扫罗对他儿子约拿单和众臣仆说，要杀大卫；扫罗的儿子约拿单却甚喜爱大卫。","n":24,"han":803},{"no":256,"c":20,"first":"大卫从拉玛的拿约逃跑，来到约拿单那里，对他说：“我做了什么？有什么罪孽呢？在你父亲面前犯了什么罪，他竟寻索我的性命呢？”","n":42,"han":1403},{"no":257,"c":21,"first":"大卫到了挪伯祭司亚希米勒那里，亚希米勒战战兢兢地出来迎接他，问他说：“你为什么独自来，没有人跟随呢？”","n":15,"han":549},{"no":258,"c":22,"first":"大卫就离开那里，逃到亚杜兰洞。他的弟兄和他父亲的全家听见了，就都下到他那里。","n":23,"han":882},{"no":259,"c":23,"first":"有人告诉大卫说：“非利士人攻击基伊拉，抢夺禾场。”","n":29,"han":1018},{"no":260,"c":24,"first":"扫罗追赶非利士人回来，有人告诉他说：“大卫在隐‧基底的旷野。”","n":22,"han":719},{"no":261,"c":25,"first":"撒母耳死了，以色列众人聚集，为他哀哭，将他葬在拉玛─他自己的坟墓（原文是房屋）里。大卫起身，下到巴兰的旷野。","n":44,"han":1569},{"no":262,"c":26,"first":"西弗人到基比亚见扫罗，说：“大卫不是在旷野前的哈基拉山藏着吗？”","n":25,"han":972},{"no":263,"c":27,"first":"大卫心里说：“必有一日我死在扫罗手里，不如逃奔非利士地去。扫罗见我不在以色列的境内，就必绝望，不再寻索我；这样我可以脱离他的手。”","n":12,"han":432},{"no":264,"c":28,"first":"那时，非利士人聚集军旅，要与以色列人打仗。亚吉对大卫说：“你当知道，你和跟随你的人都要随我出战。”","n":25,"han":868},{"no":265,"c":29,"first":"非利士人将他们的军旅聚到亚弗；以色列人在耶斯列的泉旁安营。","n":11,"han":483},{"no":266,"c":30,"first":"第三日，大卫和跟随他的人到了洗革拉。亚玛力人已经侵夺南地，攻破洗革拉，用火焚烧，","n":31,"han":1003},{"no":267,"c":31,"first":"非利士人与以色列人争战。以色列人在非利士人面前逃跑，在基利波有被杀仆倒的。","n":13,"han":422}],"cw":{"人":[[1648