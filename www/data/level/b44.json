":11},{"no":9016,"w":"亚基帕","py":"yà jī pà","freq":11,"here":11},{"no":935,"w":"一位","py":"yī wèi","freq":118,"here":10},{"no":961,"w":"应许","py":"yīng xǔ","freq":209,"here":10},{"no":1030,"w":"出去","py":"chū qù","freq":258,"here":10},{"no":1146,"w":"多日","py":"duō rì","freq":28,"here":10},{"no":1241,"w":"定睛","py":"dìng jīng","freq":21,"here":10},{"no":156,"w":"带到","py":"dài dào","freq":127,"here":10},{"no":2001,"w":"释放","py":"shì fàng","freq":69,"here":10},{"no":2194,"w":"逼迫","py":"bī pò","freq":60,"here":10},{"no":222,"w":"彼此","py":"bǐ cǐ","freq":218,"here":10},{"no":5156,"w":"指望","py":"zhǐ wàng","freq":96,"here":10},{"no":535,"w":"进去","py":"jìn qù","freq":145,"here":10},{"no":678,"w":"显现","py":"xiǎn xiàn","freq":111,"here":10},{"no":7554,"w":"称呼","py":"chēng hū","freq":27,"here":10},{"no":8173,"w":"悔改","py":"huǐ gǎi","freq":52,"here":10},{"no":8496,"w":"希腊人","py":"xī là rén","freq":27,"here":10},{"no":8763,"w":"讲道","py":"jiǎng dào","freq":33,"here":10},{"no":8888,"w":"罗马人","py":"luó mǎ rén","freq":11,"here":10},{"no":825,"w":"忽然","py":"hū rán","freq":75,"here":10},{"no":893,"w":"必须","py":"bì xū","freq":74,"here":10},{"no":9005,"w":"腓力斯","py":"féi lì sī","freq":10,"here":10},{"no":912,"w":"一同","py":"yī tóng","freq":353,"here":9}],"cp":[{"no":1019,"c":1,"first":"提阿非罗啊，我已经作了前书，论到耶稣开头一切所行所教训的，","n":26,"han":856},{"no":1020,"c":2,"first":"五旬节到了，门徒都聚集在一处。","n":47,"han":1266},{"no":1021,"c":3,"first":"申初祷告的时候，彼得、约翰上圣殿去。","n":26,"han":763},{"no":1022,"c":4,"first":"使徒对百姓说话的时候，祭司们和守殿官，并撒都该人忽然来了。","n":37,"han":1018},{"no":1023,"c":5,"first":"有一个人，名叫亚拿尼亚，同他的妻子撒非喇卖了田产，","n":42,"han":1203},{"no":1024,"c":6,"first":"那时，门徒增多，有说希腊话的犹太人向希伯来人发怨言，因为在天天的供给上忽略了他们的寡妇。","n":15,"han":444},{"no":1025,"c":7,"first":"大祭司就说：“这些事果然有吗？”","n":60,"han":1724},{"no":1026,"c":8,"first":"从这日起，耶路撒冷的教会大遭逼迫，除了使徒以外，门徒都分散在犹太和撒马利亚各处。","n":40,"han":1054},{"no":1027,"c":9,"first":"扫罗仍然向主的门徒口吐威吓凶煞的话，去见大祭司，","n":43,"han":1197},{"no":1028,"c":10,"first":"在凯撒利亚有一个人，名叫哥尼流，是“意大利营”的百夫长。","n":48,"han":1293},{"no":1029,"c":11,"first":"使徒和在犹太的众弟兄听说外邦人也领受了神的道。","n":30,"han":840},{"no":1030,"c":12,"first":"那时，希律王下手苦害教会中几个人，","n":25,"han":723},{"no":1031,"c":13,"first":"在安提阿的教会中，有几位先知和教师，就是巴拿巴和称呼尼结的西面、古利奈人路求，与分封之王希律同养的马念，并扫罗。","n":52,"han":1544},{"no":1032,"c":14,"first":"二人在以哥念同进犹太人的会堂，在那里讲的，叫犹太人和希腊人信的很多。","n":28,"han":742},{"no":1033,"c":15,"first":"有几个人从犹太下来，教训弟兄们说：“你们若不按摩西的规条受割礼，不能得救。”","n":41,"han":1183},{"no":1034,"c":16,"first":"保罗来到特庇，又到路司得。在那里有一个门徒，名叫提摩太，是信主之犹太妇人的儿子，他父亲却是希腊人。","n":40,"han":1162},{"no":1035,"c":17,"first":"保罗和西拉经过暗妃坡里、亚波罗尼亚，来到帖撒罗尼迦，在那里有犹太人的会堂。","n":34,"han":1059},{"no":1036,"c":18,"first":"这事以后，保罗离了雅典，来到哥林多。","n":28,"han":841},{"no":1037,"c":19,"first":"亚波罗在哥林多的时候，保罗经过了上边一带地方，就来到以弗所；在那里遇见几个门徒，","n":41,"han":1225},{"no":1038,"c":20,"first":"乱定之后，保罗请门徒来，劝勉他们，就辞别起行，往马其顿去。","n":38,"han":1122},{"no":1039,"c":21,"first":"我们离别了众人，就开船一直行到哥士。第二天到了罗底，从那里到帕大喇，","n":40,"han":1261},{"no":1040,"c":22,"first":"“诸位父兄请听，我现在对你们分诉。”","n":30,"han":917},{"no":1041,"c":23,"first":"保罗定睛看着公会的人，说：“弟兄们，我在神面前行事为人都是凭着良心，直到今日。”","n":35,"han":1054},{"no":1042,"c":24,"first":"过了五天，大祭司亚拿尼亚同几个长老，和一个辩士帖土罗下来，向巡抚控告保罗。","n":27,"han":802},{"no":1043,"c":25,"first":"非斯都到了任，过了三天，就从凯撒利亚上耶路撒冷去。","n":27,"han":914},{"no":1044,"c":26,"first":"亚基帕对保罗说：“准你为自己辩明。”于是保罗伸手分诉，说：","n":32,"han":963},{"no":1045,"c":27,"first":"非斯都既然定规了，叫我们坐船往意大利去，便将保罗和别的囚犯交给御营里的一个百夫长，名叫犹流。","n":44,"han":1207},{"no":1046,"c":28,"first":"我们既已得救，才知道那岛名叫马耳他。","n":31,"han":960}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"罗":[[1778,"扫罗","sǎo luó",467],[5585,"所罗门","suǒ luó mén",316],[8950,"保罗","bǎo luó",214],[6026,"耶罗波安","yé luó bō ān",103]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"保":[[8950,"保罗","bǎo luó",214],[4959,"保障","bǎo zhàng",58],[2873,"保护","bǎo hù",51],[4199,"保守","bǎo shǒu",47]],"事":[[216,"这事","zhè shì",204],[3629,"行事","xíng shì",113],[827,"服事","fú shì",100],[744,"事奉","shì fèng",