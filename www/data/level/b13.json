:350,"c":12,"first":"大卫因怕基士的儿子扫罗，躲在洗革拉的时候，有勇士到他那里帮助他打仗。","n":40,"han":1189},{"no":351,"c":13,"first":"大卫与千夫长、百夫长，就是一切首领商议。","n":14,"han":470},{"no":352,"c":14,"first":"泰尔王希兰将香柏木运到大卫那里，又差遣使者和石匠、木匠给大卫建造宫殿。","n":17,"han":424},{"no":353,"c":15,"first":"大卫在大卫城为自己建造宫殿，又为神的约柜预备地方，支搭帐幕。","n":29,"han":902},{"no":354,"c":16,"first":"众人将神的约柜请进去，安放在大卫所搭的帐幕里，就在神面前献燔祭和平安祭。","n":43,"han":1061},{"no":355,"c":17,"first":"大卫住在自己宫中，对先知拿单说：“看哪，我住在香柏木的宫中，耶和华的约柜反在幔子里。”","n":27,"han":901},{"no":356,"c":18,"first":"此后，大卫攻打非利士人，把他们治服，从他们手下夺取了迦特和属迦特的村庄；","n":17,"han":561},{"no":357,"c":19,"first":"此后，亚扪人的王拿辖死了，他儿子接续他作王。","n":19,"han":702},{"no":358,"c":20,"first":"过了一年，到列王出战的时候，约押率领军兵毁坏亚扪人的地，围攻拉巴；大卫仍住在耶路撒冷。约押攻打拉巴，将城倾覆。","n":8,"han":365},{"no":359,"c":21,"first":"撒但起来攻击以色列人，激动大卫数点他们。","n":30,"han":1048},{"no":360,"c":22,"first":"大卫说：“这就是耶和华神的殿，为以色列人献燔祭的坛。”","n":19,"han":719},{"no":361,"c":23,"first":"大卫年纪老迈，日子满足，就立他儿子所罗门作以色列的王。","n":32,"han":754},{"no":362,"c":24,"first":"亚伦子孙的班次记在下面：亚伦的儿子是拿答、亚比户、以利亚撒、以他玛。","n":31,"han":757},{"no":363,"c":25,"first":"大卫和众首领分派亚萨、希幔，并耶杜顿的子孙弹琴、鼓瑟、敲钹、唱歌（原文是说预言；本章同）。他们供职的人数记在下面：","n":31,"han":764},{"no":364,"c":26,"first":"守门的班次记在下面：可拉族亚萨的子孙中，有可利的儿子米施利米雅。","n":32,"han":947},{"no":365,"c":27,"first":"以色列人的族长、千夫长、百夫长，和官长都分定班次，每班是二万四千人，周年按月轮流，替换出入服事王。","n":34,"han":1054},{"no":366,"c":28,"first":"大卫招聚以色列各支派的首领和轮班服事王的军长，与千夫长、百夫长，掌管王和王子产业牲畜的，并太监，以及大能的勇士，都到耶路撒冷来。","n":21,"han":855},{"no":367,"c":29,"first":"大卫王对会众说：“我儿子所罗门是神特选的，还年幼娇嫩；这工程甚大，因这殿不是为人，乃是为耶和华神建造的。","n":30,"han":1080}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"儿":[[312,"儿子","ér zi",2399],[372,"女儿","nǚ ér",297],[230,"儿女","ér nǚ",262],[1153,"我儿","wǒ ér",64]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"约":[[1529,"约瑟","yuē sè",307],[2676,"约书亚","yuē shū yà",236],[719,"约旦河","yuē dàn hé",195],[3701,"约柜","yuē guì",180]],"比":[[6281,"巴比伦","bā bǐ lún",317],[616,