"n":28,"han":536},{"no":450,"c":14,"first":"人为妇人所生，日子短少，多有患难；","n":22,"han":447},{"no":451,"c":15,"first":"提幔人以利法回答说：","n":35,"han":696},{"no":452,"c":16,"first":"约伯回答说：","n":22,"han":424},{"no":453,"c":17,"first":"我的心灵消耗，我的日子灭尽；坟墓为我预备好了。","n":16,"han":329},{"no":454,"c":18,"first":"书亚人比勒达回答说：","n":21,"han":407},{"no":455,"c":19,"first":"约伯回答说：","n":29,"han":549},{"no":456,"c":20,"first":"拿玛人琐法回答说：","n":29,"han":600},{"no":457,"c":21,"first":"约伯回答说：","n":34,"han":612},{"no":458,"c":22,"first":"提幔人以利法回答说：","n":30,"han":564},{"no":459,"c":23,"first":"约伯回答说：","n":17,"han":333},{"no":460,"c":24,"first":"全能者既定期罚恶，为何不使认识他的人看见那日子呢？","n":25,"han":550},{"no":461,"c":25,"first":"书亚人比勒达回答说：","n":6,"han":95},{"no":462,"c":26,"first":"约伯回答说：","n":14,"han":238},{"no":463,"c":27,"first":"约伯接着说：","n":23,"han":439},{"no":464,"c":28,"first":"银子有矿；炼金有方。","n":28,"han":467},{"no":465,"c":29,"first":"约伯又接着说：","n":25,"han":444},{"no":466,"c":30,"first":"但如今，比我年少的人戏笑我；其人之父我曾藐视，不肯安在看守我羊群的狗中。","n":31,"han":609},{"no":467,"c":31,"first":"我与眼睛立约，怎能恋恋瞻望处女呢？","n":40,"han":785},{"no":468,"c":32,"first":"于是这三个人，因约伯自以为义就不再回答他。","n":22,"han":458},{"no":469,"c":33,"first":"约伯啊，请听我的话，留心听我一切的言语。","n":33,"han":595},{"no":470,"c":34,"first":"以利户又说：","n":37,"han":695},{"no":471,"c":35,"first":"以利户又说：","n":16,"han":307},{"no":472,"c":36,"first":"以利户又接着说：","n":33,"han":627},{"no":473,"c":37,"first":"因此我心战兢，从原处移动。","n":24,"han":441},{"no":474,"c":38,"first":"那时，耶和华从旋风中回答约伯说：","n":41,"han":721},{"no":475,"c":39,"first":"山岩间的野山羊几时生产，你知道吗？母鹿下犊之期，你能察定吗？","n":30,"han":572},{"no":476,"c":40,"first":"耶和华又对约伯说：","n":24,"han":421},{"no":477,"c":41,"first":"你能用鱼钩钓上鳄鱼吗？能用绳子压下它的舌头吗？","n":34,"han":609},{"no":478,"c":42,"first":"约伯回答耶和华说：","n":17,"han":527}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"如":[[511,"如此","rú cǐ",688],[505,"