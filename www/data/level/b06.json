"first":"耶路撒冷王亚多尼‧洗德听见约书亚夺了艾城，尽行毁灭，怎样待耶利哥和耶利哥的王，也照样待艾城和艾城的王，又听见基遍的居民与以色列人立了和约，住在他们中间，","n":43,"han":1699},{"no":198,"c":11,"first":"夏琐王耶宾听见这事，就打发人去见玛顿王约巴、伸仑王、押煞王，","n":23,"han":879},{"no":199,"c":12,"first":"以色列人在约旦河外向日出之地击杀二王，得他们的地，就是从亚嫩谷直到黑门山，并东边的全亚拉巴之地。","n":24,"han":597},{"no":200,"c":13,"first":"约书亚年纪老迈，耶和华对他说：“你年纪老迈了，还有许多未得之地，","n":33,"han":1074},{"no":201,"c":14,"first":"以色列人在迦南地所得的产业，就是祭司以利亚撒和嫩的儿子约书亚，并以色列各支派的族长所分给他们的，都记在下面，","n":15,"han":612},{"no":202,"c":15,"first":"犹大支派按著宗族拈阄所得之地是在尽南边，到以东的交界，向南直到寻的旷野。","n":63,"han":1263},{"no":203,"c":16,"first":"约瑟的子孙拈阄所得之地是从靠近耶利哥的约旦河起，以耶利哥东边的水为界：从耶利哥上去，通过山地的旷野，到伯特利；","n":10,"han":312},{"no":204,"c":17,"first":"玛拿西是约瑟的长子，他的支派拈阄所得之地记在下面。至于玛拿西的长子基列之父（或译：主）玛吉，因为是勇士就得了基列和巴珊。","n":18,"han":781},{"no":205,"c":18,"first":"以色列的全会众都聚集在示罗，把会幕设立在那里，那地已经被他们制伏了。","n":28,"han":857},{"no":206,"c":19,"first":"为西缅支派的人，按著宗族，拈出第二阄。他们所得的地业是在犹大人地业中间。","n":51,"han":1135},{"no":207,"c":20,"first":"耶和华晓谕约书亚说：","n":9,"han":376},{"no":208,"c":21,"first":"那时，利未人的众族长来到祭司以利亚撒和嫩的儿子约书亚，并以色列各支派的族长面前，","n":45,"han":1462},{"no":209,"c":22,"first":"当时，约书亚召了流便人、迦得人，和玛拿西半支派的人来，","n":34,"han":1538},{"no":210,"c":23,"first":"耶和华使以色列人安静，不与四围的一切仇敌争战，已经多日。约书亚年纪老迈，","n":16,"han":641},{"no":211,"c":24,"first":"约书亚将以色列的众支派聚集在示剑，召了以色列的长老、族长、审判官，并官长来，他们就站在神面前。","n":33,"han":1353}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"约":[[1529,"约瑟","yuē sè",307],[2676,"约书亚","yuē shū yà",236],[719,"约旦河","yuē dàn hé",195],[3701,"约柜","yuē guì",180]],"城":[[726,"城邑","chéng yì",225],[972,"城里","chéng lǐ",175],[1032,"这城","zhè chéng",112],[1029,"城中","chéng zhōng",99]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"书":[[2676,"约书亚","yuē shū yà",236],[2684,"书上","shū shàng",85],[8015,"书卷","shū juàn",38],[5632,"书记","shū jì",33]],"西":[[2263,"摩西","mó xī",870],[1951,"玛拿西","mǎ ná xī",157],[6272,"希西家","xī xī jiā",140],[6549,"西门","xī mén",78]]