1089,"w":"先知","py":"xiān zhī","freq":522,"here":10},{"no":1102,"w":"先前","py":"xiān qián","freq":110,"here":10},{"no":1441,"w":"怒气","py":"nù qì","freq":123,"here":10},{"no":188,"w":"所有","py":"suǒ yǒu","freq":303,"here":10},{"no":2147,"w":"喜悦","py":"xǐ yuè","freq":183,"here":10},{"no":2295,"w":"大能","py":"dà néng","freq":113,"here":10},{"no":2297,"w":"奇事","py":"qí shì","freq":79,"here":10},{"no":2676,"w":"约书亚","py":"yuē shū yà","freq":236,"here":10},{"no":254,"w":"打发","py":"dǎ fā","freq":365,"here":10},{"no":394,"w":"以及","py":"yǐ jí","freq":85,"here":10},{"no":397,"w":"眼前","py":"yǎn qián","freq":178,"here":10},{"no":4201,"w":"忘记","py":"wàng jì","freq":94,"here":10},{"no":4281,"w":"孤儿寡妇","py":"gū ér guǎ fù","freq":15,"here":10},{"no":470,"w":"那些","py":"nà xiē","freq":358,"here":10},{"no":505,"w":"如同","py":"rú tóng","freq":255,"here":10},{"no":597,"w":"路上","py":"lù shàng","freq":108,"here":10},{"no":700,"w":"许多","py":"xǔ duō","freq":374,"here":10},{"no":726,"w":"城邑","py":"chéng yì","freq":225,"here":10},{"no":800,"w":"承受","py":"chéng shòu","freq":93,"here":10},{"no":22,"w":"天下","py":"tiān xià","freq":67,"here":9},{"no":1072,"w":"摩押","py":"mó yā","freq":168,"here":9}],"cp":[{"no":154,"c":1,"first":"以下所记的是摩西在约旦河东的旷野、疏弗对面的亚拉巴─就是巴兰、陀弗、拉班、哈洗录、底撒哈中间─向以色列众人所说的话。","n":46,"han":1547},{"no":155,"c":2,"first":"“此后，我们转回，从红海的路往旷野去，是照耶和华所吩咐我的。我们在西珥山绕行了许多日子。","n":37,"han":1199},{"no":156,"c":3,"first":"“以后，我们转回，向巴珊去。巴珊王噩和他的众民都出来，在以得来与我们交战。","n":29,"han":1006},{"no":157,"c":4,"first":"“以色列人哪，现在我所教训你们的律例典章，你们要听从遵行，好叫你们存活，得以进入耶和华─你们列祖之神所赐给你们的地，承受为业。","n":49,"han":1684},{"no":158,"c":5,"first":"摩西将以色列众人召了来，对他们说：“以色列人哪，我今日晓谕你们的律例典章，你们要听，可以学习，谨守遵行。","n":33,"han":989},{"no":159,"c":6,"first":"“这是耶和华─你们神所吩咐教训你们的诫命、律例、典章，使你们在所要过去得为业的地上遵行，","n":25,"han":761},{"no":160,"c":7,"first":"“耶和华─你神领你进入要得为业之地，从你面前赶出许多国民，就是赫人、革迦撒人、亚摩利人、迦南人、比利洗人、希未人、耶布斯人，共七国的民，都比你强大。","n":26,"han":1026},{"no":161,"c":8,"first":"“我今日所吩咐的一切诫命，你们要谨守遵行，好叫你们存活，人数增多，且进去得耶和华向你们列祖起誓应许的那地。","n":20,"han":618},{"no":162,"c":9,"first":"“以色列啊，你当听！你今日要过约旦河，进去赶出比你强大的国民，得着广大坚固、高得顶天的城邑。","n":29,"han":1124},{"no":163,"c":10,"first":"“那时，耶和华吩咐我说：‘你要凿出两块石版，和先前的一样，上山到我这里来，又要做一木柜。","n":22,"han":704},{"no":164,"c":11,"first":"“你要爱耶和华─你的神，常守他的吩咐、律例、典章、诫命。","n":32,"han":1061},{"no":165,"c":12,"first":"“你们存活于世的日子，在耶和华─你们列祖的神所赐你们为业的地上，要谨守遵行的律例典章乃是这些：","n":32,"han":1200},{"no":166,"c":13,"first":"“你们中间若有先知或是做梦的起来，向你显个神迹奇事，","n":18,"han":670},{"no":167,"c":14,"first":"“你们是耶和华─你们神的儿女。不可为死人用刀划身，也不可将额上剃光；","n":29,"han":713},{"no":168,"c":15,"first":"“每逢七年末一年，你要施行豁免。","n":23,"han":816},{"no":169,"c":16,"first":"“你要注意亚笔月，向耶和华─你的神守逾越节，因为耶和华─你的神在亚笔月夜间领你出埃及。","n":22,"han":759},{"no":170,"c":17,"first":"“凡有残疾，或有什么恶病的牛羊，你都不可献给耶和华─你的神，因为这是耶和华─你神所憎恶的。","n":20,"han":707},{"no":171,"c":18,"first":"“祭司利未人和利未全支派必在以色列中无分无业；他们所吃用的就是献给耶和华的火祭和一切所捐的。","n":22,"han":694},{"no":172,"c":19,"first":"“耶和华─你神将列国之民剪除的时候，耶和华─你神也将他们的地赐给你，你接着住他们的城邑并他们的房屋，","n":21,"han":667},{"no":173,"c":20,"first":"“你出去与仇敌争战的时候，看见马匹、车辆，并有比你多的人民，不要怕他们，因为领你出埃及地的耶和华─你神与你同在。","n":20,"han":644},{"no":174,"c":21,"first":"“在耶和华─你神所赐你为业的地上，若遇见被杀的人倒在田野，不知道是谁杀的，","n":23,"han":778},{"no":175,"c":22,"first":"“你若看见弟兄的牛或羊失迷了路，不可佯为不见，总要把它牵回来交给你的弟兄。","n":30,"han":906},{"no":176,"c":23,"first":"“凡外肾受伤的，或被阉割的，不可入耶和华的会。","n":25,"han":748},{"no":177,"c":24,"first":"“人若娶妻以后，见她有什么不合理的事，不喜悦她，就可以写休书交在她手中，打发她离开夫家。","n":22,"han":695},{"no":178,"c":25,"first":"“人若有争讼，来听审判，审判官就要定义人有理，定恶人有罪。","n":19,"han":551},{"no":179,"c":26,"first":"“你进去得了耶和华─你神所赐你为业之地居住，","n":19,"han":729},{"no":180,"c":27,"first":"摩西和以色列的众长老吩咐百姓说：“你们要遵守我今日所吩咐的一切诫命。","n":26,"han":681},{"no":181,"c":28,"first":"“你若留意听从耶和华─你神的话，谨守遵行他的一切诫命，就是我今日所吩咐你的，他必使你超乎天下万民之上。","n":68,"han":2086},{"no":182,"c":29,"first":"这是耶和华在摩押地吩咐摩西与以色列人立约的话，是在他和他们于何烈山所立的约之外。","n":29,"han":980},{"no":183,"c":30,"first":"“我所陈明在你面前的这一切咒诅都临到你身上；你在耶和华─你神追赶你到的万国中必心里追念祝福的话；","n":20,"han":734},{"no":184,"c":31,"first":"摩西去告诉以色列众人","n":30,"han":1150},{"no":185,"c":32,"first":"诸天哪，侧耳，我要说话；愿地也听我口中的言语。","n":52,"han":1523},{"no":186,"c":33,"first":"以下是神人摩西在未死之先为以色列人所祝的福：","n":29,"han":975},{"no":187,"c":34,"first":"摩西从摩押平原登尼波山，上了那与耶利哥相对的毘斯迦山顶。耶和华把基列全地直到但，","n":12,"han":377}],"cw":{"神":[[4615,"神人","shén rén",93],[2306,"神迹","shén jì",92],[1469,"神殿","shén diàn",68],[2832,"别神","bié shén",66]],"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"日":[[39,"日子","rì zi",566],[1005,"今日","jīn rì",319],[457,"那日","nà rì",196],[2656,"安息日","ān xī rì",152]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"事":[[216,"这事","zhè shì",204],[3629,"行事","xíng shì",113],[827,"服事","fú shì",100],[744,"事奉","shì fèng",95]],"城":[[726,"城邑","chéng yì",225],[972,"城里","chéng lǐ",175],[1032,"这城","zhè chéng",112],[1029,"城中","chéng zhōng",99]],"赐":[[88,"赐给","cì gěi",399],[63,"赐福","cì fú",116],[798,"赏赐","shǎng cì",62],[7546,"恩赐","ēn cì",40]],"咐":[[143,"吩咐","fēn fù",797],[1443,"嘱咐","zhǔ fù",75]],"听":[[204,"听见","tīng jiàn",705],[233,"听从","tīng cóng",242],[2356,"听说","tīng shuō",31],[6563,"当听","dāng tīng",6]],"切":[[64,"一切","yī qiè",1422],[997,"切切","qiē qiē",26],[3118,"切成","qiè chéng",9],[7052,"切齿","qiè chǐ",9]],"面":[[157,"面前","miàn qián",1183],[379,"里面","lǐ miàn",181],[2872,"前面","qián miàn",77],[914,"对面","duì miàn",54]],"吩":[[143,"吩咐","fēn fù",797]],"民":[[1052,"居民","jū mín",247],[1960,"众民","zhòng mín",151],[2174,"万民","wàn mín",118],[2717,"国民","guó mín",90]],"话":[[289,"说话","shuō huà",269],[938,"这话","zhè huà",255],[7459,"谎话","huǎng huà",24],[333,"话语","huà yǔ",18]],"吃":[[1608,"吃饭","chī fàn",84],[1599,"吃喝","chī hē",52],[3587,"吃饱","chī bǎo",25],[1264,"不吃","bù chī",20]],"山":[[479,"山上","shān shàng",127],[814,"山羊","shān yáng",117],[3820,"山地","shān dì",79],[480,"山顶","shān dǐng",40]],"时":[[342,"时候","shí hòu",1368],[613,"那时","nà shí",450],[1069,"几时","jǐ shí",91],[180,"当时","dāng shí",71]],"起":[[106,"起来","qǐ lái",623],[785,"起誓","qǐ shì",282],[3773,"兴起","xīng qǐ",116],[1139,"起身","qǐ shēn",61]],"手":[[367,"手中","shǒu zhōng",240],[293,"手里","s