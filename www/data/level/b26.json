"py":"zhòng rén","freq":737,"here":15},{"no":673,"w":"经过","py":"jīng guò","freq":180,"here":15},{"no":700,"w":"许多","py":"xǔ duō","freq":374,"here":15},{"no":755,"w":"旷野","py":"kuàng yě","freq":319,"here":15},{"no":885,"w":"君王","py":"jūn wáng","freq":169,"here":15},{"no":34,"w":"于是","py":"yú shì","freq":667,"here":14},{"no":913,"w":"门口","py":"mén kǒu","freq":84,"here":14},{"no":1477,"w":"聚集","py":"jù jí","freq":252,"here":14},{"no":159,"w":"怎样","py":"zěn yàng","freq":380,"here":14},{"no":2227,"w":"骸骨","py":"hái gǔ","freq":38,"here":14},{"no":2379,"w":"军队","py":"jūn duì","freq":103,"here":14},{"no":2975,"w":"尺寸","py":"chǐ cùn","freq":25,"here":14},{"no":3117,"w":"赎罪祭","py":"shú zuì jì","freq":129,"here":14},{"no":3142,"w":"素祭","py":"sù jì","freq":140,"here":14},{"no":4246,"w":"报应","py":"bào yìng","freq":92,"here":14},{"no":510,"w":"弟兄","py":"dì xiōng","freq":557,"here":14},{"no":5925,"w":"内院","py":"nèi yuàn","freq":18,"here":14},{"no":685,"w":"饥荒","py":"jī huāng","freq":98,"here":14},{"no":889,"w":"割礼","py":"gē lǐ","freq":138,"here":14},{"no":895,"w":"剪除","py":"jiǎn chú","freq":122,"here":14},{"no":911,"w":"上升","py":"shàng shēng","freq":27,"here":13},{"no":1050,"w":"所说","py":"suǒ shuō","freq":316,"here":13},{"no":1467,"w":"柱子","py":"zhù zi","freq":94,"here":13},{"no":1621,"w":"脱离","py":"tuō lí","freq":287,"here":13}],"cp":[{"no":803,"c":1,"first":"当三十年四月初五日，以西结（原文是我）在迦巴鲁河边被掳的人中，天就开了，得见神的异象。","n":28,"han":844},{"no":804,"c":2,"first":"他对我说：“人子啊，你站起来，我要和你说话。”","n":10,"han":325},{"no":805,"c":3,"first":"他对我说：“人子啊，要吃你所得的，要吃这书卷，好去对以色列家讲说。”","n":27,"han":935},{"no":806,"c":4,"first":"“人子啊，你要拿一块砖，摆在你面前，将一座耶路撒冷城画在其上，","n":17,"han":528},{"no":807,"c":5,"first":"“人子啊，你要拿一把快刀，当作剃头刀，用这刀剃你的头发和你的胡须，用天平将须发平分。","n":17,"han":717},{"no":808,"c":6,"first":"耶和华的话临到我说：","n":14,"han":537},{"no":809,"c":7,"first":"耶和华的话又临到我说：","n":27,"han":897},{"no":810,"c":8,"first":"第六年六月初五日，我坐在家中；犹大的众长老坐在我面前。在那里主耶和华的灵（原文是手）降在我身上。","n":18,"han":666},{"no":811,"c":9,"first":"他向我耳中大声喊叫说：“要使那监管这城的人手中各拿灭命的兵器前来。”","n":11,"han":443},{"no":812,"c":10,"first":"我观看，见基路伯头上的穹苍之中，显出蓝宝石的形状，仿佛宝座的形像。","n":22,"han":701},{"no":813,"c":11,"first":"灵将我举起，带到耶和华殿向东的东门。谁知，在门口有二十五个人，我见其中有民间的首领押朔的儿子雅撒尼亚和比拿雅的儿子毘拉提。","n":25,"han":827},{"no":814,"c":12,"first":"耶和华的话又临到我说：","n":28,"han":954},{"no":815,"c":13,"first":"耶和华的话临到我说：","n":23,"han":920},{"no":816,"c":14,"first":"有几个以色列长老到我这里来，坐在我面前。","n":23,"han":912},{"no":817,"c":15,"first":"耶和华的话临到我说：","n":8,"han":225},{"no":818,"c":16,"first":"耶和华的话又临到我说：","n":63,"han":2096},{"no":819,"c":17,"first":"耶和华的话临到我说：","n":24,"han":851},{"no":820,"c":18,"first":"耶和华的话又临到我说：","n":32,"han":1099},{"no":821,"c":19,"first":"你当为以色列的王作起哀歌，","n":14,"han":421},{"no":822,"c":20,"first":"第七年五月初十日，有以色列的几个长老来求问耶和华，坐在我面前。","n":49,"han":1907},{"no":823,"c":21,"first":"耶和华的话临到我说：","n":32,"han":1074},{"no":824,"c":22,"first":"耶和华的话又临到我说：","n":31,"han":970},{"no":825,"c":23,"first":"耶和华的话又临到我说：","n":49,"han":1622},{"no":826,"c":24,"first":"第九年十月初十日，耶和华的话又临到我说：","n":27,"han":818},{"no":827,"c":25,"first":"耶和华的话临到我说：","n":17,"han":568},{"no":828,"c":26,"first":"第十一年十一月初一日，耶和华的话临到我说：","n":21,"han":781},{"no":829,"c":27,"first":"耶和华的话又临到我说：","n":36,"han":1022},{"no":830,"c":28,"first":"耶和华的话又临到我说：","n":26,"han":886},{"no":831,"c":29,"first":"第十年十月十二日，耶和华的话临到我说：","n":21,"han":740},{"no":832,"c":30,"first":"耶和华的话又临到我说：","n":26,"han":880},{"no":833,"c":31,"first":"十一年三月初一日，耶和华的话临到我说：","n":18,"han":692},{"no":834,"c":32,"first":"十二年十二月初一日，耶和华的话临到我说：","n":32,"han":1188},{"no":835,"c":33,"first":"耶和华的话临到我说：","n":33,"han":1184},{"no":836,"c":34,"first":"耶和华的话临到我说：","n":31,"han":1095},{"no":837,"c":35,"first":"耶和华的话又临到我说：","n":15,"han":472},{"no":838,"c":36,"first":"“人子啊，你要对以色列山发预言说：以色列山哪，要听耶和华的话。","n":38,"han":1357},{"no":839,"c":37,"first":"耶和华的灵（原文是手）降在我身上。耶和华藉他的灵带我出去，将我放在平原中；这平原遍满骸骨。","n":28,"han":1059},{"no":840,"c":38,"first":"耶和华的话临到我说：","n":23,"han":837},{"no":841,"c":39,"first":"“人子啊，你要向歌革发预言攻击他，说主耶和华如此说：罗施、米设、土巴的王歌革啊，我与你为敌。","n":29,"han":1027},{"no":842,"c":40,"first":"我们被掳掠第二十五年，耶路撒冷城攻破后十四年，正在年初，月之初十日，耶和华的灵（原文是手）降在我身上，他把我带到以色列地。","n":49,"han":1420},{"no":843,"c":41,"first":"他带我到殿那里量墙柱：这面厚六肘，那面厚六肘，宽窄与会幕相同。","n":26,"han":639},{"no":844,"c":42,"first":"他带我出来向北，到外院，又带我进入圣屋；这圣屋一排顺着空地，一排与北边铺石地之屋相对。","n":20,"han":510},{"no":845,"c":43,"first":"以后，他带我到一座门，就是朝东的门。","n":27,"han":897},{"no":846,"c":44,"first":"他又带我回到圣地朝东的外门；那门关闭了。","n":31,"han":1106},{"no":847,"c":45,"first":"你们拈阄分地为业，要献上一分给耶和华为圣供地，长二万五千肘，宽一万肘。这分以内，四围都为圣地。","n":25,"han":899},{"no":848,"c":46,"first":"主耶和华如此说：“内院朝东的门，在办理事务的六日内必须关闭；惟有安息日和月朔必须敞开。","n":24,"han":889},{"no":849,"c":47,"first":"他带我回到殿门，见殿的门槛下有水往东流出（原来殿面朝东）。这水从槛下，由殿的右边，在祭坛的南边往下流。","n":23,"han":796},{"no":850,"c":48,"first":"众支派按名所得之地记在下面：从北头，由希特伦往哈马口，到大马士革地界上的哈萨‧以难。北边靠着哈马地（各支派的地都有东西的边界），是但的一分。","n":35,"han":1042}],"cw":{"人":[[1648,"以色列人","yǐ sè liè rén",1041],[774,"仆人","pú rén",769],[639,"众人","zhòng rén",737],[1171,"有人","yǒu rén",428]],"列":[[1644,"以色列","yǐ sè liè",1662],[1648,"以色列人","yǐ sè liè rén",1041],[833,"列祖","liè zǔ",319],[4266,"列国","liè guó",209]],"主":[[1224,"主人","zhǔ rén",179],[916,"我主","wǒ zhǔ",146],[2044,"主说","zhǔ shuō",44],[5791,"救主","jiù zhǔ",39]],"如":[[511,"如此","rú cǐ",688],[505,"如同","rú tóng",255],[301,"如今","rú jīn",193],[448,"正如","zhèng rú",154]],"门":[[6114,"门徒","mén tú",375],[5585,"所罗门","suǒ luó mén",316],[1170,"城门","chéng mén",85],[913,"门口","mén kǒu",84]],"肘":[[2922,"一肘","yī zhǒu",24],[5913,"五肘","wǔ zhǒu",8],[2923,"肘半","zhǒu bàn",5],[5378,"六肘","liù zhǒu",3]],"日":[[39,"日子","rì zi",566],[1005,"今日","jīn rì",319],[457,"那日","nà rì",196],[2656,"安息日","ān xī rì",152]],"民":[[1052,"居民","jū mín",247],[1960,"众民","zhòng mín",151],[2174,"万民","wàn mín",118],[2717,"国民","guó mín",90]],"四":[[1206,"四围","sì wéi",197],[2927,"四个","sì gè",53],[3023,"四方","sì fāng",39],[260,"四面","sì miàn",37]],"物":[[90,"食物","shí wù",181],[670,"财物","cái wù",101],[276,"供物","gōng wù",97],[1624,"礼物","lǐ wù",87]],"罪":[[836,"罪孽","zuì niè",241],[3117,"赎罪祭","shú zuì jì",129],[2456,"犯罪","fàn zuì",115],[387,"罪恶","zuì è",89]],"面":[[157,"面前","miàn qián