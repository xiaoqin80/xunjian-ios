":"副词","orig":"","freq":6,"verses":5,"vols":5,"chaps":5,"ot":5,"nt":1,"first":"申命记 28:13","top":[["何西阿书",2],["申命记",1]],"rest":[3,3],"co":[["耶和华",2],["必使",1],["谨守",1],["从事",1]],"books":{"何西阿书":2,"申命记":1,"以赛亚书":1,"以西结书":1,"路加福音":1},"verse":"我知道怎么行，好叫人在我不作管家之后，接我到他们家里去。’","ref":"路加福音 16:4","def":"和合本用词；常见搭配：耶和华 2、必使 1、谨守 1。","senses":[],"bverse":"这城必不作你们的锅，你们也不作其中的肉。我必在以色列的境界审判你们，","bref":"以西结书 11:11"},{"no":4479,"w":"责罚","py":"","pos":"动词","orig":"","freq":24,"verses":22,"vols":12,"chaps":22,"ot":19,"nt":5,"first":"申命记 28:20","top":[["约伯记",4],["哥林多后书",4]],"rest":[10,16],"co":[["耶和华",3],["日子",3],["生产",3],["以法莲",3]],"books":{"约伯记":4,"哥林多后书":4,"诗篇":3,"以赛亚书":3,"耶利米书":2,"何西阿书":2,"申命记":1,"撒母耳记（下）":1,"列王记（下）":1,"历代志（上）":1,"箴言":1,"提摩太（前书）":1},"verse":"有谁对神说：我受了责罚，不再犯罪；","ref":"约伯记 34:31","def":"处罚。","senses":[["①","责备处罚","申 28:20","出现 24 次"]],"bverse":"或为责罚，或为润地，或为施行慈爱。","bref":"约伯记 37:13"},{"no":4480,"w":"旱风","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":5,"nt":0,"first":"申命记 28:22","top":[["申命记",1],["列王记（上）",1]],"rest":[3,3],"co":[["霉烂",5],["攻击",3],["耶和华",3],["蚂蚱",2]],"books":{"申命记":1,"列王记（上）":1,"历代志（下）":1,"阿摩司书":1,"哈该书":1},"verse":"在你们手下的各样工作上，我以旱风、霉烂、冰雹攻击你们，你们仍不归向我。这是耶和华说的。","ref":"哈该书 2:17","def":"和合本用词；常见搭配：霉烂 5、攻击 3、耶和华 3。","senses":[],"bverse":"耶和华要用痨病、热病、火症、疟疾、刀剑、旱风（或译：干旱）、霉烂攻击你。这都要追赶你，直到你灭亡。","bref":"申命记 28:22"},{"no":4481,"w":"霉烂","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":5,"nt":0,"first":"申命记 28:22","top":[["申命记",1],["列王记（上）",1]],"rest":[3,3],"co":[["旱风",5],["攻击",3],["耶和华",3],["蚂蚱",2]],"books":{"申命记":1,"列王记（上）":1,"历代志（下）":1,"阿摩司书":1,"哈该书":1},"verse":"在你们手下的各样工作上，我以旱风、霉烂、冰雹攻击你们，你们仍不归向我。这是耶和华说的。","ref":"哈该书 2:17","def":"和合本用词；常见搭配：旱风 5、攻击 3、耶和华 3。","senses":[["①","发霉腐烂","申 28:22","出现 5 次"]],"bverse":"耶和华要用痨病、热病、火症、疟疾、刀剑、旱风（或译：干旱）、霉烂攻击你。这都要追赶你，直到你灭亡。","bref":"申命记 28:22"},{"no":4482,"w":"天要","py":"","pos":"","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"申命记 28:23","top":[["申命记",1],["列王