[{"no":7401,"w":"由于","py":"","pos":"连词","orig":"","freq":11,"verses":8,"vols":7,"chaps":8,"ot":5,"nt":6,"first":"诗篇 37:39","top":[["以赛亚书",3],["哥林多后书",2]],"rest":[5,6],"co":[["耶和华",3],["乃是",3],["但义",1],["营寨",1]],"books":{"以赛亚书":3,"哥林多后书":2,"彼得前书":2,"诗篇":1,"箴言":1,"约翰福音":1,"加拉太书":1},"verse":"即或有人聚集，却不由于我；凡聚集攻击你的，必因你仆倒（或译：投降你）。","ref":"以赛亚书 54:15","def":"和合本用词；常见搭配：耶和华 3、乃是 3、但义 1。","senses":[],"bverse":"我们不像那许多人，为利混乱神的道；乃是由于诚实，由于神，在神面前凭着基督讲道。","bref":"哥林多后书 2:17"},{"no":7402,"w":"疲倦","py":"","pos":"形容词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":5,"nt":1,"first":"诗篇 38:8","top":[["以赛亚书",3],["诗篇",1]],"rest":[2,2],"co":[["身体",2],["压伤",1],["当受",1],["我儿",1]],"books":{"以赛亚书":3,"诗篇":1,"传道书":1,"希伯来书":1},"verse":"你因路远疲倦，却不说这是枉然；你以为有复兴之力，所以不觉疲惫。","ref":"以赛亚书 57:10","def":"和合本用词；常见搭配：身体 2、压伤 1、当受 1。","senses":[["①","疲乏;困倦","诗 38:8","出现 6 次"]],"bverse":"其中没有疲倦的，绊跌的；没有打盹的，睡觉的；腰带并不放松，鞋带也不折断。","bref":"以赛亚书 5:27"},{"no":7403,"w":"良朋","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 38:11","top":[["诗篇",2]],"rest":[0,0],"co":[["密友",2],["灾病",1],["旁边",1],["亲戚",1]],"books":{"诗篇":2},"verse":"你把我的良朋密友隔在远处，使我所认识的人进入黑暗里。","ref":"诗篇 88:18","def":"和合本用词；常见搭配：密友 2、灾病 1、旁边 1。","senses":[],"bverse":"我的良朋密友因我的灾病都躲在旁边站着；我的亲戚本家也远远地站立。","bref":"诗篇 38:11"},{"no":7404,"w":"哑巴","py":"","pos":"名词","orig":"","freq":18,"verses":17,"vols":8,"chaps":13,"ot":6,"nt":12,"first":"诗篇 38:13","top":[["马太福音",5],["路加福音",4]],"rest":[6,9],"co":[["众人",5],["说话",5],["不能",4],["希奇",4]],"books":{"马太福音":5,"路加福音":4,"以赛亚书":2,"哈巴谷书":2,"马可福音":2,"诗篇":1,"箴言":1,"哥林多前书":1},"verse":"他们出去的时候，有人将鬼所附的一个哑巴带到耶稣跟前来。","ref":"马太福音 9:32","def":"不能说话的；耶稣医治哑巴。","senses":[["①","亦作\"哑吧\"","诗 38:13","出现 18 次"]],"bverse":"耶稣赶出一个叫人哑巴的鬼；鬼出去了，哑巴就说出话来；众人都希奇。","bref":"路加福音 11:14"},{"no":7405,"w":"回话","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 38:14","top":[["诗篇",1],["罗马书",1]],"rest":[0,0],"co":[["听见",1],["口中",1],["未曾",1],["七千",1]],"books":{"诗篇":1,"罗马书":1},"verse":"我如不听见的人，口中没有回话。","ref":"诗篇 38:14","def":"回答别人问话","senses":[["①","回答别人问话","诗 38:14","出现 2 次"]],"bverse":"神的回话是怎么说的呢？他说：“我为自己留下七千人，是未曾向巴力屈膝的。”","bref":"罗马书 11:4"},{"no":7406,"w":"烧起","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 39:3","top":[["诗篇",2],["以赛亚书",1]],"rest":[0,0],"co":[["舌头",2],["怒气",2],["上腾",2],["耶和华",2]],"books":{"诗篇":2,"以赛亚书":1},"verse":"我的心在我里面发热。我默想的时候，火就烧起，我便用舌头说话。","ref":"诗篇 39:3","def":"和合本用词；常见搭配：舌头 2、怒气 2、上腾 2。","senses":[],"bverse":"所以，耶和华听见就发怒；有烈火向雅各烧起；有怒气向以色列上腾；","bref":"诗篇 78:21"},{"no":7407,"w":"虚幻","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":3,"ot":4,"nt":0,"first":"诗篇 39:5","top":[["诗篇",2],["传道书",1]],"rest":[1,1],"co":[["时候",2],["细拉",2],["真是",2],["年数",1]],"books":{"诗篇":2,"传道书":1,"以赛亚书":1},"verse":"多梦和多言，其中多有虚幻，你只要敬畏神。","ref":"传道书 5:7","def":"虚假而不真实的;虚无缥缈的","senses":[["①","虚假而不真实的;虚无","诗 39:5","出现 4 次"]],"bverse":"你使我的年日窄如手掌；我一生的年数，在你面前如同无有。各人最稳妥的时候，真是全然虚幻。（细拉）","bref":"诗篇 39:5"},{"no":7408,"w":"笑容","py":"","pos":"名词","orig":"","freq":2,"verses":1,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"诗篇 39:11","top":[["诗篇",2]],"rest":[0,0],"co":[["世人",1],["罪恶",1],["时候",1],["喜爱",1]],"books":{"诗篇":2},"verse":"你因人的罪恶惩罚他的时候，叫他的笑容（的笑容：或译所喜爱的）消灭，如衣被虫所咬。世人真是虚幻！（细拉）","ref":"诗篇 39:11","def":"指笑时面部呈现的神情状态","senses":[["①","指笑时面部呈现的神情","诗 39:11","出现 2 次"]],"bverse":"","bref":""},{"no":7409,"w":"稳当","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 40:2","top":[["诗篇",2]],"rest":[0,0],"co":[["脚步",2],["磐石",1],["坑里",1],["淤泥",1]],"books":{"诗篇":2},"verse":"求你用你的话使我脚步稳当，不许什么罪孽辖制我。","ref":"诗篇 119:133","def":"和合本用词；常见搭配：脚步 2、磐石 1、坑里 1。","senses":[["①","稳妥恰当","诗 40:2","出现 2 次"]],"bverse":"他从祸坑里，从淤泥中，把我拉上来，使我的脚立在磐石上，使我脚步稳当。","bref":"诗篇 40:2"},{"no":7410,"w":"佳音","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 40:9","top":[["诗篇",1],["启示录",1]],"rest":[0,0],"co":[["我必",1],["止住",1],["知道",1],["公义",1]],"books":{"诗篇":1,"启示录":1},"verse":"我在大会中宣传公义的佳音；我必不止住我的嘴唇。耶和华啊，这是你所知道的。","ref":"诗篇 40:9","def":"〈书〉好消息静候","senses":[["①","〈书〉好消息静候～","诗 40:9","出现 2 次"]],"bverse":"但在第七位天使吹号发声的时候，神的奥秘就成全了，正如神所传给他仆人众先知的佳音。","bref":"启示录 10:7"},{"no":7411,"w":"慈悲","py":"","pos":"形容词","orig":"","freq":17,"verses":16,"vols":7,"chaps":15,"ot":11,"nt":6,"first":"诗篇 40:11","top":[["诗篇",10],["路加福音",2]],"rest":[5,5],"co":[["耶和华",4],["慈爱",3],["不要",2],["止住",2]],"books":{"诗篇":10,"路加福音":2,"耶利米哀歌":1,"罗马书":1,"腓立比书":1,"希伯来书":1,"雅各书":1},"verse":"耶和华善待万民；他的慈悲覆庇他一切所造的。","ref":"诗篇 145:9","def":"怜悯；也指慈悲的父。","senses":[],"bverse":"他救赎你的命脱离死亡，以仁爱和慈悲为你的冠冕。","bref":"诗篇 103:4"},{"no":7412,"w":"知己","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":4,"nt":0,"first":"诗篇 41:9","top":[["诗篇",2],["耶利米书",2]],"rest":[0,0],"co":[["朋友",4],["脚踢",1],["倚靠",1],["不料",1]],"books":{"诗篇":2,"耶利米书":2},"verse":"连我知己的朋友，我所倚靠、吃过我饭的也用脚踢我。","ref":"诗篇 41:9","def":"非常了解自己并情谊深切知己话","senses":[["①","非常了解自己并情谊深","诗 41:9","出现 4 次"]],"bverse":"不料是你；你原与我平等，是我的同伴，是我知己的朋友！","bref":"诗篇 55:13"},{"no":7413,"w":"脚踢","py":"","pos":"","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 41:9","top":[["诗篇",1],["约翰福音",1]],"rest":[1,1],"co":[["朋友",1],["知己",1],["倚靠",1],["拣选",1]],"books":{"诗篇":1,"约翰福音":1,"使徒行传":1},"verse":"连我知己的朋友，我所倚靠、吃过我饭的也用脚踢我。","ref":"诗篇 41:9","def":"和合本用词；常见搭配：朋友 1、知己 1、倚靠 1。","senses":[],"bverse":"我这话不是指著你们众人说的，我知道我所拣选的是谁。现在要应验经上的话，说：‘同我吃饭的人用脚踢我。’","bref":"约翰福音 13:18"},{"no":7414,"w":"心切","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 42:1","top":[["诗篇",2]],"rest":[0,0],"co":[["可拉",1],["伶长",1],["切慕",1],["交与",1]],"books":{"诗篇":2},"verse":"（可拉后裔的训诲诗，交与伶长。）神啊，我的心切慕你，如鹿切慕溪水。","ref":"诗篇 42:1","def":"和合本用词；常见搭配：可拉 1、伶长 1、切慕 1。","senses":[["①","心情迫切","诗 42:1","出现 2 次"]],"bverse":"（大卫在犹大旷野的时候，作了这诗。）神啊，你是我的神，我要切切地寻求你，在干旱疲乏无水之地，我渴想你；我的心切慕你。","bref":"诗篇 63:1"},{"no":7415,"w":"洪涛","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 42:7","top":[["诗篇",1],["约拿书",1]],"rest":[0,0],"co":[["深渊",2],["波浪",2],["我身",2],["漫过",2]],"books":{"诗篇":1,"约拿书":1},"verse":"你的瀑布发声，深渊就与深渊响应；你的波浪洪涛漫过我身。","ref":"诗篇 42:7","def":"和合本用词；常见搭配：深渊 2、波浪 2、我身 2。","senses":[],"bverse":"你将我投下深渊，就是海的深处；大水环绕我，你的波浪洪涛都漫过我身。","bref":"约拿书 2:3"},{"no":7416,"w":"漫过","py":"","pos":"动词","orig":"","freq":16,"verses":16,"vols":5,"chaps":14,"ot":16,"nt":0,"first":"诗篇 42:7","top":[["诗篇",6],["以赛亚书",4]],"rest":[3,6],"co":[["我身",5],["大水",5],["深渊",3],["冰雹",3]],"books":{"诗篇":6,"以赛亚书":4,"以西结书":4,"耶利米书":1,"约拿书":1},"verse":"恐惧战兢归到我身；惊恐漫过了我。","ref":"诗篇 55:5","def":"漫过、淹过；诗篇「水漫过我身」。","senses":[],"bverse":"你的烈怒漫过我身；你的惊吓把我剪除。","bref":"诗篇 88:16"},{"no":7417,"w":"出令","py":"","pos":"动词","orig":"","freq":6,"verses":6,"vols":5,"chaps":6,"ot":6,"nt":0,"first":"诗篇 44:4","top":[["阿摩司书",2],["诗篇",1]],"rest":[3,3],"co":[["耶和华",3],["雅各",2],["耶路撒冷",2],["我必",2]],"books":{"阿摩司书":2,"诗篇":1,"耶利米哀歌":1,"但以理书":1,"那鸿书":1},"verse":"看哪，耶和华出令，大房就被攻破，小屋就被打裂。","ref":"阿摩司书 6:11","def":"和合本用词；常见搭配：耶和华 3、雅各 2、耶路撒冷 2。","senses":[["①","发出命令","诗 44:4","出现 6 次"]],"bverse":"我必出令，将以色列家分散在列国中，好像用筛子筛谷，连一粒也不落在地上。","bref":"阿摩司书 9:9"},{"no":7418,"w":"不靠","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":1,"nt":2,"first":"诗篇 44:6","top":[["哥林多后书",2],["诗篇",1]],"rest":[0,0],"co":[["我必",1],["不能",1],["心里",1],["复活",1]],"books":{"哥林多后书":2,"诗篇":1},"verse":"自己心里也断定是必死的，叫我们不靠自己，只靠叫死人复活的神。","ref":"哥林多后书 1:9","def":"和合本用词；常见搭配：我必 1、不能 1、心里 1。","senses":[],"bverse":"因为，我必不靠我的弓；我的刀也不能使我得胜。","bref":"诗篇 44:6"},{"no":7419,"w":"送礼","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 45:12","top":[["箴言",2],["诗篇",1]],"rest":[0,0],"co":[["必来",1],["民中",1],["女子",1],["原文",1]],"books":{"箴言":2,"诗篇":1},"verse":"欺压贫穷为要利己的，并送礼与富户的，都必缺乏。","ref":"箴言 22:16","def":"和合本用词；常见搭配：必来 1、民中 1、女子 1。","senses":[["①","指退还礼物","诗 45:12","出现 3 次"]],"bverse":"好施散的，有多人求他的恩情；爱送礼的，人都为他的朋友。","bref":"箴言 19:6"},{"no":7420,"w":"王女","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 45:13","top":[["诗篇",1],["雅歌",1]],"rest":[0,0],"co":[["宫里",1],["衣服",1],["荣华",1],["巧匠",1]],"books":{"诗篇":1,"雅歌":1},"verse":"王女在宫里极其荣华；她的衣服是用金线绣的。","ref":"诗篇 45:13","def":"古时封王者之女","senses":[["①","古时封王者之女","诗 45:13","出现 2 次"]],"bverse":"王女啊，你的脚在鞋中何其美好！你的大腿圆润，好像美玉，是巧匠的手做成的。","bref":"雅歌 7:1"},{"no":7421,"w":"荣华","py":"","pos":"名词","orig":"","freq":15,"verses":14,"vols":10,"chaps":14,"ot":11,"nt":4,"first":"诗篇 45:13","top":[["以赛亚书",3],["那鸿书",2]],"rest":[8,10],"co":[["耶和华",4],["以色列",2],["变为",2],["雅各",2]],"books":{"以赛亚书":3,"那鸿书":2,"马太福音":2,"路加福音":2,"诗篇":1,"耶利米书":1,"以西结书":1,"何西阿书":1,"阿摩司书":1,"撒迦利亚书":1},"verse":"王女在宫里极其荣华；她的衣服是用金线绣的。","ref":"诗篇 45:13","def":"草木茂盛﹑开花","senses":[["①","草木茂盛﹑开花","诗 45:13","出现 15 次"]],"bverse":"到那日，耶和华发生的苗必华美尊荣，地的出产必为以色列逃脱的人显为荣华茂盛。","bref":"以赛亚书 4:2"},{"no":7422,"w":"引到","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":1,"nt":2,"first":"诗篇 45:14","top":[["路加福音",2],["诗篇",1]],"rest":[0,0],"co":[["王前",1],["随从",1],["带到",1],["童女",1]],"books":{"路加福音":2,"诗篇":1},"verse":"要照亮坐在黑暗中死荫里的人，把我们的脚引到平安的路上。","ref":"路加福音 1:79","def":"和合本用词；常见搭配：王前 1、随从 1、带到 1。","senses":[],"bverse":"耶稣被圣灵充满，从约旦河回来，圣灵将他引到旷野，四十天受魔鬼的试探。","bref":"路加福音 4:1"},{"no":7423,"w":"翻腾","py":"","pos":"动词","orig":"","freq":12,"verses":12,"vols":7,"chaps":10,"ot":10,"nt":2,"first":"诗篇 46:3","top":[["耶利米书",3],["诗篇",2]],"rest":[5,7],"co":[["其中",3],["平静",3],["波浪",3],["过去",2]],"books":{"耶利米书":3,"诗篇":2,"以赛亚书":2,"约拿书":2,"哈巴谷书":1,"约翰福音":1,"雅各书":1},"verse":"像尼罗河涨发，像江河之水翻腾的是谁呢？","ref":"耶利米书 46:7","def":"和合本用词；常见搭配：其中 3、平静 3、波浪 3。","senses":[],"bverse":"忽然狂风大作，海就翻腾起来。","bref":"约翰福音 6:18"},{"no":7424,"w":"一道","py":"","pos":"数词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":3,"nt":1,"first":"诗篇 46:4","top":[["诗篇",1],["箴言",1]],"rest":[2,2],"co":[["指示",2],["这河",1],["居住",1],["这城",1]],"books":{"诗篇":1,"箴言":1,"阿摩司书":1,"启示录":1},"verse":"有一道河，这河的分汊使神的城欢喜；这城就是至高者居住的圣所。","ref":"诗篇 46:4","def":"和合本用词；常见搭配：指示 2、这河 1、居住 1。","senses":[["