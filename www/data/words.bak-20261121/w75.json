,"orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 60:6","top":[["诗篇",2]],"rest":[0,0],"co":[["分开",2],["我要",2],["欢乐",2],["示剑",2]],"books":{"诗篇":2},"verse":"神已经指着他的圣洁说（说：或译应许我）：我要欢乐；我要分开示剑，丈量疏割谷。","ref":"诗篇 60:6","def":"以丈为单位计量","senses":[["①","以丈为单位计量","诗 60:6","出现 2 次"]],"bverse":"神已经指着他的圣洁说（说：或译应许我）：我要欢乐；我要分开示剑，丈量疏割谷。","bref":"诗篇 108:7"},{"no":7468,"w":"我头","py":"","pos":"代词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":4,"nt":1,"first":"诗篇 60:7","top":[["诗篇",2],["雅歌",1]],"rest":[2,2],"co":[["玛拿西",2],["犹大",2],["基列",2],["护卫",2]],"books":{"诗篇":2,"雅歌":1,"耶利米哀歌":1,"加拉太书":1},"verse":"基列是我的；玛拿西是我的；以法莲是护卫我头的；犹大是我的杖；","ref":"诗篇 108:8","def":"和合本用词；常见搭配：玛拿西 2、犹大 2、基列 2。","senses":[],"bverse":"基列是我的，玛拿西也是我的。以法莲是护卫我头的；犹大是我的杖。","bref":"诗篇 60:7"},{"no":7469,"w":"神才","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"诗篇 60:12","top":[["诗篇",2],["约翰福音",1]],"rest":[0,0],"co":[["践踏",2],["倚靠",2],["敌人",2],["施展",2]],"books":{"诗篇":2,"约翰福音":1},"verse":"我们倚靠神才得施展大能，因为践踏我们敌人的就是他。","ref":"诗篇 60:12","def":"和合本用词；常见搭配：践踏 2、倚靠 2、敌人 2。","senses":[["①","神奇的人才","诗 60:12","出现 3 次"]],"bverse":"我们倚靠神才得施展大能，因为践踏我们敌人的就是他。","bref":"诗篇 108:13"},{"no":7470,"w":"发昏","py":"","pos":"动词","orig":"","freq":22,"verses":22,"vols":7,"chaps":19,"ot":22,"nt":0,"first":"诗篇 61:2","top":[["诗篇",6],["耶利米哀歌",6]],"rest":[5,10],"co":[["时候",6],["心里",4],["面前",4],["耶和华",4]],"books":{"诗篇":6,"耶利米哀歌":6,"以赛亚书":4,"耶利米书":2,"约拿书":2,"以西结书":1,"阿摩司书":1},"verse":"所以，我的灵在我里面发昏；我的心在我里面凄惨。","ref":"诗篇 143:4","def":"头晕、昏乱；心发昏表绝望。","senses":[],"bverse":"又饥又渴，心里发昏。","bref":"诗篇 107:5"},{"no":7471,"w":"世世","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"诗篇 61:6","top":[["诗篇",3]],"rest":[0,0],"co":[["寿数",1],["加添",1],["年岁",1],["必存",1]],"books":{"诗篇":3},"verse":"你要加添王的寿数；他的年岁必存到世世。","ref":"诗篇 61:6","def":"和合本用词；常见搭配：寿数 1、加添 1、年岁 1。","senses":[["①","累世;代代","诗 61:6","出现 3 次"]],"bverse":"难道他的慈爱永远穷尽，他的应许世世废弃吗？","bref":"诗篇 77:8"},{"no":7472,"w":"尊位","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 62:4","top":[["诗篇",1],["彼得后书",1]],"rest":[1,1],"co":[["污秽",2],["主治",2],["毁谤",2],["轻慢",2]],"books":{"诗篇":1,"彼得后书":1,"犹大书":1},"verse":"这些做梦的人也像他们污秽身体，轻慢主治的，毁谤在尊位的。","ref":"犹大书 1:8","def":"和合本用词；常见搭配：污秽 2、主治 2、毁谤 2。","senses":[],"bverse":"他们彼此商议，专要从他的尊位上把他推下；他们喜爱谎话，口虽祝福，心却咒诅。（细拉）","bref":"诗篇 62:4"},{"no":7473,"w":"推下","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 62:4","top":[["诗篇",1],["路加福音",1]],"rest":[0,0],"co":[["尊位",1],["商议",1],["喜爱",1],["彼此",1]],"books":{"诗篇":1,"路加福音":1},"verse":"迦百农啊，你已经升到天上（或译：你将要升到天上吗），将来必推下阴间。”","ref":"路加福音 10:15","def":"和合本用词；常见搭配：尊位 1、商议 1、喜爱 1。","senses":[["①","推让;谦让","诗 62:4","出现 2 次"]],"bverse":"他们彼此商议，专要从他的尊位上把他推下；他们喜爱谎话，口虽祝福，心却咒诅。（细拉）","bref":"诗篇 62:4"},{"no":7474,"w":"中曾","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"诗篇 63:2","top":[["耶利米书",2],["诗篇",1]],"rest":[0,0],"co":[["先知",2],["荣耀",1],["圣所",1],["如此",1]],"books":{"耶利米书":2,"诗篇":1},"verse":"我在圣所中曾如此瞻仰你，为要见你的能力和你的荣耀。","ref":"诗篇 63:2","def":"和合本用词；常见搭配：先知 2、荣耀 1、圣所 1。","senses":[],"bverse":"我在撒马利亚的先知中曾见愚妄；他们藉巴力说预言，使我的百姓以色列走错了路。","bref":"耶利米书 23:13"},{"no":7475,"w":"如刀","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 64:3","top":[["箴言",2],["诗篇",1]],"rest":[0,0],"co":[["发出",1],["好像",1],["苦毒",1],["言语",1]],"books":{"箴言":2,"诗篇":1},"verse":"说话浮躁的，如刀刺人；智慧人的舌头却为医人的良药。","ref":"箴言 12:18","def":"和合本用词；常见搭配：发出 1、好像 1、苦毒 1。","senses":[],"bverse":"有一宗人，牙如剑，齿如刀，要吞灭地上的困苦人和世间的穷乏人。","bref":"箴言 30:14"},{"no":7476,"w":"恶计","py":"","pos":"动词","orig":"","freq":6,"verses":6,"vols":6,"chaps":6,"ot":6,"nt":0,"first":"诗篇 64:5","top":[["诗篇",1],["箴言",1]],"rest":[4,4],"co":[["图谋",4],["耶和华",2],["商量",1],["网罗",1]],"books":{"诗篇":1,"箴言":1,"以赛亚书":1,"以西结书":1,"但以理书":1,"那鸿书":1},"verse":"他们彼此勉励设下恶计；他们商量暗设网罗，说：谁能看见？","ref":"诗篇 64:5","def":"和合本用词；常见搭配：图谋 4、耶和华 2、商量 1。","senses":[],"bverse":"图谋恶计的心，飞跑行恶的脚，","bref":"箴言 6:18"},{"no":7477,"w":"知足","py":"","pos":"动词","orig":"","freq":18,"verses":17,"vols":10,"chaps":15,"ot":13,"nt":5,"first":"诗篇 65:4","top":[["诗篇",3],["箴言",3]],"rest":[8,12],"co":[["耶和华",4],["得以",3],["美物",2],["心里",2]],"books":{"诗篇":3,"箴言":3,"传道书":2,"耶利米书":2,"以西结书":2,"提摩太（前书）":2,"哈巴谷书":1,"路加福音":1,"约翰福音":1,"腓立比书":1},"verse":"他用美物使你所愿的得以知足，以致你如鹰返老还童。","ref":"诗篇 103:5","def":"谓自知满足，不作过分的企求","senses":[["①","谓自知满足","诗 65:4","出现 18 次"]],"bverse":"因他使心里渴慕的人得以知足，使心里饥饿的人得饱美物。","bref":"诗篇 107:9"},{"no":7478,"w":"滴下","py":"","pos":"名词","orig":"","freq":9,"verses":9,"vols":5,"chaps":8,"ot":9,"nt":0,"first":"诗篇 65:11","top":[["箴言",2],["雅歌",2]],"rest":[3,5],"co":[["预言",3],["没药",2],["面向",2],["人子",2]],"books":{"箴言":2,"雅歌":2,"以西结书":2,"阿摩司书":2,"诗篇":1},"verse":"以知识使深渊裂开，使天空滴下甘露。","ref":"箴言 3:20","def":"和合本用词；常见搭配：预言 3、没药 2、面向 2。","senses":[],"bverse":"因为淫妇的嘴滴下蜂蜜；她的口比油更滑，","bref":"箴言 5:3"},{"no":7479,"w":"谷中","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 65:13","top":[["以西结书",2],["诗篇",1]],"rest":[0,0],"co":[["羊群",1],["草场",1],["为衣",1],["五谷",1]],"books":{"以西结书":2,"诗篇":1},"verse":"草场以羊群为衣；谷中也长满了五谷。这一切都欢呼歌唱。","ref":"诗篇 65:13","def":"和合本用词；常见搭配：羊群 1、草场 1、为衣 1。","senses":[],"bverse":"其中所逃脱的就必逃脱，各人因自己的罪孽在山上发出悲声，好像谷中的鸽子哀鸣。","bref":"以西结书 7:16"},{"no":7480,"w":"权能","py":"","pos":"名词","orig":"","freq":22,"verses":22,"vols":14,"chaps":19,"ot":3,"nt":19,"first":"诗篇 66:7","top":[["哥林多前书",3],["诗篇",2]],"rest":[12,17],"co":[["荣耀",5],["阿们",4],["永远",3],["力量",3]],"books":{"哥林多前书":3,"诗篇":2,"罗马书":2,"提摩太（前书）":2,"希伯来书":2,"彼得前书":2,"启示录":2,"以赛亚书":1,"马太福音":1,"马可福音":1,"歌罗西书":1,"帖撒罗尼迦（前书）":1,"帖撒罗尼迦（后书）":1,"彼得后书":1},"verse":"因为神的国不在乎言语，乃在乎权能。","ref":"哥林多前书 4:20","def":"权柄能力；权能者多指神。","senses":[],"bverse":"就是你们聚会的时候，我的心也同在。奉我们主耶稣的名，并用我们主耶稣的权能，","bref":"哥林多前书 5:4"},{"no":7481,"w":"用口","py":"","pos":"名词","orig":"","freq":8,"verses":8,"vols":4,"chaps":8,"ot":8,"nt":0,"first":"诗篇 66:17","top":[["诗篇",4],["箴言",2]],"rest":[2,2],"co":[["耶和华",3],["我要",2],["舌头",1],["求告",1]],"books":{"诗篇":4,"箴言":2,"以西结书":1,"何西阿书":1},"verse":"他们却用口谄媚他，用舌向他说谎。","ref":"诗篇 78:36","def":"和合本用词；常见搭配：耶和华 3、我要 2、舌头 1。","senses":[],"bverse":"我曾用口求告他；我的舌头也称他为高。","bref":"诗篇 66:17"},{"no":7482,"w":"注重","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 66:18","top":[["诗篇",1],["以赛亚书",1]],"rest":[0,0],"co":[["罪孽",1],["主必",1],["心里",1],["金子",1]],"books":{"诗篇":1,"以赛亚书":1},"verse":"我若心里注重罪孽，主必不听。","ref":"诗篇 66:18","def":"看重注重真才实学","senses":[["①","看重注重真才实学","诗 66:18","出现 2 次"]],"bverse":"我必激动米底亚人来攻击他们。米底亚人不注重银子，也不喜爱金子。","bref":"以赛亚书 13:17"},{"no":7483,"w":"修平","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":3,"chaps":5,"ot":5,"nt":0,"first":"诗篇 68:4","top":[["诗篇",2],["以赛亚书",2]],"rest":[1,1],"co":[["旷野",2],["耶和华",2],["唱诗",1],["欢乐",1]],"books":{"诗篇":2,"以赛亚书":2,"箴言":1},"verse":"他为自己的怒气修平了路，将他们交给瘟疫，使他们死亡，","ref":"诗篇 78:50","def":"和合本用词；常见搭配：旷野 2、耶和华 2、唱诗 1。","senses":[],"bverse":"要修平你脚下的路，坚定你一切的道。","bref":"箴言 4:26"},{"no":7484,"w":"势如","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"诗篇 68:14","top":[["诗篇",1],["但以理书",1]],"rest":[1,1],"co":[["境内",1],["时候",1],["撒们",1],["全能",1]],"books":{"诗篇":1,"但以理书":1,"玛拉基书":1},"verse":"全能者在境内赶散列王的时候，势如飘雪在撒们。","ref":"诗篇 68:14","def":"和合本用词；常见搭配：境内 1、时候 1、撒们 1。","senses":[],"bverse":"到末了，南方王要与他交战。北方王必用战车、马兵，和许多战船，势如暴风来攻击他，也必进入列国，如洪水泛滥。","bref":"但以理书 11:40"},{"no":7485,"w":"而来","py":"","pos":"连词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 68:26","top":[["诗篇",1],["传道书",1]],"rest":[1,1],"co":[["称颂",1],["以色列",1],["主神",1],["源头",1]],"books":{"诗篇":1,"传道书":1,"腓立比书":1},"verse":"从以色列源头而来的，当在各会中称颂主神！","ref":"诗篇 68:26","def":"和合本用词；常见搭配：称颂 1、以色列 1、主神 1。","senses":[],"bverse":"我转念观看智慧、狂妄，和愚昧。在王以后而来的人还能做什么呢？也不过行早先所行的就是了。","bref":"传道书 2:12"},{"no":7486,"w":"主神","py":"","pos":"名词","orig":"","freq":12,"verses":12,"vols":5,"chaps":12,"ot":2,"nt":10,"first":"诗篇 68:26","top":[["启示录",8],["诗篇",1]],"rest":[3,3],"co":[["全能",6],["以后",2],["作王",2],["羔羊",2]],"books":{"启示录":8,"诗篇":1,"但以理书":1,"路加福音":1,"提摩太（前书）":1},"verse":"我未见城内有殿，因主神─全能者和羔羊为城的殿。","ref":"启示录 21:22","def":"和合本用词；常见搭配：全能 6、以后 2、作王 2。","senses":[],"bverse":"说：昔在、今在的主神─全能者啊，我们感谢你！因你执掌大权作王了。","bref":"启示录 11:17"},{"no":7487,"w":"叱喝","py":"","pos":"动词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"诗篇 68:30","top":[["以赛亚书",2],["诗篇",1]],"rest":[0,0],"co":[["脚下",1],["争战",1],["并列",1],["赶散",1]],"books":{"以赛亚书":2,"诗篇":1},"verse":"求你叱喝芦苇中的野兽和群公牛，并列邦中的牛犊。把银块踹在脚下；神已经赶散好争战的列邦。","ref":"诗篇 68:30","def":"和合本用词；常见搭配：脚下 1、争战 1、并列 1。","senses":[],"bverse":"一人叱喝，必令千人逃跑；五人叱喝，你们都必逃跑；以致剩下的，好像山顶的旗杆，冈上的大旗。","bref":"以赛亚书 30:17"},{"no":7488,"w":"自古","py":"","pos":"副词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 68:33","top":[["诗篇",1],["犹大书",1]],"rest":[0,0],"co":[["声音",1],["歌颂",1],["极大",1],["以上",1]],"books":{"诗篇":1,"犹大书":1},"verse":"歌颂那自古驾行在诸天以上的主！他发出声音，是极大的声音。","ref":"诗篇 68:33","def":"和合本用词；常见搭配：声音 1、歌颂 1、极大 1。","senses":[["①","从古以来","诗 68:33","出现 2 次"]],"bverse":"因为有些人偷着进来，就是自古被定受刑罚的，是不虔诚的，将我们神的恩变作放纵情欲的机会，并且不认独一的主宰─我们（或译：和我们）主耶稣基督。","bref":"犹大书 1:4"},{"no":7489,"w":"外路","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 69:8","top":[["诗篇",1],["耶利米哀歌",1]],"rest":[0,0],"co":[["外邦人",2],["弟兄",1],["同胞",1],["房屋",1]],"books":{"诗篇":1,"耶利米哀歌":1},"verse":"我的弟兄看我为外路人；我的同胞看我为外邦人。","ref":"诗篇 69:8","def":"宋代以后指各地方行政区划","senses":[["①","宋代以后指各地方行政","诗 69:8","出现 2 次"]],"bverse":"我们的产业归与外邦人；我们的房屋归与外路人。","bref":"耶利米哀歌 5:2"},{"no":7490,"w":"倒算","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 69:10","top":[["诗篇",1],["路加福音",1]],"rest":[0,0],"co":[["我心",1],["羞辱",1],["哭泣",1],["禁食",1]],"books":{"诗篇":1,"路加福音":1},"verse":"我哭泣，以禁食刻苦我心；这倒算为我的羞辱。","ref":"诗篇 69:10","def":"指反动地主向农民夺回由革命政权分给的土地﹑财物等，这种活动大多依靠反革命武装进行","senses":[["①","指反动地主向农民夺回","诗 69:10","出现 2 次"]],"bverse":"我告诉你们，这人回家去比那人倒算为义了；因为，凡自高的，必降为卑；自卑的，必升为高。”","bref":"路加福音 18:14"},{"no":7491,"w":"酒徒","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":3,"ot":4,"nt":0,"first":"诗篇 69:12","top":[["以赛亚书",2],["诗篇",1]],"rest":[1,1],"co":[["高傲",2],["冠冕",2],["以法莲",2],["歌曲",1]],"books":{"以赛亚书":2,"诗篇":1,"以西结书":1},"verse":"以法莲高傲的酒徒，他的冠冕必被踏在脚下。","ref":"以赛亚书 28:3","def":"和合本用词；常见搭配：高傲 2、冠冕 2、以法莲 2。","senses":[],"bverse":"坐在城门口的谈论我；酒徒也以我为歌曲。","bref":"诗篇 69:12"},{"no":7492,"w":"伤破","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 69:20","top":[["诗篇",1],["以西结书",1]],"rest":[0,0],"co":[["体恤",1],["有人",1],["指望",1],["辱骂",1]],"books":{"诗篇":1,"以西结书":1},"verse":"辱骂伤破了我的心，我又满了忧愁。我指望有人体恤，却没有一个；我指望有人安慰，却找不着一个。","ref":"诗篇 69:20","def":"和合本用词；常见搭配：体恤 1、有人 1、指望 1。","senses":[],"bverse":"那脱离刀剑的人必在所掳到的各国中记念我，为他们心中何等伤破，是因他们起淫心，远离我，眼对偶像行邪淫。他们因行一切可憎的恶事，必厌恶自己。","bref":"以西结书 6:9"},{"no":7493,"w":"体恤","py":"","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":1,"nt":3,"first":"诗篇 69:20","top":[["希伯来书",2],["诗篇",1]],"rest":[1,1],"co":[["伤破",1],["有人",1],["指望",1],["辱骂",1]],"books":{"希伯来书":2,"诗篇":1,"彼得前书":1},"verse":"总而言之，你们都要同心，彼此体恤，相爱如弟兄，存慈怜谦卑的心。","ref":"彼得前书 3:8","def":"和合本用词；常见搭配：伤破 1、有人 1、指望 1。","senses":[],"bverse":"辱骂伤破了我的心，我又满了忧愁。我指望有人体恤，却没有一个；我指望有人安慰，却找不着一个。","bref":"诗篇 69:20"},{"no":7494,"w":"苦胆","py":"","pos":"名词","orig":"","freq":9,"verses":9,"vols":6,"chaps":8,"ot":7,"nt":2,"first":"诗篇 69:21","top":[["耶利米书",3],["耶利米哀歌",2]],"rest":[4,4],"co":[["茵陈",4],["水给",3],["那里",2],["耶和华",2]],"books":{"耶利米书":3,"耶利米哀歌":2,"诗篇":1,"阿摩司书":1,"马太福音":1,"使徒行传":1},"verse":"我看出你正在苦胆之中，被罪恶捆绑。”","ref":"使徒行传 8:23","def":"和合本用词；常见搭配：茵陈 4、水给 3、那里 2。","senses":[],"bverse":"耶和华啊，求你记念我如茵陈和苦胆的困苦窘迫。","bref":"耶利米哀歌 3:19"},{"no":7495,"w":"昏蒙","py":"","pos":"","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 69:23","top":[["诗篇",1],["使徒行传",1]],"rest":[1,1],"co":[["眼睛",3],["看见",2],["战抖",1],["常常",1]],"books":{"诗篇":1,"使徒行传":1,"罗马书":1},"verse":"愿他们的眼睛昏蒙，不得看见；愿你使他们的腰常常战抖。","ref":"诗篇 69:23","def":"和合本用词；常见搭配：眼睛 3、看见 2、战抖 1。","senses":[["①","亦作\"昏瞢\"","诗 69:23","出现 3 次"]],"bverse":"愿他们的眼睛昏蒙，不得看见；愿你时常弯下他们的腰。","bref":"罗马书 11:10"},{"no":7496,"w":"民要","py":"","pos":"","orig":"","freq":7,"verses":7,"vols":5,"chaps":7,"ot":4,"nt":3,"first":"诗篇 69:35","top":[["诗篇",3],["耶利米书",1]],"rest":[3,3],"co":[["国要",3],["攻打",3],["耶和华",2],["多处",2]],"books":{"诗篇":3,"耶利米书":1,"马太福音":1,"马可福音":1,"路加福音":1},"verse":"这必为后代的人记下，将来受造的民要赞美耶和华。","ref":"诗篇 102:18","def":"和合本用词；常见搭配：国要 3、攻打 3、耶和华 2。","senses":[],"bverse":"因为神要拯救锡安，建造犹大的城邑；他的民要在那里居住，得以为业。","bref":"诗篇 69:35"},{"no":7497,"w":"单要","py":"","pos":"","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 71:16","top":[["诗篇",1],["马太福音",1]],"rest":[1,1],"co":[["耶稣",2],["经上",2],["记着",2],["我要",1]],"books":{"诗篇":1,"马太福音":1,"路加福音":1},"verse":"我要来说主─耶和华大能的事；我单要提说你的公义。","ref":"诗篇 71:16","def":"和合本用词；常见搭配：耶稣 2、经上 2、记着 2。","senses":[],"bverse":"耶稣说：“经上记着说：当拜主─你的神，单要事奉他。”","bref":"路加福音 4:8"},{"no":7498,"w":"自我","py":"","pos":"代词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 71:17","top":[["诗篇",1],["以赛亚书",1]],"rest":[0,0],"co":[["传扬",1],["教训",1],["奇妙",1],["作为",1]],"books":{"诗篇":1,"以赛亚书":1},"verse":"神啊，自我年幼时，你就教训我；直到如今，我传扬你奇妙的作为。","ref":"诗篇 71:17","def":"和合本用词；常见搭配：传扬 1、教训 1、奇妙 1。","senses":[],"bverse":"众海岛啊，当听我言！远方的众民哪，留心而听！自我出胎，耶和华就选召我；自出母腹，他就提我的名。","bref":"以赛亚书 49:1"},{"no":7499,"w":"后世","py":"","pos":"时间词","orig":"","freq":5,"verses":5,"vols":4,"chaps":4,"ot":4,"nt":1,"first":"诗篇 71:18","top":[["耶利米书",2],["诗篇",1]],"rest":[2,2],"co":[["子孙",2],["不要",1],["年老",1],["时候",1]],"books":{"耶利米书":2,"诗篇":1,"以赛亚书":1,"彼得后书":1},"verse":"又判定所多玛、蛾摩拉，将二城倾覆，焚烧成灰，作为后世不敬虔人的鉴戒；","ref":"彼得后书 2:6","def":"和合本用词；常见搭配：子孙 2、不要 1、年老 1。","senses":[],"bverse":"我要使他们彼此同心同道，好叫他们永远敬畏我，使他们和他们后世的子孙得福乐，","bref":"耶利米书 32:39"},{"no":7500,"w":"经历","py":"","pos":"名词","orig":"","freq":8,"verses":8,"vols":5,"chaps":8,"ot":3,"nt":5,"first":"诗篇 71:20","top":[["传道书",2],["马太福音",2]],"rest":[3,4],"co":[["智慧",2],["时候",2],["看守",2],["坚固",2]],"books":{"传道书":2,"马太福音":2,"使徒行传":2,"诗篇":1,"彼得前书":1},"verse":"服事主，凡事谦卑，眼中流泪，又因犹太人的谋害，经历试炼。","ref":"使徒行传 20:19","def":"和合本用词；常见搭配：智慧 2、时候 2、看守 2。","senses":[],"bverse":"凡遵守命令的，必不经历祸患；智慧人的心能辨明时候和定理（原文是审判；下节同）。","bref":"传道书 8:5"}]