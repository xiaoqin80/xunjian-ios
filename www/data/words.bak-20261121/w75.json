 次"]],"bverse":"我整天伸手招呼那悖逆的百姓；他们随自己的意念行不善之道。","bref":"以赛亚书 65:2"},{"no":7439,"w":"全美","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 50:2","top":[["诗篇",1],["耶利米哀歌",1]],"rest":[0,0],"co":[["发光",1],["锡安",1],["嗤笑",1],["摇头",1]],"books":{"诗篇":1,"耶利米哀歌":1},"verse":"从全美的锡安中，神已经发光了。","ref":"诗篇 50:2","def":"和合本用词；常见搭配：发光 1、锡安 1、嗤笑 1。","senses":[["①","谓美意成全","诗 50:2","出现 2 次"]],"bverse":"凡过路的都向你拍掌。他们向耶路撒冷城嗤笑，摇头，说：难道人所称为全美的，称为全地所喜悦的，就是这城吗？","bref":"耶利米哀歌 2:15"},{"no":7440,"w":"编造","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"诗篇 50:19","top":[["诗篇",1],["启示录",1]],"rest":[0,0],"co":[["恶言",1],["诡诈",1],["犬类",1],["城外",1]],"books":{"诗篇":1,"启示录":1},"verse":"你口任说恶言；你舌编造诡诈。","ref":"诗篇 50:19","def":"把资料组织排列起来","senses":[["①","把资料组织排列起来～","诗 50:19","出现 2 次"]],"bverse":"城外有那些犬类、行邪术的、淫乱的、杀人的、拜偶像的，并一切喜好说谎言、编造虚谎的。","bref":"启示录 22:15"},{"no":7441,"w":"洗除","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"诗篇 51:2","top":[["诗篇",1],["约珥书",1]],"rest":[1,1],"co":[["罪孽",1],["净尽",1],["我要",1],["报复",1]],"books":{"诗篇":1,"约珥书":1,"撒迦利亚书":1},"verse":"求你将我的罪孽洗除净尽，并洁除我的罪！","ref":"诗篇 51:2","def":"和合本用词；常见搭配：罪孽 1、净尽 1、我要 1。","senses":[],"bverse":"那日，必给大卫家和耶路撒冷的居民开一个泉源，洗除罪恶与污秽。","bref":"撒迦利亚书 13:1"},{"no":7442,"w":"美意","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":1,"nt":4,"first":"诗篇 51:18","top":[["诗篇",1],["马太福音",1]],"rest":[3,3],"co":[["如此",2],["锡安",1],["善待",1],["建造",1]],"books":{"诗篇":1,"马太福音":1,"路加福音":1,"以弗所书":1,"腓立比书":1},"verse":"求你随你的美意善待锡安，建造耶路撒冷的城墙。","ref":"诗篇 51:18","def":"和合本用词；常见搭配：如此 2、锡安 1、善待 1。","senses":[["①","美好的情意","诗 51:18","出现 5 次"]],"bverse":"父啊，是的，因为你的美意本是如此。","bref":"马太福音 11:26"},{"no":7443,"w":"快利","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 52:2","top":[["诗篇",1],["以赛亚书",1]],"rest":[0,0],"co":[["好像",2],["舌头",1],["邪恶",1],["诡诈",1]],"books":{"诗篇":1,"以赛亚书":1},"verse":"你的舌头邪恶诡诈，好像剃头刀，快利伤人。","ref":"诗篇 52:2","def":"和合本用词；常见搭配：好像 2、舌头 1、邪恶 1。","senses":[["①","锋利;锐利","诗 52:2","出现 2 次"]],"bverse":"他们的箭快利，弓也上了弦。马蹄算如坚石，车轮好像旋风。","bref":"以赛亚书 5:28"},{"no":7444,"w":"伤人","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":4,"nt":1,"first":"诗篇 52:2","top":[["以赛亚书",2],["诗篇",1]],"rest":[2,2],"co":[["耶和华",3],["好像",2],["圣山",2],["遍处",2]],"books":{"以赛亚书":2,"诗篇":1,"以西结书":1,"启示录":1},"verse":"你的舌头邪恶诡诈，好像剃头刀，快利伤人。","ref":"诗篇 52:2","def":"和合本用词；常见搭配：耶和华 3、好像 2、圣山 2。","senses":[],"bverse":"有尾巴像蝎子，尾巴上的毒钩能伤人五个月。","bref":"启示录 9:10"},{"no":7445,"w":"不爱","py":"","pos":"副词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":1,"nt":4,"first":"诗篇 52:3","top":[["约翰（一书）",2],["诗篇",1]],"rest":[2,2],"co":[["不能",2],["弟兄",2],["说谎",1],["胜似",1]],"books":{"约翰（一书）":2,"诗篇":1,"约翰福音":1,"提摩太（后书）":1},"verse":"你爱恶胜似爱善，又爱说谎，不爱说公义。（细拉）","ref":"诗篇 52:3","def":"和合本用词；常见搭配：不能 2、弟兄 2、说谎 1。","senses":[],"bverse":"从此就显出谁是神的儿女，谁是魔鬼的儿女。凡不行义的就不属神，不爱弟兄的也是如此。","bref":"约翰一书 3:10"},{"no":7446,"w":"无可","py":"","pos":"动词","orig":"","freq":11,"verses":11,"vols":6,"chaps":10,"ot":1,"nt":10,"first":"诗篇 53:5","top":[["罗马书",4],["腓立比书",2]],"rest":[4,5],"co":[["指摘",5],["推诿",3],["时候",2],["蒙羞",1]],"books":{"罗马书":4,"腓立比书":2,"帖撒罗尼迦（前书）":2,"诗篇":1,"约翰福音":1,"彼得后书":1},"verse":"倘若亚伯拉罕是因行为称义，就有可夸的；只是在神面前并无可夸。","ref":"罗马书 4:2","def":"犹言无可无不可","senses":[["①","犹言无可无不可","诗 53:5","出现 11 次"]],"bverse":"就热心说，我是逼迫教会的；就律法上的义说，我是无可指摘的。","bref":"腓立比书 3:6"},{"no":7447,"w":"弃绝","py":"","pos":"动词","orig":"","freq":49,"verses":43,"vols":22,"chaps":36,"ot":16,"nt":33,"first":"诗篇 53:5","top":[["路加福音",6],["耶利米书",5]],"rest":[20,38],"co":[["耶和华",5],["知道",5],["听从",4],["百姓",4]],"books":{"路加福音":6,"耶利米书":5,"使徒行传":5,"箴言":4,"哥林多后书":4,"帖撒罗尼迦（前书）":3,"希伯来书":3,"诗篇":2,"何西阿书":2,"罗马书":2,"启示录":2,"以赛亚书":1,"耶利米哀歌":1,"撒迦利亚书":1,"马可福音":1,"约翰福音":1,"哥林多前书":1,"以弗所书":1,"歌罗西书":1,"提摩太（前书）":1,"提摩太（后书）":1,"提多书":1},"verse":"只是他必须先受许多苦，又被这世代弃绝。","ref":"路加福音 17:25","def":"丢弃、拒绝；诗篇 53:5 记神弃绝他们。","senses":[],"bverse":"又说：“人子必须受许多的苦，被长老、祭司长、和文士弃绝，并且被杀，第三日复