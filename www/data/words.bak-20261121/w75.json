ef":"但以理书 8:10","def":"和合本用词；常见搭配：天象 2、诚实 1、达到 1。","senses":[],"bverse":"并且它自高自大，以为高及天象之君；除掉常献给君的燔祭，毁坏君的圣所。","bref":"但以理书 8:11"},{"no":7458,"w":"走错","py":"","pos":"动词","orig":"","freq":6,"verses":6,"vols":3,"chaps":5,"ot":6,"nt":0,"first":"诗篇 58:3","top":[["以赛亚书",3],["耶利米书",2]],"rest":[1,1],"co":[["百姓",4],["引导",2],["预言",2],["疏远",1]],"books":{"以赛亚书":3,"耶利米书":2,"诗篇":1},"verse":"因为，引导这百姓的使他们走错了路；被引导的都必败亡。","ref":"以赛亚书 9:16","def":"和合本用词；常见搭配：百姓 4、引导 2、预言 2。","senses":[],"bverse":"恶人一出母胎就与神疏远，一离母腹便走错路，说谎话。","bref":"诗篇 58:3"},{"no":7459,"w":"谎话","py":"","pos":"名词","orig":"","freq":24,"verses":24,"vols":11,"chaps":22,"ot":14,"nt":10,"first":"诗篇 58:3","top":[["诗篇",6],["约翰（一书）",4]],"rest":[9,14],"co":[["诚实",3],["乃是",3],["恶人",2],["起假",2]],"books":{"诗篇":6,"约翰（一书）":4,"箴言":3,"耶利米书":2,"何西阿书":2,"启示录":2,"以西结书":1,"加拉太书":1,"提摩太（前书）":1,"提多书":1,"雅各书":1},"verse":"他们的口说谎话；他们的右手起假誓。","ref":"诗篇 144:8","def":"假话。","senses":[],"bverse":"谎话是我所恨恶所憎嫌的；惟你的律法是我所爱的。","bref":"诗篇 119:163"},{"no":7460,"w":"塞耳","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":4,"nt":0,"first":"诗篇 58:4","top":[["诗篇",1],["箴言",1]],"rest":[2,2],"co":[["好像",1],["毒气",1],["哀求",1],["呼吁",1]],"books":{"诗篇":1,"箴言":1,"以赛亚书":1,"撒迦利亚书":1},"verse":"他们的毒气好像蛇的毒气；他们好像塞耳的聋虺，","ref":"诗篇 58:4","def":"堵住耳朵。谓有意不听","senses":[["①","堵住耳朵","诗 58:4","出现 4 次"]],"bverse":"他们却不肯听从，扭转肩头，塞耳不听，","bref":"撒迦利亚书 7:11"},{"no":7461,"w":"大牙","py":"","pos":"名词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"诗篇 58:6","top":[["约珥书",2],["诗篇",1]],"rest":[0,0],"co":[["狮子",2],["少壮",1],["口中",1],["敲掉",1]],"books":{"约珥书":2,"诗篇":1},"verse":"神啊，求你敲碎他们口中的牙；耶和华啊，求你敲掉少壮狮子的大牙！","ref":"诗篇 58:6","def":"指旗竿上饰以象牙的大旗。多为主帅标识旗﹐亦为仪仗用旗","senses":[["①","指旗竿上饰以象牙的大","诗 58:6","出现 3 次"]],"bverse":"有一队蝗虫（原文是民）又强盛又无数，侵犯我的地；它的牙齿如狮子的牙齿，大牙如母狮的大牙。","bref":"约珥书 1:6"},{"no":7462,"w":"烧火","py":"","pos":"动词","orig":"","freq":6,"verses":6,"vols":5,"chaps":5,"ot":6,"nt":0,"first":"诗篇 58:9","top":[["以西结书",2],["诗篇",1]],"rest":[3,3],"co":[["器械",2],["荆