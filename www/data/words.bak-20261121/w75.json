se":"“这比喻乃是这样：种子就是神的道。","ref":"路加福音 8:11","def":"以日常事物讲明天国道理；太 13 章集中记载。","senses":[["①","修辞手法","诗 49:4","出现 55 次"]],"bverse":"门徒问耶稣说：“这比喻是什么意思呢？”","bref":"路加福音 8:9"},{"no":7430,"w":"倚仗","py":"","pos":"动词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":5,"nt":0,"first":"诗篇 49:6","top":[["诗篇",2],["箴言",1]],"rest":[2,2],"co":[["财物",2],["钱财",1],["财货",1],["自夸",1]],"books":{"诗篇":2,"箴言":1,"以赛亚书":1,"以西结书":1},"verse":"那些倚仗财货自夸钱财多的人，","ref":"诗篇 49:6","def":"依赖;依靠;仗恃","senses":[["①","依赖;依靠;仗恃","诗 49:6","出现 5 次"]],"bverse":"说：看哪，这就是那不以神为他力量的人，只倚仗他丰富的财物，在邪恶上坚立自己。","bref":"诗篇 52:7"},{"no":7431,"w":"长远","py":"","pos":"副词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":1,"nt":2,"first":"诗篇 49:8","top":[["希伯来书",2],["诗篇",1]],"rest":[0,0],"co":[["活着",2],["价值",1],["罢休",1],["极贵",1]],"books":{"希伯来书":2,"诗篇":1},"verse":"凡靠着他进到神面前的人，他都能拯救到底；因为他是长远活着，替他们祈求。","ref":"希伯来书 7:25","def":"和合本用词；常见搭配：活着 2、价值 1、罢休 1。","senses":[],"bverse":"叫他长远活着，不见朽坏；因为赎他生命的价值极贵，只可永远罢休。","bref":"诗篇 49:8"},{"no":7432,"w":"极贵","py":"","pos":"形容词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"诗篇 49:8","top":[["诗篇",1],["马太福音",1]],"rest":[2,2],"co":[["耶稣",2],["香膏",2],["价值",1],["罢休",1]],"books":{"诗篇":1,"马太福音":1,"约翰福音":1,"启示录":1},"verse":"叫他长远活着，不见朽坏；因为赎他生命的价值极贵，只可永远罢休。","ref":"诗篇 49:8","def":"非常高贵;极其贵重","senses":[["①","非常高贵;极其贵重","诗 49:8","出现 4 次"]],"bverse":"城中有神的荣耀；城的光辉如同极贵的宝石，好像碧玉，明如水晶。","bref":"启示录 21:11"},{"no":7433,"w":"佩服","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":1,"nt":2,"first":"诗篇 49:13","top":[["提摩太（前书）",2],["诗篇",1]],"rest":[0,0],"co":[["可信",2],["十分",2],["这话",2],["话语",1]],"books":{"提摩太（前书）":2,"诗篇":1},"verse":"这话是可信的，是十分可佩服的。","ref":"提摩太前书 4:9","def":"佩带有宝玉于是，俗人投之，卞和佩服。②钦佩；敬仰悦服令人佩服之至","senses":[["①","佩带有宝玉于是","诗 49:13","出现 3 次"]],"bverse":"他们行的这道本为自己的愚昧；但他们以后的人还佩服他们的话语。（细拉）","bref":"诗篇 49:13"},{"no":7434,"w":"美容","py":"","pos":"名词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":5,"nt":1,"first":"诗篇 49:14","top":[["以赛亚书",3],["诗篇",1]],