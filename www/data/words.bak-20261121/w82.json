s":[],"bverse":"他必指给你们摆设整齐的一间大楼，你们就在那里为我们预备。”","bref":"马可福音 14:15"},{"no":8146,"w":"新天新地","py":"","pos":"形容词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":2,"nt":2,"first":"以赛亚书 65:17","top":[["以赛亚书",2],["彼得后书",1]],"rest":[1,1],"co":[["不再",2],["从前",1],["记念",1],["追想",1]],"books":{"以赛亚书":2,"彼得后书":1,"启示录":1},"verse":"看哪！我造新天新地；从前的事不再被记念，也不再追想。","ref":"以赛亚书 65:17","def":"末后更新的宇宙，神与人同住","senses":[["①","末后更新的宇宙","赛 65:17","出现 4 次"]],"bverse":"但我们照他的应许，盼望新天新地，有义居在其中。","bref":"彼得后书 3:13"},{"no":8147,"w":"老者","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 65:20","top":[["以赛亚书",1],["以西结书",1]],"rest":[1,1],"co":[["孩童",2],["寿数",1],["咒诅",1],["罪人",1]],"books":{"以赛亚书":1,"以西结书":1,"约珥书":1},"verse":"聚集众民，使会众自洁：招聚老者，聚集孩童和吃奶的；使新郎出离洞房，新妇出离内室。","ref":"约珥书 2:16","def":"和合本用词；常见搭配：孩童 2、寿数 1、咒诅 1。","senses":[["①","年老的男子","赛 65:20","出现 3 次"]],"bverse":"其中必没有数日夭亡的婴孩，也没有寿数不满的老者；因为百岁死的仍算孩童，有百岁死的罪人算被咒诅。","bref":"以赛亚书 65:20"},{"no":8148,"w":"假冒","py":"","pos":"动词","orig":"","freq":22,"verses":22,"vols":6,"chaps":13,"ot":1,"nt":21,"first":"以赛亚书 66:3","top":[["马太福音",14],["路加福音",4]],"rest":[4,4],"co":[["为善",20],["法利赛人",8],["文士",7],["不可",4]],"books":{"马太福音":14,"路加福音":4,"以赛亚书":1,"马可福音":1,"提摩太（前书）":1,"雅各书":1},"verse":"假冒为善的人哪，以赛亚指著你们说的预言是不错的。他说：","ref":"马太福音 15:7","def":"假装；「假冒为善的人」。","senses":[],"bverse":"耶稣看出他们的恶意，就说：“假冒为善的人哪，为什么试探我？","bref":"马太福音 22:18"},{"no":8149,"w":"延及","py":"","pos":"名词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"以赛亚书 66:12","top":[["以赛亚书",2],["弥迦书",1]],"rest":[0,0],"co":[["我要",1],["涨溢",1],["好像",1],["列国",1]],"books":{"以赛亚书":2,"弥迦书":1},"verse":"因为撒马利亚的伤痕无法医治，延及犹大和耶路撒冷我民的城门。","ref":"弥迦书 1:9","def":"扩展到;延伸到","senses":[["①","扩展到;延伸到","赛 66:12","出现 3 次"]],"bverse":"耶和华如此说：我要使平安延及她，好像江河，使列国的荣耀延及她，如同涨溢的河。你们要从中享受（原文是咂）；你们必蒙抱在肋旁，摇弄在膝上。","bref":"以赛亚书 66:12"},{"no":8150,"w":"差到","py":"","pos":"形容词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"以赛亚书 66:19","top":[["以赛亚书",1],["约翰