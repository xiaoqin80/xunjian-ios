[{"no":8101,"w":"这杯","py":"","pos":"代词","orig":"","freq":13,"verses":13,"vols":7,"chaps":7,"ot":5,"nt":8,"first":"以赛亚书 51:23","top":[["耶利米书",3],["哥林多前书",3]],"rest":[5,7],"co":[["手中",3],["如此",3],["耶和华",3],["不要",3]],"books":{"耶利米书":3,"哥林多前书":3,"马太福音":2,"路加福音":2,"以赛亚书":1,"以西结书":1,"马可福音":1},"verse":"我就从耶和华的手中接了这杯，给耶和华所差遣我去的各国的民喝，","ref":"耶利米书 25:17","def":"和合本用词；常见搭配：手中 3、如此 3、耶和华 3。","senses":[],"bverse":"“他们若不肯从你手接这杯喝，你就要对他们说：‘万军之耶和华如此说：你们一定要喝！","bref":"耶利米书 25:28"},{"no":8102,"w":"无价","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以赛亚书 52:3","top":[["以赛亚书",2]],"rest":[0,0],"co":[["耶和华",2],["必无",1],["如此",1],["辖制",1]],"books":{"以赛亚书":2},"verse":"耶和华如此说：“你们是无价被卖的，也必无银被赎。","ref":"以赛亚书 52:3","def":"无法计算价值。比喻极为珍贵","senses":[["①","无法计算价值","赛 52:3","出现 2 次"]],"bverse":"耶和华说：我的百姓既是无价被掳去，如今我在这里做什么呢？耶和华说：辖制他们的人呼叫，我的名整天受亵渎。","bref":"以赛亚书 52:5"},{"no":8103,"w":"鼓动","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 52:15","top":[["以赛亚书",1],["使徒行传",1]],"rest":[0,0],"co":[["许多",1],["国民",1],["闭口",1],["未曾",1]],"books":{"以赛亚书":1,"使徒行传":1},"verse":"我们看这个人，如同瘟疫一般，是鼓动普天下众犹太人生乱的，又是拿撒勒教党里的一个头目，","ref":"使徒行传 24:5","def":"和合本用词；常见搭配：许多 1、国民 1、闭口 1。","senses":[["①","扇动小鸟～翅膀","赛 52:15","出现 2 次"]],"bverse":"这样，他必洗净（或译：鼓动）许多国民；君王要向他闭口。因所未曾传与他们的，他们必看见；未曾听见的，他们要明白。","bref":"以赛亚书 52:15"},{"no":8104,"w":"多受","py":"","pos":"数词","orig":"","freq":4,"verses":4,"vols":3,"chaps":3,"ot":1,"nt":3,"first":"以赛亚书 53:3","top":[["罗马书",2],["以赛亚书",1]],"rest":[1,1],"co":[["劳苦",3],["痛苦",1],["藐视",1],["掩面",1]],"books":{"罗马书":2,"以赛亚书":1,"哥林多后书":1},"verse":"又问马利亚安；她为你们多受劳苦。","ref":"罗马书 16:6","def":"和合本用词；常见搭配：劳苦 3、痛苦 1、藐视 1。","senses":[],"bverse":"又问为主劳苦的土非拿氏和土富撒氏安。问可亲爱为主多受劳苦的彼息氏安。","bref":"罗马书 16:12"},{"no":8105,"w":"延长","py":"","pos":"动词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":5,"nt":0,"first":"以赛亚书 53:10","top":[["以赛亚书",1],["耶利米书",1]],"rest":[3,3],"co":[["痛苦",1],["手中",1],["后裔",1],["事必",1]],"books":{"以赛亚书":1,"耶利米书":1,"以西结书":1,"但以理书":1,"何西阿书":1},"verse":"他的枝条必延长；他的荣华如橄榄树；他的香气如黎巴嫩的香柏树。","ref":"何西阿书 14:6","def":"和合本用词；常见搭配：痛苦 1、手中 1、后裔 1。","senses":[["①","绵延久长","赛 53:10","出现 5 次"]],"bverse":"耶和华却定意（或译：喜悦）将他压伤，使他受痛苦。耶和华以他为赎罪祭（或译：他献本身为赎罪祭）。他必看见后裔，并且延长年日。耶和华所喜悦的事必在他手中亨通。","bref":"以赛亚书 53:10"},{"no":8106,"w":"事必","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"以赛亚书 53:10","top":[["耶利米书",2],["以赛亚书",1]],"rest":[1,1],"co":[["耶和华",2],["痛苦",1],["手中",1],["后裔",1]],"books":{"耶利米书":2,"以赛亚书":1,"哈巴谷书":1},"verse":"你向黎巴嫩行强暴与残害惊吓野兽的事必遮盖你；因你杀人流血，向国内的城并城中一切居民施行强暴。","ref":"哈巴谷书 2:17","def":"和合本用词；常见搭配：耶和华 2、痛苦 1、手中 1。","senses":[],"bverse":"耶和华却定意（或译：喜悦）将他压伤，使他受痛苦。耶和华以他为赎罪祭（或译：他献本身为赎罪祭）。他必看见后裔，并且延长年日。耶和华所喜悦的事必在他手中亨通。","bref":"以赛亚书 53:10"},{"no":8107,"w":"罪犯","py":"","pos":"名词","orig":"","freq":4,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":2,"first":"以赛亚书 53:12","top":[["以赛亚书",2],["马可福音",1]],"rest":[1,1],"co":[["经上",2],["均分",1],["掳物",1],["我要",1]],"books":{"以赛亚书":2,"马可福音":1,"路加福音":1},"verse":"这就应了经上的话说：他被列在罪犯之中。）","ref":"马可福音 15:28","def":"亦称犯人”。被法院定罪处刑，而且判决已经发生法律效力的人","senses":[["①","亦称犯人”","赛 53:12","出现 4 次"]],"bverse":"所以，我要使他与位大的同分，与强盛的均分掳物。因为他将命倾倒，以致于死；他也被列在罪犯之中。他却担当多人的罪，又为罪犯代求。","bref":"以赛亚书 53:12"},{"no":8108,"w":"代求","py":"","pos":"名词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":4,"nt":2,"first":"以赛亚书 53:12","top":[["以赛亚书",2],["耶利米书",2]],"rest":[2,2],"co":[["面前",2],["均分",1],["掳物",1],["我要",1]],"books":{"以赛亚书":2,"耶利米书":2,"提摩太（前书）":1,"雅各书":1},"verse":"我劝你，第一要为万人恳求、祷告、代求、祝谢；","ref":"提摩太前书 2:1","def":"替别人向神求；提前 2:1 列为当行之事。","senses":[],"bverse":"他见无人拯救，无人代求，甚为诧异，就用自己的膀臂施行拯救，以公义扶持自己。","bref":"以赛亚书 59:16"},{"no":8109,"w":"这受","py":"","pos":"代词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"以赛亚书 54:11","top":[["以赛亚书",1],["以西结书",1]],"rest":[1,1],"co":[["安置",1],["石头",1],["困苦",1],["飘荡",1]],"books":{"以赛亚书":1,"以西结书":1,"帖撒罗尼迦（后书）":1},"verse":"你这受死伤行恶的以色列王啊，罪孽的尽头到了，受报的日子已到。","ref":"以西结书 21:25","def":"和合本用词；常见搭配：安置 1、石头 1、困苦 1。","senses":[],"bverse":"你这受困苦、被风飘荡不得安慰的人哪，我必以彩色安置你的石头，以蓝宝石立定你的根基；","bref":"以赛亚书 54:11"},{"no":8110,"w":"合用","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以赛亚书 54:16","top":[["以赛亚书",1],["路加福音",1]],"rest":[0,0],"co":[["打造",1],["铁匠",1],["炭火",1],["器械",1]],"books":{"以赛亚书":1,"路加福音":1},"verse":"吹嘘炭火、打造合用器械的铁匠是我所造；残害人、行毁灭的也是我所造。","ref":"以赛亚书 54:16","def":"共同使用两家","senses":[["①","共同使用两家～一个厨","赛 54:16","出现 2 次"]],"bverse":"他必有以利亚的心志能力，行在主的前面，叫为父的心转向儿女，叫悖逆的人转从义人的智慧，又为主预备合用的百姓。”","bref":"路加福音 1:17"},{"no":8111,"w":"从天而降","py":"","pos":"","orig":"","freq":5,"verses":5,"vols":3,"chaps":3,"ot":3,"nt":2,"first":"以赛亚书 55:10","top":[["但以理书",2],["启示录",2]],"rest":[1,1],"co":[["地上",2],["圣者",2],["守望",2],["一位",2]],"books":{"但以理书":2,"启示录":2,"以赛亚书":1},"verse":"“我在床上脑中的异象，见有一位守望的圣者从天而降。","ref":"但以理书 4:13","def":"见\"从天而下\"","senses":[["①","见\"从天而下\"","赛 55:10","出现 5 次"]],"bverse":"我又看见圣城新耶路撒冷由神那里从天而降，预备好了，就如新妇妆饰整齐，等候丈夫。","bref":"启示录 21:2"},{"no":8112,"w":"枯树","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"以赛亚书 56:3","top":[["以西结书",2],["以赛亚书",1]],"rest":[0,0],"co":[["耶和华",3],["如此",2],["青树",2],["联合",1]],"books":{"以西结书":2,"以赛亚书":1},"verse":"与耶和华联合的外邦人不要说：耶和华必定将我从他民中分别出来。太监也不要说：我是枯树。","ref":"以赛亚书 56:3","def":"和合本用词；常见搭配：耶和华 3、如此 2、青树 2。","senses":[],"bverse":"田野的树木都必知道我─耶和华使高树矮小，矮树高大；青树枯干，枯树发旺。我─耶和华如此说，也如此行了。”","bref":"以西结书 17:24"},{"no":8113,"w":"各方","py":"","pos":"代词","orig":"","freq":12,"verses":12,"vols":3,"chaps":11,"ot":7,"nt":5,"first":"以赛亚书 56:11","top":[["但以理书",6],["启示录",5]],"rest":[1,1],"co":[["各族",11],["各国",11],["各民",5],["不能",2]],"books":{"但以理书":6,"启示录":5,"以赛亚书":1},"verse":"尼布甲尼撒王晓谕住在全地各方、各国、各族的人说：“愿你们大享平安！","ref":"但以理书 4:1","def":"和合本用词；常见搭配：各族 11、各国 11、各民 5。","senses":[],"bverse":"那时，大利乌王传旨，晓谕住在全地各方、各国、各族的人说：“愿你们大享平安！","bref":"但以理书 6:25"},{"no":8114,"w":"这义","py":"","pos":"代词","orig":"","freq":4,"verses":4,"vols":3,"chaps":3,"ot":1,"nt":3,"first":"以赛亚书 57:1","top":[["马太福音",2],["以赛亚书",1]],"rest":[1,1],"c