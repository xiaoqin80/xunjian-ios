,"bref":"以赛亚书 58:5"},{"no":8119,"w":"掩藏","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"以赛亚书 58:7","top":[["以赛亚书",1],["马可福音",1]],"rest":[1,1],"co":[["隐瞒",2],["露出",2],["出来",2],["分给",1]],"books":{"以赛亚书":1,"马可福音":1,"路加福音":1},"verse":"因为掩藏的事，没有不显出来的；隐瞒的事，没有不露出来的。","ref":"马可福音 4:22","def":"和合本用词；常见搭配：隐瞒 2、露出 2、出来 2。","senses":[],"bverse":"因为掩藏的事没有不显出来的；隐瞒的事没有不露出来被人知道的。","bref":"路加福音 8:17"},{"no":8120,"w":"累代","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以赛亚书 58:12","top":[["以赛亚书",2]],"rest":[0,0],"co":[["久已",1],["重修",1],["建立",1],["居住",1]],"books":{"以赛亚书":2},"verse":"你虽然被撇弃被厌恶，甚至无人经过，我却使你变为永远的荣华，成为累代的喜乐。","ref":"以赛亚书 60:15","def":"历代;接连几代","senses":[["①","历代;接连几代","赛 58:12","出现 2 次"]],"bverse":"那些出于你的人必修造久已荒废之处；你要建立拆毁累代的根基。你必称为补破口的，和重修路径与人居住的。","bref":"以赛亚书 58:12"},{"no":8121,"w":"不随","py":"","pos":"副词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"以赛亚书 58:13","top":[["以赛亚书",1],["耶利米书",1]],"rest":[1,1],"co":[["安息日",1],["掉转",1],["圣日",1],["尊敬",1]],"books":{"以赛亚书":1,"耶利米书":1,"加拉太书":1},"verse":"但我一看见他们行的不正，与福音的真理不合，就在众人面前对矶法说：“你既是犹太人，若随外邦人行事，不随犹太人行事，怎么还勉强外邦人随犹太人呢？”","ref":"加拉太书 2:14","def":"和合本用词；常见搭配：安息日 1、掉转 1、圣日 1。","senses":[],"bverse":"你若在安息日掉转（或译：谨慎）你的脚步，在我圣日不以操作为喜乐，称安息日为可喜乐的，称耶和华的圣日为可尊重的；而且尊敬这日，不办自己的私事，不随自己的私意，不说自己的私话，","bref":"以赛亚书 58:13"},{"no":8122,"w":"私意","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"以赛亚书 58:13","top":[["以赛亚书",1],["耶利米书",1]],"rest":[2,2],"co":[["耶和华",2],["或译",2],["安息日",1],["掉转",1]],"books":{"以赛亚书":1,"耶利米书":1,"歌罗西书":1,"彼得后书":1},"verse":"第一要紧的，该知道经上所有的预言没有可随私意解说的；","ref":"彼得后书 1:20","def":"和合本用词；常见搭配：耶和华 2、或译 2、安息日 1。","senses":[],"bverse":"你若在安息日掉转（或译：谨慎）你的脚步，在我圣日不以操作为喜乐，称安息日为可喜乐的，称耶和华的圣日为可尊重的；而且尊敬这日，不办自己的私事，不随自己的私意，不说自己的私话，","bref":"以赛亚书 58:13"},{"no":8123,"w":"告状","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":1,"nt":2,"first":"以赛亚书 59:4","top":[["哥林多前书",2],["以赛亚