:8155,"w":"休妻","py":"","pos":"名词","orig":"","freq":11,"verses":11,"vols":5,"chaps":6,"ot":2,"nt":9,"first":"耶利米书 3:1","top":[["马太福音",5],["马可福音",3]],"rest":[3,3],"co":[["奸淫",4],["人若",3],["缘故",3],["耶稣",3]],"books":{"马太福音":5,"马可福音":3,"耶利米书":1,"玛拉基书":1,"路加福音":1},"verse":"“又有话说：‘人若休妻，就当给她休书。’","ref":"马太福音 5:31","def":"旧指离弃妻子","senses":[["①","旧指离弃妻子","耶 3:1","出现 11 次"]],"bverse":"有法利赛人来试探耶稣，说：“人无论什么缘故都可以休妻吗？”","bref":"马太福音 19:3"},{"no":8156,"w":"恩主","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"耶利米书 3:4","top":[["耶利米书",1],["路加福音",1]],"rest":[0,0],"co":[["幼年",1],["呼叫",1],["我父",1],["耶稣",1]],"books":{"耶利米书":1,"路加福音":1},"verse":"从今以后，你岂不向我呼叫说：我父啊，你是我幼年的恩主。","ref":"耶利米书 3:4","def":"对施恩于己者的敬称","senses":[["①","对施恩于己者的敬称","耶 3:4","出现 2 次"]],"bverse":"耶稣说：“外邦人有君王为主治理他们，那掌权管他们的称为恩主。","bref":"路加福音 22:25"},{"no":8157,"w":"坏事","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":3,"nt":1,"first":"耶利米书 3:5","top":[["耶利米书",2],["以西结书",1]],"rest":[1,1],"co":[["耶和华",2],["恶言",1],["私意",1],["又行",1]],"books":{"耶利米书":2,"以西结书":1,"雅各书":1},"verse":"他们都是极悖逆的，往来谗谤人。他们是铜是铁，都行坏事。","ref":"耶利米书 6:28","def":"使事情搞糟照他说的做，非","senses":[["①","使事情搞糟照他说的做","耶 3:5","出现 4 次"]],"bverse":"在何处有嫉妒、纷争，就在何处有扰乱和各样的坏事。","bref":"雅各书 3:16"},{"no":8158,"w":"假意","py":"","pos":"动词","orig":"","freq":6,"verses":6,"vols":5,"chaps":5,"ot":1,"nt":5,"first":"耶利米书 3:10","top":[["马可福音",2],["耶利米书",1]],"rest":[3,3],"co":[["刑罚",3],["家产",3],["寡妇",3],["祷告",3]],"books":{"马可福音":2,"耶利米书":1,"马太福音":1,"路加福音":1,"腓立比书":1},"verse":"他们侵吞寡妇的家产，假意作很长的祷告。这些人要受更重的刑罚！”","ref":"马可福音 12:40","def":"虚假的心意虚情","senses":[["①","虚假的心意虚情～","耶 3:10","出现 6 次"]],"bverse":"他们侵吞寡妇的家产，假意作很长的祷告。这些人要受更重的刑罚！”","bref":"路加福音 20:47"},{"no":8159,"w":"恶心","py":"","pos":"名词","orig":"","freq":6,"verses":6,"vols":2,"chaps":6,"ot":5,"nt":1,"first":"耶利米书 3:17","top":[["耶利米书",5],["希伯来书",1]],"rest":[0,0],"co":[["顽梗",5],["随从",4],["听从",3],["行事",2]],"books":{"耶利米书":5,"希伯来书":1},"verse":"他们却不听从，不侧耳而听，竟随从自己的计谋和顽梗的恶心，向后不向前。","ref":"耶利米书 7:24","def":"欲呕吐的感觉头晕恶心。②形容极其讨厌这话说得叫人恶心","senses":[["①","欲呕吐的感觉头晕恶心","耶 3:17","出现 6 次"]],"bverse":"而且你们行恶比你们列祖更甚；因为各人随从自己顽梗的恶心行事，甚至不听从我，","bref":"耶利米书 16:12"},{"no":8160,"w":"自行","py":"","pos":"代词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"耶利米书 4:4","top":[["耶利米书",1],["腓立比书",1]],"rest":[0,0],"co":[["污秽",1],["恐怕",1],["居民",1],["心里",1]],"books":{"耶利米书":1,"腓立比书":1},"verse":"应当防备犬类，防备作恶的，防备妄自行割的。","ref":"腓立比书 3:2","def":"自己实行;自己处理","senses":[["①","自己实行;自己处理","耶 4:4","出现 2 次"]],"bverse":"犹大人和耶路撒冷的居民哪，你们当自行割礼，归耶和华，将心里的污秽除掉；恐怕我的忿怒因你们的恶行发作，如火著起，甚至无人能以熄灭！","bref":"耶利米书 4:4"},{"no":8161,"w":"密林","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"耶利米书 4:7","top":[["耶利米书",2]],"rest":[0,0],"co":[["出离",1],["上来",1],["荒场",1],["荒凉",1]],"books":{"耶利米书":2},"verse":"各城的人因马兵和弓箭手的响声就都逃跑，进入密林，爬上磐石；各城被撇下，无人住在其中。","ref":"耶利米书 4:29","def":"和合本用词；常见搭配：出离 1、上来 1、荒场 1。","senses":[["①","茂密的树林","耶 4:7","出现 2 次"]],"bverse":"有狮子从密林中上来，是毁坏列国的。它已经动身出离本处，要使你的地荒凉，使你的城邑变为荒场无人居住。","bref":"耶利米书 4:7"},{"no":8162,"w":"无光","py":"","pos":"动词","orig":"","freq":1,"verses":1,"vols":1,"chaps":1,"ot":1,"nt":0,"first":"耶利米书 4:23","top":[["耶利米书",1]],"rest":[0,0],"co":[["先知",1],["混沌",1],["空虚",1],["不料",1]],"books":{"耶利米书":1},"verse":"先知说：我观看地，不料，地是空虚混沌；我观看天，天也无光。","ref":"耶利米书 4:23","def":"和合本用词；常见搭配：先知 1、混沌 1、空虚 1。","senses":[],"bverse":"","bref":""},{"no":8163,"w":"齐心","py":"","pos":"形容词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":1,"nt":3,"first":"耶利米书 5:5","top":[["使徒行传",2],["耶利米书",1]],"rest":[1,1],"co":[["众人",2],["我要",1],["说话",1],["尊大",1]],"books":{"使徒行传":2,"耶利米书":1,"腓立比书":1},"verse":"众人大声喊叫，摀著耳朵，齐心拥上前去，","ref":"使徒行传 7:57","def":"和合本用词；常见搭配：众人 2、我要 1、说话 1。","senses":[["①","同心;一心","耶 5:5","出现 4 次"]],"bverse":"满城都轰动起来。众人拿住与保罗同行的马其顿人该犹和亚里达古，齐心拥进戏园里去。","bref":"使徒行传 19:29"},{"no":8164,"w":"逾越","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"耶利米书 5:22","top":[["耶利米书",1],["马可福音",1]],"rest":[1,1],"co":[["一天",2],["羊羔",2],["战兢",1],["定例",1]],"books":{"耶利米书":1,"马可福音":1,"路加福音":1},"verse":"除酵节，须宰逾越羊羔的那一天到了。","ref":"路加福音 22:7","def":"和合本用词；常见搭配：一天 2、羊羔 2、战兢 1。","senses":[],"bverse":"耶和华说：你们怎么不惧怕我呢？我以永远的定例，用沙为海的界限，水不得越过。因此，你们在我面前还不战兢吗？波浪虽然翻腾，却不能逾越；虽然匉訇，却不能过去。","bref":"耶利米书 5:22"},{"no":8165,"w":"恶来","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"耶利米书 6:7","top":[["耶利米书",1],["马太福音",1]],"rest":[1,1],"co":[["心里",2],["发出",2],["善人",2],["所存",2]],"books":{"耶利米书":1,"马太福音":1,"路加福音":1},"verse":"善人从他心里所存的善就发出善来；恶人从他心里所存的恶就发出恶来。","ref":"马太福音 12:35","def":"和合本用词；常见搭配：心里 2、发出 2、善人 2。","senses":[],"bverse":"井怎样涌出水来，这城也照样涌出恶来；在其间常听见有强暴毁灭的事，病患损伤也常在我面前。","bref":"耶利米书 6:7"},{"no":8166,"w":"古道","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"耶利米书 6:16","top":[["耶利米书",2]],"rest":[0,0],"co":[["路上",2],["安息",1],["心里",1],["不行",1]],"books":{"耶利米书":2},"verse":"我的百姓竟忘记我，向假神烧香，使他们在所行的路上，在古道上绊跌，使他们行没有修筑的斜路，","ref":"耶利米书 18:15","def":"古代之道。泛指古代的制度﹑学术﹑思想﹑风尚等","senses":[["①","古代之道","耶 6:16","出现 2 次"]],"bverse":"耶和华如此说：你们当站在路上察看，访问古道，哪是善道，便行在其间；这样，你们心里必得安息。他们却说：我们不行在其间。","bref":"耶利米书 6:16"},{"no":8167,"w":"照管","py":"","pos":"名词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":4,"nt":2,"first":"耶利米书 6:17","top":[["耶利米书",2],["以西结书",2]],"rest":[2,2],"co":[["牧养",3],["设立",2],["牧人",2],["角声",1]],"books":{"耶利米书":2,"以西结书":2,"提摩太（前书）":1,"彼得前书":1},"verse":"我设立守望的人照管你们，说：要听角声。他们却说：我们不听。","ref":"耶利米书 6:17","def":"和合本用词；常见搭配：牧养 3、设立 2、牧人 2。","senses":[["①","照顾料理","耶 6:17","出现 6 次"]],"bverse":"人若不知道管理自己的家，焉能照管神的教会呢？","bref":"提摩太前书 3:5"},{"no":8168,"w":"不施","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"耶利米书 6:23","top":[["耶利米书",2],["撒迦利亚书",1]],"rest":[0,0],"co":[["怜悯",3],["海浪",2],["战场",2],["如上",2]],"books":{"耶利米书":2,"撒迦利亚书":1},"verse":"于是，耶和华的使者说：“万军之耶和华啊，你恼恨耶路撒冷和犹大的城邑已经七十年，你不施怜悯要到几时呢？”","ref":"撒迦利亚书 1:12","def":"和合本用词；常见搭配：怜悯 3、海浪 2、战场 2。","senses":[],"bverse":"他们拿弓和枪，性情残忍，不施怜悯；他们的声音像海浪匉訇。锡安城（原文是女子）啊，他们骑马都摆队伍，如上战场的人要攻击你。","bref":"耶利米书 6:23"},{"no":8169,"w":"如丧","py":"","pos":"动词","orig":"","freq":4,"verses":3,"vols":3,"chaps":3,"ot":4,"nt":0,"first":"耶利米书 6:26","top":[["撒迦利亚书",2],["耶利米书",1]],"rest":[1,1],"co":[["腰束",2],["麻布",2],["悲哀",2],["应当",1]],"books":{"撒迦利亚书":2,"耶利米书":1,"阿摩司书":1},"verse":"我民（原文是民女）哪，应当腰束麻布，滚在灰中。你要悲伤，如丧独生子痛痛哭号，因为灭命的要忽然临到我们。","ref":"耶利米书 6:26","def":"和合本用词；常见搭配：腰束 2、麻布 2、悲哀 2。","senses":[],"bverse":"我必使你们的节期变为悲哀，歌曲变为哀歌。众人腰束麻布，头上光秃，使这场悲哀如丧独生子，至终如痛苦的日子一样。","bref":"阿摩司书 8:10"},{"no":8170,"w":"贼窝","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"耶利米书 7:11","top":[["耶利米书",1],["马太福音",1]],"rest":[2,2],"co":[["称为",3],["经上",3],["祷告",3],["成为",3]],"books":{"耶利米书":1,"马太福音":1,"马可福音":1,"路加福音":1},"verse":"这称为我名下的殿在你们眼中岂可看为贼窝吗？我都看见了。这是耶和华说的。","ref":"耶利米书 7:11","def":"和合本用词；常见搭配：称为 3、经上 3、祷告 3。","senses":[],"bverse":"对他们说：“经上说：我的殿必作祷告的殿，你们倒使它成为贼窝了。”","bref":"路加福音 19:46"},{"no":8171,"w":"天后","py":"","pos":"量词","orig":"","freq":6,"verses":5,"vols":1,"chaps":2,"ot":6,"nt":0,"first":"耶利米书 7:18","top":[["耶利米书",6]],"rest":[0,0],"co":[["奠祭",5],["烧香",4],["妇女",2],["口中",2]],"books":{"耶利米书":6},"verse":"自从我们停止向天后烧香、浇奠祭，我们倒缺乏一切，又因刀剑饥荒灭绝。”","ref":"耶利米书 44:18","def":"唐高宗永徽六年废王皇后﹐立武宸妃为后。高宗称天皇﹐武后称天后。见《旧唐书．则天皇后纪》","senses":[["①","唐高宗永徽六年废王皇","耶 7:18","出现 6 次"]],"bverse":"孩子捡柴，父亲烧火，妇女抟面做饼，献给天后，又向别神浇奠祭，惹我发怒。”","bref":"耶利米书 7:18"},{"no":8172,"w":"抛散","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"耶利米书 8:2","top":[["耶利米书",1],["以西结书",1]],"rest":[1,1],"co":[["骸骨",2],["敬拜",1],["收殓",1],["众星",1]],"books":{"耶利米书":1,"以西结书":1,"但以理书":1},"verse":"我也要将以色列人的尸首放在他们的偶像面前，将你们的骸骨抛散在你们祭坛的四围。","ref":"以西结书 6:5","def":"和合本用词；常见搭配：骸骨 2、敬拜 1、收殓 1。","senses":[],"bverse":"抛散在日头、月亮，和天上众星之下，就是他们从前所喜爱、所事奉、所随从、所求问、所敬拜的。这些骸骨不再收殓，不再葬埋，必在地面上成为粪土；","bref":"耶利米书 8:2"},{"no":8173,"w":"悔改","py":"","pos":"动词","orig":"shuv, H7725 / metanoia, G3341","freq":52,"verses":46,"vols":10,"chaps":32,"ot":1,"nt":51,"first":"耶利米书 8:6","top":[["路加福音",13],["启示录",13]],"rest":[8,26],"co":[["时候",6],["告诉",6],["应当",4],["那里",4]],"books":{"路加福音":13,"启示录":13,"使徒行传":10,"马太福音":7,"马可福音":3,"罗马书":2,"耶利米书":1,"哥林多后书":1,"提摩太（后书）":1,"彼得后书":1},"verse":"我来本不是召义人悔改，乃是召罪人悔改。”","ref":"路加福音 5:32","def":"心思转变、离弃恶道归向神；原文 metanoia，与「相信」并提。","senses":[["①","心思转变、归向神","耶 8:6","出现 51 次"],["②","后悔、懊悔","林后 12:21","出现 1 次"]],"bverse":"我告诉你们，不是的！你们若不悔改，都要如此灭亡！","bref":"路加福音 13:3"},{"no":8174,"w":"守候","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"耶利米书 8:7","top":[["耶利米书",1],["使徒行传",1]],"rest":[0,0],"co":[["知道",2],["空中",1],["当来",1],["百姓",1]],"books":{"耶利米书":1,"使徒行传":1},"verse":"但他们的计谋被扫罗知道了。他们又昼夜在城门守候，要杀他。","ref":"使徒行传 9:24","def":"和合本用词；常见搭配：知道 2、空中 1、当来 1。","senses":[["①","守卫;看护","耶 8:7","出现 2 次"]],"bverse":"空中的鹳鸟知道来去的定期；斑鸠燕子与白鹤也守候当来的时令；我的百姓却不知道耶和华的法则。","bref":"耶利米书 8:7"},{"no":8175,"w":"水给","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"耶利米书 8:14","top":[["耶利米书",3]],"rest":[0,0],"co":[["苦胆",3],["茵陈",2],["必将",2],["如此",2]],"books":{"耶利米书":3},"verse":"所以万军之耶和华─以色列的神如此说：“看哪，我必将茵陈给这百姓吃，又将苦胆水给他们喝。","ref":"耶利米书 9:15","def":"和合本用词；常见搭配：苦胆 3、茵陈 2、必将 2。","senses":[],"bverse":"我们为何静坐不动呢？我们当聚集，进入坚固城，在那里静默不言；因为耶和华─我们的神使我们静默不言，又将苦胆水给我们喝，都因我们得罪了耶和华。","bref":"耶利米书 8:14"},{"no":8176,"w":"乌法","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":3,"ot":4,"nt":0,"first":"耶利米书 10:9","top":[["但以理书",3],["耶利米书",1]],"rest":[0,0],"co":[["带来",1],["匠人",1],["银匠",1],["金子",1]],"books":{"但以理书":3,"耶利米书":1},"verse":"举目观看，见有一人身穿细麻衣，腰束乌法精金带。","ref":"但以理书 10:5","def":"和合本用词；常见搭配：带来 1、匠人 1、银匠 1。","senses":[],"bverse":"“所写的文字是：‘弥尼，弥尼，提客勒，乌法珥新。’","bref":"但以理书 5:25"},{"no":8177,"w":"觉悟","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"耶利米书 10:18","top":[["耶利米书",1],["希伯来书",1]],"rest":[0,0],"co":[["居民",1],["用机",1],["必将",1],["好像",1]],"books":{"耶利米书":1,"希伯来书":1},"verse":"并尝过神善道的滋味、觉悟来世权能的人，","ref":"希伯来书 6:5","def":"由迷惑而明白；由凝而认清；醒悟政治","senses":[["①","由迷惑而明白","耶 10:18","出现 2 次"]],"bverse":"因为耶和华如此说：这时候，我必将此地的居民，好像用机弦甩出去，又必加害在他们身上，使他们觉悟。","bref":"耶利米书 10:18"},{"no":8178,"w":"忍受","py":"","pos":"动词","orig":"","freq":19,"verses":19,"vols":9,"chaps":15,"ot":3,"nt":16,"first":"耶利米书 10:19","top":[["希伯来书",8],["哥林多前书",3]],"rest":[7,8],"co":[["苦难",4],["耶和华",2],["逼迫",2],["凡事",2]],"books":{"希伯来书":8,"哥林多前书":3,"提摩太（后书）":2,"耶利米书":1,"以西结书":1,"弥迦书":1,"哥林多后书":1,"雅各书":1,"彼得前书":1},"verse":"又有人忍受戏弄、鞭打、捆锁、监禁、各等的磨炼，","ref":"希伯来书 11:36","def":"忍耐承受；也指忍受苦难。","senses":[["①","勉强承受","耶 10:19","出现 19 次"]],"bverse":"那忍受罪人这样顶撞的，你们要思想，免得疲倦灰心。","bref":"希伯来书 12:3"},{"no":8179,"w":"不由","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"耶利米书 10:23","top":[["耶利米书",1],["何西阿书",1]],"rest":[0,0],"co":[["道路",1],["脚步",1],["行路",1],["晓得",1]],"books":{"耶利米书":1,"何西阿书":1},"verse":"耶和华啊，我晓得人的道路不由自己，行路的人也不能定自己的脚步。","ref":"耶利米书 10:23","def":"和合本用词；常见搭配：道路 1、脚步 1、行路 1。","senses":[],"bverse":"他们立君王，却不由我；他们立首领，我却不认。他们用金银为自己制造偶像，以致被剪除。","bref":"何西阿书 8:4"},{"no":8180,"w":"从宽","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"耶利米书 10:24","top":[["耶利米书",3]],"rest":[0,0],"co":[["惩治",3],["耶和华",3],["不要",2],["无罪",2]],"books":{"耶利米书":3},"verse":"耶和华啊，求你从宽惩治我，不要在你的怒中惩治我，恐怕使我归于无有。","ref":"耶利米书 10:24","def":"和合本用词；常见搭配：惩治 3、耶和华 3、不要 2。","senses":[],"bverse":"因我与你同在，要拯救你，也要将所赶散你到的那些国灭绝净尽，却不将你灭绝净尽，倒要从宽惩治你，万不能不罚你（不罚你：或译以你为无罪）。这是耶和华说的。","bref":"耶利米书 30:11"},{"no":8181,"w":"柔顺","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"耶利米书 11:19","top":[["耶利米书",1],["雅各书",1]],"rest":[0,0],"co":[["不再",1],["牵到",1],["果子",1],["活人",1]],"books":{"耶利米书":1,"雅各书":1},"verse":"惟独从上头来的智慧，先是清洁，后是和平，温良柔顺，满有怜悯，多结善果，没有偏见，没有假冒。","ref":"雅各书 3:17","def":"和合本用词；常见搭配：不再 1、牵到 1、果子 1。","senses":[["①","温柔和顺","耶 11:19","出现 2 次"]],"bverse":"我却像柔顺的羊羔被牵到宰杀之地；我并不知道他们设计谋害我，说：我们把树连果子都灭了吧！将他从活人之地剪除，使他的名不再被纪念。","bref":"耶利米书 11:19"},{"no":8182,"w":"禀明","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"耶利米书 11:20","top":[["耶利米书",2]],"rest":[0,0],"co":[["心肠",2],["肺腑",2],["身上",2],["万军之耶和华",2]],"books":{"耶利米书":2},"verse":"按公义判断、察验人肺腑心肠的万军之耶和华啊，我却要见你在他们身上报仇，因我将我的案件向你禀明了。","ref":"耶利米书 11:20","def":"和合本用词；常见搭配：心肠 2、肺腑 2、身上 2。","senses":[["①","亦作\"禀明\"","耶 11:20","出现 2 次"]],"bverse":"试验义人、察看人肺腑心肠的万军之耶和华啊，求你容我见你在他们身上报仇，因我将我的案件向你禀明了。","bref":"耶利米书 20:12"},{"no":8183,"w":"如林","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"耶利米书 12:8","top":[["耶利米书",1],["以西结书",1]],"rest":[1,1],"co":[["狮子",2],["发声",1],["产业",1],["恨恶",1]],"books":{"耶利米书":1,"以西结书":1,"弥迦书":1},"verse":"我的产业向我如林中的狮子，她发声攻击我，因此我恨恶她。","ref":"耶利米书 12:8","def":"和合本用词；常见搭配：狮子 2、发声 1、产业 1。","senses":[],"bverse":"亚述王曾如黎巴嫩中的香柏树，枝条荣美，影密如林，极其高大，树尖插入云中。","bref":"以西结书 31:3"},{"no":8184,"w":"酩酊大醉","py":"","pos":"","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"耶利米书 13:13","top":[["耶利米书",1],["以西结书",1]],"rest":[0,0],"co":[["先知",1],["宝座",1],["居民",1],["必使",1]],"books":{"耶利米书":1,"以西结书":1},"verse":"你必酩酊大醉，满有愁苦，喝干你姐姐撒马利亚的杯，就是令人惊骇凄凉的杯。","ref":"以西结书 23:33","def":"形容醉得厉害","senses":[["①","形容醉得厉害","耶 13:13","出现 2 次"]],"bverse":"你就要对他们说：‘耶和华如此说：我必使这地的一切居民，就是坐大卫宝座的君王和祭司，与先知，并耶路撒冷的一切居民，都酩酊大醉。’”","bref":"耶利米书 13:13"},{"no":8185,"w":"相碰","py":"","pos":"动词","orig":"","freq":6,"verses":5,"vols":4,"chaps":5,"ot":6,"nt":0,"first":"耶利米书 13:14","top":[["耶利米书",3],["以西结书",1]],"rest":[2,2],"co":[["彼此",3],["听见",2],["双膝",2],["以致",1]],"books":{"耶利米书":3,"以西结书":1,"但以理书":1,"那鸿书":1},"verse":"列国听见你的羞辱，遍地满了你的哀声；勇士与勇士彼此相碰，一齐跌倒。","ref":"耶利米书 46:12","def":"和合本用词；常见搭配：彼此 3、听见 2、双膝 2。","senses":[],"bverse":"就变了脸色，心意惊惶，腰骨好像脱节，双膝彼此相碰，","bref":"但以理书 5:6"},{"no":8186,"w":"揭起","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"耶利米书 13:22","top":[["耶利米书",2],["那鸿书",1]],"rest":[0,0],"co":[["衣襟",3],["丑陋",2],["脸上",2],["罪孽",1]],"books":{"耶利米书":2,"那鸿书":1},"verse":"所以我要揭起你的衣襟，蒙在你脸上，显出你的丑陋。","ref":"耶利米书 13:26","def":"和合本用词；常见搭配：衣襟 3、丑陋 2、脸上 2。","senses":[],"bverse":"你若心里说：这一切事为何临到我呢？你的衣襟揭起，你的脚跟受伤，是因你的罪孽甚多。","bref":"耶利米书 13:22"},{"no":8187,"w":"习惯","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"耶利米书 13:23","top":[["耶利米书",1],["提摩太（前书）",1]],"rest":[1,1],"co":[["若能",1],["行恶",1],["行善",1],["岂能",1]],"books":{"耶利米书":1,"提摩太（前书）":1,"彼得后书":1},"verse":"古实人岂能改变皮肤呢？豹岂能改变斑点呢？若能，你们这习惯行恶的便能行善了。","ref":"耶利米书 13:23","def":"经过不断实践而逐渐适应习惯成自然","senses":[["①","经过不断实践而逐渐适","耶 13:23","出现 3 次"]],"bverse":"并且她们又习惯懒惰，挨家闲游；不但是懒惰，又说长道短，好管闲事，说些不当说的话。","bref":"提摩太前书 5:13"},{"no":8188,"w":"家僮","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"耶利米书 14:3","top":[["耶利米书",2]],"rest":[0,0],"co":[["打水",1],["器皿",1],["蒙羞",1],["贵胄",1]],"books":{"耶利米书":2},"verse":"摩押毁灭了！她的孩童（或译：家僮）发哀声，使人听见。","ref":"耶利米书 48:4","def":"和合本用词；常见搭配：打水 1、器皿 1、蒙羞 1。","senses":[["①","亦作\"家童\"","耶 14:3","出现 2 次"]],"bverse":"他们的贵胄打发家僮打水；他们来到水池，见没有水，就拿着空器皿，蒙羞惭愧，抱头而回。","bref":"耶利米书 14:3"},{"no":8189,"w":"无草","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"耶利米书 14:5","top":[["耶利米书",2],["约珥书",1]],"rest":[0,0],"co":[["田野",1],["小鹿",1],["撇弃",1],["母鹿",1]],"books":{"耶利米书":2,"约珥书":1},"verse":"田野的母鹿生下小鹿，就撇弃，因为无草。","ref":"耶利米书 14:5","def":"和合本用词；常见搭配：田野 1、小鹿 1、撇弃 1。","senses":[],"bverse":"野驴站在净光的高处，喘气好像野狗；因为无草，眼目失明。","bref":"耶利米书 14:6"},{"no":8190,"w":"不悦","py":"","pos":"形容词","orig":"","freq":5,"verses":5,"vols":4,"chaps":4,"ot":5,"nt":0,"first":"耶利米书 14:10","top":[["耶利米书",2],["何西阿书",1]],"rest":[2,2],"co":[["罪孽",2],["追讨",2],["罪恶",2],["记念",2]],"books":{"耶利米书":2,"何西阿书":1,"阿摩司书":1,"约拿书":1},"verse":"这事约拿大大不悦，且甚发怒，","ref":"约拿书 4:1","def":"和合本用词；常见搭配：罪孽 2、追讨 2、罪恶 2。","senses":[],"bverse":"你们虽然向我献燔祭和素祭，我却不悦纳，也不顾你们用肥畜献的平安祭；","bref":"阿摩司书 5:22"},{"no":8191,"w":"常对","py":"","pos":"副词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"耶利米书 14:13","top":[["耶利米书",2],["哥林多后书",1]],"rest":[0,0],"co":[["平安",2],["耶和华",2],["先知",1],["长久",1]],"books":{"耶利米书":2,"哥林多后书":1},"verse":"因为我知道你们乐意的心，常对马其顿人夸奖你们，说亚该亚人预备好了，已经有一年了；并且你们的热心激动了许多人。","ref":"哥林多后书 9:2","def":"和合本用词；常见搭配：平安 2、耶和华 2、先知 1。","senses":[],"bverse":"我就说：“唉！主耶和华啊，那些先知常对他们说：‘你们必不看见刀剑，也不遭遇饥荒；耶和华要在这地方赐你们长久的平安。’”","bref":"耶利米书 14:13"},{"no":8192,"w":"本心","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"耶利米书 14:14","top":[["耶利米书",2],["哥林多后书",1]],"rest":[0,0],"co":[["先知",2],["诡诈",2],["预言",2],["虚无",1]],"books":{"耶利米书":2,"哥林多后书":1},"verse":"说假预言的先知，就是预言本心诡诈的先知，他们这样存心要到几时呢？","ref":"耶利米书 23:26","def":"本来的心愿出于","senses":[["①","本来的心愿出于～","耶 14:14","出现 3 次"]],"bverse":"各人要随本心所酌定的，不要作难，不要勉强，因为捐得乐意的人是神所喜爱的。","bref":"哥林多后书 9:7"},{"no":8193,"w":"关口","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"耶利米书 15:7","top":[["耶利米书",1],["弥迦书",1]],"rest":[1,1],"co":[["境内",1],["毁灭",1],["丧掉",1],["儿女",1]],"books":{"耶利米书":1,"弥迦书":1,"那鸿书":1},"verse":"你地上的人民如同妇女；你国中的关口向仇敌敞开；你的门闩被火焚烧。","ref":"那鸿书 3:13","def":"和合本用词；常见搭配：境内 1、毁灭 1、丧掉 1。","senses":[],"bverse":"我在境内各城门口（或译：我在这地边界的关口），用簸箕簸了我的百姓，使他们丧掉儿女。我毁灭他们，他们仍不转离所行的道。","bref":"耶利米书 15:7"},{"no":8194,"w":"央求","py":"","pos":"动词","orig":"","freq":10,"verses":10,"vols":5,"chaps":6,"ot":1,"nt":9,"first":"耶利米书 15:11","top":[["马太福音",4],["马可福音",2]],"rest":[3,4],"co":[["耶稣",6],["打发",3],["进入",2],["离开",2]],"books":{"马太福音":4,"马可福音":2,"路加福音":2,"耶利米书":1,"使徒行传":1},"verse":"合城的人都出来迎见耶稣，既见了就央求他离开他们的境界。","ref":"马太福音 8:34","def":"和合本用词；常见搭配：耶稣 6、打发 3、进入 2。","senses":[],"bverse":"他的同伴就俯伏央求他，说：‘宽容我吧，将来我必还清。’","bref":"马太福音 18:29"},{"no":8195,"w":"丧事","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"耶利米书 16:7","top":[["耶利米书",1],["以西结书",1]],"rest":[0,0],"co":[["丧父",1],["人必",1],["不为",1],["安慰",1]],"books":{"耶利米书":1,"以西结书":1},"verse":"他们有丧事，人必不为他们擘饼，因死人安慰他们；他们丧父丧母，人也不给他们一杯酒安慰他们。","ref":"耶利米书 16:7","def":"泛指人死后殓奠殡葬等事宜","senses":[["①","泛指人死后殓奠殡葬等","耶 16:7","出现 2 次"]],"bverse":"只可叹息，不可出声，不可办理丧事；头上仍勒裹头巾，脚上仍穿鞋，不可蒙著嘴唇，也不可吃吊丧的食物。”","bref":"以西结书 24:17"},{"no":8196,"w":"失去","py":"","pos":"动词","orig":"","freq":11,"verses":10,"vols":8,"chaps":8,"ot":3,"nt":8,"first":"耶利米书 17:4","top":[["路加福音",3],["马太福音",2]],"rest":[6,6],"co":[["原文",2],["全身",2],["宁可",2],["丢掉",2]],"books":{"路加福音":3,"马太福音":2,"耶利米书":1,"耶利米哀歌":1,"以西结书":1,"哥林多后书":1,"歌罗西书":1,"约翰（二书）":1},"verse":"就请朋友邻舍来，对他们说：‘我失去的羊已经找著了，你们和我一同欢喜吧！’","ref":"路加福音 15:6","def":"和合本用词；常见搭配：原文 2、全身 2、宁可 2。","senses":[["①","消失;失掉","耶 17:4","出现 11 次"]],"bverse":"你们要小心，不要失去你们（有古卷：我们）所做的工，乃要得着满足的赏赐。","bref":"约翰二书 1:8"},{"no":8197,"w":"挂虑","py":"","pos":"动词","orig":"","freq":7,"verses":5,"vols":3,"chaps":3,"ot":1,"nt":6,"first":"耶利米书 17:8","top":[["哥林多前书",5],["耶利米书",1]],"rest":[1,1],"co":[["喜悦",3],["怎样",3],["为主",2],["世上",2]],"books":{"哥林多前书":5,"耶利米书":1,"腓立比书":1},"verse":"娶了妻的，是为世上的事挂虑，想怎样叫妻子喜悦。","ref":"哥林多前书 7:33","def":"和合本用词；常见搭配：喜悦 3、怎样 3、为主 2。","senses":[],"bverse":"我愿你们无所挂虑。没有娶妻的，是为主的事挂虑，想怎样叫主喜悦。","bref":"哥林多前书 7:32"},{"no":8198,"w":"土里","py":"","pos":"方位词","orig":"","freq":5,"verses":5,"vols":4,"chaps":4,"ot":1,"nt":4,"first":"耶利米书 17:13","top":[["路加福音",2],["耶利米书",1]],"rest":[2,2],"co":[["结实",4],["十倍",2],["泉源",1],["必致",1]],"books":{"路加福音":2,"耶利米书":1,"马太福音":1,"马可福音":1},"verse":"那落在好土里的，就是人听了道，持守在诚实善良的心里，并且忍耐著结实。”","ref":"路加福音 8:15","def":"和合本用词；常见搭配：结实 4、十倍 2、泉源 1。","senses":[],"bverse":"又有落在好土里的，就结实，有一百倍的，有六十倍的，有三十倍的。","bref":"马太福音 13:8"},{"no":8199,"w":"平常","py":"","pos":"形容词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"耶利米书 19:4","top":[["耶利米书",1],["路加福音",1]],"rest":[1,1],"co":[["地方",2],["别神",1],["无辜",1],["认识",1]],"books":{"耶利米书":1,"路加福音":1,"希伯来书":1},"verse":"耶稣来到拿撒勒，就是他长大的地方。在安息日，照他平常的规矩进了会堂，站起来要念圣经。","ref":"路加福音 4:16","def":"和合本用词；常见搭配：地方 2、别神 1、无辜 1。","senses":[],"bverse":"因为他们和他们列祖，并犹大君王离弃我，将这地方看为平常，在这里向素不认识的别神烧香，又使这地方满了无辜人的血，","bref":"耶利米书 19:4"},{"no":8200,"w":"总管","py":"","pos":"连词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"耶利米书 20:1","top":[["耶利米书",1],["使徒行传",1]],"rest":[0,0],"co":[["听见",1],["儿子",1],["预言",1],["音麦",1]],"books":{"耶利米书":1,"使徒行传":1},"verse":"祭司音麦的儿子巴施户珥作耶和华殿的总管，听见耶利米预言这些事，","ref":"耶利米书 20:1","def":"武官名『末南北朝以都督统州之军事，并总揽或与刺史治州之政事。北周始改此称。隋代至唐代初在各州设总管，边镇","senses":[["①","武官名『末南北朝以都","耶 20:1","出现 2 次"]],"bverse":"腓利就起身去了，不料，有一个埃塞俄比亚（就是古实，见以赛亚十八章一节）人，是个有大权的太监，在埃塞俄比亚女王甘大基的手下总管银库，他上耶路撒冷礼拜去了。","bref":"使徒行传 8:27"}]