32"},{"no":8815,"w":"恶鬼","py":"","pos":"名词","orig":"","freq":6,"verses":6,"vols":2,"chaps":3,"ot":0,"nt":6,"first":"路加福音 7:21","top":[["使徒行传",4],["路加福音",2]],"rest":[0,0],"co":[["耶稣",3],["身上",3],["保罗",3],["治好",2]],"books":{"使徒行传":4,"路加福音":2},"verse":"恶鬼回答他们说：“耶稣我认识，保罗我也知道。你们却是谁呢？”","ref":"使徒行传 19:15","def":"凶恶的鬼。亦常以喻邪恶的人","senses":[["①","凶恶的鬼","路 7:21","出现 6 次"]],"bverse":"甚至有人从保罗身上拿手巾或围裙放在病人身上，病就退了，恶鬼也出去了。","bref":"使徒行传 19:12"},{"no":8816,"w":"擦干","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":0,"nt":3,"first":"路加福音 7:38","top":[["路加福音",2],["约翰福音",1]],"rest":[0,0],"co":[["头发",2],["眼泪",2],["耶稣",1],["香膏",1]],"books":{"路加福音":2,"约翰福音":1},"verse":"随后把水倒在盆里，就洗门徒的脚，并用自己所束的手巾擦干。","ref":"约翰福音 13:5","def":"和合本用词；常见搭配：头发 2、眼泪 2、耶稣 1。","senses":[],"bverse":"站在耶稣背后，挨着他的脚哭，眼泪湿了耶稣的脚，就用自己的头发擦干，又用嘴连连亲他的脚，把香膏抹上。","bref":"路加福音 7:38"},{"no":8817,"w":"善良","py":"","pos":"形容词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":0,"nt":4,"first":"路加福音 8:15","top":[["路加福音",2],["罗马书",1]],"rest":[1,1],"co":[["诚实",1],["忍耐",1],["心里",1],["持守",1]],"books":{"路加福音":2,"罗马书":1,"彼得前书":1},"verse":"有一个人名叫约瑟，是个议士，为人善良公义；","ref":"路加福音 23:50","def":"和善，心地好。亦指和善而不怀恶意的人","senses":[],"bverse":"那落在好土里的，就是人听了道，持守在诚实善良的心里，并且忍耐著结实。”","bref":"路加福音 8:15"},{"no":8818,"w":"风浪","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"路加福音 8:24","top":[["路加福音",1],["使徒行传",1]],"rest":[0,0],"co":[["叫醒",1],["耶稣",1],["大浪",1],["平静",1]],"books":{"路加福音":1,"使徒行传":1},"verse":"我们被风浪逼得甚急，第二天众人就把货物抛在海里。","ref":"使徒行传 27:18","def":"水面上的风和波浪","senses":[["①","水面上的风和波浪～大","路 8:24","出现 2 次"]],"bverse":"门徒来叫醒了他，说：“夫子！夫子！我们丧命啦！”耶稣醒了，斥责那狂风大浪；风浪就止住，平静了。","bref":"路加福音 8:24"},{"no":8819,"w":"无底","py":"","pos":"动词","orig":"","freq":7,"verses":6,"vols":2,"chaps":5,"ot":0,"nt":7,"first":"路加福音 8:31","top":[["启示录",6],["路加福音",1]],"rest":[0,0],"co":[["坑里",5],["上来",2],["以后",2],["看见",2]],"books":{"启示录":6,"路加福音":1},"verse":"我又看见一位天使从天降下，手里拿着无底坑的钥匙和一条大链子。","ref":"启示录 20:1","def":"没有底部。形容极深","s