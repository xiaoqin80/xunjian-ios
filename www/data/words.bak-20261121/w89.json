"verses":4,"vols":1,"chaps":2,"ot":0,"nt":4,"first":"约翰福音 14:12","top":[["约翰福音",4]],"rest":[0,0],"co":[["那里",4],["告诉",1],["不再",1],["为义",1]],"books":{"约翰福音":4},"verse":"为义，是因我往父那里去，你们就不再见我；","ref":"约翰福音 16:10","def":"和合本用词；常见搭配：那里 4、告诉 1、不再 1。","senses":[],"bverse":"我从父出来，到了世界；我又离开世界，往父那里去。”","bref":"约翰福音 16:28"},{"no":8896,"w":"爱里","py":"","pos":"名词","orig":"","freq":5,"verses":3,"vols":2,"chaps":2,"ot":0,"nt":5,"first":"约翰福音 15:9","top":[["约翰福音",3],["约翰（一书）",2]],"rest":[0,0],"co":[["正如",2],["要常",1],["父爱",1],["命令",1]],"books":{"约翰福音":3,"约翰（一书）":2},"verse":"我爱你们，正如父爱我一样；你们要常在我的爱里。","ref":"约翰福音 15:9","def":"和合本用词；常见搭配：正如 2、要常 1、父爱 1。","senses":[],"bverse":"你们若遵守我的命令，就常在我的爱里，正如我遵守了我父的命令，常在他的爱里。","bref":"约翰福音 15:10"},{"no":8897,"w":"推诿","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":0,"nt":3,"first":"约翰福音 15:22","top":[["罗马书",2],["约翰福音",1]],"rest":[0,0],"co":[["无可",3],["教训",1],["如今",1],["以来",1]],"books":{"罗马书":2,"约翰福音":1},"verse":"我若没有来教训他们，他们就没有罪；但如今他们的罪无可推诿了。","ref":"约翰福音 15:22","def":"推卸责任;推辞","senses":[["①","推卸责任;推辞","约 15:22","出现 3 次"]],"bverse":"自从造天地以来，神的永能和神性是明明可知的，虽是眼不能见，但借着所造之物就可以晓得，叫人无可推诿。","bref":"罗马书 1:20"},{"no":8898,"w":"合而为一","py":"","pos":"","orig":"","freq":7,"verses":6,"vols":2,"chaps":3,"ot":0,"nt":7,"first":"约翰福音 17:11","top":[["约翰福音",5],["以弗所书",2]],"rest":[0,0],"co":[["保守",2],["赐给",2],["世人",2],["里面",2]],"books":{"约翰福音":5,"以弗所书":2},"verse":"你所赐给我的荣耀，我已赐给他们，使他们合而为一，像我们合而为一。","ref":"约翰福音 17:22","def":"合并在一起;合并为一体","senses":[["①","合并在一起;合并为一","约 17:11","出现 7 次"]],"bverse":"用和平彼此联络，竭力保守圣灵所赐合而为一的心。","bref":"以弗所书 4:3"},{"no":8899,"w":"领去","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":0,"nt":3,"first":"约翰福音 19:38","top":[["使徒行传",2],["约翰福音",1]],"rest":[0,0],"co":[["耶稣",2],["门徒",1],["犹太人",1],["允准",1]],"books":{"使徒行传":2,"约翰福音":1},"verse":"于是把他领去见千夫长，说：“被囚的保罗请我到他那里，求我领这少年人来见你；他有事告诉你。”","ref":"使徒行传 23:18","def":"和合本用词；常见搭配：耶稣 2、门徒 1、犹太人 1。","senses":[],"bverse":"这些事以后，有亚利马太人约瑟，是耶稣的门徒，只因怕犹太人，就暗暗地作门徒。他来求彼拉多，要把耶稣的身体领去。彼拉多允准，他就把耶稣的身体领去了。","bref":"约翰福音 19:38"},{"no":8900,"w":"主从","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"约翰福音 20:2","top":[["约翰福音",1],["罗马书",1]],"rest":[0,0],"co":[["彼得",1],["耶稣",1],["西门",1],["坟墓",1]],"books":{"约翰福音":1,"罗马书":1},"verse":"于是以色列全家都要得救。如经上所记：必有一位救主从锡安出来，要消除雅各家的一切罪恶；","ref":"罗马书 11:26","def":"和合本用词；常见搭配：彼得 1、耶稣 1、西门 1。","senses":[["①","主人与仆从","约 20:2","出现 2 次"]],"bverse":"就跑来见西门•彼得和耶稣所爱的那个门徒，对他们说：“有人把主从坟墓里挪了去，我们不知道放在哪里。”","bref":"约翰福音 20:2"}]