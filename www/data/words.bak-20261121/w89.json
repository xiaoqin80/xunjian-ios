","bref":""},{"no":8886,"w":"从父","py":"","pos":"介词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":0,"nt":6,"first":"约翰福音 10:32","top":[["约翰福音",3],["以弗所书",1]],"rest":[2,2],"co":[["真理",2],["那里",2],["出来",2],["耶稣基督",2]],"books":{"约翰福音":3,"以弗所书":1,"帖撒罗尼迦（后书）":1,"约翰（二书）":1},"verse":"我从父出来，到了世界；我又离开世界，往父那里去。”","ref":"约翰福音 16:28","def":"父亲的兄弟。即伯父或叔父","senses":[["①","父亲的兄弟","约 10:32","出现 6 次"]],"bverse":"耶稣对他们说：“我从父显出许多善事给你们看，你们是为哪一件拿石头打我呢？”","bref":"约翰福音 10:32"},{"no":8887,"w":"同作","py":"","pos":"介词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":0,"nt":5,"first":"约翰福音 11:16","top":[["罗马书",2],["约翰福音",1]],"rest":[2,2],"co":[["见证",3],["荣耀",2],["受苦",2],["基督",2]],"books":{"罗马书":2,"约翰福音":1,"使徒行传":1,"彼得前书":1},"verse":"多马，又称为低土马，就对那同作门徒的说：“我们也去和他同死吧。”","ref":"约翰福音 11:16","def":"和合本用词；常见搭配：见证 3、荣耀 2、受苦 2。","senses":[],"bverse":"就是从约翰施洗起，直到主离开我们被接上升的日子为止，必须从那常与我们作伴的人中立一位与我们同作耶稣复活的见证。”","bref":"使徒行传 1:22"},{"no":8888,"w":"罗马人","py":"","pos":"名词","orig":"","freq":11,"verses":11,"vols":2,"chaps":6,"ot":0,"nt":11,"first":"约翰福音 11:48","top":[["使徒行传",10],["约翰福音",1]],"rest":[0,0],"co":[["保罗",5],["千夫",3],["百姓",2],["定罪",2]],"books":{"使徒行传":10,"约翰福音":1},"verse":"传我们罗马人所不可受不可行的规矩。”","ref":"使徒行传 16:21","def":"罗马帝国的公民与统治者","senses":[["①","罗马帝国的公民与统治","约 11:48","出现 11 次"]],"bverse":"差役把这话回禀官长。官长听见他们是罗马人，就害怕了，","bref":"使徒行传 16:38"},{"no":8889,"w":"报明","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"约翰福音 11:57","top":[["约翰福音",1],["使徒行传",1]],"rest":[1,1],"co":[["祭司",2],["耶稣",1],["早已",1],["有人",1]],"books":{"约翰福音":1,"使徒行传":1,"帖撒罗尼迦（前书）":1},"verse":"那时，祭司长和法利赛人早已吩咐说，若有人知道耶稣在哪里，就要报明，好去拿他。","ref":"约翰福音 11:57","def":"和合本用词；常见搭配：祭司 2、耶稣 1、早已 1。","senses":[],"bverse":"于是保罗带着那四个人，第二天与他们一同行了洁净的礼，进了殿，报明洁净的日期满足，只等祭司为他们各人献祭。","bref":"使徒行传 21:26"},{"no":8890,"w":"爱人","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":0,"nt":4,"first":"约翰福音 12:43","top":[["罗马书",3],["约翰福音",1]],"rest":[0,0],"co":[["不可",3],["爱神",1],["过于",1],["荣耀",1]],"boo