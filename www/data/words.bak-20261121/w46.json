:[],"bverse":"你们中间，柔弱娇嫩的妇人，是因娇嫩柔弱不肯把脚踏地的，必恶眼看她怀中的丈夫和她的儿女。","bref":"申命记 28:56"},{"no":4510,"w":"亲人","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"申命记 28:55","top":[["申命记",1],["箴言",1]],"rest":[0,0],"co":[["城中",1],["仇敌",1],["儿女",1],["一点",1]],"books":{"申命记":1,"箴言":1},"verse":"对智慧说：你是我的姊妹，称呼聪明为你的亲人，","ref":"箴言 7:4","def":"亲近人;使人感到亲切可爱","senses":[["①","亲近人;使人感到亲切","申 28:55","出现 2 次"]],"bverse":"甚至在你受仇敌围困窘迫的城中，他要吃儿女的肉，不肯分一点给他的亲人，因为他一无所剩。","bref":"申命记 28:55"},{"no":4511,"w":"脚踏","py":"","pos":"动词","orig":"","freq":9,"verses":7,"vols":6,"chaps":7,"ot":6,"nt":3,"first":"申命记 28:56","top":[["启示录",3],["约书亚记",2]],"rest":[4,4],"co":[["妇人",2],["丈夫",1],["娇嫩",1],["柔弱",1]],"books":{"启示录":3,"约书亚记":2,"申命记":1,"诗篇":1,"以赛亚书":1,"阿摩司书":1},"verse":"他手里拿着小书卷，是展开的。他右脚踏海，左脚踏地，","ref":"启示录 10:2","def":"放在炕前或椅前供垫脚用的矮木凳","senses":[["①","放在炕前或椅前供垫脚","申 28:56","出现 9 次"]],"bverse":"天上现出大异象来：有一个妇人身披日头，脚踏月亮，头戴十二星的冠冕。","bref":"启示录 12:1"},{"no":4512,"w":"善待","py":"","pos":"动词","orig":"","freq":14,"verses":13,"vols":7,"chaps":11,"ot":11,"nt":3,"first":"申命记 28:63","top":[["诗篇",4],["路加福音",3]],"rest":[5,7],"co":[["耶和华",6],["众多",2],["正直",2],["恶待",2]],"books":{"诗篇":4,"路加福音":3,"申命记":2,"撒母耳记（上）":2,"士师记":1,"约伯记":1,"箴言":1},"verse":"耶和华啊，你向来是照你的话善待仆人。","ref":"诗篇 119:65","def":"好好对待；也指善待仇敌。","senses":[],"bverse":"耶和华啊，求你善待那些为善和心里正直的人。","bref":"诗篇 125:4"},{"no":4513,"w":"安逸","py":"","pos":"名词","orig":"","freq":22,"verses":22,"vols":10,"chaps":20,"ot":21,"nt":1,"first":"申命记 28:65","top":[["约伯记",5],["耶利米书",5]],"rest":[8,12],"co":[["无虑",5],["耶和华",4],["那里",3],["声音",3]],"books":{"约伯记":5,"耶利米书":5,"以西结书":3,"诗篇":2,"以赛亚书":2,"申命记":1,"箴言":1,"阿摩司书":1,"撒迦利亚书":1,"路加福音":1},"verse":"有人至死身体强壮，尽得平靖安逸；","ref":"约伯记 21:23","def":"安闲舒适；也指安逸无虑。","senses":[],"bverse":"被囚的人同得安逸，不听见督工的声音。","bref":"约伯记 3:18"},{"no":4514,"w":"跳动","py":"","pos":"动词","orig":"","freq":6,"verses":6,"vols":4,"chaps":5,"ot":4,"nt":2,"first":"申命记 28:65","top":[["以赛亚书",2],["路加福音",2]],"rest":[2,2],"co":[["问安",2],["腹里",2],["消耗"