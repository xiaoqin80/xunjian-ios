:4","top":[["但以理书",2]],"rest":[0,0],"co":[["呼叫",1],["大声",1],["各方",1],["原文",1]],"books":{"但以理书":2},"verse":"那时传令的大声呼叫说：“各方、各国、各族（原文是舌：下同）的人哪，有令传与你们：","ref":"但以理书 3:4","def":"和合本用词；常见搭配：呼叫 1、大声 1、各方 1。","senses":[["①","传达命令","但 3:4","出现 2 次"]],"bverse":"伯沙撒下令，人就把紫袍给但以理穿上，把金炼给他戴在颈项上，又传令使他在国中位列第三。","bref":"但以理书 5:29"},{"no":8425,"w":"琵琶","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":1,"chaps":1,"ot":4,"nt":0,"first":"但以理书 3:5","top":[["但以理书",4]],"rest":[0,0],"co":[["声音",4],["敬拜",4],["各样",4],["乐器",4]],"books":{"但以理书":4},"verse":"王啊，你曾降旨说，凡听见角、笛、琵琶、琴、瑟、笙，和各样乐器声音的都当俯伏敬拜金像。","ref":"但以理书 3:10","def":"和合本用词；常见搭配：声音 4、敬拜 4、各样 4。","senses":[],"bverse":"你们一听见角、笛、琵琶、琴、瑟、笙，和各样乐器的声音，就当俯伏敬拜尼布甲尼撒王所立的金像。","bref":"但以理书 3:5"},{"no":8426,"w":"圣神","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":1,"chaps":2,"ot":4,"nt":0,"first":"但以理书 4:8","top":[["但以理书",4]],"rest":[0,0],"co":[["里头",4],["提沙",3],["告诉",3],["讲解",2]],"books":{"但以理书":4},"verse":"末后那照我神的名，称为伯提沙撒的但以理来到我面前，他里头有圣神的灵，我将梦告诉他说：","ref":"但以理书 4:8","def":"封建时代称颂帝王之词。亦借指皇帝","senses":[["①","封建时代称颂帝王之词","但 4:8","出现 4 次"]],"bverse":"‘术士的领袖伯提沙撒啊，因我知道你里头有圣神的灵，什么奥秘的事都不能使你为难。现在要把我梦中所见的异象和梦的讲解告诉我。’","bref":"但以理书 4:9"},{"no":8427,"w":"树墩","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"但以理书 4:15","top":[["但以理书",3]],"rest":[0,0],"co":[["田野",2],["天露",2],["青草",2],["一同",2]],"books":{"但以理书":3},"verse":"守望者既吩咐存留树墩，等你知道诸天掌权，以后你的国必定归你。","ref":"但以理书 4:26","def":"树身锯去后剩下的靠近根部的一段。也叫树墩子","senses":[["①","树身锯去后剩下的靠近","但 4:15","出现 3 次"]],"bverse":"树墩却要留在地内，用铁圈和铜圈箍住，在田野的青草中让天露滴湿，使他与地上的兽一同吃草，","bref":"但以理书 4:15"},{"no":8428,"w":"天露","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":1,"chaps":2,"ot":5,"nt":0,"first":"但以理书 4:15","top":[["但以理书",5]],"rest":[0,0],"co":[["世人",3],["赶出",3],["离开",3],["田野",2]],"books":{"但以理书":5},"verse":"树墩却要留在地内，用铁圈和铜圈箍住，在田野的青草中让天露滴湿，使他与地上的兽一同吃草，","ref":"但以理书 4:15","def":"和合本用词；常见搭配：世人 3、赶出 3、离开 3。","senses":[],"bverse":"王既看见一位守望的圣者从天而降，说：‘将这树砍伐毁坏，树墩却要留在地内，用铁圈和铜圈箍住；在田野的青草中，让天露滴湿，使他与地上的兽一同吃草，直到经过七期。’","bref":"但以理书 4:23"},{"no":8429,"w":"七期","py":"","pos":"时间词","orig":"","freq":4,"verses":4,"vols":1,"chaps":1,"ot":4,"nt":0,"first":"但以理书 4:16","top":[["但以理书",4]],"rest":[0,0],"co":[["经过",4],["天露",2],["世人",2],["野地",2]],"books":{"但以理书":4},"verse":"使他的心改变，不如人心；给他一个兽心，使他经过七期（期：或译年；本章同）。","ref":"但以理书 4:16","def":"和合本用词；常见搭配：经过 4、天露 2、世人 2。","senses":[],"bverse":"王既看见一位守望的圣者从天而降，说：‘将这树砍伐毁坏，树墩却要留在地内，用铁圈和铜圈箍住；在田野的青草中，让天露滴湿，使他与地上的兽一同吃草，直到经过七期。’","bref":"但以理书 4:23"},{"no":8430,"w":"要显","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"但以理书 4:30","top":[["但以理书",1],["马太福音",1]],"rest":[0,0],"co":[["荣耀",2],["京都",1],["威严",1],["巴比伦",1]],"books":{"但以理书":1,"马太福音":1},"verse":"他说：“这大巴比伦不是我用大能大力建为京都，要显我威严的荣耀吗？”","ref":"但以理书 4:30","def":"犹显要。亦指显要之官","senses":[],"bverse":"那时，人子的兆头要显在天上，地上的万族都要哀哭。他们要看见人子，有能力，有大荣耀，驾着天上的云降临。","bref":"马太福音 24:30"},{"no":8431,"w":"望天","py":"","pos":"名词","orig":"","freq":7,"verses":7,"vols":5,"chaps":7,"ot":1,"nt":6,"first":"但以理书 4:34","top":[["约翰福音",2],["使徒行传",2]],"rest":[3,3],"co":[["举目",4],["耶稣",3],["时候",2],["荣耀",2]],"books":{"约翰福音":2,"使徒行传":2,"但以理书":1,"马可福音":1,"路加福音":1},"verse":"他们就把石头挪开。耶稣举目望天，说：“父啊，我感谢你，因为你已经听我。","ref":"约翰福音 11:41","def":"和合本用词；常见搭配：举目 4、耶稣 3、时候 2。","senses":[],"bverse":"望天叹息，对他说：“以法大！”就是说：“开了吧！”","bref":"马可福音 7:34"},{"no":8432,"w":"复归","py":"","pos":"动词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"但以理书 4:34","top":[["但以理书",3]],"rest":[0,0],"co":[["权柄",2],["聪明",2],["举目",1],["望天",1]],"books":{"但以理书":3},"verse":"日子满足，我─尼布甲尼撒举目望天，我的聪明复归于我，我便称颂至高者，赞美尊敬活到永远的神。他的权柄是永有的；他的国存到万代。","ref":"但以理书 4:34","def":"和合本用词；常见搭配：权柄 2、聪明 2、举目 1。","senses":[],"bverse":"那时，我的聪明复归于我，为我国的荣耀、威严，和光耀也都复归于我；并且我的谋士和大臣也来朝见我。我又得坚立在国位上，至大的权柄加增于我。","bref":"但以理书 4:36"},{"no":8433,"w":"恭敬","py":"","pos":"形容词","orig":"","freq":6,"verses":5,"vols":4,"chaps":5,"ot":1,"nt":5,"first":"但以理书 4:37","top":[["罗马书",3],["但以理书",1]],"rest":[2,2],"co":[["行动",2],["诚实",1],["骄傲",1],["赞美",1]],"book