5:7","top":[["但以理书",3]],"rest":[0,0],"co":[["紫袍",3],["第三",3],["金炼",3],["讲解",2]],"books":{"但以理书":3},"verse":"伯沙撒下令，人就把紫袍给但以理穿上，把金炼给他戴在颈项上，又传令使他在国中位列第三。","ref":"但以理书 5:29","def":"和合本用词；常见搭配：紫袍 3、第三 3、金炼 3。","senses":[],"bverse":"大声吩咐将用法术的和迦勒底人并观兆的领进来，对巴比伦的哲士说，谁能读这文字，把讲解告诉我，他必身穿紫袍，项带金炼，在我国中位列第三。","bref":"但以理书 5:7"},{"no":8439,"w":"疑惑","py":"","pos":"动词","orig":"","freq":14,"verses":13,"vols":8,"chaps":12,"ot":2,"nt":12,"first":"但以理书 5:12","top":[["马太福音",3],["但以理书",2]],"rest":[6,9],"co":[["信心",4],["不要",4],["告诉",3],["耶稣",3]],"books":{"马太福音":3,"但以理书":2,"使徒行传":2,"罗马书":2,"雅各书":2,"马可福音":1,"约翰福音":1,"提摩太（前书）":1},"verse":"他们见了耶稣就拜他，然而还有人疑惑。","ref":"马太福音 28:17","def":"迷惑疑惑不解。②怀疑；不相信初闻尚疑惑，涕泪已不收","senses":[["①","迷惑疑惑不解","但 5:12","出现 14 次"]],"bverse":"耶稣赶紧伸手拉住他，说：“你这小信的人哪，为什么疑惑呢？”","bref":"马太福音 14:31"},{"no":8440,"w":"解明","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"但以理书 5:12","top":[["但以理书",1],["希伯来书",1]],"rest":[0,0],"co":[["知识",1],["谜语",1],["但以理",1],["里头",1]],"books":{"但以理书":1,"希伯来书":1},"verse":"论到麦基洗德，我们有好些话，并且难以解明，因为你们听不进去。","ref":"希伯来书 5:11","def":"和合本用词；常见搭配：知识 1、谜语 1、但以理 1。","senses":[["①","晓悟聪明","但 5:12","出现 2 次"]],"bverse":"在他里头有美好的灵性，又有知识聪明，能圆梦，释谜语，解疑惑。这人名叫但以理，尼布甲尼撒王又称他为伯提沙撒，现在可以召他来，他必解明这意思。”","bref":"但以理书 5:12"},{"no":8441,"w":"弥尼","py":"","pos":"名词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"但以理书 5:25","top":[["但以理书",3]],"rest":[0,0],"co":[["乌法",1],["文字",1],["讲解",1],["数算",1]],"books":{"但以理书":3},"verse":"“所写的文字是：‘弥尼，弥尼，提客勒，乌法珥新。’","ref":"但以理书 5:25","def":"和合本用词；常见搭配：乌法 1、文字 1、讲解 1。","senses":[],"bverse":"讲解是这样：弥尼，就是神已经数算你国的年日到此完毕。","bref":"但以理书 5:26"},{"no":8442,"w":"亏欠","py":"","pos":"动词","orig":"","freq":7,"verses":6,"vols":6,"chaps":6,"ot":1,"nt":6,"first":"但以理书 5:27","top":[["罗马书",2],["但以理书",1]],"rest":[4,4],"co":[["显出",1],["天平",1],["遇见",1],["赦免",1]],"books":{"罗马书":2,"但以理书":1,"路加福音":1,"腓利门书":1,"希伯来书":1,"雅各书":1},"verse":"凡事都不可亏欠人，惟有彼此相爱要常以为亏欠，因为爱人的就完全了律法。","ref":"罗马书 13:8","def":"和合本用词；常见搭配：显出 1、天平 1、遇见 1。","senses":[],"bverse":"提客勒，就是你被称在天平里，显出你的亏欠。","bref":"但以理书 5:27"},{"no":8443,"w":"大利乌","py":"","pos":"名词","orig":"","freq":11,"verses":11,"vols":2,"chaps":6,"ot":11,"nt":0,"first":"但以理书 5:31","top":[["但以理书",8],["撒迦利亚书",3]],"rest":[0,0],"co":[["儿子",3],["临到",3],["撒迦利亚",3],["耶和华",3]],"books":{"但以理书":8,"撒迦利亚书":3},"verse":"于是大利乌王立这禁令，加盖玉玺。","ref":"但以理书 6:9","def":"波斯王名号，多位君王共用","senses":[["①","波斯王名号","但 5:31","出现 11 次"]],"bverse":"米底亚人大利乌年六十二岁，取了迦勒底国。","bref":"但以理书 5:31"},{"no":8444,"w":"总长","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":1,"chaps":1,"ot":5,"nt":0,"first":"但以理书 6:2","top":[["但以理书",5]],"rest":[0,0],"co":[["总督",5],["但以理",3],["事务",1],["王受",1]],"books":{"但以理书":5},"verse":"于是，总长和总督纷纷聚集来见王，说：“愿大利乌王万岁！","ref":"但以理书 6:6","def":"辛亥革命后成立的南京临时政府各部的长官。亦为北洋军阀统治时期中央政府各部最高长官之名称","senses":[["①","辛亥革命后成立的南京","但 6:2","出现 5 次"]],"bverse":"因这但以理有美好的灵性，所以显然超乎其余的总长和总督，王又想立他治理通国。","bref":"但以理书 6:3"},{"no":8445,"w":"显然","py":"","pos":"形容词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":2,"nt":3,"first":"但以理书 6:3","top":[["希伯来书",2],["但以理书",1]],"rest":[2,2],"co":[["其余",1],["但以理",1],["超乎",1],["灵性",1]],"books":{"希伯来书":2,"但以理书":1,"哈巴谷书":1,"约翰福音":1},"verse":"因此律法放松，公理也不显明；恶人围困义人，所以公理显然颠倒。","ref":"哈巴谷书 1:4","def":"副词。表示情况十分明显这场雪显然对庄稼有利","senses":[],"bverse":"因这但以理有美好的灵性，所以显然超乎其余的总长和总督，王又想立他治理通国。","bref":"但以理书 6:3"},{"no":8446,"w":"把柄","py":"","pos":"名词","orig":"","freq":7,"verses":7,"vols":4,"chaps":5,"ot":2,"nt":5,"first":"但以理书 6:4","top":[["路加福音",3],["但以理书",2]],"rest":[2,2],"co":[["耶稣",3],["但以理",2],["窥探",2],["这话",2]],"books":{"路加福音":3,"但以理书":2,"约翰福音":1,"提摩太（前书）":1},"verse":"文士和法利赛人窥探耶稣，在安息日治病不治病，要得把柄去告他。","ref":"路加福音 6:7","def":"和合本用词；常见搭配：耶稣 3、但以理 2、窥探 2。","senses":[],"bverse":"他们当着百姓，在这话上得不着把柄，又希奇他的应对，就闭口无言了。","bref":"路加福音 20:26"},{"no":8447,"w":"纷纷","py":"","pos":"副词","orig":"","freq":4,"verses":4,"vols":2,"chaps":2,"ot":3,"nt":1,"first":"但以理书 6:6","top":[["但以理书",3],["使徒行传",1]],"rest":[0,0],"co":[["聚集",4],["知道",2],["万岁",1],["总长",1]],"books":{"但以理书":3,"使徒行传":1},"verse":"那些人就纷纷聚集，见但以理在他神面前祈祷恳求。","ref":"但以理书 6:11","def":"和合本用词；常见搭配：聚集 4、知道 2、万岁 1。","senses":[],"bverse":"于是，总长和总督纷纷聚集来见王，说：“愿大利乌王万岁！","bref":"但以理书 6:6"},{"no":8448,"w":"禁令","py":"","pos":"名词","orig":"","freq":9,"verses":7,"vols":1,"chaps":1,"ot":9,"nt":0,"first":"但以理书 6:7","top":[["但以理书",9]],"rest":[0,0],"co":[["玉玺",5],["更改",3],["不可",3],["波斯",3]],"books":{"但以理书":9},"verse":"于是大利乌王立这禁令，加盖玉玺。","ref":"但以理书 6:9","def":"禁止从事某项活动的法令解除","senses":[["①","禁止从事某项活动的法","但 6:7","出现 9 次"]],"bverse":"国中的总长、钦差、总督、谋士，和巡抚彼此商议，要立一条坚定的禁令（或译：求王下旨要立一条……），三十日内，不拘何人，若在王以外，或向神或向人求什么，就必扔在狮子坑中。","bref":"但以理书 6:7"},{"no":8449,"w":"玉玺","py":"","pos":"名词","orig":"","freq":5,"verses":5,"vols":1,"chaps":1,"ot":5,"nt":0,"first":"但以理书 6:8","top":[["但以理书",5]],"rest":[0,0],"co":[["禁令",5],["更改",2],["不可",2],["波斯",2]],"books":{"但以理书":5},"verse":"于是大利乌王立这禁令，加盖玉玺。","ref":"但以理书 6:9","def":"专指皇帝的玉印。始于秦。据汉蔡邕《独断》载\"天子玺以玉螭虎纽。古者尊卑共之……秦以来，天子独以印称玺，又","senses":[["①","专指皇帝的玉印","但 6:8","出现 5 次"]],"bverse":"王啊，现在求你立这禁令，加盖玉玺，使禁令决不更改；照玛代和波斯人的例是不可更改的。”","bref":"但以理书 6:8"},{"no":8450,"w":"伤损","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"但以理书 6:23","top":[["但以理书",1],["使徒行传",1]],"rest":[0,0],"co":[["但以理",1],["毫无",1],["上来",1],["吩咐",1]],"books":{"但以理书":1,"使徒行传":1},"verse":"王就甚喜乐，吩咐人将但以理从坑里系上来。于是但以理从坑里被系上来，身上毫无伤损，因为信靠他的神。","ref":"但以理书 6:23","def":"和合本用词；常见搭配：但以理 1、毫无 1、上来 1。","senses":[],"bverse":"众人多日没有吃什么，保罗就出来站在他们中间，说：“众位，你们本该听我的话，不离开克里特，免得遭这样的伤损破坏。","bref":"使徒行传 27:21"},{"no":8451,"w":"这兽","py":"","pos":"代词","orig":"","freq":4,"verses":4,"vols":2,"chaps":2,"ot":3,"nt":1,"first":"但以理书 7:5","top":[["但以理书",3],["启示录",1]],"rest":[0,0],"co":[["权柄",2],["观看",2],["如熊",1],["吩咐",1]],"books":{"但以理书":3,"启示录":1},"verse":"此后我观看，又有一兽如豹，背上有鸟的四个翅膀；这兽有四个头，又得了权柄。","ref":"但以理书 7:6","def":"和合本用词；常见搭配：权柄 2、观看 2、如熊 1。","senses":[],"bverse":"又拜那龙─因为它将自己的权柄给了兽，也拜兽，说：“谁能比这兽，谁能与它交战呢？”","bref":"启示录 13:4"},{"no":8452,"w":"十角","py":"","pos":"数词","orig":"","freq":10,"verses":9,"vols":2,"chaps":4,"ot":3,"nt":7,"first":"但以理书 7:7","top":[["启示录",7],["但以理书",3]],"rest":[0,0],"co":[["七头",4],["看见",4],["异象",2],["冠冕",2]],"books":{"启示录":7,"但以理书":3},"verse":"天上又现出异象来：有一条大红龙，七头十角；七头上戴着七个冠冕。","ref":"启示录 12:3","def":"和合本用词；常见搭配：七头 4、看见 4、异象 2。","senses":[],"bverse":"我又看见一个兽从海中上来，有十角七头，在十角上戴着十个冠冕，七头上有亵渎的名号。","bref":"启示录 13:1"},{"no":8453,"w":"小角","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"但以理书 7:8","top":[["但以理书",3]],"rest":[0,0],"co":[["夸大",2],["观看",2],["长起",1],["这角",1]],"books":{"但以理书":3},"verse":"四角之中有一角长出一个小角，向南、向东、向荣美之地，渐渐成为强大。","ref":"但以理书 8:9","def":"和合本用词；常见搭配：夸大 2、观看 2、长起 1。","senses":[],"bverse":"那时我观看，见那兽因小角说夸大话的声音被杀，身体损坏，扔在火中焚烧。","bref":"但以理书 7:11"},{"no":8454,"w":"三角","py":"","pos":"数词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"但以理书 7:8","top":[["但以理书",2]],"rest":[0,0],"co":[["这角",2],["夸大",2],["长起",1],["小角",1]],"books":{"但以理书":2},"verse":"头有十角和那另长的一角，在这角前有三角被它打落。这角有眼，有说夸大话的口，形状强横，过于它的同类。","ref":"但以理书 7:20","def":"和合本用词；常见搭配：这角 2、夸大 2、长起 1。","senses":[],"bverse":"我正观看这些角，见其中又长起一个小角；先前的角中有三角在这角前，连根被它拔出来。这角有眼，像人的眼，有口说夸大的话。","bref":"但以理书 7:8"},{"no":8455,"w":"连根","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"但以理书 7:8","top":[["但以理书",1],["犹大书",1]],"rest":[0,0],"co":[["长起",1],["小角",1],["这角",1],["夸大",1]],"books":{"但以理书":1,"犹大书":1},"verse":"我正观看这些角，见其中又长起一个小角；先前的角中有三角在这角前，连根被它拔出来。这角有眼，像人的眼，有口说夸大的话。","ref":"但以理书 7:8","def":"植物的根连着根","senses":[["①","植物的根连着根","但 7:8","出现 2 次"]],"bverse":"这样的人在你们的爱席上与你们同吃的时候，正是礁石（或译：玷污）。他们作牧人，只知喂养自己，无所惧怕；是没有雨的云彩，被风飘荡；是秋天没有果子的树，死而又死，连根被拔出来；","bref":"犹大书 1:12"},{"no":8456,"w":"如雪","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"但以理书 7:9","top":[["但以理书",1],["马太福音",1]],"rest":[1,1],"co":[["洁白",2],["火焰",2],["羊毛",2],["衣服",2]],"books":{"但以理书":1,"马太福音":1,"启示录":1},"verse":"他的相貌如同闪电，衣服洁白如雪。","ref":"马太福音 28:3","def":"和合本用词；常见搭配：洁白 2、火焰 2、羊毛 2。","senses":[],"bverse":"他的头与发皆白，如白羊毛，如雪；眼目如同火焰；","bref":"启示录 1:14"},{"no":8457,"w":"案卷","py":"","pos":"名词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":2,"first":"但以理书 7:10","top":[["启示录",2],["但以理书",1]],"rest":[0,0],"co":[["展开",2],["审判",2],["要行",1],["发出",1]],"books":{"启示录":2,"但以理书":1},"verse":"从他面前有火，像河发出；事奉他的有千千，在他面前侍立的有万万；他坐着要行审判，案卷都展开了。","ref":"但以理书 7:10","def":"和合本用词；常见搭配：展开 2、审判 2、要行 1。","senses":[],"bverse":"我又看见死了的人，无论大小，都站在宝座前。案卷展开了，并且另有一卷展开，就是生命册。死了的人都凭着这些案卷所记载的，照他们所行的受审判。","bref":"启示录 20:12"},{"no":8458,"w":"一载","py":"","pos":"数词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"但以理书 7:25","top":[["但以理书",2],["启示录",1]],"rest":[0,0],"co":[["二载",3],["半载",3],["圣民",2],["律法",1]],"books":{"但以理书":2,"启示录":1},"verse":"他必向至高者说夸大的话，必折磨至高者的圣民，必想改变节期和律法。圣民必交付他手一载、二载、半载。","ref":"但以理书 7:25","def":"和合本用词；常见搭配：二载 3、半载 3、圣民 2。","senses":[],"bverse":"我听见那站在河水以上、穿细麻衣的，向天举起左右手，指著活到永远的主起誓说：“要到一载、二载、半载，打破圣民权力的时候，这一切事就都应验了。”","bref":"但以理书 12:7"},{"no":8459,"w":"二载","py":"","pos":"数词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"但以理书 7:25","top":[["但以理书",2],["启示录",1]],"rest":[0,0],"co":[["一载",3],["半载",3],["圣民",2],["律法",1]],"books":{"但以理书":2,"启示录":1},"verse":"他必向至高者说夸大的话，必折磨至高者的圣民，必想改变节期和律法。圣民必交付他手一载、二载、半载。","ref":"但以理书 7:25","def":"和合本用词；常见搭配：一载 3、半载 3、圣民 2。","senses":[],"bverse":"我听见那站在河水以上、穿细麻衣的，向天举起左右手，指著活到永远的主起誓说：“要到一载、二载、半载，打破圣民权力的时候，这一切事就都应验了。”","bref":"但以理书 12:7"},{"no":8460,"w":"半载","py":"","pos":"数词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"但以理书 7:25","top":[["但以理书",2],["启示录",1]],"rest":[0,0],"co":[["二载",3],["一载",3],["圣民",2],["律法",1]],"books":{"但以理书":2,"启示录":1},"verse":"他必向至高者说夸大的话，必折磨至高者的圣民，必想改变节期和律法。圣民必交付他手一载、二载、半载。","ref":"但以理书 7:25","def":"和合本用词；常见搭配：二载 3、一载 3、圣民 2。","senses":[],"bverse":"我听见那站在河水以上、穿细麻衣的，向天举起左右手，指著活到永远的主起誓说：“要到一载、二载、半载，打破圣民权力的时候，这一切事就都应验了。”","bref":"但以理书 12:7"},{"no":8461,"w":"双角","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"但以理书 8:3","top":[["但以理书",3]],"rest":[0,0],"co":[["绵羊",3],["河边",2],["看见",2],["举目",1]],"books":{"但以理书":3},"verse":"你所看见双角的公绵羊，就是玛代和波斯王。","ref":"但以理书 8:20","def":"和合本用词；常见搭配：绵羊 3、河边 2、看见 2。","senses":[],"bverse":"它往我所看见、站在河边有双角的公绵羊那里去，大发忿怒，向它直闯。","bref":"但以理书 8:6"},{"no":8462,"w":"自高自大","py":"","pos":"","orig":"","freq":15,"verses":15,"vols":6,"chaps":10,"ot":6,"nt":9,"first":"但以理书 8:4","top":[["但以理书",5],["哥林多前书",5]],"rest":[4,5],"co":[["任意",3],["不可",3],["时候",2],["以为",2]],"books":{"但以理书":5,"哥林多前书":5,"提摩太（前书）":2,"哈巴谷书":1,"歌罗西书":1,"提摩太（后书）":1},"verse":"并且它自高自大，以为高及天象之君；除掉常献给君的燔祭，毁坏君的圣所。","ref":"但以理书 8:11","def":"自以为了不起","senses":[["①","自以为了不起","但 8:4","出现 15 次"]],"bverse":"有些人自高自大，以为我不到你们那里去；","bref":"哥林多前书 4:18"},{"no":8463,"w":"百列","py":"","pos":"数词","orig":"","freq":4,"verses":4,"vols":2,"chaps":3,"ot":2,"nt":2,"first":"但以理书 8:16","top":[["但以理书",2],["路加福音",2]],"rest":[0,0],"co":[["异象",2],["天使",2],["呼叫",1],["明白",1]],"books":{"但以理书":2,"路加福音":2},"verse":"我又听见乌莱河两岸中有人声呼叫说：“加百列啊，要使此人明白这异象。”","ref":"但以理书 8:16","def":"和合本用词；常见搭配：异象 2、天使 2、呼叫 1。","senses":[],"bverse":"到了第六个月，天使加百列奉神的差遣往加利利的一座城去（这城名叫拿撒勒），","bref":"路加福音 1:26"},{"no":8464,"w":"一来","py":"","pos":"副词","orig":"","freq":4,"verses":4,"vols":3,"chaps":3,"ot":3,"nt":1,"first":"但以理书 8:17","top":[["约珥书",2],["但以理书",1]],"rest":[1,1],"co":[["它们",2],["惊慌",1],["异象",1],["明白",1]],"books":{"约珥书":2,"但以理书":1,"路加福音":1},"verse":"它们一来，众民伤恸，脸都变色。","ref":"约珥书 2:6","def":"和合本用词；常见搭配：它们 2、惊慌 1、异象 1。","senses":[],"bverse":"它们一来，地震天动，日月昏暗，星宿无光。","bref":"约珥书 2:10"},{"no":8465,"w":"希腊","py":"","pos":"名词","orig":"","freq":16,"verses":15,"vols":6,"chaps":14,"ot":5,"nt":11,"first":"但以理书 8:21","top":[["使徒行传",7],["但以理书",4]],"rest":[4,5],"co":[["犹太人",6],["原文",3],["希伯来",3],["我要",2]],"books":{"使徒行传":7,"但以理书":4,"约翰福音":2,"撒迦利亚书":1,"路加福音":1,"启示录":1},"verse":"所以他们中间多有相信的，又有希腊尊贵的妇女，男子也不少。","ref":"使徒行传 17:12","def":"东南欧国家。在巴尔干半岛南部。东、南、西分别临爱琴海、地中和爱奥尼亚海。面积1320万平方千米。人口约1","senses":[["①","东南欧国家","但 8:21","出现 16 次"]],"bverse":"走遍了那一带地方，用许多话劝勉门徒（或译：众人），然后来到希腊。","bref":"使徒行传 20:2"},{"no":8466,"w":"末时","py":"","pos":"时间词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"但以理书 8:23","top":[["但以理书",3]],"rest":[0,0],"co":[["但以理",2],["隐藏",2],["封闭",2],["这话",2]],"books":{"但以理书":3},"verse":"他说：“但以理啊，你只管去；因为这话已经隐藏封闭，直到末时。","ref":"但以理书 12:9","def":"和合本用词；常见搭配：但以理 2、隐藏 2、封闭 2。","senses":[],"bverse":"这四国末时，犯法的人罪恶满盈，必有一王兴起，面貌凶恶，能用双关的诈语。","bref":"但以理书 8:23"},{"no":8467,"w":"必大","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"但以理书 8:24","top":[["但以理书",1],["路加福音",1]],"rest":[0,0],"co":[["圣民",1],["顺利",1],["权柄",1],["事情",1]],"books":{"但以理书":1,"路加福音":1},"verse":"他的权柄必大，却不是因自己的能力；他必行非常的毁灭，事情顺利，任意而行；又必毁灭有能力的和圣民。","ref":"但以理书 8:24","def":"谓后世必然兴旺。语出《左传．僖公十五年》\"且吾闻唐叔之封也，箕子曰'其后必大。'晋其庸可冀乎？\"","senses":[["①","谓后世必然兴旺","但 8:24","出现 2 次"]],"bverse":"你们倒要爱仇敌，也要善待他们，并要借给人不指望偿还，你们的赏赐就必大了，你们也必作至高者的儿子；因为他恩待那忘恩的和作恶的。","bref":"路加福音 6:35"},{"no":8468,"w":"无备","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"但以理书 8:25","top":[["但以理书",3]],"rest":[0,0],"co":[["时候",3],["坦然",3],["未曾",2],["手中",1]],"books":{"但以理书":3},"verse":"必有一个卑鄙的人兴起接续为王，人未曾将国的尊荣给他，他却趁人坦然无备的时候，用谄媚的话得国。","ref":"但以理书 11:21","def":"和合本用词；常见搭配：时候 3、坦然 3、未曾 2。","senses":[],"bverse":"他用权术成就手中的诡计，心里自高自大，在人坦然无备的时候，毁灭多人；又要站起来攻击万君之君，至终却非因人手而灭亡。","bref":"但以理书 8:25"},{"no":8469,"w":"意向","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"但以理书 9:3","top":[["但以理书",1],["路加福音",1]],"rest":[0,0],"co":[["禁食",1],["恳求",1],["主神",1],["祈祷",1]],"books":{"但以理书":1,"路加福音":1},"verse":"我便禁食，披麻蒙灰，定意向主神祈祷恳求。","ref":"但以理书 9:3","def":"和合本用词；常见搭配：禁食 1、恳求 1、主神 1。","senses":[["①","亦作\"意向\"","但 9:3","出现 2 次"]],"bverse":"耶稣被接上升的日子将到，他就定意向耶路撒冷去，","bref":"路加福音 9:51"},{"no":8470,"w":"爱主","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"但以理书 9:4","top":[["但以理书",1],["马太福音",1]],"rest":[2,2],"co":[["尽性",3],["尽心",3],["尽意",3],["尽力",2]],"books":{"但以理书":1,"马太福音":1,"马可福音":1,"路加福音":1},"verse":"你要尽心、尽性、尽意、尽力爱主─你的神。’","ref":"马可福音 12:30","def":"和合本用词；常见搭配：尽性 3、尽心 3、尽意 3。","senses":[],"bverse":"耶稣对他说：“你要尽心、尽性、尽意爱主─你的神。","bref":"马太福音 22:37"},{"no":8471,"w":"眷爱","py":"","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"但以理书 9:23","top":[["但以理书",3]],"rest":[0,0],"co":[["大蒙",3],["明白",2],["我来",1],["时候",1]],"books":{"但以理书":3},"verse":"你初恳求的时候，就发出命令，我来告诉你，因你大蒙眷爱；所以你要思想明白这以下的事和异象。","ref":"但以理书 9:23","def":"和合本用词；常见搭配：大蒙 3、明白 2、我来 1。","senses":[["①","垂爱;爱念","但 9:23","出现 3 次"]],"bverse":"他对我说：“大蒙眷爱的但以理啊，要明白我与你所说的话，只管站起来，因为我现在奉差遣来到你这里。”他对我说这话，我便战战兢兢地立起来。","bref":"但以理书 10:11"},{"no":8472,"w":"引进","py":"","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"但以理书 9:24","top":[["但以理书",1],["加拉太书",1]],"rest":[2,2],"co":[["除净",1],["罪孽",1],["异象",1],["罪恶",1]],"books":{"但以理书":1,"加拉太书":1,"希伯来书":1,"彼得后书":1},"verse":"（律法原来一无所成）就引进了更美的指望；靠这指望，我们便可以进到神面前。","ref":"希伯来书 7:19","def":"和合本用词；常见搭配：除净 1、罪孽 1、异象 1。","senses":[],"bverse":"因为有偷着引进来的假弟兄，私下窥探我们在基督耶稣里的自由，要叫我们作奴仆。","bref":"加拉太书 2:4"},{"no":8473,"w":"一七","py":"","pos":"数词","orig":"","freq":2,"verses":1,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"但以理书 9:27","top":[["但以理书",2]],"rest":[0,0],"co":[["许多",1],["必使",1],["祭祀",1],["盟约",1]],"books":{"但以理书":2},"verse":"一七之内，他必与许多人坚定盟约；一七之半，他必使祭祀与供献止息。那行毁坏可憎的（或译：使地荒凉的）如飞而来，并且有忿怒倾在那行毁坏的身上（或译：倾在那荒凉之地），直到所定的结局。”","ref":"但以理书 9:27","def":"旧时称人死后的头一个第七天。故亦称头七","senses":[["①","旧时称人死后的头一个","但 9:27","出现 2 次"]],"bverse":"","bref":""},{"no":8474,"w":"已蒙","py":"","pos":"副词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":1,"nt":2,"first":"但以理书 10:12","top":[["使徒行传",2],["但以理书",1]],"rest":[0,0],"co":[["面前",3],["达到",2],["祷告",2],["记念",2]],"books":{"使徒行传":2,"但以理书":1},"verse":"说：‘哥尼流，你的祷告已蒙垂听，你的赒济达到神面前已蒙记念了。","ref":"使徒行传 10:31","def":"和合本用词；常见搭配：面前 3、达到 2、祷告 2。","senses":[],"bverse":"他就说：“但以理啊，不要惧怕！因为从你第一日专心求明白将来的事，又在你神面前刻苦己心，你的言语已蒙应允；我是因你的言语而来。","bref":"但以理书 10:12"},{"no":8475,"w":"魔君","py":"","pos":"名词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"但以理书 10:13","top":[["但以理书",3]],"rest":[0,0],"co":[["波斯",2],["大君",1],["诸王",1],["迦勒",1]],"books":{"但以理书":3},"verse":"他就说：“你知道我为何来见你吗？现在我要回去与波斯的魔君争战，我去后，希腊（原文是雅完）的魔君必来。","ref":"但以理书 10:20","def":"犹魔王。喻指凶残﹑凶暴者","senses":[],"bverse":"但波斯国的魔君拦阻我二十一日。忽然有大君（就是天使长；二十一节同）中的一位米迦勒来帮助我，我就停留在波斯诸王那里。","bref":"但以理书 10:13"},{"no":8476,"w":"大君","py":"","pos":"名词","orig":"","freq":4,"verses":4,"vols":2,"chaps":3,"ot":3,"nt":1,"first":"但以理书 10:13","top":[["但以理书",3],["马太福音",1]],"rest":[0,0],"co":[["迦勒",3],["帮助",2],["天使",2],["诸王",1]],"books":{"但以理书":3,"马太福音":1},"verse":"不可指著地起誓，因为地是他的脚凳；也不可指著耶路撒冷起誓，因为耶路撒冷是大君的京城；","ref":"马太福音 5:35","def":"和合本用词；常见搭配：迦勒 3、帮助 2、天使 2。","senses":[],"bverse":"但波斯国的魔君拦阻我二十一日。忽然有大君（就是天使长；二十一节同）中的一位米迦勒来帮助我，我就停留在波斯诸王那里。","bref":"但以理书 10:13"},{"no":8477,"w":"通行","py":"","pos":"","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"但以理书 11:20","top":[["哈巴谷书",2],["但以理书",1]],"rest":[0,0],"co":[["兴起",2],["争战",1],["接续",1],["多日",1]],"books":{"哈巴谷书":2,"但以理书":1},"verse":"你发忿恨通行大地，发怒气责打列国，如同打粮。","ref":"哈巴谷书 3:12","def":"谓行人﹑车马等可以通过","senses":[["①","谓行人﹑车马等可以通","但 11:20","出现 3 次"]],"bverse":"我必兴起迦勒底人，就是那残忍暴躁之民，通行遍地，占据那不属自己的住处。","bref":"哈巴谷书 1:6"},{"no":8478,"w":"了结","py":"","pos":"动词","orig":"","freq":5,"verses":5,"vols":4,"chaps":4,"ot":2,"nt":3,"first":"但以理书 11:27","top":[["但以理书",2],["路加福音",1]],"rest":[2,2],"co":[["定期",2],["说谎",1],["成就",1],["心怀",1]],"books":{"但以理书":2,"路加福音":1,"腓立比书":1,"希伯来书":1},"verse":"所以，我一看出我的事要怎样了结，就盼望立刻打发他去；","ref":"腓立比书 2:23","def":"解决；结束案子已经","senses":[],"bverse":"至于这二王，他们心怀恶计，同席说谎，计谋却不成就；因为到了定期，事就了结。","bref":"但以理书 11:27"},{"no":8479,"w":"圣约","py":"","pos":"名词","orig":"","freq":5,"verses":4,"vols":2,"chaps":2,"ot":4,"nt":1,"first":"但以理书 11:28","top":[["但以理书",4],["路加福音",1]],"rest":[0,0],"co":[["任意",2],["财宝",1],["回往",1],["许多",1]],"books":{"但以理书":4,"路加福音":1},"verse":"作恶违背圣约的人，他必用巧言勾引；惟独认识神的子民必刚强行事。","ref":"但以理书 11:32","def":"和合本用词；常见搭配：任意 2、财宝 1、回往 1。","senses":[],"bverse":"北方王（原文是他）必带许多财宝回往本国，他的心反对圣约，任意而行，回到本地。","bref":"但以理书 11:28"},{"no":8480,"w":"战船","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"但以理书 11:30","top":[["但以理书",2]],"rest":[0,0],"co":[["攻击",2],["基提",1],["必来",1],["丧胆",1]],"books":{"但以理书":2},"verse":"因为基提战船必来攻击他，他就丧胆而回，又要恼恨圣约，任意而行；他必回来联络背弃圣约的人。","ref":"但以理书 11:30","def":"和合本用词；常见搭配：攻击 2、基提 1、必来 1。","senses":[["①","作战用的船","但 11:30","出现 2 次"]],"bverse":"到末了，南方王要与他交战。北方王必用战车、马兵，和许多战船，势如暴风来攻击他，也必进入列国，如洪水泛滥。","bref":"但以理书 11:40"},{"no":8481,"w":"那站","py":"","pos":"代词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"但以理书 12:7","top":[["但以理书",1],["撒迦利亚书",1]],"rest":[1,1],"co":[["时候",1],["向天",1],["活到",1],["听见",1]],"books":{"但以理书":1,"撒迦利亚书":1,"启示录":1},"verse":"我看见那站在神面前的七位天使，有七枝号赐给他们。","ref":"启示录 8:2","def":"和合本用词；常见搭配：时候 1、向天 1、活到 1。","senses":[],"bverse":"那站在番石榴树中间的人说：“这是奉耶和华差遣在遍地走来走去的。”","bref":"撒迦利亚书 1:10"},{"no":8482,"w":"末期","py":"","pos":"方位词","orig":"","freq":6,"verses":6,"vols":5,"chaps":5,"ot":1,"nt":5,"first":"但以理书 12:13","top":[["马太福音",2],["但以理书",1]],"rest":[3,3],"co":[["不要",3],["只是",3],["打仗",3],["必须",3]],"books":{"马太福音":2,"但以理书":1,"马可福音":1,"路加福音":1,"哥林多前书":1},"verse":"这天国的福音要传遍天下，对万民作见证，然后末期才来到。”","ref":"马太福音 24:14","def":"行将结束的时期;最后的一段时期","senses":[["①","行将结束的时期;最后","但 12:13","出现 6 次"]],"bverse":"“你且去等候结局，因为你必安歇。到了末期，你必起来，享受你的福分。”","bref":"但以理书 12:13"},{"no":8483,"w":"何西阿","py":"","pos":"名词","orig":"","freq":6,"verses":6,"vols":2,"chaps":2,"ot":5,"nt":1,"first":"何西阿书 1:1","top":[["何西阿书",5],["罗马书",1]],"rest":[0,0],"co":[["耶和华",4],["以色列",3],["儿子",2],["歌篾",2]],"books":{"何西阿书":5,"罗马书":1},"verse":"于是，何西阿去娶了滴拉音的女儿歌篾。这妇人怀孕，给他生了一个儿子。","ref":"何西阿书 1:3","def":"圣经专名（人名／地名／族名），首见 何西阿书 1:1。","senses":[],"bverse":"当乌西雅、约坦、亚哈斯、希西家作犹大王，约阿施的儿子耶罗波安作以色列王的时候，耶和华的话临到备利的儿子何西阿。","bref":"何西阿书 1:1"},{"no":8484,"w":"大日","py":"","pos":"名词","orig":"","freq":6,"verses":6,"vols":5,"chaps":6,"ot":2,"nt":4,"first":"何西阿书 1:11","top":[["启示录",2],["何西阿书",1]],"rest":[3,3],"co":[["聚集",2],["日子",2],["以色列人",1],["一同",1]],"books":{"启示录":2,"何西阿书":1,"西番雅书":1,"约翰福音":1,"犹大书":1},"verse":"因为他们忿怒的大日到了，谁能站得住呢？”","ref":"启示录 6:17","def":"和合本用词；常见搭配：聚集 2、日子 2、以色列人 1。","senses":[],"bverse":"耶和华的大日临近，临近而且甚快，乃是耶和华日子的风声；勇士必痛痛地哭号。","bref":"西番雅书 1:14"},{"no":8485,"w":"胸间","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":1,"nt":2,"first":"何西阿书 2:2","top":[["启示录",2],["何西阿书",1]],"rest":[0,0],"co":[["金带",2],["丈夫",1],["妻子",1],["除掉",1]],"books":{"启示录":2,"何西阿书":1},"verse":"灯台中间有一位好像人子，身穿长衣，直垂到脚，胸间束着金带。","ref":"启示录 1:13","def":"和合本用词；常见搭配：金带 2、丈夫 1、妻子 1。","senses":[],"bverse":"你们要与你们的母亲大大争辩；因为她不是我的妻子，我也不是她的丈夫。叫她除掉脸上的淫像和胸间的淫态，","bref":"何西阿书 2:2"},{"no":8486,"w":"倔强","py":"","pos":"形容词","orig":"","freq":2,"verses":1,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"何西阿书 4:16","top":[["何西阿书",2]],"rest":[0,0],"co":[["犹如",1],["宽阔",1],["以色列",1],["如同",1]],"books":{"何西阿书":2},"verse":"以色列倔强，犹如倔强的母牛；现在耶和华要放他们，如同放羊羔在宽阔之地。","ref":"何西阿书 4:16","def":"刚强不屈性格","senses":[["①","刚强不屈性格～ㄧ他有","何 4:16","出现 2 次"]],"bverse":"","bref":""},{"no":8487,"w":"私子","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"何西阿书 5:7","top":[["何西阿书",1],["希伯来书",1]],"rest":[0,0],"co":[["吞灭",1],["行事",1],["诡诈",1],["耶和华",1]],"books":{"何西阿书":1,"希伯来书":1},"verse":"他们向耶和华行事诡诈，生了私子。到了月朔，他们与他们的地业必被吞灭。","ref":"何西阿书 5:7","def":"和合本用词；常见搭配：吞灭 1、行事 1、诡诈 1。","senses":[],"bverse":"管教原是众子所共受的。你们若不受管教，就是私子，不是儿子了。","bref":"希伯来书 12:8"},{"no":8488,"w":"发苗","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"何西阿书 8:7","top":[["何西阿书",1],["马太福音",1]],"rest":[1,1],"co":[["石头",2],["地上",2],["最快",2],["禾稼",1]],"books":{"何西阿书":1,"马太福音":1,"马可福音":1},"verse":"有落在土浅石头地上的，土既不深，发苗最快，","ref":"马太福音 13:5","def":"和合本用词；常见搭配：石头 2、地上 2、最快 2。","senses":[],"bverse":"有落在土浅石头地上的，土既不深，发苗最快，","bref":"马可福音 4:5"},{"no":8489,"w":"大多","py":"","pos":"数词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"何西阿书 8:14","top":[["何西阿书",1],["马太福音",1]],"rest":[1,1],"co":[["先知",2],["究竟",2],["出去",2],["告诉",2]],"books":{"何西阿书":1,"马太福音":1,"路加福音":1},"verse":"你们出去究竟是为什么？是要看先知吗？我告诉你们，是的，他比先知大多了。","ref":"马太福音 11:9","def":"大部分;大多数","senses":[["①","大部分;大多数","何 8:14","出现 3 次"]],"bverse":"你们出去，究竟是要看什么？要看先知吗？我告诉你们，是的，他比先知大多了。","bref":"路加福音 7:26"},{"no":8490,"w":"纵然","py":"","pos":"连词","orig":"","freq":6,"verses":6,"vols":6,"chaps":6,"ot":1,"nt":5,"first":"何西阿书 9:12","top":[["何西阿书",1],["路加福音",1]],"rest":[4,4],"co":[["不留",1],["必使",1],["儿女",1],["丧子",1]],"books":{"何西阿书":1,"路加福音":1,"约翰福音":1,"使徒行传":1,"哥林多后书":1,"提摩太（后书）":1},"verse":"纵然养大儿女，我却必使他们丧子，甚至不留一个。我离弃他们，他们就有祸了。","ref":"何西阿书 9:12","def":"连词。即使纵然酷暑严寒，大家也不迟到早退","senses":[],"bverse":"我们纵然失信，他仍是可信的，因为他不能背乎自己。","bref":"提摩太后书 2:13"},{"no":8491,"w":"犹疑","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"何西阿书 11:12","top":[["何西阿书",1],["约翰福音",1]],"rest":[0,0],"co":[["不定",2],["诚实",1],["圣者",1],["诡计",1]],"books":{"何西阿书":1,"约翰福音":1},"verse":"犹太人围着他，说：“你叫我们犹疑不定到几时呢？你若是基督，就明明地告诉我们。”","ref":"约翰福音 10:24","def":"和合本用词；常见搭配：不定 2、诚实 1、圣者 1。","senses":[["①","犹豫不决","何 11:12","出现 2 次"]],"bverse":"以法莲用谎话，以色列家用诡计围绕我；犹大却靠神掌权，向圣者有忠心（或译：犹大向神，向诚实的圣者犹疑不定）。","bref":"何西阿书 11:12"},{"no":8492,"w":"那因","py":"","pos":"代词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":1,"nt":4,"first":"何西阿书 12:14","top":[["何西阿书",1],["罗马书",1]],"rest":[3,3],"co":[["必将",1],["惹动",1],["流血",1],["羞辱",1]],"books":{"何西阿书":1,"罗马书":1,"哥林多后书":1,"提摩太（前书）":1,"彼得后书":1},"verse":"感谢神！常率领我们在基督里夸胜，并借着我们在各处显扬那因认识基督而有的香气。","ref":"哥林多后书 2:14","def":"和合本用词；常见搭配：必将 1、惹动 1、流血 1。","senses":[],"bverse":"因为我们属肉体的时候，那因律法而生的恶欲就在我们肢体中发动，以致结成死亡的果子。","bref":"罗马书 7:5"},{"no":8493,"w":"剪虫","py":"","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"约珥书 1:4","top":[["约珥书",2],["阿摩司书",1]],"rest":[0,0],"co":[["蝗虫",2],["蚂蚱",2],["剩下",1],["我要",1]],"books":{"约珥书":2,"阿摩司书":1},"verse":"剪虫剩下的，蝗虫来吃；蝗虫剩下的，蝻子来吃；蝻子剩下的，蚂蚱来吃。","ref":"约珥书 1:4","def":"和合本用词；常见搭配：蝗虫 2、蚂蚱 2、剩下 1。","senses":[],"bverse":"我打发到你们中间的大军队，就是蝗虫、蝻子、蚂蚱、剪虫，那些年所吃的，我要补还你们。","bref":"约珥书 2:25"},{"no":8494,"w":"幽冥","py":"","pos":"形容词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"约珥书 2:2","top":[["约珥书",1],["西番雅书",1]],"rest":[0,0],"co":[["乌黑",2],["那日",2],["日子",2],["密云",2]],"books":{"约珥书":1,"西番雅书":1},"verse":"那日是忿怒的日子，是急难困苦的日子，是荒废凄凉的日子，是黑暗幽冥、密云乌黑的日子，","ref":"西番雅书 1:15","def":"和合本用词；常见搭配：乌黑 2、那日 2、日子 2。","senses":[["①","玄远;微妙","珥 2:2","出现 2 次"]],"bverse":"那日是黑暗、幽冥、密云、乌黑的日子，好像晨光铺满山岭。有一队蝗虫（原文是民）又大又强；从来没有这样的，以后直到万代也必没有。","bref":"约珥书 2:2"},{"no":8495,"w":"异梦","py":"","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"约珥书 2:28","top":[["约珥书",1],["使徒行传",1]],"rest":[0,0],"co":[["浇灌",2],["要说",2],["我要",2],["儿女",2]],"books":{"约珥书":1,"使徒行传":1},"verse":"以后，我要将我的灵浇灌凡有血气的。你们的儿女要说预言；你们的老年人要做异梦，少年人要见异象。","ref":"约珥书 2:28","def":"神借梦赐下的启示","senses":[["①","神借梦赐下的启示","珥 2:28","出现 2 次"]],"bverse":"神说：在末后的日子，我要将我的灵浇灌凡有血气的。你们的儿女要说预言；你们的少年人要见异象；老年人要做异梦。","bref":"使徒行传 2:17"},{"no":8496,"w":"希腊人","py":"","pos":"名词","orig":"","freq":27,"verses":27,"vols":8,"chaps":22,"ot":1,"nt":26,"first":"约珥书 3:6","top":[["使徒行传",10],["罗马书",6]],"rest":[6,11],"co":[["犹太人",19],["保罗",4],["那里",3],["割礼",3]],"books":{"使徒行传":10,"罗马书":6,"哥林多前书":4,"约翰福音":2,"加拉太书":2,"约珥书":1,"马可福音":1,"歌罗西书":1},"verse":"每逢安息日，保罗在会堂里辩论，劝化犹太人和希腊人。","ref":"使徒行传 18:4","def":"希腊文化圈的民族，泛指外邦人","senses":[["①","希腊文化圈的民族","珥 3:6","出现 27 次"]],"bverse":"又对犹太人和希腊人证明当向神悔改，信靠我主耶稣基督。","bref":"使徒行传 20:21"},{"no":8497,"w":"酒池","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"约珥书 3:13","top":[["约珥书",1],["哈该书",1]],"rest":[0,0],"co":[["践踏",1],["开镰",1],["罪恶",1],["盈溢",1]],"books":{"约珥书":1,"哈该书":1},"verse":"开镰吧！因为庄稼熟了；践踏吧！因为酒醡满了。酒池盈溢；他们的罪恶甚大。","ref":"约珥书 3:13","def":"和合本用词；常见搭配：践踏 1、开镰 1、罪恶 1。","senses":[["①","谓以酒为池","珥 3:13","出现 2 次"]],"bverse":"在那一切日子，有人来到谷堆，想得二十斗，只得了十斗。有人来到酒池，想得五十桶，只得了二十桶。","bref":"哈该书 2:16"},{"no":8498,"w":"阿摩司","py":"","pos":"名词","orig":"","freq":7,"verses":7,"vols":1,"chaps":3,"ot":7,"nt":0,"first":"阿摩司书 1:1","top":