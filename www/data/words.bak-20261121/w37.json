"箴言 16:15"},{"no":3610,"w":"撒种","py":"","pos":"动词","orig":"","freq":33,"verses":29,"vols":17,"chaps":24,"ot":20,"nt":13,"first":"利未记 26:5","top":[["以赛亚书",4],["利未记",3]],"rest":[15,26],"co":[["收割",7],["耶和华",3],["出去",3],["时候",2]],"books":{"以赛亚书":4,"利未记":3,"申命记":3,"耶利米书":3,"马太福音":3,"马可福音":3,"路加福音":2,"约翰福音":2,"加拉太书":2,"民数记":1,"士师记":1,"诗篇":1,"传道书":1,"阿摩司书":1,"弥迦书":1,"撒迦利亚书":1,"哥林多后书":1},"verse":"你们在各水边撒种、牧放牛驴的有福了！","ref":"以赛亚书 32:20","def":"播种；耶稣撒种的比喻。","senses":[],"bverse":"那耕地为要撒种的，岂是常常耕地呢？岂是常常开垦耙地呢？","bref":"以赛亚书 28:24"},{"no":3611,"w":"惊吓","py":"","pos":"动词","orig":"","freq":39,"verses":37,"vols":13,"chaps":30,"ot":38,"nt":1,"first":"利未记 26:6","top":[["以赛亚书",10],["约伯记",8]],"rest":[11,21],"co":[["无人",9],["耶和华",8],["四围",6],["躺卧",4]],"books":{"以赛亚书":10,"约伯记":8,"耶利米书":8,"诗篇":3,"以西结书":2,"利未记":1,"历代志（下）":1,"耶利米哀歌":1,"弥迦书":1,"那鸿书":1,"哈巴谷书":1,"西番雅书":1,"腓立比书":1},"verse":"你当进入岩穴，藏在土中，躲避耶和华的惊吓和他威严的荣光。","ref":"以赛亚书 2:10","def":"因意外的刺激而害怕孩子受了","senses":[["①","因意外的刺激而害怕孩","利 26:6","出现 39 次"]],"bverse":"你必因公义得坚立，必远离欺压，不致害怕；你必远离惊吓，惊吓必不临近你。","bref":"以赛亚书 54:14"},{"no":3612,"w":"息灭","py":"","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"利未记 26:6","top":[["利未记",1],["雅歌",1]],"rest":[0,0],"co":[["躺卧",1],["我要",1],["恶兽",1],["刀剑",1]],"books":{"利未记":1,"雅歌":1},"verse":"爱情，众水不能息灭，大水也不能淹没。若有人拿家中所有的财宝要换爱情，就全被藐视。","ref":"雅歌 8:7","def":"和合本用词；常见搭配：躺卧 1、我要 1、恶兽 1。","senses":[["①","熄灭;绝灭","利 26:6","出现 2 次"]],"bverse":"我要赐平安在你们的地上；你们躺卧，无人惊吓。我要叫恶兽从你们的地上息灭；刀剑也必不经过你们的地。","bref":"利未记 26:6"},{"no":3613,"w":"必倒","py":"","pos":"副词","orig":"","freq":28,"verses":28,"vols":9,"chaps":21,"ot":28,"nt":0,"first":"利未记 26:7","top":[["以西结书",15],["民数记",3]],"rest":[7,10],"co":[["耶和华",12],["如此",7],["以色列",5],["田野",4]],"books":{"以西结书":15,"民数记":3,"利未记":2,"以赛亚书":2,"耶利米书":2,"诗篇":1,"但以理书":1,"何西阿书":1,"阿摩司书":1},"verse":"被杀的人必倒在你们中间，你们就知道我是耶和华。","ref":"以西结书 6:7","def":"必倒下；常写「仇敌必倒」。","senses":[],"bverse":"你必倒在田野，因为我曾说过。这是主耶和华说的。","bref":"以西结书 39:5"},{"no":3614,"w":"一万","py":"","pos":"数词","orig"