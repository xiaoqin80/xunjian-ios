[{"no":7101,"w":"土块","py":"tǔ kuài","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"约伯记 21:33","top":[["约伯记",2],["诗篇",1]],"rest":[1,1],"co":[["甘甜",1],["无数",1],["以后",1],["聚集",1]],"books":{"约伯记":2,"诗篇":1,"约珥书":1},"verse":"他要以谷中的土块为甘甜；在他以先去的无数，在他以后去的更多。","ref":"约伯记 21:33","def":"成疙瘩或成团块的泥土","senses":[["①","成疙瘩或成团块的泥土","伯 21:33","出现 4 次"]],"bverse":"谁能用智慧数算云彩呢？尘土聚集成团，土块紧紧结连；那时，谁能倾倒天上的瓶呢？","bref":"约伯记 38:37"},{"no":7102,"w":"错谬","py":"cuò miù","pos":"形容词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"约伯记 21:34","top":[["约伯记",1],["以赛亚书",1]],"rest":[2,2],"co":[["徒然",1],["安慰",1],["罪孽",1],["亵渎",1]],"books":{"约伯记":1,"以赛亚书":1,"彼得后书":1,"犹大书":1},"verse":"你们对答的话中既都错谬，怎么徒然安慰我呢？","ref":"约伯记 21:34","def":"和合本用词；常见搭配：徒然 1、安慰 1、罪孽 1。","senses":[],"bverse":"因为愚顽人必说愚顽话，心里想作罪孽，惯行亵渎的事，说错谬的话攻击耶和华，使饥饿的人无食可吃，使口渴的人无水可喝。","bref":"以赛亚书 32:6"},{"no":7103,"w":"看透","py":"kàn tòu","pos":"动词","orig":"","freq":4,"verses":3,"vols":2,"chaps":2,"ot":1,"nt":3,"first":"约伯记 22:13","top":[["哥林多前书",3],["约伯记",1]],"rest":[0,0],"co":[["知道",2],["属灵",2],["岂能",1],["审判",1]],"books":{"哥林多前书":3,"约伯记":1},"verse":"属灵的人能看透万事，却没有一人能看透了他。","ref":"哥林多前书 2:15","def":"和合本用词；常见搭配：知道 2、属灵 2、岂能 1。","senses":[],"bverse":"你说：神知道什么？他岂能看透幽暗施行审判呢？","bref":"约伯记 22:13"},{"no":7104,"w":"周游","py":"zhōu yóu","pos":"方位词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"约伯记 22:14","top":[["约伯记",1],["诗篇",1]],"rest":[1,1],"co":[["遮盖",1],["密云",1],["穹苍",1],["不能",1]],"books":{"约伯记":1,"诗篇":1,"路加福音":1},"verse":"密云将他遮盖，使他不能看见；他周游穹苍。","ref":"约伯记 22:14","def":"和合本用词；常见搭配：遮盖 1、密云 1、穹苍 1。","senses":[["①","见\"周游\"","伯 22:14","出现 3 次"]],"bverse":"你们当周游锡安，四围旋绕，数点城楼，","bref":"诗篇 48:12"},{"no":7105,"w":"这道","py":"zhè dào","pos":"代词","orig":"","freq":19,"verses":18,"vols":7,"chaps":16,"ot":2,"nt":17,"first":"约伯记 22:15","top":[["使徒行传",13],["约伯记",1]],"rest":[5,5],"co":[["耶路撒冷",3],["门徒",2],["面前",2],["男女",2]],"books":{"使徒行传":13,"约伯记":1,"诗篇":1,"约翰福音":1,"罗马书":1,"帖撒罗尼迦（前书）":1,"彼得前书