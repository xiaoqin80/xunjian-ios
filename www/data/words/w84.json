:[["以西结书",6]],"rest":[0,0],"co":[["门洞",4],["廊子",4],["两旁",3],["窗櫺",3]],"books":{"以西结书":6},"verse":"卫房前展出的境界：这边一肘，那边一肘；卫房这边六肘，那边六肘。","ref":"以西结书 40:12","def":"和合本用词；常见搭配：门洞 4、廊子 4、两旁 3。","senses":[],"bverse":"卫房和门洞两旁柱间并廊子，都有严紧的窗櫺；里边都有窗櫺，柱上有雕刻的棕树。","bref":"以西结书 40:16"},{"no":8374,"w":"门廊","py":"mén láng","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 40:9","top":[["以西结书",3]],"rest":[0,0],"co":[["桌子",2],["这边",2],["那边",2],["两张",2]],"books":{"以西结书":3},"verse":"又量门廊，宽八肘，墙柱厚二肘；那门的廊子向着殿。","ref":"以西结书 40:9","def":"和合本用词；常见搭配：桌子 2、这边 2、那边 2。","senses":[],"bverse":"上到朝北的门口，这边有两张桌子，门廊那边也有两张桌子。","bref":"以西结书 40:40"},{"no":8375,"w":"墙柱","py":"qiáng zhù","pos":"名词","orig":"","freq":6,"verses":6,"vols":1,"chaps":2,"ot":6,"nt":0,"first":"以西结书 40:9","top":[["以西结书",6]],"rest":[0,0],"co":[["廊子",4],["又量",2],["二十",2],["这面",2]],"books":{"以西结书":6},"verse":"又量门廊，宽八肘，墙柱厚二肘；那门的廊子向着殿。","ref":"以西结书 40:9","def":"和合本用词；常见搭配：廊子 4、又量 2、二十 2。","senses":[],"bverse":"他到内殿量墙柱，各厚二肘。门口宽六肘，门两旁各宽七肘。","bref":"以西结书 41:3"},{"no":8376,"w":"门洞","py":"mén dòng","pos":"名词","orig":"","freq":21,"verses":14,"vols":1,"chaps":1,"ot":21,"nt":0,"first":"以西结书 40:10","top":[["以西结书",21]],"rest":[0,0],"co":[["廊子",9],["柱子",8],["两旁",7],["尺寸",5]],"books":{"以西结书":21},"verse":"铺石地，就是矮铺石地在各门洞两旁，以门洞的长短为度。","ref":"以西结书 40:18","def":"城门的门洞。","senses":[],"bverse":"就是量卫房和柱子，并廊子。门洞周围都有窗櫺；门洞长五十肘，宽二十五肘。","bref":"以西结书 40:36"},{"no":8377,"w":"三间","py":"sān jiān","pos":"数词","orig":"","freq":4,"verses":2,"vols":1,"chaps":1,"ot":4,"nt":0,"first":"以西结书 40:10","top":[["以西结书",4]],"rest":[0,0],"co":[["这旁",2],["尺寸",2],["门洞",2],["那旁",2]],"books":{"以西结书":4},"verse":"东门洞有卫房：这旁三间，那旁三间，都是一样的尺寸；这边的柱子和那边的柱子，也是一样的尺寸。","ref":"以西结书 40:10","def":"和合本用词；常见搭配：这旁 2、尺寸 2、门洞 2。","senses":[],"bverse":"门洞的卫房，这旁三间，那旁三间。门洞的柱子和廊子，与第一门的尺寸一样。门洞长五十肘，宽二十五肘。","bref":"以西结书 40:21"},{"no":8378,"w":"他量","py":"tā liàng","pos":"代词","orig":"","freq":7,"verses":7,"vols":1,"chaps":3,"ot":7,"nt":0,"first":"以西结书 40:11","top":[["以西结书",7]],"rest":[0,0],"co":[["门口",2],["两旁",2],["二十",2],["房子",2]],"books":{"以西结书":7},"verse":"他量门口，宽十肘，长十三肘。","ref":"以西结书 40:11","def":"和合本用词；常见搭配：门口 2、两旁 2、二十 2。","senses":[],"bverse":"他量外院朝北的门，长宽若干。","bref":"以西结书 40:20"},{"no":8379,"w":"译本","py":"yì běn","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以西结书 40:14","top":[["以西结书",2]],"rest":[0,0],"co":[["七十",2],["墙柱",1],["两边",1],["原文",1]],"books":{"以西结书":2},"verse":"本月初七日（七十士译本是七月初一日）也要为误犯罪的和愚蒙犯罪的如此行，为殿赎罪。","ref":"以西结书 45:20","def":"翻译成另一种文字的本子","senses":[["①","翻译成另一种文字的本","结 40:14","出现 2 次"]],"bverse":"又量（原文是造）廊子六十肘（七十士译本是二十肘），墙柱外是院子，有廊为界，在门洞两边。","bref":"以西结书 40:14"},{"no":8380,"w":"长宽","py":"zhǎng kuān","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"以西结书 40:20","top":[["以西结书",2],["启示录",1]],"rest":[0,0],"co":[["他量",1],["外院",1],["朝北",1],["夹道",1]],"books":{"以西结书":2,"启示录":1},"verse":"他量外院朝北的门，长宽若干。","ref":"以西结书 40:20","def":"和合本用词；常见搭配：他量 1、外院 1、朝北 1。","senses":[],"bverse":"这圣屋前的夹道与北边圣屋的夹道长宽一样；出入之处与北屋门的样式相同。","bref":"以西结书 42:11"},{"no":8381,"w":"八层","py":"bā céng","pos":"数词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 40:31","top":[["以西结书",3]],"rest":[0,0],"co":[["棕树",3],["上到",3],["台阶",3],["雕刻",3]],"books":{"以西结书":3},"verse":"廊子朝着外院，柱上有雕刻的棕树。登八层台阶上到这门。","ref":"以西结书 40:31","def":"和合本用词；常见搭配：棕树 3、上到 3、台阶 3。","senses":[],"bverse":"廊子朝着外院。门洞两旁的柱子都有雕刻的棕树。登八层台阶上到这门。","bref":"以西结书 40:34"},{"no":8382,"w":"四张","py":"sì zhāng","pos":"数词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 40:41","top":[["以西结书",3]],"rest":[0,0],"co":[["桌子",2],["宰杀",2],["祭司",2],["牺牲",1]],"books":{"以西结书":3},"verse":"门这边有四张桌子，那边有四张桌子，共八张；在其上祭司宰杀牺牲。","ref":"以西结书 40:41","def":"和合本用词；常见搭配：桌子 2、宰杀 2、祭司 2。","senses":[],"bverse":"为燔祭牲有四张桌子，是凿过的石头做成的，长一肘半，宽一肘半，高一肘。祭司将宰杀燔祭牲和平安祭牲所用的器皿放在其上。","bref":"以西结书 40:42"},{"no":8383,"w":"三肘","py":"sān zhǒu","pos":"数词","orig":"","freq":2,"verses":1,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以西结书 40:48","top":[["以西结书",2]],"rest":[0,0],"co":[["五肘",1],["墙柱",1],["这面",1],["那面",1]],"books":{"以西结书":2},"verse":"于是他带我到殿前的廊子，量廊子的墙柱。这面厚五肘，那面厚五肘。门两旁，这边三肘，那边三肘。","ref":"以西结书 40:48","def":"肘，度量词。一肘一尺五寸，三肘为四尺五寸『班固《白虎通．圣人》\"汤臂三肘，是谓柳翼，攘去不义，万民蕃息。","senses":[],"bverse":"","bref":""},{"no":8384,"w":"楼廊","py":"lóu láng","pos":"名词","orig":"","freq":4,"verses":3,"vols":1,"chaps":2,"ot":4,"nt":0,"first":"以西结书 41:15","top":[["以西结书",4]],"rest":[0,0],"co":[["两旁",1],["房子",1],["后面",1],["一百",1]],"books":{"以西结书":4},"verse":"他量空地后面的那房子，并两旁的楼廊，共长一百肘。","ref":"以西结书 41:15","def":"和合本用词；常见搭配：两旁 1、房子 1、后面 1。","senses":[],"bverse":"对着内院那二十肘宽之空地，又对着外院的铺石地，在第三层楼上有楼廊对着楼廊。","bref":"以西结书 42:3"},{"no":8385,"w":"圣屋","py":"shèng wū","pos":"名词","orig":"","freq":9,"verses":9,"vols":1,"chaps":2,"ot":9,"nt":0,"first":"以西结书 42:1","top":[["以西结书",9]],"rest":[0,0],"co":[["外院",4],["进入",3],["祭司",3],["石地",2]],"books":{"以西结书":9},"verse":"圣屋因为楼廊占去些地方，所以上层比中下两层窄些。","ref":"以西结书 42:5","def":"和合本用词；常见搭配：外院 4、进入 3、祭司 3。","senses":[],"bverse":"在圣屋以下，东头有进入之处，就是从外院进入之处。","bref":"以西结书 42:9"},{"no":8386,"w":"一排","py":"yī pái","pos":"数词","orig":"","freq":11,"verses":5,"vols":3,"chaps":4,"ot":5,"nt":6,"first":"以西结书 42:1","top":[["以西结书",5],["马可福音",4]],"rest":[1,2],"co":[["石地",2],["相对",2],["圣屋",2],["坐下",2]],"books":{"以西结书":5,"马可福音":4,"路加福音":2},"verse":"其中周围有一排房子，房子内有煮肉的地方。","ref":"以西结书 46:23","def":"和合本用词；常见搭配：石地 2、相对 2、圣屋 2。","senses":[],"bverse":"向南（原文是东）在内院墙里有圣屋，一排与铺石地之屋相对，一排顺着空地。","bref":"以西结书 42:10"},{"no":8387,"w":"屋长","py":"wū zhǎng","pos":"名词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 42:2","top":[["以西结书",3]],"rest":[0,0],"co":[["五十",2],["一百",2],["北面",1],["外院",1]],"books":{"以西结书":3},"verse":"这圣屋长一百肘，宽五十肘，有向北的门。","ref":"以西结书 42:2","def":"和合本用词；常见搭配：五十 2、一百 2、北面 1。","senses":[],"bverse":"靠着外院的圣屋长五十肘。殿北面的圣屋长一百肘。","bref":"以西结书 42:8"},{"no":8388,"w":"夹道","py":"jiā dào","pos":"动词","orig":"","freq":4,"verses":3,"vols":1,"chaps":1,"ot":4,"nt":0,"first":"以西结书 42:4","top":[["以西结书",4]],"rest":[0,0],"co":[["房门",1],["一条",1],["一百",1],["相同",1]],"books":{"以西结书":4},"verse":"在圣屋前有一条夹道，宽十肘，长一百肘。房门都向北。","ref":"以西结书 42:4","def":"和合本用词；常见搭配：房门 1、一条 1、一百 1。","senses":[["①","左右都有墙壁等的狭窄","结 42:4","出现 4 次"]],"bverse":"这圣屋前的夹道与北边圣屋的夹道长宽一样；出入之处与北屋门的样式相同。","bref":"以西结书 42:11"},{"no":8389,"w":"若因","py":"ruò yīn","pos":"连词","orig":"","freq":5,"verses":4,"vols":3,"chaps":3,"ot":1,"nt":4,"first":"以西结书 43:11","top":[["罗马书",2],["彼得前书",2]],"rest":[1,1],"co":[["一人",2],["过犯",2],["何况",2],["耶稣基督",2]],"books":{"罗马书":2,"彼得前书":2,"以西结书":1},"verse":"你们若因犯罪受责打，能忍耐，有什么可夸的呢？但你们若因行善受苦，能忍耐，这在神看是可喜爱的。","ref":"彼得前书 2:20","def":"和合本用词；常见搭配：一人 2、过犯 2、何况 2。","senses":[],"bverse":"他们若因自己所行的一切事惭愧，你就将殿的规模、样式、出入之处，和一切形状、典章、礼仪、法则指示他们，在他们眼前写上，使他们遵照殿的一切规模典章去做。","bref":"以西结书 43:11"},{"no":8390,"w":"礼仪","py":"lǐ yí","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"以西结书 43:11","top":[["以西结书",1],["路加福音",1]],"rest":[1,1],"co":[["指示",1],["规模",1],["眼前",1],["形状",1]],"books":{"以西结书":1,"路加福音":1,"罗马书":1},"verse":"他们二人在神面前都是义人，遵行主的一切诫命礼仪，没有可指摘的，","ref":"路加福音 1:6","def":"和合本用词；常见搭配：指示 1、规模 1、眼前 1。","senses":[],"bverse":"他们是以色列人；那儿子的名分、荣耀、诸约、律法、礼仪、应许都是他们的。","bref":"罗马书 9:4"},{"no":8391,"w":"底座","py":"dǐ zuò","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 43:13","top":[["以西结书",3]],"rest":[0,0],"co":[["一肘",3],["四围",2],["以下",1],["祭坛",1]],"books":{"以西结书":3},"verse":"从底座到下层磴台，高二肘，边宽一肘。从小磴台到大磴台，高四肘，边宽一肘。","ref":"以西结书 43:14","def":"和合本用词；常见搭配：一肘 3、四围 2、以下 1。","senses":[],"bverse":"磴台长十四肘，宽十四肘，四面见方。四围起边高半肘，底座四围的边宽一肘。台阶朝东。","bref":"以西结书 43:17"},{"no":8392,"w":"台长","py":"tái zhǎng","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以西结书 43:16","top":[["以西结书",2]],"rest":[0,0],"co":[["四面",2],["见方",2],["十二",1],["底座",1]],"books":{"以西结书":2},"verse":"供台长十二肘，宽十二肘，四面见方。","ref":"以西结书 43:16","def":"古时御史台的长官。一般指御史大夫。明代罢御史台﹐置都察院﹐则以左右都御史为台长","senses":[["①","古时御史台的长官","结 43:16","出现 2 次"]],"bverse":"磴台长十四肘，宽十四肘，四面见方。四围起边高半肘，底座四围的边宽一肘。台阶朝东。","bref":"以西结书 43:17"},{"no":8393,"w":"外门","py":"wài mén","pos":"方位词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"以西结书 44:1","top":[["以西结书",2],["使徒行传",1]],"rest":[0,0],"co":[["朝东",2],["关闭",1],["回到",1],["圣地",1]],"books":{"以西结书":2,"使徒行传":1},"verse":"他又带我回到圣地朝东的外门；那门关闭了。","ref":"以西结书 44:1","def":"和合本用词；常见搭配：朝东 2、关闭 1、回到 1。","senses":[],"bverse":"他带我出北门，又领我从外边转到朝东的外门，见水从右边流出。","bref":"以西结书 47:2"},{"no":8394,"w":"使民","py":"shǐ mín","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"以西结书 44:19","top":[["以西结书",2]],"rest":[0,0],"co":[["成圣",2],["免得",2],["外院",2],["那里",1]],"books":{"以西结书":2},"verse":"他对我说：“这是祭司煮赎愆祭、赎罪祭，烤素祭之地，免得带到外院，使民成圣。”","ref":"以西结书 46:20","def":"统治人民，使其服从自己","senses":[["①","统治人民","结 44:19","出现 2 次"]],"bverse":"他们出到外院的民那里，当脱下供职的衣服，放在圣屋内，穿上别的衣服，免得因圣衣使民成圣。","bref":"以西结书 44:19"},{"no":8395,"w":"中事","py":"zhōng shì","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以西结书 44:27","top":[["以西结书",1],["启示录",1]],"rest":[0,0],"co":[["日子",1],["圣所",1],["内院",1],["赎罪祭",1]],"books":{"以西结书":1,"启示录":1},"verse":"所以，他们在神宝座前，昼夜在他殿中事奉他。坐宝座的要用帐幕覆庇他们。","ref":"启示录 7:15","def":"指某时期中重要的事情","senses":[["①","指某时期中重要的事情","结 44:27","出现 2 次"]],"bverse":"当他进内院，进圣所，在圣所中事奉的日子，要为自己献赎罪祭。这是主耶和华说的。","bref":"以西结书 44:27"},{"no":8396,"w":"圣供","py":"shèng gōng","pos":"动词","orig":"","freq":9,"verses":6,"vols":1,"chaps":2,"ot":9,"nt":0,"first":"以西结书 45:1","top":[["以西结书",9]],"rest":[0,0],"co":[["圣地",2],["一万",2],["其中",2],["归城",2]],"books":{"以西结书":9},"verse":"你们所献的圣供地连归城之地，是四方的：长二万五千肘，宽二万五千肘。","ref":"以西结书 48:20","def":"和合本用词；常见搭配：圣地 2、一万 2、其中 2。","senses":[],"bverse":"也要分定属城的地业，宽五千肘，长二万五千肘，挨着那分圣供地，要归以色列全家。","bref":"以西结书 45:6"},{"no":8397,"w":"加油","py":"jiā yóu","pos":"动词","orig":"","freq":4,"verses":4,"vols":1,"chaps":2,"ot":4,"nt":0,"first":"以西结书 45:24","top":[["以西结书",4]],"rest":[0,0],"co":[["伊法",4],["素祭",4],["一欣",4],["细面",4]],"books":{"以西结书":4},"verse":"同献的素祭要为公绵羊献一伊法细面，为羊羔照他的力量而献，一伊法细面加油一欣。","ref":"以西结书 46:5","def":"和合本用词；常见搭配：伊法 4、素祭 4、一欣 4。","senses":[],"bverse":"他也要预备素祭，就是为一只公牛同献一伊法细面，为一只公绵羊同献一伊法细面，每一伊法细面加油一欣。","bref":"以西结书 45:24"},{"no":8398,"w":"必由","py":"bì yóu","pos":"副词","orig":"","freq":3,"verses":2,"vols":1,"chaps":1,"ot":3,"nt":0,"first":"以西结书 46:8","top":[["以西结书",3]],"rest":[0,0],"co":[["时候",2],["进入",2],["由此",1],["这门",1]],"books":{"以西结书":3},"verse":"王进入的时候必由这门的廊而入，也必由此而出。","ref":"以西结书 46:8","def":"和合本用词；常见搭配：时候 2、进入 2、由此 1。","senses":[],"bverse":"在各节期，国内居民朝见耶和华的时候，从北门进入敬拜的，必由南门而出；从南门进入的，必由北门而出。不可从所入的门而出，必要直往前行，由对门而出。","bref":"以西结书 46:9"},{"no":8399,"w":"岸上","py":"àn shàng","pos":"处所词","orig":"","freq":8,"verses":8,"vols":5,"chaps":6,"ot":2,"nt":6,"first":"以西结书 47:7","top":[["以西结书",2],["马可福音",2]],"rest":[3,4],"co":[["上船",3],["众人",3],["耶稣",3],["树木",2]],"books":{"以西结书":2,"马可福音":2,"约翰福音":2,"马太福音":1,"使徒行传":1},"verse":"我回到河边的时候，见在河这边与那边的岸上有极多的树木。","ref":"以西结书 47:7","def":"和合本用词；常见搭配：上船 3、众人 3、耶稣 3。","senses":[],"bverse":"到了晚上，船在海中，耶稣独自在岸上；","bref":"马可福音 6:47"},{"no":8400,"w":"治病","py":"zhì bìng","pos":"动词","orig":"","freq":8,"verses":7,"vols":3,"chaps":6,"ot":1,"nt":7,"first":"以西结书 47:12","top":[["路加福音",6],["以西结书",1]],"rest":[1,1],"co":[["耶稣",5],["安息日",4],["枯干",2],["法利赛人",2]],"books":{"路加福音":6,"以西结书":1,"马太福音":1},"verse":"门徒就出去，走遍各乡宣传福音，到处治病。","ref":"路加福音 9:6","def":"和合本用词；常见搭配：耶稣 5、安息日 4、枯干 2。","senses":[],"bverse":"文士和法利赛人窥探耶稣，在安息日治病不治病，要得把柄去告他。","bref":"路加福音 6:7"}]