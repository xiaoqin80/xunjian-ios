erse":"田野的树木都必知道我─耶和华使高树矮小，矮树高大；青树枯干，枯树发旺。我─耶和华如此说，也如此行了。”","ref":"以西结书 17:24","def":"常绿乔木。亦泛指绿树","senses":[["①","常绿乔木","结 17:24","出现 2 次"]],"bverse":"对南方的树林说，要听耶和华的话。主耶和华如此说：我必使火在你中间著起，烧灭你中间的一切青树和枯树，猛烈的火焰必不熄灭。从南到北，人的脸面都被烧焦。","bref":"以西结书 20:47"},{"no":8315,"w":"因由","py":"yīn yóu","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以西结书 18:3","top":[["以西结书",1],["彼得后书",1]],"rest":[0,0],"co":[["不再",1],["起誓",1],["永生",1],["有用",1]],"books":{"以西结书":1,"彼得后书":1},"verse":"主耶和华说：“我指着我的永生起誓，你们在以色列中，必不再有用这俗语的因由。","ref":"以西结书 18:3","def":"和合本用词；常见搭配：不再 1、起誓 1、永生 1。","senses":[["①","理由;由头","结 18:3","出现 2 次"]],"bverse":"并且要以我主长久忍耐为得救的因由，就如我们所亲爱的兄弟保罗，照着所赐给他的智慧写了信给你们。","bref":"彼得后书 3:15"},{"no":8316,"w":"合理","py":"hé lǐ","pos":"动词","orig":"","freq":9,"verses":9,"vols":3,"chaps":4,"ot":7,"nt":2,"first":"以西结书 18:5","top":[["以西结书",7],["路加福音",1]],"rest":[1,1],"co":[["正直",7],["存活",4],["必定",4],["恶人",4]],"books":{"以西结书":7,"路加福音":1,"使徒行传":1},"verse":"“人若是公义，且行正直与合理的事：","ref":"以西结书 18:5","def":"和合本用词；常见搭配：正直 7、存活 4、必定 4。","senses":[],"bverse":"恶人转离他的恶，行正直与合理的事，就必因此存活。","bref":"以西结书 33:19"},{"no":8317,"w":"多要","py":"duō yào","pos":"","orig":"","freq":4,"verses":4,"vols":1,"chaps":2,"ot":4,"nt":0,"first":"以西结书 18:8","top":[["以西结书",4]],"rest":[0,0],"co":[["借钱",4],["取利",4],["弟兄",4],["罪孽",2]],"books":{"以西结书":4},"verse":"未曾向借钱的弟兄取利，也未曾向借粮的弟兄多要，缩手不作罪孽，在两人之间，按至理判断；","ref":"以西结书 18:8","def":"和合本用词；常见搭配：借钱 4、取利 4、弟兄 4。","senses":[],"bverse":"向借钱的弟兄取利，向借粮的弟兄多要─这人岂能存活呢？他必不能存活。他行这一切可憎的事，必要死亡，他的罪（原文是血）必归到他身上。","bref":"以西结书 18:13"},{"no":8318,"w":"缩手","py":"suō shǒu","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"以西结书 18:8","top":[["以西结书",3]],"rest":[0,0],"co":[["多要",2],["借钱",2],["罪孽",2],["未曾",2]],"books":{"以西结书":3},"verse":"未曾向借钱的弟兄取利，也未曾向借粮的弟兄多要，缩手不作罪孽，在两人之间，按至理判断；","ref":"以西结书 18:8","def":"和合本用词；常见搭配：多要 2、借钱 2、罪孽 2。","senses":[["①","袖手;停手","结 18:8","出现 3 次"]],"bverse":"缩手不害贫穷人，未曾向借钱的弟兄取利，也未曾向借粮的弟兄多要；他顺从我的典章，遵行我的律例，就不因父亲的罪孽死亡，定要存活。","bref":"以西结书 18:17"},{"no":8319,"w":"并行","py":"bìng xíng","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以西结书 18:12","top":[["以西结书",1],["雅各书",1]],"rest":[0,0],"co":[["抢夺",1],["仰望",1],["未曾",1],["当头",1]],"books":{"以西结书":1,"雅各书":1},"verse":"可见，信心是与他的行为并行，而且信心因着行为才得成全。","ref":"雅各书 2:22","def":"和合本用词；常见搭配：抢夺 1、仰望 1、未曾 1。","senses":[["①","犹言兼程","结 18:12","出现 2 次"]],"bverse":"亏负困苦和穷乏的人，抢夺人的物，未曾将当头还给人，仰望偶像，并行可憎的事，","bref":"以西结书 18:12"},{"no":8320,"w":"取人","py":"qǔ rén","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"以西结书 18:16","top":[["以西结书",1],["哈巴谷书",1]],"rest":[1,1],"co":[["当头",2],["抢夺",1],["赤身",1],["未曾",1]],"books":{"以西结书":1,"哈巴谷书":1,"加拉太书":1},"verse":"未曾亏负人，未曾取人的当头，未曾抢夺人的物件，却将食物给饥饿的人吃，将衣服给赤身的人穿，","ref":"以西结书 18:16","def":"和合本用词；常见搭配：当头 2、抢夺 1、赤身 1。","senses":[],"bverse":"这些国的民岂不都要提起诗歌并俗语讥刺他说：祸哉！迦勒底人，你增添不属自己的财物，多多取人的当头，要到几时为止呢？","bref":"哈巴谷书 2:6"},{"no":8321,"w":"义行","py":"yì xíng","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":2,"nt":1,"first":"以西结书 18:24","top":[["以西结书",2],["罗马书",1]],"rest":[0,0],"co":[["罪孽",2],["义人",2],["死亡",2],["转离",2]],"books":{"以西结书":2,"罗马书":1},"verse":"义人若转离义行而作罪孽死亡，他是因所作的罪孽死亡。","ref":"以西结书 18:26","def":"和合本用词；常见搭配：罪孽 2、义人 2、死亡 2。","senses":[["①","同\"仪形\"","结 18:24","出现 3 次"]],"bverse":"义人若转离义行而作罪孽，照着恶人所行一切可憎的事而行，他岂能存活吗？他所行的一切义都不被记念；他必因所犯的罪、所行的恶死亡。","bref":"以西结书 18:24"},{"no":8322,"w":"王作","py":"wáng zuò","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"以西结书 19:1","top":[["以西结书",3]],"rest":[0,0],"co":[["哀歌",2],["以色列",2],["当为",1],["充足",1]],"books":{"以西结书":3},"verse":"你当为以色列的王作起哀歌，","ref":"以西结书 19:1","def":"和合本用词；常见搭配：哀歌 2、以色列 2、当为 1。","senses":[],"bverse":"“人子啊，你为泰尔王作起哀歌，说主耶和华如此说：你无所不备，智慧充足，全然美丽。","bref":"以西结书 28:12"},{"no":8323,"w":"学会","py":"xué huì","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":2,"nt":1,"first":"以西结书 19:3","top":[["以西结书",2],["腓立比书",1]],"rest":[0,0],"co":[["狮子",2],["少壮",2],["抓食",2],["缺乏",1]],"books":{"以西结书":2,"腓立比书":1},"verse":"在它小狮子中养大一个，成了少壮狮子，学会抓食而吃人。","ref":"以西结书 19:3","def":"由研究某一学科或某个学术领域的人组成的学术团体。如语言学会﹑物理学会等","senses":[["①","由研究某一学科或某个","结 19:3","出现 3 次"]],"bverse":"它在众狮子中走来走去，成了少壮狮子，学会抓食而吃人。","bref":"以西结书 19:6"},{"no":8324,"w":"钩住","py":"gōu zhù","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"以西结书 19:9","top":[["以西结书",3]],"rest":[0,0],"co":[["钩子",3],["腮颊",2],["必用",2],["不再",1]],"books":{"以西结书":3},"verse":"他们用钩子钩住它，将它放在笼中，带到巴比伦王那里，将他放入坚固之所，使他的声音在以色列山上不再听见。","ref":"以西结书 19:9","def":"和合本用词；常见搭配：钩子 3、腮颊 2、必用 2。","senses":[],"bverse":"我─耶和华必用钩子钩住你的腮颊，又使江河中的鱼贴住你的鳞甲；我必将你和所有贴住你鳞甲的鱼，从江河中拉上来，","bref":"以西结书 29:4"},{"no":8325,"w":"枝干","py":"zhī gàn","pos":"名词","orig":"","freq":5,"verses":3,"vols":1,"chaps":1,"ot":5,"nt":0,"first":"以西结书 19:11","top":[["以西结书",5]],"rest":[0,0],"co":[["坚固",3],["果子",2],["生出",1],["枝子",1]],"books":{"以西结书":5},"verse":"但这葡萄树因忿怒被拔出摔在地上；东风吹干其上的果子，坚固的枝干折断枯干，被火烧毁了；","ref":"以西结书 19:12","def":"和合本用词；常见搭配：坚固 3、果子 2、生出 1。","senses":[["①","树枝和树干","结 19:11","出现 5 次"]],"bverse":"生出坚固的枝干，可作掌权者的杖。这枝干高举在茂密的枝中，而且它生长高大，枝子繁多，远远可见。","bref":"以西结书 19:11"},{"no":8326,"w":"上供","py":"shàng gòng","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"以西结书 20:31","top":[["以西结书",1],["但以理书",1]],"rest":[0,0],"co":[["永生",1],["时候",1],["经火",1],["起誓",1]],"books":{"以西结书":1,"但以理书":1},"verse":"当时，尼布甲尼撒王俯伏在地，向但以理下拜，并且吩咐人给他奉上供物和香品。","ref":"但以理书 2:46","def":"唐宋时所征赋税中解交朝廷的部分","senses":[["①","唐宋时所征赋税中解交","结 20:31","出现 2 次"]],"bverse":"你们奉上供物使你们儿子经火的时候，仍将一切偶像玷污自己，直到今日吗？以色列家啊，我岂被你们求问吗？主耶和华说：我指着我的永生起誓，我必不被你们求问。","bref":"以西结书 20:31"},{"no":8327,"w":"苦苦","py":"kǔ kǔ","pos":"形容词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"以西结书 21:6","top":[["以西结书",2],["玛拉基书",1]],"rest":[0,0],"co":[["叹息",1],["眼前",1],["人子",1],["束腰",1]],"books":{"以西结书":2,"玛拉基书":1},"verse":"人子啊，你要叹息，在他们眼前弯著腰，苦苦地叹息。","ref":"以西结书 21:6","def":"副词。表示坚决﹑执着","senses":[],"bverse":"又为你使头上光秃，用麻布束腰，号咷痛哭，苦苦悲哀。","bref":"以西结书 27:31"},{"no":8328,"w":"擦亮","py":"cā liàng","pos":"动词","orig":"","freq":5,"verses":4,"vols":1,"chaps":1,"ot":5,"nt":0,"first":"以西结书 21:9","top":[["以西结书",5]],"rest":[0,0],"co":[["磨快",3],["杀戮",3],["吩咐",2],["如此",2]],"books":{"以西结书":5},"verse":"“人子啊，你要预言。耶和华吩咐我如此说：有刀、有刀，是磨快擦亮的；","ref":"以西结书 21:9","def":"和合本用词；常见搭配：磨快 3、杀戮 3、吩咐 2。","senses":[],"bverse":"这刀已经交给人擦亮，为要应手使用。这刀已经磨快擦亮，好交在行杀戮的人手中。","bref":"以西结书 21:11"},{"no":8329,"w":"死伤","py":"sǐ shāng","pos":"动词","orig":"","freq":8,"verses":6,"vols":2,"chaps":3,"ot":5,"nt":3,"first":"以西结书 21:14","top":[["以西结书",5],["启示录",3]],"rest":[0,0],"co":[["罪孽",2],["受报",2],["日子",2],["已到",2]],"books":{"以西结书":5,"启示录":3},"verse":"你这受死伤行恶的以色列王啊，罪孽的尽头到了，受报的日子已到。","ref":"以西结书 21:25","def":"和合本用词；常见搭配：罪孽 2、受报 2、日子 2。","senses":[["①","死亡和创伤","结 21:14","出现 8 次"]],"bverse":"我看见兽的七头中，有一个似乎受了死伤，那死伤却医好了。全地的人都希奇跟从那兽，","bref":"启示录 13:3"},{"no":8330,"w":"内屋","py":"nèi wū","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":1,"first":"以西结书 21:14","top":[["以西结书",1],["马太福音",1]],"rest":[0,0],"co":[["大人",1],["死伤",1],["三次",1],["拍掌",1]],"books":{"以西结书":1,"马太福音":1},"verse":"你祷告的时候，要进你的内屋，关上门，祷告你在暗中的父；你父在暗中察看，必然报答你。","ref":"马太福音 6:6","def":"里屋;大宅深处的屋子","senses":[["①","里屋;大宅深处的屋子","结 21:14","出现 2 次"]],"bverse":"“人子啊，你要拍掌预言。我─耶和华要使这刀，就是致死伤的刀，一连三次加倍刺人，进入他们的内屋，使大人受死伤的就是这刀。","bref":"以西结书 21:14"},{"no":8331,"w":"路口","py":"lù kǒu","pos":"处所词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"以西结书 21:19","top":[["以西结书",2]],"rest":[0,0],"co":[["巴比伦",2],["好使",1],["通城",1],["一只",1]],"books":{"以西结书":2},"verse":"因为巴比伦王站在岔路那里，在两条路口上要占卜。他摇签（原文是箭）求问神像，察看牺牲的肝；","ref":"以西结书 21:21","def":"路的一端。亦指道路会合的地方","senses":[["①","路的一端","结 21:19","出现 2 次"]],"bverse":"“人子啊，你要定出两条路，好使巴比伦王的刀来。这两条路必从一地分出来，又要在通城的路口上画出一只手来。","bref":"以西结书 21:19"},{"no":8333,"w":"岔路","py":"chà lù","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"以西结书 21:21","top":[["以西结书",1],["俄巴底亚书",1]],"rest":[1,1],"co":[["牺牲",1],["王站",1],["两条",1],["那里",1]],"books":{"以西