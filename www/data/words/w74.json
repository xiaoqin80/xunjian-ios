[{"no":7301,"w":"拉网","py":"lā wǎng","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"诗篇 10:9","top":[["诗篇",1],["哈巴谷书",1]],"rest":[0,0],"co":[["困苦",1],["埋伏",1],["狮子",1],["聚集",1]],"books":{"诗篇":1,"哈巴谷书":1},"verse":"他用钩钩住，用网捕获，用拉网聚集他们；因此，他欢喜快乐，","ref":"哈巴谷书 1:15","def":"比喻四面包围，逐步收缩的战术","senses":[["①","比喻四面包围","诗 10:9","出现 2 次"]],"bverse":"他埋伏在暗地，如狮子蹲在洞中。他埋伏，要掳去困苦人；他拉网，就把困苦人掳去。","bref":"诗篇 10:9"},{"no":7302,"w":"爪牙","py":"zhǎo yá","pos":"名词","orig":"","freq":2,"verses":1,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"诗篇 10:10","top":[["诗篇",2]],"rest":[0,0],"co":[["无倚无靠",1],["屈身",1],["蹲伏",1],["强暴",1]],"books":{"诗篇":2},"verse":"他屈身蹲伏，无倚无靠的人就倒在他爪牙（爪牙：或译强暴人）之下。","ref":"诗篇 10:10","def":"比喻为坏人效力的人他是个甘愿作侵略者爪牙的民族败类","senses":[["①","比喻为坏人效力的人他","诗 10:10","出现 2 次"]],"bverse":"","bref":""},{"no":7303,"w":"打断","py":"dǎ duàn","pos":"动词","orig":"","freq":6,"verses":6,"vols":3,"chaps":3,"ot":3,"nt":3,"first":"诗篇 10:15","top":[["约翰福音",3],["以西结书",2]],"rest":[1,1],"co":[["膀臂",3],["手中",2],["有力",2],["耶稣",2]],"books":{"约翰福音":3,"以西结书":2,"诗篇":1},"verse":"只是来到耶稣那里，见他已经死了，就不打断他的腿。","ref":"约翰福音 19:33","def":"使物体折裂;使活动停止","senses":[["①","使物体折裂;使活动停","诗 10:15","出现 6 次"]],"bverse":"于是兵丁来，把头一个人的腿，并与耶稣同钉第二个人的腿，都打断了。","bref":"约翰福音 19:32"},{"no":7304,"w":"热风","py":"rè fēng","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 11:6","top":[["诗篇",1],["耶利米书",1]],"rest":[1,1],"co":[["网罗",1],["恶人",1],["硫磺",1],["烈火",1]],"books":{"诗篇":1,"耶利米书":1,"雅各书":1},"verse":"他要向恶人密布网罗；有烈火、硫磺、热风，作他们杯中的分。","ref":"诗篇 11:6","def":"杂文集。鲁迅作。1925年出版。收入随感录、杂文四十一篇。《题记》中称，因周围的空气太寒冽了”，故题名《","senses":[],"bverse":"那时，必有话对这百姓和耶路撒冷说：“有一阵热风从旷野净光的高处向我的众民（原文是民女）刮来，不是为簸扬，也不是为扬净。","bref":"耶利米书 4:11"},{"no":7305,"w":"杯中","py":"bēi zhōng","pos":"处所词","orig":"","freq":5,"verses":5,"vols":3,"chaps":5,"ot":3,"nt":2,"first":"诗篇 11:6","top":[["诗篇",2],["启示录",2]],"rest":[1,1],"co":[["硫磺",2],["网罗",1],["恶人",1],["热风",1]],"books":{"诗篇":2,"启示录":2,"箴言":1},"verse":"耶和华是我的产业，是我杯中的分；我所得的，你为我持守。","ref":"诗篇 16:5","def":"和合本用词；常见搭配：硫磺 2、网罗 1、恶人 1。","senses":[],"bverse":"他要向恶人密布网罗；有烈火、硫磺、热风，作他们杯中的分。","bref":"诗篇 11:6"},{"no":7306,"w":"能作","py":"néng zuò","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":1,"nt":2,"first":"诗篇 12:4","top":[["哥林多前书",2],["诗篇",1]],"rest":[0,0],"co":[["舌头",1],["必能",1],["嘴唇",1],["意见",1]],"books":{"哥林多前书":2,"诗篇":1},"verse":"他们曾说：我们必能以舌头得胜；我们的嘴唇是我们自己的，谁能作我们的主呢？","ref":"诗篇 12:4","def":"和合本用词；常见搭配：舌头 1、必能 1、嘴唇 1。","senses":[],"bverse":"论到童身的人，我没有主的命令，但我既蒙主怜恤能作忠心的人，就把自己的意见告诉你们。","bref":"哥林多前书 7:25"},{"no":7307,"w":"冤屈","py":"yuān qū","pos":"动词","orig":"","freq":7,"verses":6,"vols":5,"chaps":6,"ot":5,"nt":2,"first":"诗篇 12:5","top":[["诗篇",3],["以赛亚书",1]],"rest":[3,3],"co":[["耶和华",4],["以色列",2],["安置",1],["叹息",1]],"books":{"诗篇":3,"以赛亚书":1,"以西结书":1,"使徒行传":1,"彼得前书":1},"verse":"倘若人为叫良心对得住神，就忍受冤屈的苦楚，这是可喜爱的。","ref":"彼得前书 2:19","def":"和合本用词；常见搭配：耶和华 4、以色列 2、安置 1。","senses":[["①","郁悒;委曲","诗 12:5","出现 7 次"]],"bverse":"到了那里，见他们一个人受冤屈，就护庇他，为那受欺压的人报仇，打死了那埃及人。","bref":"使徒行传 7:24"},{"no":7308,"w":"纯净","py":"chún jìng","pos":"形容词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":4,"nt":1,"first":"诗篇 12:6","top":[["诗篇",1],["箴言",1]],"rest":[3,3],"co":[["耶和华",2],["七次",1],["银子",1],["如同",1]],"books":{"诗篇":1,"箴言":1,"耶利米哀歌":1,"但以理书":1,"彼得前书":1},"verse":"耶和华的言语是纯净的言语，如同银子在泥炉中炼过七次。","ref":"诗篇 12:6","def":"和合本用词；常见搭配：耶和华 2、七次 1、银子 1。","senses":[],"bverse":"恶谋为耶和华所憎恶；良言乃为纯净。","bref":"箴言 15:26"},{"no":7309,"w":"升高","py":"shēng gāo","pos":"动词","orig":"","freq":7,"verses":7,"vols":4,"chaps":7,"ot":3,"nt":4,"first":"诗篇 12:8","top":[["诗篇",3],["雅各书",2]],"rest":[2,2],"co":[["自卑",2],["世人",1],["下流",1],["恶人",1]],"books":{"诗篇":3,"雅各书":2,"路加福音":1,"彼得前书":1},"verse":"下流人在世人中升高，就有恶人到处游行。","ref":"诗篇 12:8","def":"和合本用词；常见搭配：自卑 2、世人 1、下流 1。","senses":[],"bverse":"惟有神断定；他使这人降卑，使那人升高。","bref":"诗篇 75:7"},{"no":7310,"w":"筹算","py":"chóu suàn","pos":"动词","orig":"","freq":9,"verses":9,"vols":3,"chaps":7,"ot":9,"nt":0,"first":"诗篇 13:2","top":[["诗篇",4],["箴言",3]],"rest":[1,2],"co":[["耶和华",4],["立定",4],["成就",3],["思念",2]],"books":{"诗篇":4,"箴言":3,"以赛亚书":2},"verse":"将你心所愿的赐给你，成就你的一切筹算。","ref":"诗篇 20:4","def":"中国古代用竹、木、骨等制成小棍状的算筹记数，并以此进行的第一筹第二筹第九筹空筹筹算加、减、乘、除、开方等","senses":[["①","中国古代用竹、木、骨","诗 13:2","出现 9 次"]],"bverse":"耶和华的筹算永远立定；他心中的思念万代常存。","bref":"诗篇 33:11"},{"no":7311,"w":"厚恩","py":"hòu ēn","pos":"名词","orig":"","freq":6,"verses":6,"vols":2,"chaps":5,"ot":5,"nt":1,"first":"诗篇 13:6","top":[["诗篇",5],["哥林多后书",1]],"rest":[0,0],"co":[["耶和华",3],["我要",1],["他用",1],["歌唱",1]],"books":{"诗篇":5,"哥林多后书":1},"verse":"我要向耶和华歌唱，因他用厚恩待我。","ref":"诗篇 13:6","def":"和合本用词；常见搭配：耶和华 3、我要 1、他用 1。","senses":[],"bverse":"我拿什么报答耶和华向我所赐的一切厚恩？","bref":"诗篇 116:12"},{"no":7312,"w":"圣山","py":"shèng shān","pos":"名词","orig":"","freq":20,"verses":20,"vols":10,"chaps":18,"ot":19,"nt":1,"first":"诗篇 15:1","top":[["以赛亚书",6],["诗篇",3]],"rest":[8,11],"co":[["耶和华",11],["耶路撒冷",4],["好像",3],["其中",3]],"books":{"以赛亚书":6,"诗篇":3,"但以理书":3,"约珥书":2,"耶利米书":1,"以西结书":1,"俄巴底亚书":1,"西番雅书":1,"撒迦利亚书":1,"彼得后书":1},"verse":"神的车辇累万盈千；主在其中，好像在西奈圣山一样。","ref":"诗篇 68:17","def":"神的圣山；多指锡安山。","senses":[],"bverse":"我们同他在圣山的时候，亲自听见这声音从天上出来。","bref":"彼得后书 1:18"},{"no":7313,"w":"谗谤","py":"chán bàng","pos":"动词","orig":"","freq":9,"verses":9,"vols":3,"chaps":9,"ot":9,"nt":0,"first":"诗篇 15:3","top":[["诗篇",3],["箴言",3]],"rest":[1,3],"co":[["朋友",2],["舌头",2],["许多",2],["四围",2]],"books":{"诗篇":3,"箴言":3,"耶利米书":3},"verse":"他不以舌头谗谤人，不恶待朋友，也不随伙毁谤邻里。","ref":"诗篇 15:3","def":"和合本用词；常见搭配：朋友 2、舌头 2、许多 2。","senses":[["①","谗毁诽谤","诗 15:3","出现 9 次"]],"bverse":"在暗中谗谤他邻居的，我必将他灭绝；眼目高傲、心里骄纵的，我必不容他。","bref":"诗篇 101:5"},{"no":7314,"w":"金诗","py":"jīn shī","pos":"名词","orig":"","freq":6,"verses":6,"vols":1,"chaps":6,"ot":6,"nt":0,"first":"诗篇 16:1","top":[["诗篇",6]],"rest":[0,0],"co":[["大卫",6],["伶长",5],["交与",5],["调用",5]],"books":{"诗篇":6},"verse":"（大卫的金诗。）神啊，求你保佑我，因为我投靠你。","ref":"诗篇 16:1","def":"和合本用词；常见搭配：大卫 6、伶长 5、交与 5。","senses":[],"bverse":"（非利士人在迦特拿住大卫。那时，他作这金诗，交与伶长。调用远方无声鸽。）神啊，求你怜悯我，因为人要把我吞了，终日攻击欺压我。","bref":"诗篇 56:1"},{"no":7315,"w":"听闻","py":"tīng wén","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"诗篇 17:1","top":[["以赛亚书",2],["诗篇",1]],"rest":[1,1],"co":[["嘴唇",1],["留心",1],["呼吁",1],["公义",1]],"books":{"以赛亚书":2,"诗篇":1,"以西结书":1},"verse":"那能看的人，眼不再昏迷；能听的人，耳必得听闻。","ref":"以赛亚书 32:3","def":"和合本用词；常见搭配：嘴唇 1、留心 1、呼吁 1。","senses":[],"bverse":"你们禁食，却互相争竞，以凶恶的拳头打人。你们今日禁食，不得使你们的声音听闻于上。","bref":"以赛亚书 58:4"},{"no":7316,"w":"公正","py":"gōng zhèng","pos":"名词","orig":"","freq":6,"verses":6,"vols":2,"chaps":6,"ot":6,"nt":0,"first":"诗篇 17:2","top":[["诗篇",5],["但以理书",1]],"rest":[0,0],"co":[["审判",3],["万民",2],["世界",2],["公义",2]],"books":{"诗篇":5,"但以理书":1},"verse":"愿我的判语从你面前发出；愿你的眼睛观看公正。","ref":"诗篇 17:2","def":"公平正直，没有偏私为人","senses":[["①","公平正直","诗 17:2","出现 6 次"]],"bverse":"王有能力，喜爱公平，坚立公正，在雅各中施行公平和公义。","bref":"诗篇 99:4"},{"no":7317,"w":"熬炼","py":"áo liàn","pos":"动词","orig":"","freq":13,"verses":10,"vols":7,"chaps":10,"ot":13,"nt":0,"first":"诗篇 17:3","top":[["诗篇",4],["以赛亚书",2]],"rest":[5,7],"co":[["耶和华",4],["银子",4],["试验",3],["我要",2]],"books":{"诗篇":4,"以赛亚书":2,"但以理书":2,"撒迦利亚书":2,"箴言":1,"耶利米书":1,"玛拉基书":1},"verse":"神啊，你曾试验我们，熬炼我们，如熬炼银子一样。","ref":"诗篇 66:10","def":"熬炼、锻炼；也指熬炼银子。","senses":[],"bverse":"耶和华啊，求你察看我，试验我，熬炼我的肺腑心肠。","bref":"诗篇 26:2"},{"no":7318,"w":"立志","py":"lì zhì","pos":"名词","orig":"","freq":7,"verses":7,"vols":7,"chaps":7,"ot":2,"nt":5,"first":"诗篇 17:3","top":[["诗篇",1],["但以理书",1]],"rest":[5,5],"co":[["熬炼",1],["夜间",1],["鉴察",1],["口中",1]],"books":{"诗篇":1,"但以理书":1,"约翰福音":1,"罗马书":1,"腓立比书":1,"帖撒罗尼迦（前书）":1,"提摩太（后书）":1},"verse":"不但如此，凡立志在基督耶稣里敬虔度日的也都要受逼迫。","ref":"提摩太后书 3:12","def":"和合本用词；常见搭配：熬炼 1、夜间 1、鉴察 1。","senses":[["①","立定志愿～做一名教师","诗 17:3","出现 7 次"]],"bverse":"因为你们立志行事都是神在你们心里运行，为要成就他的美意。","bref":"腓立比书 2:13"},{"no":7319,"w":"我命","py":"wǒ mìng","pos":"代词","orig":"","freq":12,"verses":12,"vols":3,"chaps":11,"ot":12,"nt":0,"first":"诗篇 17:9","top":[["诗篇",10],["耶利米哀歌",1]],"rest":[1,1],"co":[["寻索",4],["脱离",3],["要害",3],["蒙羞",3]],"books":{"诗篇":10,"耶利米哀歌":1,"哈该书":1},"verse":"神是帮助我的，是扶持我命的。","ref":"诗篇 54:4","def":"和合本用词；常见搭配：寻索 4、脱离 3、要害 3。","senses":[],"bverse":"但那些寻索要灭我命的人必往地底下去；","bref":"诗篇 63:9"},{"no":7321,"w":"暗处","py":"àn chù","pos":"副词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 17:12","top":[["诗篇",1],["约翰福音",1]],"rest":[1,1],"co":[["蹲伏",1],["狮子",1],["少壮",1],["抓食",1]],"books":{"诗篇":1,"约翰福音":1,"彼得后书":1},"verse":"他像狮子急要抓食，又像少壮狮子蹲伏在暗处。","ref":"诗篇 17:12","def":"不为人们所注意的地方;隐蔽的地方","senses":[["①","不为人们所注意的地方","诗 17:12","出现 3 次"]],"bverse":"人要显扬名声，没有在暗处行事的；你如果行这些事，就当将自己显明给世人看。”","bref":"约翰福音 7:4"},{"no":7322,"w":"打倒","py":"dǎ dǎo","pos":"动词","orig":"","freq":7,"verses":7,"vols":3,"chaps":7,"ot":6,"nt":1,"first":"诗篇 17:13","top":[["诗篇",5],["以赛亚书",1]],"rest":[1,1],"co":[["恶人",2],["逼迫",2],["我命",1],["救护",1]],"books":{"诗篇":5,"以赛亚书":1,"哥林多后书":1},"verse":"说恶言的人在地上必坚立不住；祸患必猎取强暴的人，将他打倒。","ref":"诗篇 140:11","def":"和合本用词；常见搭配：恶人 2、逼迫 2、我命 1。","senses":[["①","打击使翻倒","诗 17:13","出现 7 次"]],"bverse":"恶人已经弓上弦，刀出鞘，要打倒困苦穷乏的人，要杀害行动正直的人。","bref":"诗篇 37:14"},{"no":7323,"w":"今生","py":"jīn shēng","pos":"时间词","orig":"","freq":8,"verses":8,"vols":5,"chaps":7,"ot":1,"nt":7,"first":"诗篇 17:14","top":[["哥林多前书",3],["路加福音",2]],"rest":[3,3],"co":[["思虑",2],["审判",2],["福分",1],["充满",1]],"books":{"哥林多前书":3,"路加福音":2,"诗篇":1,"提摩太（前书）":1,"约翰（一书）":1},"verse":"岂不知我们要审判天使吗？何况今生的事呢？","ref":"哥林多前书 6:3","def":"和合本用词；常见搭配：思虑 2、审判 2、福分 1。","senses":[],"bverse":"我们若靠基督只在今生有指望，就算比众人更可怜。","bref":"哥林多前书 15:19"},{"no":7324,"w":"心满意足","py":"xīn mǎn yì zú","pos":"","orig":"","freq":5,"verses":5,"vols":3,"chaps":4,"ot":5,"nt":0,"first":"诗篇 17:14","top":[["诗篇",2],["以赛亚书",2]],"rest":[1,1],"co":[["耶和华",3],["福分",1],["充满",1],["世人",1]],"books":{"诗篇":2,"以赛亚书":2,"耶利米书":1},"verse":"迦勒底必成为掠物；凡掳掠她的都必心满意足。这是耶和华说的。”","ref":"耶利米书 50:10","def":"称心如意，十分满足","senses":[["①","称心如意","诗 17:14","出现 5 次"]],"bverse":"至于我，我必在义中见你的面；我醒了的时候，得见（或译：著）你的形像就心满意足了。","bref":"诗篇 17:15"},{"no":7325,"w":"扶持","py":"fú chí","pos":"动词","orig":"","freq":22,"verses":21,"vols":3,"chaps":19,"ot":22,"nt":0,"first":"诗篇 18:35","top":[["诗篇"