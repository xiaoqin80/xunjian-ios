t":3,"nt":0,"first":"诗篇 31:9","top":[["以西结书",2],["诗篇",1]],"rest":[0,0],"co":[["耶和华",2],["圣地",2],["割礼",2],["外邦人",2]],"books":{"以西结书":2,"诗篇":1},"verse":"“主耶和华如此说：以色列中的外邦人，就是身心未受割礼的，都不可入我的圣地。”","ref":"以西结书 44:9","def":"和合本用词；常见搭配：耶和华 2、圣地 2、割礼 2。","senses":[["①","身体和精神","诗 31:9","出现 3 次"]],"bverse":"耶和华啊，求你怜恤我，因为我在急难之中；我的眼睛因忧愁而干瘪，连我的身心也不安舒。","bref":"诗篇 31:9"},{"no":7356,"w":"图谋","py":"tú móu","pos":"动词","orig":"","freq":22,"verses":20,"vols":10,"chaps":18,"ot":22,"nt":0,"first":"诗篇 31:13","top":[["诗篇",6],["箴言",5]],"rest":[8,11],"co":[["耶和华",6],["奸恶",5],["恶计",4],["罪孽",3]],"books":{"诗篇":6,"箴言":5,"以赛亚书":2,"耶利米书":2,"以西结书":2,"何西阿书":1,"阿摩司书":1,"弥迦书":1,"那鸿书":1,"哈巴谷书":1},"verse":"他们心中图谋奸恶，常常聚集要争战。","ref":"诗篇 140:2","def":"谋划坏事；常写「图谋恶事」。","senses":[],"bverse":"他们图谋奸恶，说：我们是极力图谋的。他们各人的意念心思是深的。","bref":"诗篇 64:6"},{"no":7357,"w":"撒谎","py":"sā huǎng","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 31:18","top":[["诗篇",2],["箴言",1]],"rest":[0,0],"co":[["攻击",2],["骄傲",1],["义人",1],["无言",1]],"books":{"诗篇":2,"箴言":1},"verse":"那撒谎的人逞骄傲轻慢，出狂妄的话攻击义人；愿他的嘴哑而无言。","ref":"诗篇 31:18","def":"说谎你老实说，不要撒谎","senses":[["①","说谎你老实说","诗 31:18","出现 3 次"]],"bverse":"因为恶人的嘴和诡诈人的口已经张开攻击我；他们用撒谎的舌头对我说话。","bref":"诗篇 109:2"},{"no":7358,"w":"急促","py":"jí cù","pos":"形容词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"诗篇 31:22","top":[["诗篇",2],["提摩太（前书）",1]],"rest":[0,0],"co":[["隔绝",1],["时候",1],["呼求",1],["眼前",1]],"books":{"诗篇":2,"提摩太（前书）":1},"verse":"我曾急促地说：人都是说谎的！","ref":"诗篇 116:11","def":"快而短促呼吸","senses":[["①","快而短促呼吸～ㄧ～的","诗 31:22","出现 3 次"]],"bverse":"给人行按手的礼，不可急促；不要在别人的罪上有分，要保守自己清洁。","bref":"提摩太前书 5:22"},{"no":7359,"w":"足足","py":"zú zú","pos":"动词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":2,"nt":3,"first":"诗篇 31:23","top":[["诗篇",1],["耶利米书",1]],"rest":[3,3],"co":[["圣民",1],["诚实",1],["骄傲",1],["报应",1]],"books":{"诗篇":1,"耶利米书":1,"使徒行传":1,"以弗所书":1,"歌罗西书":1},"verse":"耶和华的圣民哪，你们都要爱他！耶和华保护诚实人，足足报应行事骄傲的人。","ref":"诗篇 31:23","def":"相传为雌凤鸣声","senses":[["①","相传为雌凤鸣声","诗 31:23","出现 5 次"]],"bverse":"这恩典是神用诸般智慧聪明，充充足足赏给我们的；","bref":"以弗所书 1:8"},{"no":7360,"w":"耗尽","py":"hào jìn","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":3,"nt":1,"first":"诗篇 32:4","top":[["诗篇",2],["以赛亚书",1]],"rest":[1,1],"co":[["心神",2],["白日",1],["黑夜",1],["夏天",1]],"books":{"诗篇":2,"以赛亚书":1,"路加福音":1},"verse":"黑夜白日，你的手在我身上沉重；我的精液耗尽，如同夏天的干旱。（细拉）","ref":"诗篇 32:4","def":"和合本用词；常见搭配：心神 2、白日 1、黑夜 1。","senses":[["①","消减净尽","诗 32:4","出现 4 次"]],"bverse":"耶和华啊，求你速速应允我！我心神耗尽！不要向我掩面，免得我像那些下坑的人一样。","bref":"诗篇 143:7"},{"no":7361,"w":"勒住","py":"lēi zhù","pos":"动词","orig":"","freq":4,"verses":4,"vols":2,"chaps":4,"ot":2,"nt":2,"first":"诗篇 32:9","top":[["诗篇",2],["雅各书",2]],"rest":[0,0],"co":[["舌头",2],["有人",2],["骡马",1],["不然",1]],"books":{"诗篇":2,"雅各书":2},"verse":"你不可像那无知的骡马，必用嚼环辔头勒住它；不然，就不能驯服。","ref":"诗篇 32:9","def":"和合本用词；常见搭配：舌头 2、有人 2、骡马 1。","senses":[],"bverse":"若有人自以为虔诚，却不勒住他的舌头，反欺哄自己的心，这人的虔诚是虚的。","bref":"雅各书 1:26"},{"no":7362,"w":"新歌","py":"xīn gē","pos":"形容词","orig":"","freq":9,"verses":9,"vols":3,"chaps":9,"ot":7,"nt":2,"first":"诗篇 33:3","top":[["诗篇",6],["启示录",2]],"rest":[1,1],"co":[["耶和华",5],["赞美",3],["巧妙",1],["应当",1]],"books":{"诗篇":6,"启示录":2,"以赛亚书":1},"verse":"应当向他唱新歌，弹得巧妙，声音洪亮。","ref":"诗篇 33:3","def":"和合本用词；常见搭配：耶和华 5、赞美 3、巧妙 1。","senses":[],"bverse":"神啊，我要向你唱新歌，用十弦瑟向你歌颂。","bref":"诗篇 144:9"},{"no":7363,"w":"巧妙","py":"qiǎo miào","pos":"形容词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 33:3","top":[["诗篇",2]],"rest":[0,0],"co":[["应当",1],["新歌",1],["手中",1],["牧养",1]],"books":{"诗篇":2},"verse":"应当向他唱新歌，弹得巧妙，声音洪亮。","ref":"诗篇 33:3","def":"精巧美妙;灵巧高妙","senses":[["①","精巧美妙;灵巧高妙","诗 33:3","出现 2 次"]],"bverse":"于是，他按心中的纯正牧养他们，用手中的巧妙引导他们。","bref":"诗篇 78:72"},{"no":7364,"w":"仁义","py":"rén yì","pos":"名词","orig":"","freq":14,"verses":14,"vols":7,"chaps":13,"ot":6,"nt":8,"first":"诗篇 33:5","top":[["哥林多后书",4],["箴言",3]],"rest":[5,7],"co":[["公平",5],["永远",3],["慈爱",2],["耶和华",2]],"books":{"哥林多后书":4,"箴言":3,"诗篇":2,"希伯来书":2,"何西阿书":1,"以弗所书":1,"