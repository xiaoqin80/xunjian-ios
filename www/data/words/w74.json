:"诗篇 34:11","top":[["诗篇",2],["耶利米书",1]],"rest":[1,1],"co":[["耶和华",3],["我要",1],["教训",1],["敬畏",1]],"books":{"诗篇":2,"耶利米书":1,"启示录":1},"verse":"你们当乐意事奉耶和华，当来向他歌唱！","ref":"诗篇 100:2","def":"和合本用词；常见搭配：耶和华 3、我要 1、教训 1。","senses":[],"bverse":"众弟子啊，你们当来听我的话！我要将敬畏耶和华的道教训你们。","bref":"诗篇 34:11"},{"no":7370,"w":"喜好","py":"xǐ hào","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":1,"nt":2,"first":"诗篇 34:12","top":[["诗篇",1],["以弗所书",1]],"rest":[1,1],"co":[["何人",1],["存活",1],["爱慕",1],["长寿",1]],"books":{"诗篇":1,"以弗所书":1,"启示录":1},"verse":"有何人喜好存活，爱慕长寿，得享美福，","ref":"诗篇 34:12","def":"和合本用词；常见搭配：何人 1、存活 1、爱慕 1。","senses":[["①","喜欢;爱好","诗 34:12","出现 3 次"]],"bverse":"我们从前也都在他们中间，放纵肉体的私欲，随着肉体和心中所喜好的去行，本为可怒之子，和别人一样。","bref":"以弗所书 2:3"},{"no":7371,"w":"灵性","py":"líng xìng","pos":"名词","orig":"","freq":13,"verses":12,"vols":9,"chaps":12,"ot":6,"nt":7,"first":"诗篇 34:18","top":[["以赛亚书",2],["但以理书",2]],"rest":[7,9],"co":[["耶和华",3],["但以理",2],["美好",2],["复活",2]],"books":{"以赛亚书":2,"但以理书":2,"哥林多前书":2,"彼得前书":2,"诗篇":1,"以西结书":1,"提摩太（前书）":1,"彼得后书":1,"犹大书":1},"verse":"我必不永远相争，也不长久发怒，恐怕我所造的人与灵性都必发昏。","ref":"以赛亚书 57:16","def":"精神；灵魂灵性不泯","senses":[],"bverse":"所种的是血气的身体，复活的是灵性的身体。若有血气的身体，也必有灵性的身体。","bref":"哥林多前书 15:44"},{"no":7372,"w":"痛悔","py":"tòng huǐ","pos":"动词","orig":"","freq":5,"verses":4,"vols":2,"chaps":4,"ot":5,"nt":0,"first":"诗篇 34:18","top":[["以赛亚书",3],["诗篇",2]],"rest":[0,0],"co":[["耶和华",2],["原文",2],["靠近",1],["拯救",1]],"books":{"以赛亚书":3,"诗篇":2},"verse":"耶和华靠近伤心的人，拯救灵性痛悔的人。","ref":"诗篇 34:18","def":"和合本用词；常见搭配：耶和华 2、原文 2、靠近 1。","senses":[["①","深切地悔恨","诗 34:18","出现 5 次"]],"bverse":"神所要的祭就是忧伤的灵；神啊，忧伤痛悔的心，你必不轻看。","bref":"诗篇 51:17"},{"no":7373,"w":"恶必","py":"è bì","pos":"","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"诗篇 34:21","top":[["诗篇",1],["箴言",1]],"rest":[1,1],"co":[["义人",1],["恨恶",1],["害死",1],["恶人",1]],"books":{"诗篇":1,"箴言":1,"耶利米书":1},"verse":"恶必害死恶人；恨恶义人的，必被定罪。","ref":"诗篇 34:21","def":"和合本用词；常见搭配：义人 1、恨恶 1、害死 1。","senses":[],"bverse":"恳切求善的，就求得恩惠；惟独求恶的，恶必临到他身。","bref":"箴言 11:27"},{"no":7374,"w":"挡住","py":"dǎng zhù","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":3,"nt":1,"first":"诗篇 35:3","top":[["诗篇",1],["耶利米哀歌",1]],"rest":[2,2],"co":[["石头",2],["拯救",1],["抽出",1],["灵魂",1]],"books":{"诗篇":1,"耶利米哀歌":1,"何西阿书":1,"马可福音":1},"verse":"抽出枪来，挡住那追赶我的；求你对我的灵魂说：我是拯救你的。","ref":"诗篇 35:3","def":"和合本用词；常见搭配：石头 2、拯救 1、抽出 1。","senses":[],"bverse":"他用凿过的石头挡住我的道；他使我的路弯曲。","bref":"耶利米哀歌 3:9"},{"no":7375,"w":"受辱","py":"shòu rǔ","pos":"动词","orig":"","freq":11,"verses":11,"vols":5,"chaps":10,"ot":9,"nt":2,"first":"诗篇 35:4","top":[["诗篇",7],["箴言",1]],"rest":[3,3],"co":[["蒙羞",7],["我命",3],["谋害",3],["羞愧",3]],"books":{"诗篇":7,"箴言":1,"以赛亚书":1,"使徒行传":1,"帖撒罗尼迦（前书）":1},"verse":"愿那寻索我命的，蒙羞受辱！愿那谋害我的，退后羞愧！","ref":"诗篇 35:4","def":"和合本用词；常见搭配：蒙羞 7、我命 3、谋害 3。","senses":[["①","遭受侮辱","诗 35:4","出现 11 次"]],"bverse":"但如今你丢弃了我们，使我们受辱，不和我们的军兵同去。","bref":"诗篇 44:9"},{"no":7376,"w":"挖坑","py":"wā kēng","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"诗篇 35:7","top":[["耶利米书",2],["诗篇",1]],"rest":[0,0],"co":[["网罗",2],["要害",2],["暗设",2],["性命",2]],"books":{"耶利米书":2,"诗篇":1},"verse":"因他们无故地为我暗设网罗，无故地挖坑，要害我的性命。","ref":"诗篇 35:7","def":"和合本用词；常见搭配：网罗 2、要害 2、暗设 2。","senses":[],"bverse":"岂可以恶报善呢？他们竟挖坑要害我的性命！求你记念我怎样站在你面前为他们代求，要使你的忿怒向他们转消。","bref":"耶利米书 18:20"},{"no":7377,"w":"盘问","py":"pán wèn","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"诗篇 35:11","top":[["诗篇",1],["马可福音",1]],"rest":[2,2],"co":[["耶稣",2],["知道",1],["起来",1],["见证",1]],"books":{"诗篇":1,"马可福音":1,"约翰福音":1,"哥林多前书":1},"verse":"凶恶的见证人起来，盘问我所不知道的事。","ref":"诗篇 35:11","def":"详细查问;反复询问","senses":[["①","详细查问;反复询问","诗 35:11","出现 4 次"]],"bverse":"我对那盘问我的人就是这样分诉：","bref":"哥林多前书 9:3"},{"no":7378,"w":"孤苦","py":"gū kǔ","pos":"形容词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"诗篇 35:12","top":[["诗篇",2],["耶利米哀歌",1]],"rest":[0,0],"co":[["灵魂",1],["恶报",1],["不要",1],["仰望",1]],"books":{"诗篇":2,"耶利米哀歌":1},"verse":"他们向我以恶报善，使我的灵魂孤苦。","ref":"诗篇 35:12","def":"孤单无靠，生活困苦","senses":[["①","孤单无靠","诗 35:12","出现 3 次"]],"bverse":"主─耶和华啊，我的眼目仰望你；我投靠你，求你不要将我撇得孤苦！","bref":"诗篇 141:8"},{"no":7379,"w":"咬牙","py":"yǎo yá","pos":"动词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"诗篇 35:16","top":[["诗篇",3]],"rest":[0,0],"co":[["恶人",2],["人向",1],["如同",1],["席上",1]],"books":{"诗篇":3},"verse":"恶人设谋害义人，又向他咬牙。","ref":"诗篇 37:12","def":"紧咬牙根。形容愤怒至极或下定决心","senses":[["①","紧咬牙根","诗 35:16","出现 3 次"]],"bverse":"他们如同席上好嬉笑的狂妄人向我咬牙。","bref":"诗篇 35:16"},{"no":7380,"w":"阿哈","py":"ā hā","pos":"名词","orig":"","freq":10,"verses":7,"vols":2,"chaps":6,"ot":10,"nt":0,"first":"诗篇 35:21","top":[["诗篇",7],["以西结书",3]],"rest":[0,0],"co":[["羞愧",2],["如此",2],["耶和华",2],["攻击",1]],"books":{"诗篇":7,"以西结书":3},"verse":"愿那些对我说阿哈、阿哈的，因羞愧退后。","ref":"诗篇 70:3","def":"和合本用词；常见搭配：羞愧 2、如此 2、耶和华 2。","senses":[],"bverse":"愿那些对我说阿哈、阿哈的，因羞愧而败亡！","bref":"诗篇 40:15"},{"no":7381,"w":"当尊","py":"dāng zūn","pos":"介词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"诗篇 35:27","top":[["诗篇",3]],"rest":[0,0],"co":[["常说",3],["耶和华",2],["救恩",2],["高兴",2]],"books":{"诗篇":3},"verse":"愿一切寻求你的，因你高兴欢喜；愿那些喜爱你救恩的，常说：当尊神为大！","ref":"诗篇 70:4","def":"和合本用词；常见搭配：常说 3、耶和华 2、救恩 2。","senses":[],"bverse":"愿一切寻求你的，因你高兴欢喜！愿那些喜爱你救恩的，常说：当尊耶和华为大！","bref":"诗篇 40:16"},{"no":7382,"w":"源头","py":"yuán tóu","pos":"名词","orig":"","freq":5,"verses":5,"vols":4,"chaps":5,"ot":4,"nt":1,"first":"诗篇 36:9","top":[["诗篇",2],["以赛亚书",1]],"rest":[2,2],"co":[["耶和华",2],["那里",1],["必得",1],["见光",1]],"books":{"诗篇":2,"以赛亚书":1,"何西阿书":1,"马可福音":1},"verse":"从以色列源头而来的，当在各会中称颂主神！","ref":"诗篇 68:26","def":"和合本用词；常见搭配：耶和华 2、那里 1、必得 1。","senses":[["①","水发源处","诗 36:9","出现 5 次"]],"bverse":"因为，在你那里有生命的源头；在你的光中，我们必得见光。","bref":"诗篇 36:9"},{"no":7383,"w":"见光","py":"jiàn guāng","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"诗篇 36:9","top":[["诗篇",2]],"rest":[0,0],"co":[["那里",2],["必得",1],["生命",1],["源头",1]],"books":{"诗篇":2},"verse":"他仍必归到他历代的祖宗那里，永不见光。","ref":"诗篇 49:19","def":"磨拭器物使之光润","senses":[["①","磨拭器物使之光润","诗 36:9","出现 2 次"]],"bverse":"因为，在你那里有生命的源头；在你的光中，我们必得见光。","bref":"诗篇 36:9"},{"no":7384,"w":"心怀","py":"xīn huái","pos":"名词","orig":"","freq":14,"verses":14,"vols":8,"chaps":12,"ot":11,"nt":3,"first":"诗篇 37:1","top":[["诗篇",5],["箴言",2]],"rest":[6,7],"co":[["不平",5],["不要",4],["二意",4],["作恶",3]],"books":{"诗篇":5,"箴言":2,"雅各书":2,"传道书":1,"以赛亚书":1,"但以理书":1,"何西阿书":1,"腓立比书":1},"verse":"我见恶人和狂傲人享平安就心怀不平。","ref":"诗篇 73:3","def":"居心;心中存有","senses":[["①","居心;心中存有","诗 37:1","出现 14 次"]],"bverse":"心怀二意的人为我所恨；但你的律法为我所爱。","bref":"诗篇 119:113"},{"no":7385,"w":"不平","py":"bù píng","pos":"名词","orig":"","freq":5,"verses":5,"vols":2,"chaps":3,"ot":5,"nt":0,"first":"诗篇 37:1","top":[["诗篇",4],["箴言",1]],"rest":[0,0],"co":[["心怀",5],["不要",4],["作恶",3],["嫉妒",2]],"books":{"诗篇":4,"箴言":1},"verse":"我见恶人和狂傲人享平安就心怀不平。","ref":"诗篇 73:3","def":"和合本用词；常见搭配：心怀 5、不要 4、作恶 3。","senses":[],"bverse":"当止住怒气，离弃忿怒；不要心怀不平，以致作恶。","bref":"诗篇 37:8"},{"no":7386,"w":"那行","py":"nà xíng","pos":"代词","orig":"","freq":5,"verses":5,"vols":5,"chaps":5,"ot":3,"nt":2,"first":"诗篇 37:1","top":[["诗篇",1],["耶利米书",1]],"rest":[3,3],"co":[["不义",3],["可憎",2],["不要",1],["嫉妒",1]],"books":{"诗篇":1,"耶利米书":1,"但以理书":1,"歌罗西书":1,"启示录":1},"verse":"（大卫的诗。）不要为作恶的心怀不平，也不要向那行不义的生出嫉妒。","ref":"诗篇 37:1","def":"和合本用词；常见搭配：不义 3、可憎 2、不要 1。","senses":[["①","移步向前","诗 37:1","出现 5 次"]],"bverse":"那行不义的必受不义的报应；主并不偏待人。","bref":"歌罗西书 3:25"},{"no":7387,"w":"如草","py":"rú cǎo","pos":"动词","orig":"","freq":8,"verses":8,"vols":4,"chaps":7,"ot":7,"nt":1,"first":"诗篇 37:2","top":[["诗篇",5],["箴言",1]],"rest":[2,2],"co":[["枯干",4],["发旺",2],["野地",2],["血气",2]],"books":{"诗篇":5,"箴言":1,"以赛亚书":1,"彼得前书":1},"verse":"我的年日如日影偏斜；我也如草枯干。","ref":"诗篇 102:11","def":"和合本用词；常见搭配：枯干 4、发旺 2、野地 2。","senses":[],"bverse":"我的心被伤，如草枯干，甚至我忘记吃饭。","bref":"诗篇 102:4"},{"no":7388,"w":"如光","py":"rú guāng","pos":"连词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 37:6","top":[["诗篇",1],["何西阿书",1]],"rest":[1,1],"co":[["发出",2],["公义",1],["正午",1],["公平",1]],"books":{"诗篇":1,"何西阿书":1,"马太福音":1},"verse":"他要使你的公义如光发出，使你的公平明如正午。","ref":"诗篇 37:6","def":"和合本用词；常见搭配：发出 2、公义 1、正午 1。","senses":[],"bverse":"就在他们面前变了形像，脸面明亮如日头，衣裳洁白如光。","bref":"马太福音 17:2"},{"no":7389,"w":"默然","py":"mò rán","pos":"副词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"诗篇 37:7","top":[["诗篇",2],["以赛亚书",1]],"rest":[1,1],"co":[["耶和华",2],["道路",1],["等候",1],["不要",1]],"books":{"诗篇":2,"以赛亚书":1,"西番雅书":1},"verse":"我默然无声，连好话也不出口；我的愁苦就发动了，","ref":"诗篇 39:2","def":"和合本用词；常见搭配：耶和华 2、道路 1、等候 1。","senses":[["①","沉默不语貌","诗 37:7","出现 4 次"]],"bverse":"你当默然倚靠耶和华，耐性等候他；不要因那道路通达的和那恶谋成就的心怀不平。","bref":"诗篇 37:7"},{"no":7390,"w":"耐性","py":"nài xìng","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":2,"nt":1,"first":"诗篇 37:7","top":[["诗篇",2],["使徒行传",1]],"rest":[0,0],"co":[["等候",2],["耶和华",2],["道路",1],["不要",1]],"books":{"诗篇":2,"使徒行传":1},"verse":"（大卫的诗，交与伶长。）我曾耐性等候耶和华；他垂听我的呼求。","ref":"诗篇 40:1","def":"不急躁﹐不厌烦","senses":[["①","不急躁﹐不厌烦","诗 37:7","出现 3 次"]],"bverse":"你当默然倚靠耶和华，耐性等候他；不要因那道路通达的和那恶谋成就的心怀不平。","bref":"诗篇 37:7"},{"no":7391,"w":"细察","py":"xì chá","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":3,"nt":0,"first":"诗篇 37:10","top":[["诗篇",3]],"rest":[0,0],"co":[["无有",1],["归于",1],["片时",1],["住处",1]],"books":{"诗篇":3},"verse":"我行路，我躺卧，你都细察；你也深知我一切所行的。","ref":"诗篇 139:3","def":"和合本用词；常见搭配：无有 1、归于 1、片时 1。","senses":[],"bverse":"你要细察那完全人，观看那正直人，因为和平人有好结局。","bref":"诗篇 37:37"},{"no":7392,"w":"出鞘","py":"chū qiào","pos":"动词","orig":"","freq":4,"verses":4,"vols":2,"chaps":2,"ot":4,"nt":0,"first":"诗篇 37:14","top":[["以西结书",3],["诗篇",1]],"rest":[0,0],"co":[["恶人",3],["中间",2],["拔刀",2],["耶和华",2]],"books":{"以西结书":3,"诗篇":1},"verse":"一切有血气的就知道我─耶和华已经拔刀出鞘，必不再入鞘。","ref":"以西结书 21:5","def":"和合本用词；常见搭配：恶人 3、中间 2、拔刀 2。","senses":[],"bverse":"我既要从你中间剪除义人和恶人，所以我的刀要出鞘，自南至北攻击一切有血气的；","bref":"以西结书 21:4"},{"no":7393,"w":"富余","py":"fù yú","pos":"形容词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":1,"nt":2,"first":"诗篇 37:16","top":[["哥林多后书",2],["诗篇",1]],"rest":[0,0],"co":[["许多",1],["义人",1],["恶人",1],["所有",1]],"books":{"哥林多后书":2,"诗篇":1},"verse":"一个义人所有的虽少，强过许多恶人的富余。","ref":"诗篇 37:16","def":"和合本用词；常见搭配：许多 1、义人 1、恶人 1。","senses":[],"bverse":"乃要均平，就是要你们的富余，现在可以补他们的不足，使他们的富余，将来也可以补你们的不足，这就均平了。","bref":"哥林多后书 8:14"},{"no":7394,"w":"存到","py":"cún dào","pos":"动词","orig":"","freq":6,"verses":6,"vols":3,"chaps":6,"ot":5,"nt":1,"first":"诗篇 37:18","top":[["诗篇",4],["耶利米哀歌",1]],"rest":[1,1],"co":[["永远",5],["耶和华",3],["宝座",2],["万代",2]],"books":{"诗篇":4,"耶利米哀歌":1,"约翰福音":1},"verse":"耶和华知道完全人的日子；他们的产业要存到永远。","ref":"诗篇 37:18","def":"和合本用词；常见搭配：永远 5、耶和华 3、宝座 2。","senses":[],"bverse":"惟你─耶和华必存到永远；你可记念的名也存到万代。","bref":"诗篇 102:12"},{"no":7395,"w":"施舍","py":"shī shě","pos":"名词","orig":"","freq":10,"verses":10,"vols":7,"chaps":8,"ot":3,"nt":7,"first":"诗篇 37:21","top":[["马太福音",3],["箴言",2]],"rest":[5,5],"co":[["义人",2],["时候",2],["甘心",2],["富足",2]],"books":{"马太福音":3,"箴言":2,"诗篇":1,"路加福音":1,"罗马书":1,"哥林多后书":1,"提摩太（前书）":1},"verse":"你施舍的时候，不要叫左手知道右手所做的，","ref":"马太福音 6:3","def":"无偿送给穷人或出家人钱财、东西多谢施舍","senses":[["①","无偿送给穷人或出家人","诗 37:21","出现 10 次"]],"bverse":"要叫你施舍的事行在暗中。你父在暗中察看，必然报答你（有古卷：必在明处报答你）。”","bref":"马太福音 6:4"},{"no":7396,"w":"讨饭","py":"tǎo fàn","pos":"动词","orig":"","freq":10,"verses":9,"vols":5,"chaps":7,"ot":3,"nt":7,"first":"诗篇 37:25","top":[["路加福音",4],["诗篇",2]],"rest":[3,4],"co":[["时候",3],["从前",2],["耶稣",2],["瞎子",2]],"books":{"路加福音":4,"诗篇":2,"约翰福音":2,"箴言":1,"马可福音":1},"verse":"耶稣将近耶利哥的时候，有一个瞎子坐在路旁讨饭。","ref":"路加福音 18:35","def":"和合本用词；常见搭配：时候 3、从前 2、耶稣 2。","senses":[["①","行乞﹔要饭","诗 37:25","出现 10 次"]],"bverse":"又有一个讨饭的，名叫拉撒路，浑身生疮，被人放在财主门口，","bref":"路加福音 16:20"},{"no":7397,"w":"不定","py":"bù dìng","pos":"副词","orig":"","freq":8,"verses":8,"vols":7,"chaps":8,"ot":4,"nt":4,"first":"诗篇 37:33","top":[["约翰福音",2],["诗篇",1]],"rest":[5,5],"co":[["告诉",2],["犹疑",2],["手中",1],["时候",1]],"books":{"约翰福音":2,"诗篇":1,"箴言":1,"耶利米书":1,"何西阿书":1,"路加福音":1,"哥林多后书":1},"verse":"耶和华必不撇他在恶人手中；当审判的时候，也不定他的罪。","ref":"诗篇 37:33","def":"不安定;不稳定","senses":[["①","不安定;不稳定","诗 37:33","出现 8 次"]],"bverse":"她说：“主啊，没有。”耶稣说：“我也不定你的罪。去吧，从此不要再犯罪了！”","bref":"约翰福音 8:11"},{"no":7398,"w":"本土","py":"běn tǔ","pos":"名词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"诗篇 37:35","top":[["以赛亚书",2],["诗篇",1]],"rest":[1,1],"co":[["本族",2],["归回",2],["欺压",2],["势力",1]],"books":{"以赛亚书":2,"诗篇":1,"耶利米书":1},"verse":"人必像被追赶的鹿，像无人收聚的羊，各归回本族，各逃到本土。","ref":"以赛亚书 13:14","def":"乡土；原来的生长地本乡","senses":[],"bverse":"我见过恶人大有势力，好像一根青翠树在本土生发。","bref":"诗篇 37:35"},{"no":7399,"w":"犯法","py":"fàn fǎ","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"诗篇 37:38","top":[["诗篇",1],["但以理书",1]],"rest":[1,1],"co":[["至于",1],["一同",1],["灭绝",1],["恶人",1]],"books":{"诗篇":1,"但以理书":1,"雅各书":1},"verse":"至于犯法的人，必一同灭绝；恶人终必剪除。","ref":"诗篇 37:38","def":"和合本用词；常见搭配：至于 1、一同 1、灭绝 1。","senses":[],"bverse":"但你们若按外貌待人，便是犯罪，被律法定为犯法的。","bref":"雅各书 2:9"}]