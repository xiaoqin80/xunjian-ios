:8,"vols":3,"chaps":7,"ot":9,"nt":0,"first":"列王纪上 20:31","top":[["箴言",7],["列王记（上）",1]],"rest":[1,1],"co":[["腰束",1],["麻布",1],["王都",1],["听说",1]],"books":{"箴言":7,"列王记（上）":1,"诗篇":1},"verse":"仁慈的人善待自己；残忍的人扰害己身。","ref":"箴言 11:17","def":"和合本用词；常见搭配：腰束 1、麻布 1、王都 1。","senses":[],"bverse":"王因仁慈和诚实得以保全他的国位，也因仁慈立稳。","bref":"箴言 20:28"},{"no":6112,"w":"头套","py":"tóu tào","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":2,"nt":0,"first":"列王纪上 20:31","top":[["列王记（上）",2]],"rest":[0,0],"co":[["腰束",2],["麻布",2],["以色列",2],["性命",2]],"books":{"列王记（上）":2},"verse":"他的臣仆对他说：“我们听说以色列王都是仁慈的王，现在我们不如腰束麻布，头套绳索，出去投降以色列王，或者他存留王的性命。”","ref":"列王纪上 20:31","def":"套在演员等头上，使头型﹑发式等符合某种需要的化装用具","senses":[["①","套在演员等头上","王上 20:31","出现 2 次"]],"bverse":"于是他们腰束麻布，头套绳索，去见以色列王，说：“王的仆人便‧哈达说，求王存留我的性命。”亚哈说：“他还活着吗？他是我的兄弟。”","bref":"列王纪上 20:32"},{"no":6113,"w":"照此","py":"zhào cǐ","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"列王纪上 20:34","top":[["列王记（上）",1],["列王记（下）",1]],"rest":[1,1],"co":[["石榴",2],["网子",2],["一根",2],["柱子",2]],"books":{"列王记（上）":1,"列王记（下）":1,"耶利米书":1},"verse":"柱上有铜顶，高五肘；铜顶的周围有网子和石榴，都是铜的。那一根柱子照此一样，也有石榴。","ref":"耶利米书 52:22","def":"和合本用词；常见搭配：石榴 2、网子 2、一根 2。","senses":[],"bverse":"便‧哈达对王说：“我父从你父那里所夺的城邑，我必归还。你可以在大马士革立街市，像我父在撒马利亚所立的一样。”亚哈说：“我照此立约，放你回去”，就与他立约，放他去了。","bref":"列王纪上 20:34"},{"no":6114,"w":"门徒","py":"mén tú","pos":"名词","orig":"","freq":375,"verses":348,"vols":9,"chaps":90,"ot":14,"nt":361,"first":"列王纪上 20:35","top":[["马太福音",89],["约翰福音",89]],"rest":[7,197],"co":[["耶稣",168],["那里",47],["众人",32],["时候",28]],"books":{"马太福音":89,"约翰福音":89,"马可福音":84,"路加福音":58,"使徒行传":41,"列王记（下）":10,"列王记（上）":2,"以赛亚书":1,"阿摩司书":1},"verse":"耶稣上了船，门徒跟着他。","ref":"马太福音 8:23","def":"跟随学习者；新约特指跟随耶稣、受其教导的人。","senses":[["①","圣经用语：跟随耶稣学","王上 20:35","出现 375 次"]],"bverse":"拿着这七个饼和几条鱼，祝谢了，擘开，递给门徒；门徒又递给众人。","bref":"马太福音 15:36"},{"no":6115,"w":"面目","py":"miàn mù","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":1,"nt":3,"first":"列王纪上 20:38","top":[["列王记（上）",1],["帖撒罗尼迦（前书）"