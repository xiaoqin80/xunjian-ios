1","出现 4 次"]],"bverse":"银炼折断，金罐破裂，瓶子在泉旁损坏，水轮在井口破烂，","bref":"传道书 12:6"},{"no":7785,"w":"闪烁","py":"shǎn shuò","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"箴言 23:31","top":[["那鸿书",2],["箴言",1]],"rest":[1,1],"co":[["观看",2],["发红",1],["舒畅",1],["终久",1]],"books":{"那鸿书":2,"箴言":1,"以西结书":1},"verse":"酒发红，在杯中闪烁，你不可观看，虽然下咽舒畅，终久是咬你如蛇，刺你如毒蛇。","ref":"箴言 23:31","def":"光摇晃不定的样子星星闪烁","senses":[["①","光摇晃不定的样子星星","箴 23:31","出现 4 次"]],"bverse":"马兵争先，刀剑发光，枪矛闪烁，被杀的甚多，尸首成了大堆，尸骸无数，人碰著而跌倒，","bref":"那鸿书 3:3"},{"no":7786,"w":"下咽","py":"xià yàn","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"箴言 23:31","top":[["箴言",1],["雅歌",1]],"rest":[0,0],"co":[["舒畅",2],["发红",1],["终久",1],["不可",1]],"books":{"箴言":1,"雅歌":1},"verse":"你的口如上好的酒。女子说：为我的良人下咽舒畅，流入睡觉人的嘴中。","ref":"雅歌 7:9","def":"和合本用词；常见搭配：舒畅 2、发红 1、终久 1。","senses":[],"bverse":"酒发红，在杯中闪烁，你不可观看，虽然下咽舒畅，终久是咬你如蛇，刺你如毒蛇。","bref":"箴言 23:31"},{"no":7787,"w":"毒蛇","py":"dú shé","pos":"名词","orig":"","freq":12,"verses":12,"vols":6,"chaps":10,"ot":5,"nt":7,"first":"箴言 23:31","top":[["以赛亚书",3],["马太福音",3]],"rest":[4,6],"co":[["种类",3],["出来",3],["约翰",2],["将来",2]],"books":{"以赛亚书":3,"马太福音":3,"使徒行传":3,"箴言":1,"耶利米书":1,"路加福音":1},"verse":"他们菢毒蛇蛋，结蜘蛛网；人吃这蛋必死。这蛋被踏，必出蝮蛇。","ref":"以赛亚书 59:5","def":"和合本用词；常见搭配：种类 3、出来 3、约翰 2。","senses":[],"bverse":"吃奶的孩子必玩耍在虺蛇的洞口；断奶的婴儿必按手在毒蛇的穴上。","bref":"以赛亚书 11:8"},{"no":7788,"w":"桅杆","py":"wéi gān","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"箴言 23:34","top":[["箴言",1],["以赛亚书",1]],"rest":[1,1],"co":[["海中",1],["必像",1],["夺去",1],["许多",1]],"books":{"箴言":1,"以赛亚书":1,"以西结书":1},"verse":"你必像躺在海中，或像卧在桅杆上。","ref":"箴言 23:34","def":"和合本用词；常见搭配：海中 1、必像 1、夺去 1。","senses":[["①","见\"桅竿\"","箴 23:34","出现 3 次"]],"bverse":"他们用示尼珥的松树做你的一切板，用黎巴嫩的香柏树做桅杆，","bref":"以西结书 27:5"},{"no":7789,"w":"清醒","py":"qīng xǐng","pos":"形容词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"箴言 23:35","top":[["箴言",1],["约珥书",1]],"rest":[1,1],"co":[["受伤",1],["鞭打",1],["必说",1],["几时",1]],"books":{"箴言":1,"约珥书":1,"路加福音":1},"verse":"彼得和他的同伴都打盹，既清醒了，就看见耶稣的荣光，并同他站着的那两个人。","ref":"路加福音 9:32","def":"和合本用词；常见搭配：受伤 1、鞭打 1、必说 1。","senses":[],"bverse":"你必说：人打我，我却未受伤；人鞭打我，我竟不觉得。我几时清醒，我仍去寻酒。","bref":"箴言 23:35"},{"no":7790,"w":"人力","py":"rén lì","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"箴言 24:5","top":[["箴言",1],["弥迦书",1]],"rest":[0,0],"co":[["知识",1],["人大",1],["加力",1],["智慧",1]],"books":{"箴言":1,"弥迦书":1},"verse":"智慧人大有能力；有知识的人力上加力。","ref":"箴言 24:5","def":"人的劳力，人的力量","senses":[["①","人的劳力","箴 24:5","出现 2 次"]],"bverse":"雅各余剩的人必在多国的民中，如从耶和华那里降下的露水，又如甘霖降在草上；不仗赖人力，也不等候世人之功。","bref":"弥迦书 5:7"},{"no":7791,"w":"仍必","py":"réng bì","pos":"副词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"箴言 24:16","top":[["箴言",1],["耶利米书",1]],"rest":[1,1],"co":[["义人",1],["七次",1],["祸患",1],["倾倒",1]],"books":{"箴言":1,"耶利米书":1,"撒迦利亚书":1},"verse":"因为，义人虽七次跌倒，仍必兴起；恶人却被祸患倾倒。","ref":"箴言 24:16","def":"和合本用词；常见搭配：义人 1、七次 1、祸患 1。","senses":[],"bverse":"耶和华说：这全地的人，三分之二必剪除而死，三分之一仍必存留。","bref":"撒迦利亚书 13:8"},{"no":7792,"w":"刺草","py":"cì cǎo","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"箴言 24:31","top":[["箴言",1],["以赛亚书",1]],"rest":[1,1],"co":[["荆棘",2],["遮盖",1],["坍塌",1],["石墙",1]],"books":{"箴言":1,"以赛亚书":1,"西番雅书":1},"verse":"荆棘长满了地皮，刺草遮盖了田面，石墙也坍塌了。","ref":"箴言 24:31","def":"和合本用词；常见搭配：荆棘 2、遮盖 1、坍塌 1。","senses":[],"bverse":"以东的宫殿要长荆棘；保障要长蒺藜和刺草；要作野狗的住处，鸵鸟的居所。","bref":"以赛亚书 34:13"},{"no":7793,"w":"坍塌","py":"tān tā","pos":"动词","orig":"","freq":4,"verses":4,"vols":3,"chaps":4,"ot":4,"nt":0,"first":"箴言 24:31","top":[["耶利米书",2],["箴言",1]],"rest":[1,1],"co":[["巴比伦",2],["城墙",2],["遮盖",1],["石墙",1]],"books":{"耶利米书":2,"箴言":1,"以赛亚书":1},"verse":"荆棘长满了地皮，刺草遮盖了田面，石墙也坍塌了。","ref":"箴言 24:31","def":"和合本用词；常见搭配：巴比伦 2、城墙 2、遮盖 1。","senses":[],"bverse":"故此，这罪孽在你们身上，好像将要破裂凸出来的高墙，顷刻之间忽然坍塌；","bref":"以赛亚书 30:13"},{"no":7794,"w":"赠送","py":"zèng sòng","pos":"动词","orig":"","freq":6,"verses":4,"vols":2,"chaps":2,"ot":6,"nt":0