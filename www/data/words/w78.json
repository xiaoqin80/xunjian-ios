["箴言",1]],"rest":[0,0],"co":[["火焰",2],["义人",1],["动摇",1],["恶行",1]],"books":{"以赛亚书":2,"箴言":1},"verse":"人靠恶行不能坚立；义人的根必不动摇。","ref":"箴言 12:3","def":"和合本用词；常见搭配：火焰 2、义人 1、动摇 1。","senses":[],"bverse":"火苗怎样吞灭碎秸，干草怎样落在火焰之中，照样，他们的根必像朽物，他们的花必像灰尘飞腾；因为他们厌弃万军之耶和华的训诲，藐视以色列圣者的言语。","bref":"以赛亚书 5:24"},{"no":7722,"w":"家必","py":"jiā bì","pos":"量词","orig":"","freq":6,"verses":5,"vols":5,"chaps":5,"ot":6,"nt":0,"first":"箴言 12:7","top":[["俄巴底亚书",2],["箴言",1]],"rest":[3,3],"co":[["耶和华",3],["必将",2],["以色列",2],["义人",1]],"books":{"俄巴底亚书":2,"箴言":1,"以赛亚书":1,"耶利米书":1,"以西结书":1},"verse":"恶人倾覆，归于无有；义人的家必站得住。","ref":"箴言 12:7","def":"和合本用词；常见搭配：耶和华 3、必将 2、以色列 2。","senses":[],"bverse":"这样，从那日以后，以色列家必知道我是耶和华─他们的神。","bref":"以西结书 39:22"},{"no":7723,"w":"劝教","py":"quàn jiào","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":3,"ot":3,"nt":0,"first":"箴言 12:15","top":[["箴言",3]],"rest":[0,0],"co":[["智慧",2],["愚妄",1],["眼中",1],["看为",1]],"books":{"箴言":3},"verse":"你要听劝教，受训诲，使你终久有智慧。","ref":"箴言 19:20","def":"和合本用词；常见搭配：智慧 2、愚妄 1、眼中 1。","senses":[["①","劝勉教化","箴 12:15","出现 3 次"]],"bverse":"膏油与香料使人心喜悦；朋友诚实的劝教也是如此甘美。","bref":"箴言 27:9"},{"no":7724,"w":"真话","py":"zhēn huà","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"箴言 12:17","top":[["箴言",1],["耶利米书",1]],"rest":[2,2],"co":[["见证",2],["学习",2],["谎言",2],["显出",1]],"books":{"箴言":1,"耶利米书":1,"罗马书":1,"提摩太（前书）":1},"verse":"说出真话的，显明公义；作假见证的，显出诡诈。","ref":"箴言 12:17","def":"和合本用词；常见搭配：见证 2、学习 2、谎言 2。","senses":[["①","犹言实情","箴 12:17","出现 4 次"]],"bverse":"我在基督里说真话，并不谎言，有我良心被圣灵感动，给我作见证：","bref":"罗马书 9:1"},{"no":7725,"w":"医人","py":"yī rén","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,"first":"箴言 12:18","top":[["箴言",2]],"rest":[0,0],"co":[["良药",2],["智慧",1],["说话",1],["舌头",1]],"books":{"箴言":2},"verse":"奸恶的使者必陷在祸患里；忠信的使臣乃医人的良药。","ref":"箴言 13:17","def":"和合本用词；常见搭配：良药 2、智慧 1、说话 1。","senses":[],"bverse":"说话浮躁的，如刀刺人；智慧人的舌头却为医人的良药。","bref":"箴言 12:18"},{"no":7726,"w":"满受","py":"mǎn shòu","pos":"动词","orig":"","freq":3,"verses"