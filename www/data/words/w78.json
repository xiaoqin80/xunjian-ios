no":7799,"w":"下雨","py":"xià yǔ","pos":"动词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":2,"nt":2,"first":"箴言 26:1","top":[["箴言",1],["以西结书",1]],"rest":[2,2],"co":[["相宜",1],["夏天",1],["收割",1],["愚昧",1]],"books":{"箴言":1,"以西结书":1,"使徒行传":1,"雅各书":1},"verse":"夏天落雪，收割时下雨，都不相宜；愚昧人得尊荣也是如此。","ref":"箴言 26:1","def":"和合本用词；常见搭配：相宜 1、夏天 1、收割 1。","senses":[],"bverse":"土人看待我们，有非常的情分；因为当时下雨，天气又冷，就生火接待我们众人。","bref":"使徒行传 28:2"},{"no":7800,"w":"刑杖","py":"xíng zhàng","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":2,"nt":1,"first":"箴言 26:3","top":[["箴言",1],["弥迦书",1]],"rest":[1,1],"co":[["辔头",1],["鞭子",1],["愚昧",1],["呼叫",1]],"books":{"箴言":1,"弥迦书":1,"哥林多前书":1},"verse":"鞭子是为打马，辔头是为勒驴；刑杖是为打愚昧人的背。","ref":"箴言 26:3","def":"刑具，行刑用的棍棒","senses":[],"bverse":"耶和华向这城呼叫，智慧人必敬畏他的名。你们当听是谁派定刑杖的惩罚。","bref":"弥迦书 6:9"}]