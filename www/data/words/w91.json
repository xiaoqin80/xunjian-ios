,4],["该死",2],["非斯都",2],["交给",1]],"books":{"使徒行传":5},"verse":"亚基帕又对非斯都说：“这人若没有上告于凯撒，就可以释放了。”","ref":"使徒行传 26:32","def":"向天呼吁，诉之于上帝","senses":[["①","向天呼吁","徒 25:11","出现 5 次"]],"bverse":"非斯都和议会商量了，就说：“你既上告于凯撒，可以往凯撒那里去。”","bref":"使徒行传 25:12"},{"no":9016,"w":"亚基帕","py":"yà jī pà","pos":"名词","orig":"","freq":11,"verses":11,"vols":1,"chaps":2,"ot":0,"nt":11,"first":"使徒行传 25:13","top":[["使徒行传",11]],"rest":[0,0],"co":[["非斯都",5],["这人",4],["保罗",3],["凯撒",2]],"books":{"使徒行传":11},"verse":"亚基帕王啊，你信先知吗？我知道你是信的。”","ref":"使徒行传 26:27","def":"圣经专名（人名／地名／族名），首见 使徒行传 25:13。","senses":[],"bverse":"“亚基帕王啊，我故此没有违背那从天上来的异象；","bref":"使徒行传 26:19"},{"no":9017,"w":"罪案","py":"zuì àn","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"使徒行传 25:27","top":[["使徒行传",1],["罗马书",1]],"rest":[0,0],"co":[["看来",1],["囚犯",1],["指明",1],["律法",1]],"books":{"使徒行传":1,"罗马书":1},"verse":"据我看来，解送囚犯，不指明他的罪案是不合理的。”","ref":"使徒行传 25:27","def":"和合本用词；常见搭配：看来 1、囚犯 1、指明 1。","senses":[["①","罪状;罪名","徒 25:27","出现 2 次"]],"bverse":"律法既因肉体软弱，有所不能行的，神就差遣自己的儿子，成为罪身的形状，作了赎罪祭，在肉体中定了罪案，","bref":"罗马书 8:3"},{"no":9018,"w":"多方","py":"duō fāng","pos":"数词","orig":"","freq":6,"verses":6,"vols":4,"chaps":6,"ot":0,"nt":6,"first":"使徒行传 26:9","top":[["使徒行传",2],["启示录",2]],"rest":[2,2],"co":[["天使",2],["应当",1],["耶稣",1],["以为",1]],"books":{"使徒行传":2,"启示录":2,"以弗所书":1,"希伯来书":1},"verse":"从前我自己以为应当多方攻击拿撒勒人耶稣的名，","ref":"使徒行传 26:9","def":"和合本用词；常见搭配：天使 2、应当 1、耶稣 1。","senses":[],"bverse":"他们又多方地尊敬我们；到了开船的时候，也把我们所需用的送到船上。","bref":"使徒行传 28:10"},{"no":9019,"w":"深信","py":"shēn xìn","pos":"动词","orig":"","freq":15,"verses":15,"vols":8,"chaps":13,"ot":0,"nt":15,"first":"使徒行传 26:26","top":[["罗马书",4],["哥林多后书",3]],"rest":[6,8],"co":[["现在",3],["知道",3],["既然",2],["众人",2]],"books":{"罗马书":4,"哥林多后书":3,"腓立比书":2,"提摩太（后书）":2,"使徒行传":1,"帖撒罗尼迦（后书）":1,"腓利门书":1,"希伯来书":1},"verse":"又深信自己是给瞎子领路的，是黑暗中人的光，","ref":"罗马书 2:19","def":"深切相信。","senses":[],"bverse":"弟兄们，我自己也深信你们是满有良善，充足了诸般的知识，也能彼此劝戒。","bref":"罗马书 15:14"},{"no":9020,"w":"背地里","py":"bèi dì lǐ","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"使徒行传 26:26","top":[["使徒行传",1],["加拉太书",1]],"rest":[0,0],"co":[["放胆",1],["隐藏",1],["晓得",1],["深信",1]],"books":{"使徒行传":1,"加拉太书":1},"verse":"王也晓得这些事，所以我向王放胆直言，我深信这些事没有一件向王隐藏的，因都不是在背地里做的。","ref":"使徒行传 26:26","def":"暗中﹐背人处","senses":[["①","暗中﹐背人处","徒 26:26","出现 2 次"]],"bverse":"我是奉启示上去的，把我在外邦人中所传的福音对弟兄们陈说；却是背地里对那有名望之人说的，惟恐我现在，或是从前，徒然奔跑。","bref":"加拉太书 2:2"},{"no":9021,"w":"背风","py":"bèi fēng","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":0,"nt":3,"first":"使徒行传 27:4","top":[["使徒行传",3]],"rest":[0,0],"co":[["那里",2],["仅仅",2],["塞浦路斯",1],["开船",1]],"books":{"使徒行传":3},"verse":"从那里又开船，因为风不顺，就贴著塞浦路斯背风岸行去。","ref":"使徒行传 27:4","def":"风不能直接吹到找个","senses":[["①","风不能直接吹到找个～","徒 27:4","出现 3 次"]],"bverse":"贴著一个小岛的背风岸奔行，那岛名叫高大，在那里仅仅收住了小船。","bref":"使徒行传 27:16"},{"no":9022,"w":"行船","py":"xíng chuán","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":0,"nt":2,"first":"使徒行传 27:9","top":[["使徒行传",2]],"rest":[0,0],"co":[["日子",1],["众人",1],["禁食",1],["保罗",1]],"books":{"使徒行传":2},"verse":"走的日子多了，已经过了禁食的节期，行船又危险，保罗就劝众人说：","ref":"使徒行传 27:9","def":"通行船只;驾驶船只","senses":[["①","通行船只;驾驶船只","徒 27:9","出现 2 次"]],"bverse":"“众位，我看这次行船，不但货物和船要受伤损，大遭破坏，连我们的性命也难保。”","bref":"使徒行传 27:10"},{"no":9023,"w":"岛上","py":"dǎo shàng","pos":"处所词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":0,"nt":3,"first":"使徒行传 27:14","top":[["使徒行传",3]],"rest":[0,0],"co":[["名叫",1],["狂风",1],["几时",1],["只是",1]],"books":{"使徒行传":3},"verse":"只是我们必要撞在一个岛上。”","ref":"使徒行传 27:26","def":"和合本用词；常见搭配：名叫 1、狂风 1、几时 1。","senses":[],"bverse":"从此，岛上其余的病人也来，得了医治。","bref":"使徒行传 28:9"},{"no":9024,"w":"缆索","py":"lǎn suǒ","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":0,"nt":2,"first":"使徒行传 27:17","top":[["使徒行传",2]],"rest":[0,0],"co":[["恐怕",1],["既然",1],["捆绑",1],["飘去",1]],"books":{"使徒行传":2},"verse":"于是砍断缆索，弃锚在海里；同时也松开舵绳，拉起头篷，顺着风向岸行去。","ref":"使徒行传 27:40","def":"和合本用词；常见搭配：恐怕 1、既然 1、捆绑 1。","senses":[],"bverse":"既然把小船拉上来，就用缆索捆绑船底，又恐怕在赛耳底沙滩上搁了浅，就落下篷来，任船飘去。","bref":"使徒行传 27:17"},{"no":9025,"w":"本该","py":"běn gāi","pos":"副词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":0,"nt":4,"first":"使徒行传 27:21","top":[["使徒行传",1],["哥林多后书",1]],"rest":[2,2],"co":[["破坏",1],["众位",1],["中间",1],["多日",1]],"books":{"使徒行传":1,"哥林多后书":1,"帖撒罗尼迦（后书）":1,"希伯来书":1},"verse":"我成了愚妄人，是被你们强逼的。我本该被你们称许才是。我虽算不了什么，却没有一件事在那些最大的使徒以下。","ref":"哥林多后书 12:11","def":"和合本用词；常见搭配：破坏 1、众位 1、中间 1。","senses":[],"bverse":"众人多日没有吃什么，保罗就出来站在他们中间，说：“众位，你们本该听我的话，不离开克里特，免得遭这样的伤损破坏。","bref":"使徒行传 27:21"},{"no":9026,"w":"所属","py":"suǒ shǔ","pos":"","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"使徒行传 27:23","top":[["使徒行传",1],["希伯来书",1]],"rest":[0,0],"co":[["所事",1],["旁边",1],["使者",1],["昨夜",1]],"books":{"使徒行传":1,"希伯来书":1},"verse":"因我所属所事奉的神，他的使者昨夜站在我旁边，说：","ref":"使徒行传 27:23","def":"和合本用词；常见搭配：所事 1、旁边 1、使者 1。","senses":[["①","自己隶属的","徒 27:23","出现 2 次"]],"bverse":"原来那为万物所属、为万物所本的，要领许多的儿子进荣耀里去，使救他们的元帅，因受苦难得以完全，本是合宜的。","bref":"希伯来书 2:10"},{"no":9027,"w":"深浅","py":"shēn qiǎn","pos":"形容词","orig":"","freq":2,"verses":1,"vols":1,"chaps":1,"ot":0,"nt":2,"first":"使徒行传 27:28","top":[["使徒行传",2]],"rest":[0,0],"co":[["往前",1],["十二",1]],"books":{"使徒行传":2},"verse":"就探深浅，探得有十二丈；稍往前行，又探深浅，探得有九丈。","ref":"使徒行传 27:28","def":"指水的深浅程度。引申指事物的轻重﹑大小﹑多少等","senses":[["①","指水的深浅程度","徒 27:28","出现 2 次"]],"bverse":"","bref":""},{"no":9028,"w":"猛力","py":"měng lì","pos":"副词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"使徒行传 27:41","top":[["使徒行传",1],["启示录",1]],"rest":[0,0],"co":[["船尾",1],["地方",1],["大城",1],["举起",1]],"books":{"使徒行传":1,"启示录":1},"verse":"但遇着两水夹流的地方，就把船搁了浅；船头胶住不动，船尾被浪的猛力冲坏。","ref":"使徒行传 27:41","def":"和合本用词；常见搭配：船尾 1、地方 1、大城 1。","senses":[["①","勇猛有力","徒 27:41","出现 2 次"]],"bverse":"有一位大力的天使举起一块石头，好像大磨石，扔在海里，说：巴比伦大城也必这样猛力地被扔下去，决不能再见了。","bref":"启示录 18:21"},{"no":9029,"w":"土人","py":"tǔ rén","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":1,"ot":0,"nt":3,"first":"使徒行传 28:2","top":[["使徒行传",3]],"rest":[0,0],"co":[["接待",1],["看待",1],["下雨",1],["天气",1]],"books":{"使徒行传":3},"verse":"土人看待我们，有非常的情分；因为当时下雨，天气又冷，就生火接待我们众人。","ref":"使徒行传 28:2","def":"世代居住本地的人","senses":[["①","世代居住本地的人","徒 28:2","出现 3 次"]],"bverse":"土人看见那毒蛇悬在他手上，就彼此说：“这人必是个凶手，虽然从海里救上来，天理还不容他活着。”","bref":"使徒行传 28:4"},{"no":9030,"w":"接纳","py":"jiē nà","pos":"动词","orig":"","freq":5,"verses":4,"vols":3,"chaps":4,"ot":0,"nt":5,"first":"使徒行传 28:7","top":[["罗马书",3],["使徒行传",1]],"rest":[1,1],"co":[["尽情",1],["三日",1],["地方",1],["田产",1]],"books":{"罗马书":3,"使徒行传":1,"哥林多后书":1},"verse":"信心软弱的，你们要接纳，但不要辩论所疑惑的事。","ref":"罗马书 14:1","def":"和合本用词；常见搭配：尽情 1、三日 1、地方 1。","senses":[],"bverse":"所以，你们要彼此接纳，如同基督接纳你们一样，使荣耀归与神。","bref":"罗马书 15:7"},{"no":9031,"w":"款待","py":"kuǎn dài","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"使徒行传 28:7","top":[["使徒行传",1],["罗马书",1]],"rest":[1,1],"co":[["接纳",1],["尽情",1],["三日",1],["地方",1]],"books":{"使徒行传":1,"罗马书":1,"彼得前书":1},"verse":"离那地方不远，有田产是岛长部百流的；他接纳我们，尽情款待三日。","ref":"使徒行传 28:7","def":"和合本用词；常见搭配：接纳 1、尽情 1、三日 1。","senses":[],"bverse":"你们要互相款待，不发怨言。","bref":"彼得前书 4:9"},{"no":9033,"w":"真道","py":"zhēn dào","pos":"副词","orig":"","freq":36,"verses":35,"vols":13,"chaps":25,"ot":0,"nt":36,"first":"罗马书 1:5","top":[["提摩太（前书）",12],["提摩太（后书）",6]],"rest":[11,18],"co":[["有人",5],["明白",4],["从前",3],["圣灵",3]],"books":{"提摩太（前书）":12,"提摩太（后书）":6,"罗马书":2,"加拉太书":2,"提多书":2,"希伯来书":2,"雅各书":2,"彼得后书":2,"犹大书":2,"哥林多前书":1,"以弗所书":1,"帖撒罗尼迦（前书）":1,"启示录":1},"verse":"他愿意万人得救，明白真道。","ref":"提摩太前书 2:4","def":"犹真理。旧时常指道教或其他宗教的教义","senses":[],"bverse":"要存清洁的良心，固守真道的奥秘。","bref":"提摩太前书 3:9"},{"no":9034,"w":"想见","py":"xiǎng jiàn","pos":"动词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":3,"first":"罗马书 1:11","top":[["帖撒罗尼迦（前书）",2],["罗马书",1]],"rest":[0,0],"co":[["切切",2],["分给",1],["恩赐",1],["坚固",1]],"books":{"帖撒罗尼迦（前书）":2,"罗马书":1},"verse":"因为我切切地想见你们，要把些属灵的恩赐分给你们，使你们可以坚固；","ref":"罗马书 1:11","def":"推测而知球场上的热烈气氛可以想见","senses":[["①","推测而知球场上的热烈","罗 1:11","出现 3 次"]],"bverse":"但提摩太刚才从你们那里回来，将你们信心和爱心的好消息报给我们，又说你们常常记念我们，切切地想见我们，如同我们想见你们一样。","bref":"帖撒罗尼迦前书 3:6"},{"no":9035,"w":"阻隔","py":"zǔ gé","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"罗马书 1:13","top":[["罗马书",1],["哥林多前书",1]],"rest":[1,1],"co":[["其余",1],["果子",1],["屡次",1],["中间",1]],"books":{"罗马书":1,"哥林多前书":1,"希伯来书":1},"verse":"那些成为祭司的，数目本来多，是因为有死阻隔，不能长久。","ref":"希伯来书 7:23","def":"和合本用词；常见搭配：其余 1、果子 1、屡次 1。","senses":[["①","阻挡隔绝","罗 1:13","出现 3 次"]],"bverse":"弟兄们，我不愿意你们不知道，我屡次定意往你们那里去，要在你们中间得些果子，如同在其余的外邦人中一样；只是到如今仍有阻隔。","bref":"罗马书 1:13"},{"no":9036,"w":"为耻","py":"wèi chǐ","pos":"介词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":0,"nt":3,"first":"罗马书 1:16","top":[["提摩太（后书）",2],["罗马书",1]],"rest":[0,0],"co":[["福音",2],["先是",1],["相信",1],["犹太人",1]],"books":{"提摩太（后书）":2,"罗马书":1},"verse":"愿主怜悯阿尼色弗一家的人；因他屡次使我畅快，不以我的锁链为耻，","ref":"提摩太后书 1:16","def":"和合本用词；常见搭配：福音 2、先是 1、相信 1。","senses":[],"bverse":"我不以福音为耻；这福音本是神的大能，要救一切相信的，先是犹太人，后是希腊人。","bref":"罗马书 1:16"},{"no":9037,"w":"本于","py":"běn yú","pos":"介词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":0,"nt":3,"first":"罗马书 1:17","top":[["罗马书",2],["哥林多前书",1]],"rest":[0,0],"co":[["归于",2],["义人",1],["正在",1],["必因",1]],"books":{"罗马书":2,"哥林多前书":1},"verse":"因为万有都是本于他，倚靠他，归于他。愿荣耀归给他，直到永远。阿们！","ref":"罗马书 11:36","def":"和合本用词；常见搭配：归于 2、义人 1、正在 1。","senses":[],"bverse":"因为神的义正在这福音上显明出来；这义是本于信，以至于信。如经上所记：“义人必因信得生。”","bref":"罗马书 1:17"},{"no":9038,"w":"顺性","py":"shùn xìng","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":1,"ot":0,"nt":2,"first":"罗马书 1:26","top":[["罗马书",2]],"rest":[0,0],"co":[["女人",2],["羞耻",2],["用处",2],["任凭",1]],"books":{"罗马书":2},"verse":"因此，神任凭他们放纵可羞耻的情欲。他们的女人把顺性的用处变为逆性的用处；","ref":"罗马书 1:26","def":"和合本用词；常见搭配：女人 2、羞耻 2、用处 2。","senses":[["①","顺从天性","罗 1:26","出现 2 次"]],"bverse":"男人也是如此，弃了女人顺性的用处，欲火攻心，彼此贪恋，男和男行可羞耻的事，就在自己身上受这妄为当得的报应。","bref":"罗马书 1:27"},{"no":9039,"w":"阴毒","py":"yīn dú","pos":"名词","orig":"","freq":7,"verses":7,"vols":6,"chaps":6,"ot":0,"nt":7,"first":"罗马书 1:29","top":[["彼得前书",2],["罗马书",1]],"rest":[4,4],"co":[["恶毒",7],["或译",7],["嫉妒",3],["毁谤",3]],"books":{"彼得前书":2,"罗马书":1,"哥林多前书":1,"以弗所书":1,"歌罗西书":1,"提多书":1},"verse":"你们虽是自由的，却不可借着自由遮盖恶毒（或译：阴毒），总要作神的仆人。","ref":"彼得前书 2:16","def":"和合本用词；常见搭配：恶毒 7、或译 7、嫉妒 3。","senses":[["①","阴险毒辣","罗 1:29","出现 7 次"]],"bverse":"所以，你们既除去一切的恶毒（或译：阴毒）、诡诈，并假善、嫉妒，和一切毁谤的话，","bref":"彼得前书 2:1"},{"no":9040,"w":"亲情","py":"qīn qíng","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"罗马书 1:31","top":[["罗马书",1],["提摩太（后书）",1]],"rest":[0,0],"co":[["无知",1],["怜悯",1],["背约",1],["谗言",1]],"books":{"罗马书":1,"提摩太（后书）":1},"verse":"无知的、背约的、无亲情的、不怜悯人的。","ref":"罗马书 1:31","def":"亲戚。亦指亲戚情谊","senses":[],"bverse":"无亲情，不解怨，好说谗言，不能自约，性情凶暴，不爱良善，","bref":"提摩太后书 3:3"},{"no":9041,"w":"判定","py":"pàn dìng","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"罗马书 1:32","top":[["罗马书",1],["彼得后书",1]],"rest":[0,0],"co":[["知道",1],["去行",1],["喜欢",1],["别人",1]],"books":{"罗马书":1,"彼得后书":1},"verse":"又判定所多玛、蛾摩拉，将二城倾覆，焚烧成灰，作为后世不敬虔人的鉴戒；","ref":"彼得后书 2:6","def":"和合本用词；常见搭配：知道 1、去行 1、喜欢 1。","senses":[["①","裁定;断定","罗 1:32","出现 2 次"]],"bverse":"他们虽知道神判定行这样事的人是当死的，然而他们不但自己去行，还喜欢别人去行。","bref":"罗马书 1:32"},{"no":9042,"w":"功用","py":"gōng yòng","pos":"名词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":0,"nt":4,"first":"罗马书 2:15","top":[["罗马书",1],["哥林多前书",1]],"rest":[2,2],"co":[["较量",1],["律法",1],["心里",1],["以为",1]],"books":{"罗马书":1,"哥林多前书":1,"以弗所书":1,"歌罗西书":1},"verse":"功用也有分别，神却是一位，在众人里面运行一切的事。","ref":"哥林多前书 12:6","def":"和合本用词；常见搭配：较量 1、律法 1、心里 1。","senses":[],"bverse":"你们既受洗与他一同埋葬，也就在此与他一同复活，都因信那叫他从死里复活神的功用。","bref":"歌罗西书 2:12"},{"no":9043,"w":"模范","py":"mó fàn","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":0,"nt":2,"first":"罗马书 2:20","top":[["罗马书",2]],"rest":[0,0],"co":[["小孩子",1],["先生",1],["知识",1],["律法",1]],"books":{"罗马书":2},"verse":"是蠢笨人的师傅，是小孩子的先生，在律法上有知识和真理的模范。","ref":"罗马书 2:20","def":"制造器物的模型","senses":[["①","制造器物的模型","罗 2:20","出现 2 次"]],"bverse":"感谢神！因为你们从前虽然作罪的奴仆，现今却从心里顺服了所传给你们道理的模范。","bref":"罗马书 6:17"},{"no":9044,"w":"仪文","py":"yí wén","pos":"名词","orig":"","freq":3,"verses":3,"vols":1,"chaps":2,"ot":0,"nt":3,"first":"罗马书 2:27","top":[["罗马书",3]],"rest":[0,0],"co":[["律法",2],["割礼",2],["本来",1],["全守",1]],"books":{"罗马书":3},"verse":"而且那本来未受割礼的，若能全守律法，岂不是要审判你这有仪文和割礼竟犯律法的人吗？","ref":"罗马书 2:27","def":"和合本用词；常见搭配：律法 2、割礼 2、本来 1。","senses":[["①","礼仪形式","罗 2:27","出现 3 次"]],"bverse":"惟有里面作的，才是真犹太人；真割礼也是心里的，在乎灵，不在乎仪文。这人的称赞不是从人来的，乃是从神来的。","bref":"罗马书 2:29"},{"no":9045,"w":"说来","py":"shuō lái","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":0,"nt":3,"first":"罗马书 3:1","top":[["罗马书",2],["加拉太书",1]],"rest":[0,0],"co":[["律法",2],["犹太人",1],["长处",1],["益处",1]],"books":{"罗马书":2,"加拉太书":1},"verse":"这样说来，犹太人有什么长处？割礼有什么益处呢？","ref":"罗马书 3:1","def":"和合本用词；常见搭配：律法 2、犹太人 1、长处 1。","senses":[],"bverse":"我的弟兄们，这样说来，你们借着基督的身体，在律法上也是死了，叫你们归于别人，就是归于那从死里复活的，叫我们结果子给神。","bref":"罗马书 7:4"},{"no":9046,"w":"常话","py":"cháng huà","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":0,"nt":3,"first":"罗马书 3:5","top":[["罗马书",2],["加拉太书",1]],"rest":[0,0],"co":[["我且",2],["显出",1],["不义",1],["成圣",1]],"books":{"罗马书":2,"加拉太书":1},"verse":"弟兄们，我且照着人的常话说：虽然是人的文约，若已经立定了，就没有能废弃或加增的。","ref":"加拉太书 3:15","def":"和合本用词；常见搭配：我且 2、显出 1、不义 1。","senses":[],"bverse":"我且照着人的常话说，我们的不义若显出神的义来，我们可以怎么说呢？神降怒，是他不义吗？","bref":"罗马书 3:5"},{"no":9047,"w":"该当","py":"gāi dāng","pos":"副词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"罗马书 3:8","top":[["罗马书",1],["彼得后书",1]],"rest":[0,0],"co":[["不说",1],["定罪",1],["毁谤",1],["作恶",1]],"books":{"罗马书":1,"彼得后书":1},"verse":"这一切既然都要如此销化，你们为人该当怎样圣洁，怎样敬虔，","ref":"彼得后书 3:11","def":"和合本用词；常见搭配：不说 1、定罪 1、毁谤 1。","senses":[["①","应当～何罪？ㄧ大伙儿","罗 3:8","出现 2 次"]],"bverse":"为什么不说，我们可以作恶以成善呢？这是毁谤我们的人说我们有这话。这等人定罪是该当的。","bref":"罗马书 3:8"},{"no":9048,"w":"可夸","py":"kě kuā","pos":"动词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"罗马书 3:27","top":[["罗马书",1],["哥林多前书",1]],"rest":[1,1],"co":[["何法",1],["哪里",1],["夸口",1],["我传",1]],"books":{"罗马书":1,"哥林多前书":1,"彼得前书":1},"verse":"我传福音原没有可夸的，因为我是不得已的。若不传福音，我便有祸了。","ref":"哥林多前书 9:16","def":"和合本用词；常见搭配：何法 1、哪里 1、夸口 1。","senses":[],"bverse":"既是这样，哪里能夸口呢？没有可夸的了。用何法没有的呢？是用立功之法吗？不是，乃用信主之法。","bref":"罗马书 3:27"},{"no":9049,"w":"踪迹","py":"zōng jì","pos":"名词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":0,"nt":2,"first":"罗马书 4:12","top":[["罗马书",2]],"rest":[0,0],"co":[["亚伯拉罕",1],["祖宗",1],["去行",1],["割礼",1]],"books":{"罗马书":2},"verse":"深哉，神丰富的智慧和知识！他的判断何其难测！他的踪迹何其难寻！","ref":"罗马书 11:33","def":"脚印；泛指事情留下的痕迹不见踪迹","senses":[],"bverse":"又作受割礼之人的父，就是那些不但受割礼，并且按我们的祖宗亚伯拉罕未受割礼而信之踪迹去行的人。","bref":"罗马书 4:12"},{"no":9050,"w":"本乎","py":"běn hū","pos":"副词","orig":"","freq":8,"verses":7,"vols":4,"chaps":4,"ot":0,"nt":8,"first":"罗马书 4:16","top":[["加拉太书",4],["以弗所书",2]],"rest":[2,2],"co":[["律法",4],["应许",3],["亚伯拉罕",2],["效法",1]],"books":{"加拉太书":4,"以弗所书":2,"罗马书":1,"哥林多前书":1},"verse":"律法原不本乎信，只说：“行这些事的，就必因此活着。”","ref":"加拉太书 3:12","def":"和合本用词；常见搭配：律法 4、应许 3、亚伯拉罕 2。","senses":[],"bverse":"因为承受产业，若本乎律法，就不本乎应许；但神是凭着应许把产业赐给亚伯拉罕。","bref":"加拉太书 3:18"},{"no":9051,"w":"显多","py":"xiǎn duō","pos":"动词","orig":"","freq":5,"verses":3,"vols":2,"chaps":3,"ot":0,"nt":5,"first":"罗马书 5:20","top":[["罗马书",4],["哥林多后书",1]],"rest":[0,0],"co":[["恩典",2],["律法",1],["只是",1],["哪里",1]],"books":{"罗马书":4,"哥林多后书":1},"verse":"这样，怎么说呢？我们可以仍在罪中、叫恩典显多吗？","ref":"罗马书 6:1","def":"和合本用词；常见搭配：恩典 2、律法 1、只是 1。","senses":[],"bverse":"律法本是外添的，叫过犯显多；只是罪在哪里显多，恩典就更显多了。","bref":"罗马书 5:20"},{"no":9052,"w":"旧人","py":"jiù rén","pos":"名词","orig":"","freq":5,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":5,"first":"罗马书 6:6","top":[["以弗所书",2],["歌罗西书",2]],"rest":[1,1],"co":[["行为",2],["不再",1],["钉十字架",1],["奴仆",1]],"books":{"以弗所书":2,"歌罗西书":2,"罗马书":1},"verse":"就要脱去你们从前行为上的旧人，这旧人是因私欲的迷惑渐渐变坏的；","ref":"以弗所书 4:22","def":"谓年高德劭的旧臣","senses":[["①","谓年高德劭的旧臣","罗 6:6","出现 5 次"]],"bverse":"不要彼此说谎；因你们已经脱去旧人和旧人的行为，","bref":"歌罗西书 3:9"},{"no":9053,"w":"作罪","py":"zuò zuì","pos":"动词","orig":"","freq":4,"verses":4,"vols":1,"chaps":1,"ot":0,"nt":4,"first":"罗马书 6:6","top":[["罗马书",4]],"rest":[0,0],"co":[["奴仆",4],["不再",1],["钉十字架",1],["知道",1]],"books":{"罗马书":4},"verse":"因为你们作罪之奴仆的时候，就不被义约束了。","ref":"罗马书 6:20","def":"和合本用词；常见搭配：奴仆 4、不再 1、钉十字架 1。","senses":[],"bverse":"因为知道我们的旧人和他同钉十字架，使罪身灭绝，叫我们不再作罪的奴仆；","bref":"罗马书 6:6"},{"no":9054,"w":"同活","py":"tóng huó","pos":"介词","orig":"","freq":4,"verses":4,"vols":4,"chaps":4,"ot":0,"nt":4,"first":"罗马书 6:8","top":[["罗马书",1],["哥林多后书",1]],"rest":[2,2],"co":[["同死",2],["基督",2],["仍然",1],["因神",1]],"books":{"罗马书":1,"哥林多后书":1,"帖撒罗尼迦（前书）":1,"提摩太（后书）":1},"verse":"我们若是与基督同死，就信必与他同活。","ref":"罗马书 6:8","def":"和合本用词；常见搭配：同死 2、基督 2、仍然 1。","senses":[],"bverse":"他替我们死，叫我们无论醒著，睡着，都与他同活。","bref":"帖撒罗尼迦前书 5:10"},{"no":9055,"w":"罪作","py":"zuì zuò","pos":"名词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":0,"nt":3,"first":"罗马书 6:13","top":[["约翰（一书）",2],["罗马书",1]],"rest":[0,0],"co":[["挽回",2],["不要",1],["复活",1],["献给",1]],"books":{"约翰（一书）":2,"罗马书":1},"verse":"他为我们的罪作了挽回祭，不是单为我们的罪，也是为普天下人的罪。","ref":"约翰一书 2:2","def":"和合本用词；常见搭配：挽回 2、不要 1、复活 1。","senses":[],"bverse":"不是我们爱神，乃是神爱我们，差他的儿子为我们的罪作了挽回祭，这就是爱了。","bref":"约翰一书 4:10"},{"no":9056,"w":"顺命","py":"shùn mìng","pos":"名词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":0,"nt":2,"first":"罗马书 6:16","top":[["罗马书",1],["彼得前书",1]],"rest":[0,0],"co":[["以致",1],["奴仆",1],["顺从",1],["晓得",1]],"books":{"罗马书":1,"彼得前书":1},"verse":"你们既作顺命的儿女，就不要效法从前蒙昧无知的时候那放纵私欲的样子。","ref":"彼得前书 1:14","def":"和合本用词；常见搭配：以致 1、奴仆 1、顺从 1。","senses":[["①","顺从天命","罗 6:16","出现 2 次"]],"bverse":"岂不晓得你们献上自己作奴仆，顺从谁，就作谁的奴仆吗？或作罪的奴仆，以至于死；或作顺命的奴仆，以致成义。","bref":"罗马书 6:16"},{"no":9057,"w":"照人","py":"zhào rén","pos":"名词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":0,"nt":3,"first":"罗马书 6:19","top":[["罗马书",1],["哥林多前书",1]],"rest":[1,1],"co":[["成圣",1],["照样",1],["奴仆",1],["肉体",1]],"books":{"罗马书":1,"哥林多前书":1,"歌罗西书":1},"verse":"我说这话，岂是照人的意见；律法不也是这样说吗？","ref":"哥林多前书 9:8","def":"和合本用词；常见搭配：成圣 1、照样 1、奴仆 1。","senses":[],"bverse":"这都是照人所吩咐、所教导的。说到这一切，正用的时候就都败坏了。","bref":"歌罗西书 2:22"},{"no":9058,"w":"这爱","py":"zhè ài","pos":"代词","orig":"","freq":3,"verses":3,"vols":3,"chap