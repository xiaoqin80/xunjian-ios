oks":{"士师记":2,"约翰福音":1},"verse":"你们若不能猜出意思告诉我，你们就给我三十件里衣，三十套衣裳。”他们说：“请将谜语说给我们听。”","ref":"士师记 14:13","def":"和合本用词；常见搭配：谜语 2、猜出 2、三十 2。","senses":[],"bverse":"参孙对他们说：“我给你们出一个谜语，你们在七日筵宴之内，若能猜出意思告诉我，我就给你们三十件里衣，三十套衣裳；","bref":"士师记 14:12"},{"no":5058,"w":"啼哭","py":"tí kū","pos":"动词","orig":"","freq":3,"verses":3,"vols":2,"chaps":2,"ot":2,"nt":1,"first":"士师记 14:16","top":[["士师记",2],["路加福音",1]],"rest":[0,0],"co":[["丈夫",2],["谜语",2],["本国",2],["面前",2]],"books":{"士师记":2,"路加福音":1},"verse":"好像孩童坐在街市上，彼此呼叫说：我们向你们吹笛，你们不跳舞；我们向你们举哀，你们不啼哭。","ref":"路加福音 7:32","def":"和合本用词；常见搭配：丈夫 2、谜语 2、本国 2。","senses":[["①","放声地哭","士 14:16","出现 3 次"]],"bverse":"参孙的妻在丈夫面前啼哭说：“你是恨我，不是爱我，你给我本国的人出谜语，却没有将意思告诉我。”参孙回答说：“连我父母我都没有告诉，岂可告诉你呢？”","bref":"士师记 14:16"},{"no":5060,"w":"未落","py":"wèi luò","pos":"动词","orig":"","freq":3,"verses":2,"vols":2,"chaps":2,"ot":3,"nt":0,"first":"士师记 14:18","top":[["撒母耳记（下）",2],["士师记",1]],"rest":[0,0],"co":[["以前",2],["日头",2],["谜语",1],["参孙",1]],"books":{"撒母耳记（下）":2,"士师记":1},"verse":"日头未落的时候，众民来劝大卫吃饭，但大卫起誓说：“我若在日头未落以前吃饭，或吃别物，愿神重重地降罚与我！”","ref":"撒母耳记下 3:35","def":"和合本用词；常见搭配：以前 2、日头 2、谜语 1。","senses":[],"bverse":"到第七天，日头未落以前，那城里的人对参孙说：有什么比蜜还甜呢？有什么比狮子还强呢？参孙对他们说：你们若非用我的母牛犊耕地，就猜不出我谜语的意思来。","bref":"士师记 14:18"},{"no":5061,"w":"比蜜","py":"bǐ mì","pos":"介词","orig":"","freq":3,"verses":3,"vols":2,"chaps":3,"ot":3,"nt":0,"first":"士师记 14:18","top":[["诗篇",2],["士师记",1]],"rest":[0,0],"co":[["谜语",1],["参孙",1],["不出",1],["以前",1]],"books":{"诗篇":2,"士师记":1},"verse":"你的言语在我上膛何等甘美，在我口中比蜜更甜！","ref":"诗篇 119:103","def":"和合本用词；常见搭配：谜语 1、参孙 1、不出 1。","senses":[],"bverse":"都比金子可羡慕，且比极多的精金可羡慕；比蜜甘甜，且比蜂房下滴的蜜甘甜。","bref":"诗篇 19:10"},{"no":5062,"w":"若非","py":"ruò fēi","pos":"连词","orig":"","freq":3,"verses":3,"vols":3,"chaps":3,"ot":3,"nt":0,"first":"士师记 14:18","top":[["士师记",1],["诗篇",1]],"rest":[1,1],"co":[["狮子",2],["谜语",1],["参孙",1],["不出",1]],"books":{"士师记":1,"诗篇":1,"阿摩司书":1},"verse":"狮子若非抓食，岂能在林中咆哮呢？少壮狮子若无所得，岂能从洞中发声呢？","ref":"阿摩司书 3:4","def":"如果不是;要不是","senses":[["①","如果不是;要不是","士 14:18","出现 3 次"]],"bverse":"到第七天，日头未