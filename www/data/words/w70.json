,1],["隐藏",1],["珍宝",1]],"books":{"约伯记":2,"诗篇":1},"verse":"你以为有理，或以为你的公义胜于神的公义，","ref":"约伯记 35:2","def":"和合本用词；常见搭配：切望 1、求死 1、隐藏 1。","senses":[],"bverse":"他们切望死，却不得死；求死，胜于求隐藏的珍宝。","bref":"约伯记 3:21"},{"no":6911,"w":"遮隐","py":"zhē yǐn","pos":"动词","orig":"","freq":2,"verses":2,"vols":2,"chaps":2,"ot":2,"nt":0,"first":"约伯记 3:23","top":[["约伯记",1],["箴言",1]],"rest":[0,0],"co":[["道路",1],["四面",1],["为何",1],["既然",1]],"books":{"约伯记":1,"箴言":1},"verse":"人的道路既然遮隐，神又把他四面围困，为何有光赐给他呢？","ref":"约伯记 3:23","def":"和合本用词；常见搭配：道路 1、四面 1、为何 1。","senses":[["①","掩盖;隐藏","伯 3:23","出现 2 次"]],"bverse":"往来传舌的，泄漏密事；心中诚实的，遮隐事情。","bref":"箴言 11:13"},{"no":6912,"w":"涌出","py":"yǒng chū","pos":"动词","orig":"","freq":11,"verses":10,"vols":5,"chaps":9,"ot":10,"nt":1,"first":"约伯记 3:24","top":[["诗篇",4],["耶利米书",3]],"rest":[3,4],"co":[["磐石",4],["江河",2],["使水",2],["水来",2]],"books":{"诗篇":4,"耶利米书":3,"以赛亚书":2,"约伯记":1,"犹大书":1},"verse":"他使水从磐石涌出，叫水如江河下流。","ref":"诗篇 78:16","def":"和合本用词；常见搭配：磐石 4、江河 2、使水 2。","senses":[["①","亦作\"涌出\"","伯 3:24","出现 11 次"]],"bverse":"他打开磐石，水就涌出；在干旱之处，水流成河。","bref":"诗篇 105:41"},{"no":6914,"w":"扶助","py":"fú zhù","pos":"动词","orig":"","freq":16,"verses":16,"vols":9,"chaps":14,"ot":12,"nt":4,"first":"约伯记 4:4","top":[["约伯记",4],["但以理书",3]],"rest":[7,9],"co":[["软弱",3],["耶和华",3],["言语",2],["神必",2]],"books":{"约伯记":4,"但以理书":3,"诗篇":2,"以西结书":2,"以赛亚书":1,"路加福音":1,"使徒行传":1,"哥林多后书":1,"帖撒罗尼迦（前书）":1},"verse":"神必不丢弃完全人，也不扶助邪恶人。","ref":"约伯记 8:20","def":"帮助、扶持。","senses":[],"bverse":"神必不收回他的怒气；扶助拉哈伯的，屈身在他以下。","bref":"约伯记 9:13"},{"no":6915,"w":"毒害","py":"dú hài","pos":"名词","orig":"","freq":8,"verses":8,"vols":3,"chaps":6,"ot":8,"nt":0,"first":"约伯记 4:8","top":[["诗篇",5],["约伯记",2]],"rest":[1,1],"co":[["罪孽",3],["所生",3],["所怀",3],["奸恶",3]],"books":{"诗篇":5,"约伯记":2,"以赛亚书":1},"verse":"他必救你脱离捕鸟人的网罗和毒害的瘟疫。","ref":"诗篇 91:3","def":"和合本用词；常见搭配：罪孽 3、所生 3、所怀 3。","senses":[],"bverse":"他满口是咒骂、诡诈、欺压，舌底是毒害、奸恶。","bref":"诗篇 10:7"},{"no":6916,"w":"出气","py":"chū qì","pos":"动词","orig":"","freq":2,"verses":2,"vols":1,"chaps":2,"ot":2,"nt":0,